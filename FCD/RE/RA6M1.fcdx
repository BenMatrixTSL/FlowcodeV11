<!-- CRC:  -->
<!-- REVISION: 1.0 -->
<!-- GUID: D4E5F6A7-B8C9-0123-4567-890123456789 -->
<!-- DATE: 25\06\2026 -->
<!-- DIR: FCD\RE\RA6M1.fcdx -->
<root>

<build>
<compiler exe="$(fcddir)RE\batch\racomp.bat" params="&quot;$(target)&quot; &quot;$(outdir)&quot; &quot;$(chipalt)&quot; &quot;$(family)&quot; &quot;$(lscript)&quot; &quot;$(clock)&quot; &quot;$(romsize)&quot; &quot;$(ramsize)&quot; &quot;$(compilerstarm)&quot;" />
<linker exe="$(appdir)tools\DoNothing\DoNothing.exe" params="" />
<programmer exe="$(fcddir)RE\batch\raprog.bat" params="&quot;$(outdir)&quot; &quot;$(target)&quot; $(devname) &quot;$(compilerstarm)&quot; " />
</build>

<device    file = 'RA6M1'
        name='R7FA6M1AD3CFP'
        namealt='RA6M1'
        product='RE' compiler='RE' cal='RE'
        family='RA6'
        bits='32' >

    <parameters>
        <lscript value = 'ra6m1.ld' />
        <romsize value = '256K' />
        <ramsize value = '32K' />
    </parameters>

    <!-- system_ra6.c configures HOCO(20MHz) + PLL x6 = 120MHz -->
    <clock max_speed='120000000' master_divider='1' default='120000000' />

    <memory >
        <flash bytes='262144' />
        <ram bytes='32768' />
    </memory>

    <configuration address='0' mult='1' >
        <format ><dword address='RA_SYSCLK' value='120000000' /></format>
        <setting />
        <settings >
            <setting name='System Clock' offset='0' mask='0xFFFFFFFF' bits='32' hint='CPU clock frequency (Hz)' >
                <option name='120 MHz (HOCO+PLL)' value='120000000' />
                <option name='48 MHz (HOCO only)' value='48000000' />
            </setting>
        </settings>
    </configuration>

    <!--
        RA6M1 LQFP-100 pin listing (R7FA6M1AD3CFP).
        Peripherals: SCI0-SCI9, IIC0-IIC2, RSPI0, ADC12 (14-ch), GPT0-GPT9.
        PSEL values: 1=IIC, 3=RSPI, 4=SCI, 6=GPT (same as RA4M1)
    -->
    <pins sides='4' smd='1' >
        <pin name='VCC'   />
        <pin name='VSS'   />
        <pin name='AVCC0' />
        <pin name='AVSS0' />
        <pin name='NRST'  />

        <!-- Port 0: ADC capable AN000-AN009 -->
        <pin name='P000' port='0' bit='0'  adc='0'  />
        <pin name='P001' port='0' bit='1'  adc='1'  />
        <pin name='P002' port='0' bit='2'  adc='2'  />
        <pin name='P003' port='0' bit='3'  adc='3'  />
        <pin name='P004' port='0' bit='4'  adc='4'  />
        <pin name='P005' port='0' bit='5'  adc='5'  />
        <pin name='P006' port='0' bit='6'  adc='6'  />
        <pin name='P007' port='0' bit='7'  adc='7'  />
        <pin name='P008' port='0' bit='8'  />
        <pin name='P009' port='0' bit='9'  />
        <pin name='P010' port='0' bit='10' />
        <pin name='P011' port='0' bit='11' />
        <pin name='P012' port='0' bit='12' />
        <pin name='P013' port='0' bit='13' />
        <pin name='P014' port='0' bit='14' adc='8'  />
        <pin name='P015' port='0' bit='15' adc='9'  />

        <!-- Port 1 -->
        <pin name='P100' port='1' bit='0'  />
        <pin name='P101' port='1' bit='1'  />
        <pin name='P102' port='1' bit='2'  />
        <pin name='P103' port='1' bit='3'  />
        <pin name='P104' port='1' bit='4'  />
        <pin name='P105' port='1' bit='5'  />
        <pin name='P106' port='1' bit='6'  />
        <pin name='P107' port='1' bit='7'  />
        <pin name='P108' port='1' bit='8'  />
        <pin name='P109' port='1' bit='9'  />
        <pin name='P110' port='1' bit='10' />
        <pin name='P111' port='1' bit='11' />
        <pin name='P112' port='1' bit='12' />
        <pin name='P113' port='1' bit='13' />
        <pin name='P114' port='1' bit='14' />
        <pin name='P115' port='1' bit='15' />

        <!-- Port 2 -->
        <pin name='P200' port='2' bit='0'  />
        <pin name='P201' port='2' bit='1'  />
        <pin name='P202' port='2' bit='2'  />
        <pin name='P203' port='2' bit='3'  />
        <pin name='P204' port='2' bit='4'  />
        <pin name='P205' port='2' bit='5'  />
        <pin name='P206' port='2' bit='6'  />
        <pin name='P207' port='2' bit='7'  />
        <pin name='P208' port='2' bit='8'  />
        <pin name='P212' port='2' bit='12' />
        <pin name='P213' port='2' bit='13' />

        <!-- Port 3 -->
        <pin name='P300' port='3' bit='0'  />
        <pin name='P301' port='3' bit='1'  />
        <pin name='P302' port='3' bit='2'  />
        <pin name='P303' port='3' bit='3'  />
        <pin name='P304' port='3' bit='4'  />
        <pin name='P305' port='3' bit='5'  />
        <pin name='P306' port='3' bit='6'  />
        <pin name='P307' port='3' bit='7'  />

        <!-- Port 4 -->
        <pin name='P400' port='4' bit='0'  />
        <pin name='P401' port='4' bit='1'  />
        <pin name='P402' port='4' bit='2'  />
        <pin name='P403' port='4' bit='3'  />
        <pin name='P404' port='4' bit='4'  />
        <pin name='P405' port='4' bit='5'  />
        <pin name='P406' port='4' bit='6'  />
        <pin name='P407' port='4' bit='7'  />
        <pin name='P408' port='4' bit='8'  />
        <pin name='P409' port='4' bit='9'  />
        <pin name='P410' port='4' bit='10' />
        <pin name='P411' port='4' bit='11' />
        <pin name='P412' port='4' bit='12' />
        <pin name='P413' port='4' bit='13' />
        <pin name='P414' port='4' bit='14' />
        <pin name='P415' port='4' bit='15' />

        <!-- Port 5 -->
        <pin name='P500' port='5' bit='0'  />
        <pin name='P501' port='5' bit='1'  />
        <pin name='P502' port='5' bit='2'  />
        <pin name='P503' port='5' bit='3'  />
        <pin name='P504' port='5' bit='4'  />
        <pin name='P505' port='5' bit='5'  />
        <pin name='P506' port='5' bit='6'  />
        <pin name='P507' port='5' bit='7'  />
        <pin name='P508' port='5' bit='8'  />

        <!-- Port 6 -->
        <pin name='P600' port='6' bit='0'  />
        <pin name='P601' port='6' bit='1'  />
        <pin name='P602' port='6' bit='2'  />
        <pin name='P603' port='6' bit='3'  />
        <pin name='P604' port='6' bit='4'  />
        <pin name='P605' port='6' bit='5'  />

        <!-- Port 7 -->
        <pin name='P700' port='7' bit='0'  />
        <pin name='P701' port='7' bit='1'  />
        <pin name='P702' port='7' bit='2'  />
        <pin name='P703' port='7' bit='3'  />
        <pin name='P704' port='7' bit='4'  />
        <pin name='P705' port='7' bit='5'  />

        <!-- Port 8 -->
        <pin name='P800' port='8' bit='0'  />
        <pin name='P801' port='8' bit='1'  />
        <pin name='P802' port='8' bit='2'  />

        <!-- Port 9 -->
        <pin name='P900' port='9' bit='0'  />
        <pin name='P901' port='9' bit='1'  />
        <pin name='P902' port='9' bit='2'  />

        <pin name='SWDIO' />
        <pin name='SWCLK' />
    </pins>

    <adc type='2' bits='12' >
        <speed >
            <option name='Fast'   value='0x13' />
            <option name='Medium' value='0x1F' />
            <option name='Slow'   value='0x3F' />
        </speed>
    </adc>

    <spi remappable='1' name='SPI0' >
        <clk  af0='3' port0='1' pin0='2' />
        <miso af0='3' port0='1' pin0='0' />
        <mosi af0='3' port0='1' pin0='1' />
    </spi>

    <uart remappable='3' name='SCI0' >
        <tx af0='4' port0='3' pin0='2' af1='4' port1='1' pin1='9'  af2='4' port2='6' pin2='4' />
        <rx af0='4' port0='3' pin0='1' af1='4' port1='1' pin1='10' af2='4' port2='6' pin2='5' />
    </uart>

    <uart remappable='2' name='SCI1' >
        <tx af0='4' port0='1' pin0='9'  af1='4' port1='4' pin1='2' />
        <rx af0='4' port0='1' pin0='10' af1='4' port1='4' pin1='3' />
    </uart>

    <uart remappable='2' name='SCI2' >
        <tx af0='4' port0='3' pin0='4' af1='4' port1='5' pin1='0' />
        <rx af0='4' port0='3' pin0='5' af1='4' port1='5' pin1='1' />
    </uart>

    <uart remappable='2' name='SCI9' >
        <tx af0='4' port0='4' pin0='11' af1='4' port1='1' pin1='4' />
        <rx af0='4' port0='4' pin0='10' af1='4' port1='1' pin1='3' />
    </uart>

    <!-- IIC0: SCL=P400(bit0), SDA=P401(bit1). PSEL=1. Alt: SCL=P112, SDA=P113. -->
    <i2c remappable='2' name='IIC0' >
        <scl af0='1' port0='4' pin0='0' af1='1' port1='1' pin1='12' />
        <sda af0='1' port0='4' pin0='1' af1='1' port1='1' pin1='13' />
    </i2c>

    <!-- IIC1: SCL=P505(bit5), SDA=P506(bit6). Alt: SCL=P204, SDA=P205. PSEL=1. -->
    <i2c remappable='2' name='IIC1' >
        <scl af0='1' port0='5' pin0='5' af1='1' port1='2' pin1='4' />
        <sda af0='1' port0='5' pin0='6' af1='1' port1='2' pin1='5' />
    </i2c>

    <!-- IIC2: SCL=P700(bit0), SDA=P701(bit1). PSEL=1. -->
    <i2c remappable='1' name='IIC2' >
        <scl af0='1' port0='7' pin0='0' />
        <sda af0='1' port0='7' pin0='1' />
    </i2c>

    <pwm regset='1' remappable='1' >
        <timer><option name='Fixed' value='1' count='10' /></timer>
        <prescaler >
            <option name="1"    value="1"    />
            <option name="4"    value="4"    />
            <option name="16"   value="16"   />
            <option name="64"   value="64"   />
            <option name="256"  value="256"  />
            <option name="1024" value="1024" />
        </prescaler>
        <out name='GPT0_A' af0='6' port0='4' pin0='0'  />
        <out name='GPT0_B' af0='6' port0='4' pin0='1'  />
        <out name='GPT1_A' af0='6' port0='4' pin0='2'  />
        <out name='GPT1_B' af0='6' port0='4' pin0='3'  />
        <out name='GPT2_A' af0='6' port0='1' pin0='5'  />
        <out name='GPT2_B' af0='6' port0='1' pin0='6'  />
        <out name='GPT3_A' af0='6' port0='1' pin0='7'  />
        <out name='GPT3_B' af0='6' port0='1' pin0='8'  />
        <out name='GPT4_A' af0='6' port0='1' pin0='11' />
        <out name='GPT4_B' af0='6' port0='1' pin0='12' />
        <out name='GPT5_A' af0='6' port0='3' pin0='3'  />
        <out name='GPT5_B' af0='6' port0='3' pin0='4'  />
        <out name='GPT6_A' af0='6' port0='6' pin0='0'  />
        <out name='GPT6_B' af0='6' port0='6' pin0='1'  />
        <out name='GPT7_A' af0='6' port0='6' pin0='2'  />
        <out name='GPT7_B' af0='6' port0='6' pin0='3'  />
    </pwm>

    <interrupts >
    </interrupts>

</device>

<inline >
    <defines code='\n#define MX_CAL_RE' />
    <directives code='' />
    <main >
        <start code='
int main()
{
' />
        <end code='    mainendloop: goto mainendloop;\n\treturn 0;\n}\n\n' />
        <init code='' />
    </main>
    <interrupt ><enable code='' /><start code='' /><end code='' /><init code='' /></interrupt>
    <config >
        <start code='//Configuration Start\n' />
        <body code='#define $(address) ($(value))\n' />
        <end code='//Configuration End\n\n' />
    </config>
</inline>

<test >
    <icd ><clock port0='1' pin0='2' /><data port0='1' pin0='1' /></icd>
</test>

</root>
