<!-- CRC:  -->
<!-- REVISION: 1.0 -->
<!-- GUID: A1B2C3D4-E5F6-7890-1234-567890123456 -->
<!-- DATE: 25\06\2026 -->
<!-- DIR: FCD\RE\RA4M1_Minima.fcdx -->
<root>

<build>
<compiler exe="$(fcddir)RE\batch\racomp.bat" params="&quot;$(target)&quot; &quot;$(outdir)&quot; &quot;$(chipalt)&quot; &quot;$(family)&quot; &quot;$(lscript)&quot; &quot;$(clock)&quot; &quot;$(romsize)&quot; &quot;$(ramsize)&quot; &quot;$(compilerstarm)&quot;" />
<linker exe="$(appdir)tools\DoNothing\DoNothing.exe" params="" />
<programmer exe="$(fcddir)RE\batch\raprog.bat" params="&quot;$(outdir)&quot; &quot;$(target)&quot; $(devname) &quot;$(compilerstarm)&quot; " />
</build>

<device    file = 'RA4M1_Minima'
        name='R7FA4M1AB3CFM'
        namealt='RA4M1'
        product='RE' compiler='RE' cal='RE'
        family='RA4'
        bits='32' >

    <parameters>
        <lscript value = 'ra4m1_boot.ld' />
        <romsize value = '256K' />
        <ramsize value = '32K' />
    </parameters>

    <clock max_speed='48000000' master_divider='1' default='48000000' />

    <memory >
        <flash bytes='262144' />
        <ram bytes='32768' />
    </memory>

    <configuration address='0' mult='1' >
        <format >
            <dword address='RA_HOCO_FREQ' value='48000000' />
        </format>
        <setting />
        <settings >
            <setting name='HOCO Frequency' offset='0' mask='0xFFFFFFFF' bits='32' hint='System clock frequency (Hz)' >
                <option name='24 MHz' value='24000000' />
                <option name='32 MHz' value='32000000' />
                <option name='48 MHz' value='48000000' />
            </setting>
        </settings>
    </configuration>

    <!--
        Arduino Uno R4 Minima pin mapping (R7FA4M1AB3CFM LQFP-64)
        Verified against ArduinoCore-renesas MINIMA/variant.cpp and MINIMA/pinmux.inc.

        D0  (RX)   = P301 (port=3, bit=1)  SCI2 RXD          PSEL=4
        D1  (TX)   = P302 (port=3, bit=2)  SCI2 TXD          PSEL=4
        D2         = P105 (port=1, bit=5)
        D3  (PWM)  = P104 (port=1, bit=4)  GPT1B             PSEL=6
        D4         = P103 (port=1, bit=3)
        D5  (PWM)  = P102 (port=1, bit=2)  GPT2B             PSEL=6
        D6  (PWM)  = P106 (port=1, bit=6)  GPT0B             PSEL=6
        D7         = P107 (port=1, bit=7)
        D8         = P304 (port=3, bit=4)
        D9  (PWM)  = P303 (port=3, bit=3)  GPT7B             PSEL=6
        D10 (SS)   = P112 (port=1, bit=12) GPT3B             PSEL=6
        D11 (MOSI) = P109 (port=1, bit=9)  RSPI0 MOSIA/GPT1A PSEL=3/6
        D12 (MISO) = P110 (port=1, bit=10) RSPI0 MISOA/GPT1B PSEL=3/6
        D13 (SCK)  = P111 (port=1, bit=11) RSPI0 RSPCKA/GPT3A PSEL=3/6
        A0  (DAC)  = P014 (port=0, bit=14) AN008
        A1         = P000 (port=0, bit=0)  AN000
        A2         = P001 (port=0, bit=1)  AN001
        A3         = P002 (port=0, bit=2)  AN002
        A4  (SDA)  = P101 (port=1, bit=1)  AN021, IIC1 SDA   PSEL=1
        A5  (SCL)  = P100 (port=1, bit=0)  AN022, IIC1 SCL   PSEL=1

        PSEL values (R_PFS PSEL field):
          1 = IIC  (SDA/SCL)
          3 = RSPI (RSPCK/MOSI/MISO)
          4 = SCI  (TXD/RXD)
          6 = GPT  (GTIOCA/GTIOCB)
    -->
    <pins sides='4' smd='1' >
        <!-- Power -->
        <pin name='AVCC0' />
        <pin name='AVSS0' />
        <pin name='VCC' />
        <pin name='VSS' />
        <pin name='VCL' />

        <!-- Port 0: A0=P014/AN008, A1-A3=P000-P002/AN000-AN002 -->
        <pin name='P000/A1'         port='0' bit='0'  adc='0'  />
        <pin name='P001/A2'         port='0' bit='1'  adc='1'  />
        <pin name='P002/A3'         port='0' bit='2'  adc='2'  />
        <pin name='P003'            port='0' bit='3'  adc='3'  />
        <pin name='P004'            port='0' bit='4'  adc='4'  />
        <pin name='P005'            port='0' bit='5'  adc='5'  />
        <pin name='P006'            port='0' bit='6'  adc='6'  />
        <pin name='P007'            port='0' bit='7'  adc='7'  />
        <pin name='P008'            port='0' bit='8'  />
        <pin name='P009'            port='0' bit='9'  />
        <pin name='P010'            port='0' bit='10' />
        <pin name='P011'            port='0' bit='11' />
        <pin name='P012'            port='0' bit='12' />
        <pin name='P013'            port='0' bit='13' />
        <pin name='P014/A0'         port='0' bit='14' adc='8'  />
        <pin name='P015'            port='0' bit='15' adc='9'  />

        <!-- Port 1 -->
        <pin name='P100/A5/SCL'     port='1' bit='0'  adc='22' />
        <pin name='P101/A4/SDA'     port='1' bit='1'  adc='21' />
        <pin name='P102/D5'         port='1' bit='2'  />
        <pin name='P103/D4'         port='1' bit='3'  />
        <pin name='P104/D3'         port='1' bit='4'  />
        <pin name='P105/D2'         port='1' bit='5'  />
        <pin name='P106/D6'         port='1' bit='6'  />
        <pin name='P107/D7'         port='1' bit='7'  />
        <pin name='P108'            port='1' bit='8'  />
        <pin name='P109/D11/MOSI'   port='1' bit='9'  />
        <pin name='P110/D12/MISO'   port='1' bit='10' />
        <pin name='P111/D13/SCK'    port='1' bit='11' />
        <pin name='P112/D10/SS'     port='1' bit='12' />
        <pin name='P113'            port='1' bit='13' />
        <pin name='P114'            port='1' bit='14' />
        <pin name='P115'            port='1' bit='15' />

        <!-- Port 2 -->
        <pin name='P200'            port='2' bit='0'  />
        <pin name='P201'            port='2' bit='1'  />
        <pin name='P202'            port='2' bit='2'  />
        <pin name='P203'            port='2' bit='3'  />
        <pin name='P204'            port='2' bit='4'  />
        <pin name='P205'            port='2' bit='5'  />
        <pin name='P206'            port='2' bit='6'  />
        <pin name='P207'            port='2' bit='7'  />
        <pin name='P208'            port='2' bit='8'  />

        <!-- Port 3: D0(RX)/D1(TX), D8/D9 -->
        <pin name='P301/D0/RX'      port='3' bit='1'  />
        <pin name='P302/D1/TX'      port='3' bit='2'  />
        <pin name='P303/D9'         port='3' bit='3'  />
        <pin name='P304/D8'         port='3' bit='4'  />
        <pin name='P305'            port='3' bit='5'  />

        <!-- Port 4 -->
        <pin name='P400'            port='4' bit='0'  />
        <pin name='P401'            port='4' bit='1'  />
        <pin name='P402'            port='4' bit='2'  />
        <pin name='P403'            port='4' bit='3'  />
        <pin name='P404'            port='4' bit='4'  />
        <pin name='P405'            port='4' bit='5'  />
        <pin name='P406'            port='4' bit='6'  />
        <pin name='P407'            port='4' bit='7'  />
        <pin name='P408'            port='4' bit='8'  />
        <pin name='P409'            port='4' bit='9'  />
        <pin name='P410'            port='4' bit='10' />
        <pin name='P411'            port='4' bit='11' />
        <pin name='P412'            port='4' bit='12' />
        <pin name='P413'            port='4' bit='13' />
        <pin name='P414'            port='4' bit='14' />
        <pin name='P415'            port='4' bit='15' />

        <!-- Port 5 -->
        <pin name='P500'            port='5' bit='0'  />
        <pin name='P501'            port='5' bit='1'  />
        <pin name='P502'            port='5' bit='2'  />
        <pin name='P503'            port='5' bit='3'  />
        <pin name='P504'            port='5' bit='4'  />
        <pin name='P505'            port='5' bit='5'  />
        <pin name='P506'            port='5' bit='6'  />

        <!-- Debug -->
        <pin name='NRST' />
        <pin name='SWDIO' />
        <pin name='SWCLK' />
    </pins>

    <adc type='2' bits='12' >
        <speed >
            <option name='Fast'    value='0x13' />
            <option name='Medium'  value='0x1F' />
            <option name='Slow'    value='0x3F' />
        </speed>
    </adc>

    <!-- SPI0 (RSPI0): D13=SCK(P111), D12=MISO(P110), D11=MOSI(P109). PSEL=3. -->
    <spi remappable='1' name='SPI0' >
        <clk  af0='3' port0='1' pin0='11' />
        <miso af0='3' port0='1' pin0='10' />
        <mosi af0='3' port0='1' pin0='9'  />
    </spi>

    <!-- SCI2 UART: D0=RX(P301), D1=TX(P302). PSEL=4. -->
    <uart remappable='1' name='SCI2' >
        <tx af0='4' port0='3' pin0='2' />
        <rx af0='4' port0='3' pin0='1' />
    </uart>

    <!-- SCI9 UART: P109(TX)/P110(RX) - additional UART option (shares D11/D12) -->
    <uart remappable='1' name='SCI9' >
        <tx af0='4' port0='1' pin0='9'  />
        <rx af0='4' port0='1' pin0='10' />
    </uart>

    <!-- IIC1 (A4/A5): SDA=P101, SCL=P100. PSEL=1. -->
    <i2c remappable='1' name='IIC1' >
        <sda af0='1' port0='1' pin0='1' />
        <scl af0='1' port0='1' pin0='0' />
    </i2c>

    <!-- GPT PWM: D3/D5/D6/D9/D10/D11. PSEL=6 selects GTIOC output. -->
    <pwm regset='1' remappable='1' >
        <timer>
            <option name='Fixed' value='1' count='6' />
        </timer>
        <prescaler >
            <option name="1"    value="1"    />
            <option name="4"    value="4"    />
            <option name="16"   value="16"   />
            <option name="64"   value="64"   />
            <option name="256"  value="256"  />
            <option name="1024" value="1024" />
        </prescaler>
        <out name='GPT0_B/D6'   af0='6' port0='1' pin0='6'  />
        <out name='GPT1_A/D11'  af0='6' port0='1' pin0='9'  />
        <out name='GPT1_B/D3'   af0='6' port0='1' pin0='4'  />
        <out name='GPT2_B/D5'   af0='6' port0='1' pin0='2'  />
        <out name='GPT3_B/D10'  af0='6' port0='1' pin0='12' />
        <out name='GPT7_B/D9'   af0='6' port0='3' pin0='3'  />
    </pwm>

    <interrupts >
    </interrupts>

</device>

<inline >
    <defines code='\n#define MX_CAL_RE' />
    <directives code='' />
    <main >
        <start code='
int main()
{
    /* SystemInit() called from startup code (ra4m1_startup.c) before main() */
    /* All ports powered by default on RA4M1 - no clock-enable per port needed */
' />
        <end code='    mainendloop: goto mainendloop;\n\treturn 0;\n}\n\n' />
        <init code='' />
    </main>
    <interrupt >
        <enable code='' />
        <start code='' />
        <end code='' />
        <init code='' />
    </interrupt>
    <config >
        <start code='//Configuration Start\n' />
        <body code='#define $(address) ($(value))\n' />
        <end code='//Configuration End\n\n' />
    </config>
</inline>

<test >
    <icd >
        <clock port0='1' pin0='11' />
        <data  port0='1' pin0='9'  />
    </icd>
</test>

</root>
