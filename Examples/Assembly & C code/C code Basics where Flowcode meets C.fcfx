set_bit(portb, 0);		//Output a 1' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' language='C' />
						<command class_type='delay' title='Delay' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='2' type='2' />
						<command class_type='native' title='Writing to 8 bit registers' comment='' ccode='//The registers on the microcontroller control
//all the functionality from the state of the I/O to
//the function of complex hardware tasks.

trisb = 0;		//Set all of port B to output
