						<command class_type='delay' title='Delay' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='2' type='2' />
						<command class_type='native' title='Flowcode Variables' comment='' ccode='//When using Flowcode variables in C simply
//Capitalise the variable name and add the prefix
//FCV_ if using assembler then this changes to
//_FCV.

//Flowcode variable - Var1.
//C Code equivalent - FCV_VAR1
//Assembler equivalent - _FCV_VAR1

