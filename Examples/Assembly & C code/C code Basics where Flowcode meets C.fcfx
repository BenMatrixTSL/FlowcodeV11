							<flowline >
								<command class_type='native' title='If Statement' comment='' ccode='trisb = 0;			//Set all of port B to output
set_bit(trisa, 0);	//Convert A0 to input

if (test_bit(porta, 0))		//check to see if A0 is high
{
	portb = 85;				//Write 85 to portb
}
else
{
	portb = 170;			//Write 170 to portb
}' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' language='C' />
