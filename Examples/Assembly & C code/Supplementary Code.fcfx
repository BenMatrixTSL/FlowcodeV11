	<supplement use='1' head='//Adds two numbers together
char Add_Nums(char Num1, char Num2);

//Subtracts one number from a second
char Sub_Nums(char Num1, char Num2);' body='char Add_Nums(char Num1, char Num2)
{
  return Num1 + Num2;
}

char Sub_Nums(char Num1, char Num2)
{
  return Num1 - Num2;
}
' />
