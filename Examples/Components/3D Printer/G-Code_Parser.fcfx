						</command>
						<command class_type='comment' title='' comment='Start by processing the command
' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
						<command class_type='switch' title='Switch' comment='' ccode='' textshow='1' textmode='0' textarea='36,25,36,25' break='0' mark='0' disable='0' hide='0' customize='0' exp='.Command[0]' >
							<case >
								<flowline >
									<command class_type='block' title='' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='1' customize='0' start='1' />
									<command class_type='block' title='' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='1' customize='0' start='0' />
									<command class_type='block' title='' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='1' customize='0' start='1' />
									<command class_type='block' title='' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='1' customize='0' start='0' />
									<command class_type='block' title='' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='1' customize='0' start='1' />
									<command class_type='block' title='' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='1' customize='0' start='0' />
								</flowline>
							</case>
							<case exp='&apos;G&apos;' >
								<flowline >
									<command class_type='block' title='' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='1' customize='0' start='1' />
									<command class_type='block' title='' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='1' customize='0' start='0' />
									<command class_type='block' title='' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='1' customize='0' start='1' />
									<command class_type='block' title='' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='1' customize='0' start='0' />
									<command class_type='block' title='' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='1' customize='0' start='1' />
									<command class_type='block' title='' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='1' customize='0' start='0' />
									<command class_type='call' title='Call Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Collect_Int' >
										<return exp='.Temp_Int' />
										<argument exp='.Command' />
										<argument exp='.str_idx' />
									</command>
									<command class_type='switch' title='Switch' comment='' ccode='' textshow='1' textmode='0' textarea='36,25,36,25' break='0' mark='0' disable='0' hide='0' customize='0' exp='.Temp_Int' >
										<case >
											<flowline >
