				<macro >
					<flowline name='Collect_Line_From_File' description='' >
						<return name='Return' type='s16' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<param name='buffer_idx' type='s16' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='file_length' type='s16' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='valid' type='u8' description='' isconst='0' isinit='1' usrinit='0' setinit='0' />
						<local name='cmd_index' type='u8' description='' isconst='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='FAT' macro='ReadFileLength' >
							<return exp='.file_length' />
						</command>
						<command class_type='loop' title='Loop' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='.valid = 0' type='0' start='1' count='1' breakend='0' >
							<flowline >
								<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='FAT' macro='ReadByteFromBuffer' >
									<return exp='G_Command[.cmd_index]' />
									<argument exp='.buffer_idx' />
								</command>
								<command class_type='decision' title='Detect Carriage Return' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='G_Command[.cmd_index] = 13' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='G_Command[.cmd_index] = 0' />
										</command>
										<command class_type='calculation' title='Detected line correctly' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='.valid = 2' />
										</command>
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='.buffer_idx = .buffer_idx + 1' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='.buffer_idx = .buffer_idx + 1' />
									<exp exp='.cmd_index = .cmd_index + 1' />
								</command>
								<command class_type='decision' title='End of file sector?' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='.buffer_idx &gt;= 512' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='.buffer_idx = 0' />
										</command>
										<command class_type='call' title='Bail out if this is the last sector and EOF' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='FAT' macro='MoveToNextFileSector' >
											<return exp='.valid' />
											<argument exp='0' />
										</command>
										<command class_type='call' title='Refresh file length' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='FAT' macro='ReadFileLength' >
											<return exp='.file_length' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='.buffer_idx &gt;= .file_length' swap='0' >
									<flowline >
										<command class_type='calculation' title='Bail out if we have reached the end of a file' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='.valid = 1' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='.cmd_index &gt;= Buffer_Size' swap='0' >
									<flowline >
										<command class_type='calculation' title='Bail out we have run out of buffer' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='.valid = 1' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='.valid &amp; 2' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='.Return = .buffer_idx' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='.Return = -1' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Parse_G_Command' description='' >
						<param name='Command' type='T8' description='' isconst='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='50' />
						</param>
						<local name='Temp_Int' type='u16' description='' isconst='0' isinit='1' usrinit='0' setinit='0' />
						<local name='str_idx' type='u8' description='' isconst='0' isinit='1' usrinit='1' setinit='1' />
						<local name='Req_E' type='f32' description='' isconst='0' isinit='1' usrinit='0.0' setinit='0.0' />
						<local name='Move_Detected' type='u8' description='' isconst='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
							<exp exp='.Req_E = 0' />
						</command>
						<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='Coordinate_System = 1' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='Req_X = 0' />
									<exp exp='Req_Y = 0' />
