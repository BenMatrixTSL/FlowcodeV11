											<flowline >
												<command class_type='sim' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='RepRap_Printer' macro='ControlPrintHead' >
