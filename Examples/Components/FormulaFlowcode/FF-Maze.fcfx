											<flowline >
												<command class_type='decision' title='Wall Left?' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='(cells[.pointer] &amp; 0x10) = 0' swap='0' >
