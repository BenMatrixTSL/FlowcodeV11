			<macros >
				<macro >
					<flowline name='SecondOrdCalc' description='Simulates a basic 2nd order system' >
						<command class_type='sim' title='Get the current feedback reading' macro='Connection.GetAn' >
							<return exp='SecOrdSimVar' />
							<argument exp='0' />
							<argument exp='0' />
						</command>
						<command class_type='calculation' title='Calculate 2nd Order System Response' >
							<exp exp='SecOrdSimVar = ((1.0 - SndOrd) * SecOrdSimVar) + (SndOrd * (FLOAT Control / 255.0))' />
						</command>
						<command class_type='sim' title='Assign new feedback reading' macro='Connection.SetAn' >
							<argument exp='0' />
							<argument exp='SecOrdSimVar' />
							<argument exp='0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='timer_tick' description='' >
						<command class_type='call' title='Read Setpoint ADC' component='ADCFeedback' macro='GetByte' >
							<return exp='Feedback' />
						</command>
						<command class_type='call' title='Read Setpoint ADC' component='DSPInput1' macro='AddAsByteTick' >
							<argument exp='Feedback' />
						</command>
						<command class_type='call' title='Read Setpoint ADC' component='ADCSetpoint' macro='GetByte' >
							<return exp='Setpoint' />
						</command>
						<command class_type='call' title='Process Input Buffer' component='DSPControl1' macro='ProcessTick' >
							<argument exp='Setpoint' />
						</command>
						<command class_type='call' title='Read from DSP output buffer' component='DSPOutput1' macro='ReadAsByteTick' >
							<return exp='Control' />
						</command>
						<command class_type='call' title='Assign to PWM duty' component='PWM1' macro='SetDutyCycle' >
							<argument exp='Control' />
						</command>
						<command class_type='call' title='Perform DSP tick' component='DSPSystem1' macro='TickAllBuffers' >
							<return exp='trigger' />
						</command>
						<command class_type='decision' title='Decision' exp='SimModel = 1' swap='0' >
							<flowline >
								<command class_type='call' title='Call Macro' macro='ThirdOrderCalc' />
							</flowline>
							<flowline >
								<command class_type='call' title='Call Macro' macro='SecondOrdCalc' />
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ThirdOrderCalc' description='Simulates a basic 3rd order system' >
						<command class_type='sim' title='Get the current feedback reading' macro='Connection.GetAn' >
							<return exp='SecOrdSimVar' />
							<argument exp='0' />
							<argument exp='0' />
						</command>
						<command class_type='calculation' title='Calculate 2nd Order System Response' >
							<exp exp='SecOrdSimVar = ((1.0 - SndOrd) * SecOrdSimVar) + (SndOrd * (FLOAT Control / 255.0))' />
						</command>
						<command class_type='calculation' title='Calculate 3rd Order System Response' >
							<exp exp='TrdOrdSimVar = ((1.0 - TrdOrd) * TrdOrdSimVar) + (TrdOrd * SecOrdSimVar)' />
						</command>
						<command class_type='sim' title='Assign new feedback reading' macro='Connection.SetAn' >
							<argument exp='0' />
							<argument exp='TrdOrdSimVar' />
							<argument exp='0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='' >
						<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='DSPSystem1' macro='Initialise' />
						<command class_type='call' title='Enable PWM Output' textarea='36,0,511,300' component='PWM1' macro='Enable' />
						<command class_type='interrupt' title='Enable Timer Tick' textarea='36,0,511,300' enable='1' name='TMR1' call='timer_tick' >
							<settings timer='1' prescale='64' postscale='-1' rollover='2048' bitcount='-1' trigger='3' maskhi='-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAA' masklo='-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAA' >
								<option value='0' />
								<option value='2' />
								<option value='2048' />
								<option value='-1' />
							</settings>
						</command>
						<command class_type='loop' title='Loop' textarea='36,0,511,300' exp='1' type='0' start='1' count='1' breakend='0' >
							<flowline >
