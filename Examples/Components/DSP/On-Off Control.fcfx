			<macros >
				<macro >
					<flowline name='timer_tick' description='' >
						<command class_type='call' title='Sample ADC Feedback' textarea='36,0,511,300' component='FeedbackADC' macro='GetByte' >
							<return exp='Data' />
						</command>
						<command class_type='call' title='Add ADC Sample to DSP Buffer' textarea='36,0,511,300' component='DSPInput1' macro='AddAsByteTick' >
							<argument exp='Data' />
						</command>
						<command class_type='call' title='Perform On / Off Control' textarea='36,0,511,300' component='DSPControl1' macro='ProcessTick' >
							<argument exp='Level' />
						</command>
						<command class_type='call' title='Read Output Buffer' textarea='36,0,511,300' component='DSPOutput1' macro='ReadAsByteTick' >
							<return exp='Level' />
						</command>
						<command class_type='sim' title='Simulation' macro='Debug.PrintLn' >
							<argument exp='&quot;Level: &quot; + STRING level' />
						</command>
						<command class_type='decision' title='And output to control Relay' textarea='36,0,511,300' exp='Level' swap='0' >
							<flowline >
								<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='LED1' macro='TurnOn' />
							</flowline>
							<flowline >
								<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='LED1' macro='TurnOff' />
							</flowline>
						</command>
						<command class_type='call' title='DSP Master Tick' textarea='36,0,511,300' component='DSPSystem1' macro='TickAllBuffers' >
							<return exp='trigger' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='' >
						<command class_type='call' title='Initialise DSP System Buffers' textarea='36,0,511,300' component='DSPSystem1' macro='Initialise' />
						<command class_type='interrupt' title='Enable Timer Tick' textarea='36,0,511,300' enable='1' name='TMR1' call='timer_tick' >
							<settings timer='1' prescale='64' postscale='-1' rollover='2048' bitcount='-1' trigger='3' maskhi='-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAA' masklo='-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAA' >
								<option value='0' />
								<option value='2' />
								<option value='2048' />
								<option value='-1' />
							</settings>
						</command>
						<command class_type='loop' title='Loop' textarea='36,0,511,300' exp='1' type='0' start='1' count='1' breakend='0' >
							<flowline >
								<command class_type='decision' title='If Triggered' textarea='36,0,511,300' exp='trigger = 1' swap='0' >
									<flowline >
										<command class_type='call' title='Read Setpoint ADC' textarea='36,0,511,300' component='SetpointADC' macro='GetByte' >
											<return exp='Level' />
										</command>
										<command class_type='calculation' title='Reset Trigger' textarea='36,0,511,300' >
											<exp exp='trigger = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
			</macros>
