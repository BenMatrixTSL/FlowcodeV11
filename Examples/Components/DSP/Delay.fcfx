			<macros >
				<macro >
					<flowline name='Main' description='' >
						<command class_type='call' title='Initialise the DSP Buffers' component='DSPSystem1' macro='Initialise' />
						<command class_type='call' title='Initialise the PWM Component' component='PWM1' macro='Enable' />
						<command class_type='loop' title='Loop' exp='1' type='0' start='1' count='1' breakend='0' >
							<flowline >
								<command class_type='call' title='Read the Delay ADC as a Byte' component='DelayADC' macro='GetByte' >
									<return exp='Delay' />
								</command>
								<command class_type='decision' title='Only assign new delay if value has changed' exp='Delay &lt;&gt; OldDelay' swap='0' >
									<flowline >
										<command class_type='call' title='Assign the delay' component='DSPDelay1' macro='SetDelaySize' >
											<argument exp='Delay * 10' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='OldDelay = Delay' />
										</command>
									</flowline>
									<flowline />
								</command>
