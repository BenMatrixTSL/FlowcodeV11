								</command>
								<command class_type='call' title='Perform Delay' component='DSPDelay1' macro='DelayTick' />
								<command class_type='call' title='Collect Output' component='DSPOutput1' macro='ReadRawTick' >
									<return exp='Output' />
								</command>
								<command class_type='call' title='Collect Output' component='PWM1' macro='SetDutyCycle' >
									<argument exp='Output' />
								</command>
								<command class_type='call' title='Move to next buffer position' component='DSPSystem1' macro='TickAllBuffers' />
							</flowline>
						</command>
					</flowline>
				</macro>
