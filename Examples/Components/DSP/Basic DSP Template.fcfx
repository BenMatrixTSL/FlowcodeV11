			<macros >
				<macro >
					<flowline name='timer_tick' description='' >
						<command class_type='comment' title='' comment='Insert DSP Tick Code Here' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
						<command class_type='comment' title='' comment='The DSP System Tick component macro allows the buffer pointer to be
incremented. When the buffer pointer reaches the end of the buffer 
the pointer is reset back to 0 and the return value is a 1.
This trigger functionality allows for the mixing of single value (tick) 
and buffer style DSP functionality. For example a regular ADC sample
using the tick based functions and a FFT which requires a buffer full of data.
 ' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
						<command class_type='call' title='Perform DSP tick' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' component='DSPSystem1' macro='TickAllBuffers' >
							<return exp='trigger' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='' >
						<command class_type='comment' title='' comment='DSP System needs initialising or you will get compile errors.
Initialise function basically sets up all the DSP buffers for you.' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
						<command class_type='call' title='Setup DSP System Variables' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' component='DSPSystem1' macro='Initialise' />
						<command class_type='comment' title='' comment='This interrupt enable icon enables the main DSP timer tick
This defines the overall DSP sample rate and therefore the
bandwidth of the system. The rules of Nyquist suggest that
the timer frequency should be at least twice that of the 
highest frequency in the input signal. In practise it is 
usually worth going beyond this to give around 12 times the 
maximum input frequency where possible.' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
						<command class_type='interrupt' title='Enable Timer Tick' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' enable='1' name='TMR1' call='timer_tick' >
							<settings timer='1' prescale='64' postscale='-1' rollover='2048' bitcount='-1' trigger='3' maskhi='-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAA' masklo='-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAD-AAAA-wAAAP8AAAA' >
								<option value='0' />
								<option value='2' />
								<option value='2048' />
								<option value='-1' />
							</settings>
						</command>
						<command class_type='loop' title='Loop' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' exp='1' type='0' start='1' count='1' breakend='0' >
							<flowline >
								<command class_type='comment' title='' comment='The code for the DSP trigger is controlled by calling
the DSP system tick component macro. On each tick the
index pointer moves to the next buffer location. When 
the index pointer has reached the end of the DSP buffer 
a value of 1 will be passed into the Trigger variable
allowing for an entire buffer to be processed at once.' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
								<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' exp='trigger = 1' swap='0' >
									<flowline >
										<command class_type='comment' title='' comment='Care should be taken to reset the trigger variable' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='trigger = 0' />
										</command>
										<command class_type='comment' title='' comment='Insert DSP Tick Code Here' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
			</macros>
			<component class_type='ref' guid='917f243e-4102-4bee-9998-81f18bc6ca9d' vmin='2' vmaj='1' codename='DSPSystem1' x='0' y='0' z='0' xsz='32' ysz='32' zsz='5.1' xang='0' yang='0' zang='0' xquat='0' yquat='0' zquat='0' wquat='1' visible='1' interactive='1' solid='1' layer='0' >
