				<macro >
					<flowline name='timer_tick' description='' >
						<command class_type='call' title='Read From ADC' textarea='36,0,511,300' component='ADCAudioIn1' macro='GetByte' >
							<return exp='Data' />
						</command>
						<command class_type='call' title='Add to DSP input buffer' textarea='36,0,511,300' component='DSPInput1' macro='AddRawTick' >
