			<macros >
				<macro >
					<flowline name='Main' description='A basic example which moves an object on the panel. When the object is in range of the sensor the sensor output goes high, otherwise the sensor output goes low.' >
						<command class_type='call' title='Call Component Macro' component='PhotoTransistor2' macro='Initialise' />
						<command class_type='loop' title='Loop' exp='1' type='0' start='1' count='1' breakend='0' >
							<flowline >
								<command class_type='loop' title='Move object to the right' exp='1' type='2' start='1' count='50' breakend='0' >
									<flowline >
										<command class_type='call' title='Call Component Macro' component='PhotoTransistor2' macro='SampleSensor' >
											<return exp='senseval' />
										</command>
										<command class_type='decision' title='Decision' exp='senseval' swap='0' >
											<flowline >
												<command class_type='call' title='Call Component Macro' component='lamp_les1' macro='TurnOn' />
											</flowline>
											<flowline >
												<command class_type='call' title='Call Component Macro' component='lamp_les1' macro='TurnOff' />
											</flowline>
										</command>
