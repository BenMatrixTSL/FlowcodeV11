						<local name='x_min' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='y_max' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='y_min' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculate coordinates of 5 x 5 pixel box' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
							<exp exp='DrawBox.x_min = DrawBox.x_pos * 5' />
							<exp exp='DrawBox.x_max = DrawBox.x_min + 4' />
							<exp exp='DrawBox.y_min = DrawBox.y_pos * 5' />
							<exp exp='DrawBox.y_max = DrawBox.y_min + 4' />
						</command>
						<command class_type='decision' title='Foreground colour?' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' exp='DrawBox.colour_ref' swap='0' >
							<flowline >
								<command class_type='call' title='Define current foreground colour' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' component='GLCD_EBM001' macro='SetForegroundColour' >
									<argument exp='gLCDforeR' />
									<argument exp='gLCDforeG' />
									<argument exp='gLCDforeB' />
								</command>
							</flowline>
							<flowline >
								<command class_type='call' title='Define background colour' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' component='GLCD_EBM001' macro='SetForegroundColour' >
									<argument exp='gLCDbackR' />
									<argument exp='gLCDbackG' />
									<argument exp='gLCDbackB' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Draw box' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' component='GLCD_EBM001' macro='DrawRectangle' >
							<argument exp='DrawBox.x_min' />
							<argument exp='DrawBox.y_min' />
							<argument exp='DrawBox.x_max' />
							<argument exp='DrawBox.y_max' />
							<argument exp='0' />
							<argument exp='1' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ForeColB' description='' >
						<command class_type='calculation' title='Define blue bat colour' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
							<exp exp='gLCDforeR = 0x00' />
							<exp exp='gLCDforeG = 0x00' />
							<exp exp='gLCDforeB = 0xFF' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='StartScreen' description='' >
						<command class_type='call' title='Initialise gLCD' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' component='GLCD_EBM001' macro='Initialise' />
						<command class_type='calculation' title='Define background colour values' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
							<exp exp='gLCDbackR = 0xFF' />
							<exp exp='gLCDbackG = 0xFF' />
							<exp exp='gLCDbackB = 0xFF' />
						</command>
						<command class_type='call' title='Set background colour' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' component='GLCD_EBM001' macro='SetBackgroundColour' >
							<argument exp='gLCDbackR' />
							<argument exp='gLCDbackG' />
							<argument exp='gLCDbackB' />
						</command>
						<command class_type='call' title='Clear gLCD' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' component='GLCD_EBM001' macro='ClearDisplay' />
					</flowline>
				</macro>
				<macro >
					<flowline name='ColourButtons' description='' >
						<local name='buttonhandle' type='h32' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Component.FindChild' >
							<return exp='.buttonhandle' />
							<argument exp='sw_push_rnd_pnl1' />
							<argument exp='&quot;button&quot;' />
						</command>
						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Component.Property.SetColor' >
							<argument exp='.buttonhandle' />
							<argument exp='0' />
							<argument exp='0' />
							<argument exp='255' />
						</command>
						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Component.FindChild' >
							<return exp='.buttonhandle' />
							<argument exp='sw_push_rnd_pnl2' />
							<argument exp='&quot;button&quot;' />
						</command>
						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Component.Property.SetColor' >
							<argument exp='.buttonhandle' />
							<argument exp='0' />
							<argument exp='0' />
							<argument exp='255' />
						</command>
						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Component.FindChild' >
							<return exp='.buttonhandle' />
							<argument exp='sw_push_rnd_pnl3' />
							<argument exp='&quot;button&quot;' />
						</command>
						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Component.Property.SetColor' >
							<argument exp='.buttonhandle' />
							<argument exp='255' />
							<argument exp='0' />
							<argument exp='0' />
						</command>
						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Component.FindChild' >
							<return exp='.buttonhandle' />
							<argument exp='sw_push_rnd_pnl4' />
							<argument exp='&quot;button&quot;' />
						</command>
						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Component.Property.SetColor' >
							<argument exp='.buttonhandle' />
							<argument exp='255' />
							<argument exp='0' />
							<argument exp='0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='LineUp' description='' >
						<return name='Return' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<param name='x_pos' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<param name='y_pos' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='y_temp' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='Room to move up?' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' exp='LineUp.y_pos &gt; 2' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculate new top block' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='LineUp.y_temp = LineUp.y_pos + 4' />
								</command>
								<command class_type='call' title='Erase bottom block' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' macro='DrawBox' >
									<argument exp='0' />
									<argument exp='LineUp.x_pos' />
									<argument exp='LineUp.y_temp' />
								</command>
								<command class_type='calculation' title='Return new line position' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='LineUp.Return = LineUp.y_pos - 1' />
								</command>
								<command class_type='call' title='Draw new top block' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' macro='DrawBox' >
									<argument exp='1' />
									<argument exp='LineUp.x_pos' />
									<argument exp='LineUp.Return' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Hold position' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='LineUp.Return = LineUp.y_pos' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='' >
						<command class_type='call' title='Call Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='ColourButtons' />
						<command class_type='call' title='Initialise thew display' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' macro='StartScreen' />
						<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='GLCD_EBM001' macro='Initialise' />
						<command class_type='calculation' title='Initialise the scores' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
							<exp exp='BlueScore = 0' />
							<exp exp='RedScore = 0' />
						</command>
						<command class_type='loop' title='Play the game' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' exp='(BlueScore &lt; 10) &amp;&amp; (RedScore &lt; 10)' type='0' start='0' count='1' breakend='0' >
							<flowline >
								<command class_type='calculation' title='Initialise status' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='BlueGoal = 0' />
									<exp exp='RedGoal = 0' />
								</command>
								<command class_type='call' title='Clear the gLCD' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' component='GLCD_EBM001' macro='ClearDisplay' />
								<command class_type='call' title='Draw the blue bat' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' macro='BlueBat' />
								<command class_type='call' title='Draw the red bat' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' macro='RedBat' />
								<command class_type='call' title='Display the score' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' macro='ShowScore' />
								<command class_type='call' title='Define the colour of the ball' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' macro='ForeColG' />
								<command class_type='calculation' title='Initialise the position of the ball' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='xBallPos = 2' />
									<exp exp='yBallPos = 2' />
									<exp exp='xBallSrc = 2' />
									<exp exp='yBallSrc = 2' />
									<exp exp='xBallVel = 1' />
									<exp exp='yBallVel = 1' />
								</command>
								<command class_type='call' title='Draw the ball' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' macro='DrawBox' >
									<argument exp='1' />
									<argument exp='xBallPos' />
									<argument exp='yBallPos' />
								</command>
								<command class_type='delay' title='Delay' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' exp='2' type='0' />
								<command class_type='loop' title='Play until goal scored' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' exp='(BlueGoal == 0) &amp;&amp; (RedGoal == 0)' type='0' start='0' count='1' breakend='0' >
									<flowline >
										<command class_type='delay' title='Delay' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' exp='100' type='1' />
										<command class_type='input' title='Read the control buttons' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' mode='0' port='1048577' mask='255' exp='Controls' />
										<command class_type='call' title='Control the blue bat' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' macro='BlueBatCtrl' />
										<command class_type='call' title='Control the red bat' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' macro='RedBatCtrl' />
										<command class_type='call' title='Define the ball colour' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' macro='ForeColG' />
										<command class_type='call' title='Erase the ball' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' macro='DrawBox' >
											<argument exp='0' />
											<argument exp='xBallPos' />
											<argument exp='yBallPos' />
										</command>
										<command class_type='decision' title='Don&apos;t test for wall bounce if already against wall' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' exp='(yBallPos = 2) || (yBallPos = 25)' swap='0' >
											<flowline >
												<command class_type='calculation' title='Bounce detect OFF' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='bounce_test = 0' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Bounce detect ON' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='bounce_test = 1' />
												</command>
											</flowline>
										</command>
										<command class_type='calculation' title='Calculate the next ball position' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='xBallPos = xBallPos + xBallVel' />
											<exp exp='yBallPos = yBallSrc + ((xBallPos - xBallSrc) * yBallVel) / 4' />
										</command>
										<command class_type='call' title='Draw the ball' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' macro='DrawBox' >
											<argument exp='1' />
											<argument exp='xBallPos' />
											<argument exp='yBallPos' />
										</command>
										<command class_type='call' title='Detect bat hit and goal' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' macro='BatHit' />
										<command class_type='call' title='Detect wall hit' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' macro='WallBounce' />
									</flowline>
								</command>
								<command class_type='calculation' title='Calculate current score' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='BlueScore = BlueScore + BlueGoal' />
									<exp exp='RedScore = RedScore + RedGoal' />
								</command>
								<command class_type='call' title='Display the score' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' macro='ShowScore' />
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='BatHit' description='' >
						<command class_type='decision' title='Ball at goal line?' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' exp='(xBallPos = 2) || (xBallPos = 23)' swap='0' >
							<flowline >
								<command class_type='decision' title='Ball at blue goal line?' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' exp='xBallPos = 2' swap='0' >
									<flowline >
										<command class_type='decision' title='Hit bat?' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' exp='(yBallPos &gt;= yposB) &amp;&amp; (yBallPos &lt;= (yposB + 4))' swap='0' >
											<flowline >
												<command class_type='calculation' title='Bounce back at angle' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='xBallSrc = xBallPos' />
													<exp exp='yBallSrc = yBallPos' />
													<exp exp='xBallVel = -xBallVel' />
													<exp exp='yBallVel = yBallVel - (yBallPos - yposB - 2)' />
													<exp exp='yBallVel = -yBallVel' />
													<exp exp='' />
												</command>
												<command class_type='calculation' title='Wall ounce detect ON' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='bounce_test = 1' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Goal!' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='RedGoal = 1' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Ball at red goal line?' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' exp='xBallPos = 23' swap='0' >
									<flowline >
										<command class_type='decision' title='Hit bat?' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' exp='(yBallPos &gt;= yposR) &amp;&amp; (yBallPos &lt;= (yposR + 4))' swap='0' >
											<flowline >
												<command class_type='calculation' title='Bounce back at angle' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='xBallSrc = xBallPos' />
													<exp exp='yBallSrc = yBallPos' />
													<exp exp='xBallVel = -xBallVel' />
													<exp exp='yBallVel = yBallVel + (yBallPos - yposR - 2)' />
													<exp exp='yBallVel = -yBallVel' />
													<exp exp='' />
												</command>
												<command class_type='calculation' title='Wall bounce detect ON' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='bounce_test = 1' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Goal!' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='BlueGoal = 1' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Limit y +ve velocity' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' exp='yBallVel &gt; 4' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='yBallVel = 4' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Limit y -ve velocity' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,511,300' break='0' mark='0' disable='0' hide='0' customize='0' exp='yBallVel &lt; -4' swap='0' >
									<flowline >
