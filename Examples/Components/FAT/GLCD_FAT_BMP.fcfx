	<components >
		<settings autoimg='1' center='1' unitscale='0' fixedscale='0' fixedx='1' fixedy='1' fixedz='1' headcode='0' />
		<definition guid='' vmin='0' vmaj='1' srcleaf='' visiblename='' description='' category='' catenable='1' author='' sysinfo='0' keywords='' dynamic='0' iconpath='' />
		<component class_type='root' codename='panel' x='0' y='0' z='0' xsz='1' ysz='1' zsz='1' xang='0' yang='0' zang='0' xquat='0' yquat='0' zquat='0' wquat='1' visible='1' interactive='1' solid='1' layer='0' poslock='0' >
			<resources />
			<properties />
			<values />
			<events />
			<apis />
			<variables >
				<variable public='0' >
					<def class_type='variable' name='false' type='b1' description='' isconst='1' isinit='1' usrinit='0' setinit='0' />
				</variable>
				<variable public='0' >
					<def class_type='variable' name='card_status' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
				</variable>
				<variable public='0' >
					<def class_type='variable' name='true' type='b1' description='' isconst='1' isinit='1' usrinit='1' setinit='1' />
				</variable>
			</variables>
			<macros >
				<macro >
					<flowline name='Read_2_Byte_Packet' description='' >
						<return name='Return' type='u16' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<param name='idx' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='dat0' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='dat1' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Read Byte From Buffer' component='FAT16' macro='ReadByteFromBuffer' >
							<return exp='.dat0' />
							<argument exp='.idx' />
						</command>
						<command class_type='call' title='Read Byte From Buffer' component='FAT16' macro='ReadByteFromBuffer' >
							<return exp='.dat1' />
							<argument exp='.idx+1' />
						</command>
						<command class_type='calculation' title='Position bytes into long variable' >
							<exp exp='.Return = 0' />
							<exp exp='.Return = .Return | .dat1' />
							<exp exp='.Return = .Return &lt;&lt; 8' />
							<exp exp='.Return = .Return | .dat0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Read_4_Byte_Packet' description='' >
						<return name='Return' type='u32' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<param name='idx' type='s16' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='dat0' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='dat1' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='dat2' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='dat3' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Read Byte From Buffer' component='FAT16' macro='ReadByteFromBuffer' >
							<return exp='.dat0' />
							<argument exp='.idx' />
						</command>
						<command class_type='call' title='Read Byte From Buffer' component='FAT16' macro='ReadByteFromBuffer' >
							<return exp='.dat1' />
							<argument exp='.idx+1' />
						</command>
						<command class_type='call' title='Read Byte From Buffer' component='FAT16' macro='ReadByteFromBuffer' >
							<return exp='.dat2' />
							<argument exp='.idx+2' />
						</command>
						<command class_type='call' title='Read Byte From Buffer' component='FAT16' macro='ReadByteFromBuffer' >
							<return exp='.dat3' />
							<argument exp='.idx+3' />
						</command>
						<command class_type='calculation' title='Position bytes into long variable' >
							<exp exp='.Return = 0' />
							<exp exp='.Return = .dat3' />
							<exp exp='.Return = .Return &lt;&lt; 8' />
							<exp exp='.Return = .Return | .dat2' />
							<exp exp='.Return = .Return &lt;&lt; 8' />
							<exp exp='.Return = .Return | .dat1' />
							<exp exp='.Return = .Return &lt;&lt; 8' />
							<exp exp='.Return = .Return | .dat0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Increment_idx' description='' >
						<return name='Return' type='u16' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<param name='idx' type='u16' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='eof' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Assign incremented value to return variable' textarea='36,0,511,300' >
							<exp exp='.Return = .idx + 1' />
						</command>
						<command class_type='decision' title='If we are at the end of the sector' textarea='36,0,511,300' exp='.idx + 1 = 512' swap='0' >
							<flowline >
								<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='FAT16' macro='MoveToNextFileSector' >
									<return exp='.eof' />
									<argument exp='0' />
								</command>
								<command class_type='decision' title='Decision' textarea='36,0,511,300' exp='.eof' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' textarea='36,0,511,300' >
											<exp exp='.Return = 512' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' textarea='36,0,511,300' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Display_BMP' description='' >
						<param name='filename' type='T8' description='' isconst='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='X' type='u16' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<param name='Y' type='u16' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='retval' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='idx' type='s16' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='Data_Offset' type='u16' description='' isconst='0' isinit='1' usrinit='0' setinit='0' />
						<local name='width' type='u16' description='' isconst='0' isinit='1' usrinit='0' setinit='0' />
						<local name='height' type='u16' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='Header_field' type='u16' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='Bits_Per_Pixel' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='Compression' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='width_idx' type='u16' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='R' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='G' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='B' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Open File' textarea='36,0,511,300' component='FAT16' macro='OpenFile' >
							<return exp='.retval' />
							<argument exp='.filename' />
						</command>
						<command class_type='decision' title='Confirm File Opened' textarea='36,0,511,300' exp='.retval = 0' swap='0' >
							<flowline >
								<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='gLCD_EBM001' macro='Print' >
									<argument exp='&quot;File Open&quot;' />
									<argument exp='2' />
									<argument exp='2' />
									<argument exp='0' />
									<argument exp='1' />
								</command>
								<command class_type='delay' title='Delay' textarea='36,0,511,300' exp='1' type='2' />
								<command class_type='call' title='Read Header Field' textarea='36,0,511,300' macro='Read_2_Byte_Packet' >
									<return exp='.Header_field' />
									<argument exp='0' />
								</command>
								<command class_type='decision' title='Confirm &quot;BM&quot; file format' exp='.Header_field = (&apos;M&apos; &lt;&lt; 8) | &apos;B&apos;' swap='0' >
									<flowline >
										<command class_type='call' title='Read Data Offset' macro='Read_4_Byte_Packet' >
											<return exp='.Data_Offset' />
											<argument exp='0x0A' />
										</command>
										<command class_type='call' title='Read pixel width' macro='Read_4_Byte_Packet' >
											<return exp='.width' />
											<argument exp='0x12' />
										</command>
										<command class_type='call' title='Read pixel height' macro='Read_4_Byte_Packet' >
											<return exp='.height' />
											<argument exp='0x16' />
										</command>
										<command class_type='call' title='Read pixel data format' macro='Read_2_Byte_Packet' >
											<return exp='.Bits_Per_Pixel' />
											<argument exp='0x1C' />
										</command>
										<command class_type='call' title='Read pixel data format' macro='Read_4_Byte_Packet' >
											<return exp='.Compression' />
											<argument exp='0x1E' />
										</command>
										<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='gLCD_EBM001' macro='Print' >
											<argument exp='&quot;Header OK&quot;' />
											<argument exp='2' />
											<argument exp='12' />
											<argument exp='0' />
											<argument exp='1' />
										</command>
										<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='gLCD_EBM001' macro='Print' >
											<argument exp='&quot;Width&quot;' />
											<argument exp='2' />
											<argument exp='22' />
											<argument exp='0' />
											<argument exp='1' />
										</command>
										<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='gLCD_EBM001' macro='PrintNumber' >
											<argument exp='.width' />
											<argument exp='60' />
											<argument exp='22' />
											<argument exp='0' />
											<argument exp='1' />
										</command>
										<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='gLCD_EBM001' macro='Print' >
											<argument exp='&quot;Height&quot;' />
											<argument exp='2' />
											<argument exp='32' />
											<argument exp='0' />
											<argument exp='1' />
										</command>
										<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='gLCD_EBM001' macro='PrintNumber' >
											<argument exp='.height' />
											<argument exp='60' />
											<argument exp='32' />
											<argument exp='0' />
											<argument exp='1' />
										</command>
										<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='gLCD_EBM001' macro='Print' >
											<argument exp='&quot;BPP&quot;' />
											<argument exp='2' />
											<argument exp='42' />
											<argument exp='0' />
											<argument exp='1' />
										</command>
										<command class_type='call' title='Call Component Macro' component='gLCD_EBM001' macro='PrintNumber' >
											<argument exp='.Bits_Per_Pixel' />
											<argument exp='60' />
											<argument exp='42' />
											<argument exp='0' />
											<argument exp='1' />
										</command>
										<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='gLCD_EBM001' macro='Print' >
											<argument exp='&quot;Offset&quot;' />
											<argument exp='2' />
											<argument exp='52' />
											<argument exp='0' />
											<argument exp='1' />
										</command>
										<command class_type='call' title='Call Component Macro' component='gLCD_EBM001' macro='PrintNumber' >
											<argument exp='.Data_Offset' />
											<argument exp='60' />
											<argument exp='52' />
											<argument exp='0' />
											<argument exp='1' />
										</command>
										<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='gLCD_EBM001' macro='Print' >
											<argument exp='&quot;Comp&quot;' />
											<argument exp='2' />
											<argument exp='62' />
											<argument exp='0' />
											<argument exp='1' />
										</command>
										<command class_type='call' title='Call Component Macro' component='gLCD_EBM001' macro='PrintNumber' >
											<argument exp='.Compression' />
											<argument exp='60' />
											<argument exp='62' />
											<argument exp='0' />
											<argument exp='1' />
										</command>
										<command class_type='delay' title='Delay' textarea='36,0,511,300' exp='4' type='2' />
										<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='gLCD_EBM001' macro='ClearDisplay' />
										<command class_type='decision' title='Check we can read the data' exp='(.Bits_Per_Pixel = 24) &amp;&amp; (.Compression = 0)' swap='0' >
											<flowline >
												<command class_type='loop' title='Move to sector containing start of pixel data' textarea='36,0,511,300' exp='.Data_Offset &gt; 511' type='0' start='1' count='1' breakend='0' >
													<flowline >
														<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='FAT16' macro='MoveToNextFileSector' >
															<argument exp='0' />
														</command>
														<command class_type='calculation' title='Calculation' >
															<exp exp='.Data_Offset = .Data_Offset - 512' />
														</command>
													</flowline>
												</command>
												<command class_type='calculation' title='Initialise idx to start of data' textarea='36,0,511,300' >
													<exp exp='.idx = .Data_Offset' />
												</command>
												<command class_type='comment' title='' comment='BMP files run from left to right 
working upwards a row at a time
from bottom to top.
' textarea='12,0,12,0' />
												<command class_type='loop' title='Loop through data' textarea='36,0,511,300' exp='.height &gt; 0' type='0' start='1' count='1' breakend='0' >
													<flowline >
														<command class_type='calculation' title='Reset Row Idx' textarea='36,0,511,300' >
															<exp exp='.width_idx = 0' />
														</command>
														<command class_type='loop' title='Read and Print a row' textarea='36,0,511,300' exp='.width &gt; .width_idx' type='0' start='1' count='1' breakend='0' >
															<flowline >
																<command class_type='call' title='Read Blue Data Byte' textarea='36,0,511,300' component='FAT16' macro='ReadByteFromBuffer' >
																	<return exp='.B' />
																	<argument exp='.idx' />
																</command>
																<command class_type='call' title='Call Macro' textarea='36,0,511,300' macro='Increment_idx' >
																	<return exp='.idx' />
																	<argument exp='.idx' />
																</command>
																<command class_type='call' title='Read Green Data Byte' textarea='36,0,511,300' component='FAT16' macro='ReadByteFromBuffer' >
																	<return exp='.G' />
																	<argument exp='.idx' />
																</command>
																<command class_type='call' title='Call Macro' textarea='36,0,511,300' macro='Increment_idx' >
																	<return exp='.idx' />
																	<argument exp='.idx' />
																</command>
																<command class_type='call' title='Read Red Data Byte' textarea='36,0,511,300' component='FAT16' macro='ReadByteFromBuffer' >
																	<return exp='.R' />
																	<argument exp='.idx' />
																</command>
																<command class_type='call' title='Call Macro' textarea='36,0,511,300' macro='Increment_idx' >
																	<return exp='.idx' />
																	<argument exp='.idx' />
																</command>
																<command class_type='decision' title='EOF?' textarea='36,0,511,300' exp='.idx = 512' swap='0' >
																	<flowline >
																		<command class_type='goto' title='Goto Connection Point' textarea='36,0,511,300' labelid='0' labelname='' />
																	</flowline>
																	<flowline />
																</command>
																<command class_type='call' title='Set Pixel Colour' textarea='36,0,511,300' component='gLCD_EBM001' macro='SetForegroundColour' >
																	<argument exp='.R' />
																	<argument exp='.G' />
																	<argument exp='.B' />
																</command>
																<command class_type='call' title='Print Pixel' textarea='36,0,511,300' component='gLCD_EBM001' macro='Plot' >
																	<argument exp='.X + .width_idx' />
																	<argument exp='.Y + (.height - 1)' />
																</command>
																<command class_type='calculation' title='Move to next pixel in row' textarea='36,0,511,300' >
																	<exp exp='.width_idx = .width_idx + 1' />
																</command>
															</flowline>
														</command>
														<command class_type='calculation' title='Calculate number of data bytes per row' >
															<exp exp='.width_idx = .width * (.Bits_Per_Pixel &gt;&gt; 3)' />
														</command>
														<command class_type='loop' title='Row data always ends 32-bit aligned' textarea='36,0,511,300' exp='(.width_idx MOD 4) != 0' type='0' start='1' count='1' breakend='0' >
															<flowline >
																<command class_type='call' title='Call Macro' textarea='36,0,511,300' macro='Increment_idx' >
																	<return exp='.idx' />
																	<argument exp='.idx' />
																</command>
																<command class_type='decision' title='Decision' textarea='36,0,511,300' exp='.idx = 512' swap='0' >
																	<flowline >
																		<command class_type='goto' title='Goto Connection Point' textarea='36,0,511,300' labelid='0' labelname='' />
																	</flowline>
																	<flowline />
																</command>
																<command class_type='calculation' title='Calculation' textarea='36,0,511,300' >
																	<exp exp='.width_idx = .width_idx + 1' />
																</command>
															</flowline>
														</command>
														<command class_type='calculation' title='Move to next row' textarea='36,0,511,300' >
															<exp exp='.height = .height - 1' />
														</command>
													</flowline>
												</command>
												<command class_type='label' title='Connection Point' textarea='36,0,511,300' labelid='0' labelname='A' />
											</flowline>
											<flowline />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='' >
						<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='gLCD_EBM001' macro='Initialise' />
						<command class_type='calculation' title='Calculation' textarea='36,0,511,300' >
							<exp exp='card_status = 1' />
						</command>
						<command class_type='loop' title='Loop' textarea='36,0,511,300' exp='card_status &gt; 0' type='0' start='1' count='1' breakend='0' >
							<flowline >
								<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='FAT16' macro='Initialise' >
									<return exp='card_status' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='gLCD_EBM001' macro='Print' >
							<argument exp='&quot;Init OK&quot;' />
							<argument exp='2' />
							<argument exp='2' />
							<argument exp='0' />
							<argument exp='1' />
						</command>
						<command class_type='delay' title='Delay' textarea='36,0,511,300' exp='2' type='2' />
						<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='gLCD_EBM001' macro='SetBackgroundColour' >
							<argument exp='255' />
							<argument exp='255' />
							<argument exp='255' />
						</command>
						<command class_type='loop' title='Loop' textarea='36,0,511,300' exp='1' type='0' start='1' count='1' breakend='0' >
							<flowline >
								<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='gLCD_EBM001' macro='ClearDisplay' />
								<command class_type='call' title='Call Component Macro' textarea='36,0,511,300' component='gLCD_EBM001' macro='SetForegroundColour' >
									<argument exp='0' />
									<argument exp='0' />
