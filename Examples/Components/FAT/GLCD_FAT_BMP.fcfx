	<config data='!0,ffffffff!8,ffffffff!10,ffffffff!18,ffffffff!20,ffffffff!28,ffffffff!30,ffffffff!38,ffffffff!40,ffffffff!48,ffffffff!50,ffffffff!58,ffffffff!60,ffffffff!68,ffffffff' clkspd='48000000' simspd='1' usewdt='0' constif='0' />
	<plugins >
