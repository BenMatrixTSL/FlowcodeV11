			<macros >
				<macro >
					<flowline name='Byte_2_4Char_Buffer' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='in' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Convert ADC Sample to String' >
							<exp exp='filestring = ToString$ (ADC_Val)' />
						</command>
						<command class_type='decision' title='If String is 3 characters' exp='Byte_2_4Char_Buffer.in &gt; 100' swap='0' >
							<flowline />
							<flowline >
								<command class_type='decision' title='If String is 2 characters' exp='Byte_2_4Char_Buffer.in &gt; 10' swap='0' >
									<flowline >
										<command class_type='calculation' title='Add a character' >
											<exp exp='filestring = &quot;0&quot; + filestring' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Add 2 characters' >
											<exp exp='filestring = &quot;00&quot; + filestring' />
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='String Manipulation' >
							<exp exp='char1 = Char$ (filestring,0)' />
							<exp exp='char2 = Char$ (filestring,1)' />
							<exp exp='char3 = Char$ (filestring,2)' />
						</command>
						<command class_type='call' title='Write 1st Byte to Buffer' component='FAT1' macro='WriteByteToBuffer' >
							<argument exp='idx' />
							<argument exp='char1' />
						</command>
						<command class_type='calculation' title='Increment Buffer Index' >
							<exp exp='idx = idx + 1' />
						</command>
						<command class_type='call' title='Write 2nd Byte to Buffer' component='FAT1' macro='WriteByteToBuffer' >
							<argument exp='idx' />
							<argument exp='char2' />
						</command>
						<command class_type='calculation' title='Increment Buffer Index' >
							<exp exp='idx = idx + 1' />
						</command>
						<command class_type='call' title='Write 3rd Byte to Buffer' component='FAT1' macro='WriteByteToBuffer' >
							<argument exp='idx' />
							<argument exp='char3' />
						</command>
						<command class_type='calculation' title='Increment Buffer Index' >
							<exp exp='idx = idx + 1' />
						</command>
						<command class_type='call' title='Write Comma' component='FAT1' macro='WriteByteToBuffer' >
							<argument exp='idx' />
							<argument exp='&quot;,&quot;' />
						</command>
						<command class_type='calculation' title='Increment Buffer Index' >
							<exp exp='idx = idx + 1' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='call' title='Start LCd' component='LCD1' macro='Start' />
						<command class_type='call' title='Print Startup String' component='LCD1' macro='PrintString' >
							<argument exp='&quot;Waiting for Card&quot;' />
						</command>
						<command class_type='calculation' title='Assign filename and data' >
							<exp exp='filename = &quot;log2.txt&quot;' />
							<exp exp='filestring = &quot;&quot;' />
						</command>
						<command class_type='calculation' title='Initialise Return Value' >
							<exp exp='retval = 1' />
						</command>
						<command class_type='loop' title='Wait for card to start up' type='0' exp='retval &gt; 0' for1='' for3='' >
							<flowline >
								<command class_type='delay' title='Delay' exp='1' type='2' />
								<command class_type='call' title='Init FAT16' component='FAT1' macro='Initialise' >
									<return exp='retval' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Clear Display' component='LCD1' macro='Clear' />
						<command class_type='call' title='Print Creating File' component='LCD1' macro='PrintString' >
							<argument exp='&quot;Creating File&quot;' />
						</command>
						<command class_type='call' title='Move to next line of LCD' component='LCD1' macro='Cursor' >
							<argument exp='0' />
							<argument exp='1' />
						</command>
						<command class_type='call' title='Create File' component='FAT1' macro='CreateFile' >
							<return exp='retval' />
							<argument exp='filename' />
						</command>
						<command class_type='decision' title='Decision' exp='retval' swap='0' >
							<flowline >
								<command class_type='call' title='File Error' component='LCD1' macro='PrintString' >
									<argument exp='&quot;File Exists&quot;' />
								</command>
							</flowline>
							<flowline >
								<command class_type='call' title='File OK' component='LCD1' macro='PrintString' >
									<argument exp='&quot;File Created&quot;' />
								</command>
								<command class_type='delay' title='Delay' exp='5' type='2' />
								<command class_type='call' title='Clear Display' component='LCD1' macro='Clear' />
								<command class_type='call' title='Print Opening File' component='LCD1' macro='PrintString' >
									<argument exp='&quot;Opening File&quot;' />
								</command>
								<command class_type='call' title='Move to next line of LCD' component='LCD1' macro='Cursor' >
									<argument exp='0' />
									<argument exp='1' />
								</command>
								<command class_type='call' title='Open the file' component='FAT1' macro='OpenFile' >
									<return exp='retval' />
									<argument exp='filename' />
								</command>
								<command class_type='decision' title='Decision' exp='retval' swap='0' >
									<flowline >
										<command class_type='call' title='File Error' component='LCD1' macro='PrintString' >
											<argument exp='&quot;File Error&quot;' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='File OK' component='LCD1' macro='PrintString' >
											<argument exp='&quot;File Opened&quot;' />
										</command>
										<command class_type='delay' title='Delay' exp='5' type='2' />
										<command class_type='call' title='Clear Display' component='LCD1' macro='Clear' />
										<command class_type='call' title='Print Writing Data' component='LCD1' macro='PrintString' >
											<argument exp='&quot;Writing Data&quot;' />
										</command>
										<command class_type='call' title='Move to next line of LCD' component='LCD1' macro='Cursor' >
											<argument exp='0' />
											<argument exp='1' />
										</command>
										<command class_type='loop' title='Fill up 5 disk sectors' type='2' exp='5' for1='' for3='' >
											<flowline >
												<command class_type='calculation' title='Initialise Buffer Index' >
													<exp exp='idx = 0' />
												</command>
												<command class_type='loop' title='Take 128 samples - 4 x 128 = 512 = full sector' type='2' exp='128' for1='' for3='' >
													<flowline >
														<command class_type='call' title='Read into byte Variable' component='Pot_Slider1' macro='GetInt' >
															<return exp='ADC_Val' />
														</command>
														<command class_type='call' title='Convert byte to 4 char ASCII' macro='Byte_2_4Char_Buffer' >
															<argument exp='ADC_Val' />
														</command>
													</flowline>
												</command>
												<command class_type='call' title='Write complete 512 byte sector to file' component='FAT1' macro='WriteFileSector' />
												<command class_type='call' title='Create Next 512 Byte Sector' component='FAT1' macro='MoveToNextFileSector' >
													<return exp='retval' />
													<argument exp='1' />
												</command>
											</flowline>
										</command>
										<command class_type='decision' title='Decision' exp='retval' swap='0' >
											<flowline >
												<command class_type='call' title='Write Error' component='LCD1' macro='PrintString' >
													<argument exp='&quot;Data Error&quot;' />
												</command>
											</flowline>
											<flowline >
												<command class_type='call' title='Write OK' component='LCD1' macro='PrintString' >
													<argument exp='&quot;Data Written&quot;' />
												</command>
											</flowline>
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
			</macros>
