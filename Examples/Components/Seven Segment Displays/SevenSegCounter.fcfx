				</variable>
				<variable public='0' >
					<def class_type='variable' name='Sw' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
				</variable>
				<variable public='0' >
					<def class_type='variable' name='false' type='b1' description='' isconst='1' isinit='1' usrinit='0' setinit='0' />
				</variable>
				<variable public='0' >
					<def class_type='variable' name='Seg' type='u8' description='' isconst='0' isinit='1' usrinit='0' setinit='0' />
				</variable>
				<variable public='0' >
					<def class_type='variable' name='Units' type='u8' description='' isconst='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
						<array size='4' />
					</def>
				</variable>
				<variable public='0' >
					<def class_type='variable' name='true' type='b1' description='' isconst='1' isinit='1' usrinit='1' setinit='1' />
				</variable>
			</variables>
			<macros >
				<macro >
					<flowline name='SegRefresh' description='' >
						<command class_type='switch' title='Which segment are we due to strobe?' textarea='36,25,36,25' exp='Seg' >
							<case >
								<flowline >
									<command class_type='call' title='Call Component Macro' component='led_7seg_quad1' macro='ShowDigit' >
										<argument exp='3' />
										<argument exp='Units[0]' />
										<argument exp='0' />
									</command>
								</flowline>
							</case>
							<case exp='1' >
								<flowline >
									<command class_type='call' title='Call Component Macro' component='led_7seg_quad1' macro='ShowDigit' >
										<argument exp='2' />
										<argument exp='Units[1]' />
										<argument exp='0' />
									</command>
								</flowline>
							</case>
							<case exp='2' >
								<flowline >
									<command class_type='call' title='Call Component Macro' component='led_7seg_quad1' macro='ShowDigit' >
										<argument exp='1' />
										<argument exp='Units[2]' />
										<argument exp='0' />
									</command>
								</flowline>
							</case>
							<case exp='3' >
								<flowline >
									<command class_type='call' title='Call Component Macro' component='led_7seg_quad1' macro='ShowDigit' >
										<argument exp='0' />
										<argument exp='Units[3]' />
										<argument exp='0' />
									</command>
								</flowline>
							</case>
						</command>
						<command class_type='calculation' title='Move to next segment' >
							<exp exp='Seg = (Seg + 1) &amp; 0x03' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='' >
						<command class_type='calculation' title='Reset Counter Variables' >
							<exp exp='Units[0] = 0' />
							<exp exp='Units[1] = 0' />
							<exp exp='Units[2] = 0' />
							<exp exp='Units[3] = 0' />
							<exp exp='count = 0' />
						</command>
						<command class_type='interrupt' title='Enable Round Robin Display Strobes' enable='1' name='TMR0' call='SegRefresh' >
							<settings timer='1' prescale='16' postscale='-1' rollover='-1' bitcount='-1' trigger='3' maskhi='--------------------------------------------------------------------------------------------------------------------------------------------------------------------------8' masklo='--------------------------------------------------------------------------------------------------------------------------------------------------------------------------8' >
								<option value='1' />
								<option value='0' />
								<option value='4' />
								<option value='-1' />
							</settings>
						</command>
						<command class_type='loop' title='Loop Forever' exp='1' type='0' start='1' count='1' breakend='0' >
							<flowline >
								<command class_type='call' title='Collect the state of the switch' component='sw_push_pcb1' macro='ReadState' >
									<return exp='Sw' />
								</command>
								<command class_type='decision' title='If switch pressed?' exp='Sw' swap='0' >
									<flowline >
										<command class_type='calculation' title='Increment counter' >
											<exp exp='Count = Count + 1' />
										</command>
										<command class_type='calculation' title='Convert to digits to drive the 7seg' >
											<exp exp='Units[0] = Count % 10' />
											<exp exp='Units[1] = (Count / 10) % 10' />
											<exp exp='Units[2] = (Count / 100) % 10' />
											<exp exp='Units[3] = (Count / 1000) % 10' />
										</command>
										<command class_type='loop' title='Wait for switch to be released' exp='sw' type='0' start='1' count='1' breakend='0' >
											<flowline >
												<command class_type='call' title='Call Component Macro' component='sw_push_pcb1' macro='ReadState' >
													<return exp='Sw' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
			</macros>
			<component class_type='ref' guid='f4400e36-dd95-4472-86da-4bba68d68d5d' vmin='2' vmaj='1' codename='led_7seg_quad1' x='1.27233' y='1.90849' z='4.125' xsz='50.4' ysz='19' zsz='8.25' xang='0' yang='0' zang='0' xquat='0' yquat='0' zquat='0' wquat='1' visible='1' interactive='1' solid='1' layer='0' >
