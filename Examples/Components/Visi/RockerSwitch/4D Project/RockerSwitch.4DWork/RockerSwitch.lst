003332  000271  var hFonts[1] ;
003333  000272  var iSounds[1] ;
003334  000273  var stringsCV[1] ;
003335  000274  var dKeyboard[1] ;
003336  000275  var fTimers[1] ;
003337  000276  var oObjects[MaxTotObjects+1] ;                 // address of objects
003338  000277  var hstrings ;
003339  000278  var curform ;
003340  000279  var x, y, actKB ;
