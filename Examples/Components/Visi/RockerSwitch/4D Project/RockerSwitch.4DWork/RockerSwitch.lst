003345  000284        
003346  000285  func seroutCS(var op)
003347  000286      serout(op) ;
003348  000287      Ocs ^= op ;
003349  000288  endfunc
003350  000289        
003351  000290  func seroutOcs()
003352  000291      serout(Ocs) ;
003353  000292      Ocs := 0 ;
003354  000293  endfunc
003355  000294        
003356  000295  func TMul(var p1, var p2, var p3)
003357  000296      var var32[2], var322[2] ;
003358  000297      umul_1616(var32, p1, *(input+p2)) ;
003359  000298      umul_1616(var322, var32[1], *(input+p3)) ;
003360  000299      umul_1616(var32, var32[0], *(input+p3)) ;
003361  000300      return(var32[1] + var322[0]) ;
003362  000301  endfunc
003363  000302        
003364  000303  func ReadObject(var ObjectType, var ObjectIdx)
003365  000304      var j, k, Objects ;
003366  000305      Objects := *(oObjects+ObjectType) ;
003367  000306        
003368  000307      seroutCS(REPORT_OBJ) ;
003369  000308      seroutCS(ObjectType) ;
003370  000309      seroutCS(ObjectIdx) ;
003371  000310      j := 2 + ObjectIdx * 2 + Objects ;
003372  000311      if ((ObjectType == tCustomdigits) || (ObjectType == tLeddigits))
003373  000312          k := img_GetWord(hndl, *j, IMAGE_TAG2);
003374  000313      else if (ObjectType == tStrings)
003375  000314          k := stringsCV[ObjectIdx];
003376  000315      else if (ObjectType == tTimer)
003377  000316          k := sys_GetTimer(ObjectIdx);
003378  000317      else if (ObjectType == tSounds)
003379  000318          k := snd_Playing();             // only a code of 0 is valid, return playing block regardless
003380  000319      else
003381  000320          k := img_GetWord(hndl, *j, IMAGE_INDEX);
003382  000321          if ((ObjectType == tWinButton) && (k)) k := 1 ;
003383  000322      endif
003384  000323      seroutCS(k >> 8) ; // first 8 bits
003385  000324      seroutCS(k) ;
003386  000325      seroutOcs() ;
003387  000326  endfunc
003388  000327        
003389  000328  func WriteObject(var ObjectType, var ObjectIdx, var NewVal)
003390  000329      var i, j, Objects ;
003391  000330      ObjectType &= 0x3f ;
003392  000331      if (ObjectType == tForm)
003393  000332          ActivateForm(ObjectIdx) ;
003394  000333      else
003395  000334          Objects := *(oObjects+ObjectType)+ObjectIdx*2+2 ;
003396  000335          i := *(Objects) ;
003397  000336          if (ObjectType == tWinButton)
003398  000337              j := IPControls[oWinButtons[ObjectIdx+1]] ;
003399  000338              if (*(j+IPData+IPD_P2) != -1) TurnOffButtons(*(j+IPData+IPD_P2)) ;
003400  000339              NewVal := NewVal << 1 ;
003401  000340          endif
003402  000341          if (ObjectType == tCustomdigits)
003403  000342              img_SetWord(hndl, i , IMAGE_TAG2, NewVal); // where state is 0 to 2
003404  000343              ledDigitsDisplay(i, oCustomdigitss, OPDataC) ;
003405  000344          else if (ObjectType == tLeddigits)
003406  000345              img_SetWord(hndl, i , IMAGE_TAG2, NewVal); // where state is 0 to 2
003407  000346              ledDigitsDisplay(i, oLeddigitss, OPDataL) ;
003408  000347          else if (ObjectType == tStrings)
003409  000348              PrintStrings(ObjectIdx, NewVal, 0);
003410  000349          else if (ObjectType == tTimer)
003411  000350              if (NewVal)
003412  000351                  sys_SetTimerEvent(ObjectIdx, fTimers[ObjectIdx]);
003413  000352                  sys_SetTimer(ObjectIdx, oTimers[ObjectIdx+1]);
003414  000353              else
003415  000354                  sys_SetTimerEvent(ObjectIdx, 0);
003416  000355  //                sys_SetTimer(ObjectIdx, 0);
003417  000356              endif
003418  000357          else if (ObjectType == tSounds)
003419  000358              if (!ObjectIdx)
003420  000359                  file_PlayWAV(iSounds[NewVal]);
003421  000360              else if (ObjectIdx == 1)
003422  000361                  snd_Volume(NewVal) ;
003423  000362              else if (ObjectIdx == 2)
003424  000363                  snd_Pause() ;
003425  000364              else if (ObjectIdx == 3)
003426  000365                  snd_Continue() ;
003427  000366              else if (ObjectIdx == 4)
003428  000367                  snd_Stop() ;
003429  000368              endif
003430  000369          else
003431  000370              img_SetWord(hndl, i , IMAGE_INDEX, NewVal); // where state is 0 to 2
003432  000371              img_Show(hndl, i) ; // will only display if form is current
003433  000372          endif
003434  000373      endif
003435  000374  endfunc
003436  000375        
003437  000376  func TurnOffButtons(var group)
003438  000377      var j, k, l;
003439  000378      for (j := 0; j < nInputs; j++)
003440  000379          k := j*IPDatasize ;
003441  000380          l := oWinButtons[*(IPData+k+IPD_OBJVidx)/2] ;
003442  000381          if ((*(IPData+k) == tWinButton) && (*(IPData+k+IPD_P2) == group))
003443  000382              img_SetWord(hndl, l, IMAGE_INDEX, 0);
003444  000383              img_Show(hndl, l);      // only shows on current form
003445  000384          endif
003446  000385      next
003447  000386  endfunc
003448  000387        
003449  000388  // WARNING, this code will crash if newval exceeds maximum displayable number
003450  000389  func ledDigitsDisplay(var imgidx, var typeptr, var setptr)
003451  000390      var i, j, k, l, lb, newval ;
003452  000391      if (!((img_GetWord(hndl, imgidx, IMAGE_FLAGS) & I_ENABLED))) return ;  // ;img_GetWord(hndl, imgidx, IMAGE_TAG2) ;if diabled then exit
003453  000392      newval := img_GetWord(hndl, imgidx, IMAGE_TAG2) ;
003454  000393      i := -1 ;
003455  000394      j := *(typeptr) ;
003456  000395      repeat
003457  000396          typeptr += 2 ;
003458  000397          i++ ;
003459  000398          until (*(typeptr) == imgidx);
003460  000399      j := setptr + i*10 ;
003461  000400        
003462  000401      imgidx++ ;
003463  000402      l := 1 ;
003464  000403      for (i := 1; i < *(j+iDigits); i++)
003465  000404          l *= 10 ;
003466  000405      next
003467  000406      lb := *(j+iLeadingBlanks) ;
003468  000407      for (i := 0; i < *(j+iDigits); i++)
003469  000408          k := newval / l ;
003470  000409          newval -= k * l ;
003471  000410          if ( lb && (i < *(j+iDigits) - *(j+iMinDigits)) )
003472  000411              if (k == 0)
003473  000412                  k := -1 ; // was 10
003474  000413              else
003475  000414                  lb := 0 ;
003476  000415              endif
003477  000416          endif
003478  000417          l /= 10 ;
003479  000418          img_SetWord(hndl, imgidx, IMAGE_INDEX, k);
003480  000419          img_SetWord(hndl, imgidx, IMAGE_XPOS, *(j+ileft)+i* *(j+iWidthDigit)) ;
003481  000420          img_Show(hndl, imgidx);
003482  000421      next
003483  000422  endfunc
003484  000423        
003485  000424  func ActivateForm(var newform)
003486  000425      var i, j ;
003487  000426      if (curform != -1) // deactivate old form, by disabling all inputs
003488  000427          for (i := formstidx[curform]; i <= formenidx[curform]; i++)
003489  000428              if (img_GetWord(hndl, i, IMAGE_TAG))
003490  000429                  img_Disable(hndl,i) ;
003491  000430              endif
003492  000431          next
003493  000432      endif
003494  000433      curform := newform ;
003495  000434      // display newform image or clear to image color
003496  000435      if (formBGcol[curform] != BGIMAGE)
003497  000436          gfx_Set(BACKGROUND_COLOUR,formBGcol[curform]);
003498  000437          gfx_Cls() ;
003499  000438          DoGFXObjects() ;                                    // display GFX 'widgets'
003500  000439      endif
003501  000440        
003502  000441      // enable inputs
003503  000442      for (i := formstidx[curform]; i < formenidx[curform]; i++)
003504  000443          j := img_GetWord(hndl, i, IMAGE_TAG) ;
003505  000444          if (j)
003506  000445              j-- ;
003507  000446              img_SetAttributes(hndl, i, I_STAYONTOP+I_ENABLED);        // make sure this is on top of form, if applicable
003508  000447              //if (j != tKeyboard)
003509  000448              if (j <= tWinButton)
003510  000449                  img_ClearAttributes(hndl, i, I_TOUCH_DISABLE);  // ensure touch is enabled
003511  000450              endif
003512  000451              img_Show(hndl,i) ; // show initialy, if required
003513  000452              if (j == tForm)
003514  000453                  DoGFXObjects() ;                                    // display GFX 'widgets' for image backgruobds
003515  000454              else if (j == tCustomdigits)
003516  000455                  ledDigitsDisplay(i, oCustomdigitss, OPDataC) ;
003517  000456              else if (j == tLeddigits)
003518  000457                  ledDigitsDisplay(i, oLeddigitss, OPDataL) ;
003519  000458              endif
003520  000459          endif
003521  000460      next
003522  000461      for (i := 0; i < oStringss[0]; i++)
003523  000462          if (stringsCV[i] != -1)
003524  000463              WriteObject(tStrings, i, stringsCV[i]) ;
003525  000464          endif
003526  000465      next
003527  000466  endfunc
003528  000467        
003529  000468  func UpdateObjects(var newval)
003530  000469      var IPidx, otherOBJ ;
003531  000470      if ( ( img_GetWord(hndl, *(object), IMAGE_INDEX) != newval) || (TState == IPD_RELEASE) ) // only bother if values changed, or release
003532  000471        
003533  000472          img_SetWord(hndl, *(object), IMAGE_INDEX, newval);
003534  000473          img_Show(hndl, *(object));      // only shows on current form
003535  000474          IPidx := *(input+TState) ;
003536  000475          while(IPidx != 0)
003537  000476              otherOBJ := IPidx + IPData;
003538  000477              if (*(otherOBJ) == OT_REPORT)
003539  000478                  if ((inputtype == tWinButton) && (newval > 1))newval := newval >> 1;
003540  000479                  seroutCS(REPORT_EVENT) ;
003541  000480                  seroutCS(inputtype) ;
003542  000481                  seroutCS(*(otherOBJ+IPD_OBJVidx)) ;
003543  000482                  seroutCS(newval >> 8) ;
003544  000483                  seroutCS(newval) ;
003545  000484                  seroutOcs() ;
003546  000485              else if (TState == *(otherOBJ+IPD_P4))
003547  000486                  if (*(otherOBJ) == OT_ACTIVATE)
003548  000487                      ActivateForm(*(otherOBJ+IPD_P2) ) ;
003549  000488                      inputtype := tForm ;
003550  000489                  else if (*(otherOBJ) == OT_SETCONST)
003551  000490                      newval := *(otherOBJ+IPD_P3) ;
003552  000491                      WriteObject(*(otherOBJ+IPD_P1), *(otherOBJ+IPD_P2), newval) ;
003553  000492                  else if (*(otherOBJ) == OT_SETANOTHER)
003554  000493                      WriteObject(*(otherOBJ+IPD_P1), *(otherOBJ+IPD_P2), newval) ;
003555  000494                  else if (*(otherOBJ) == OT_PREVFRAME)
003556  000495                      if (img_GetWord(hndl, *(otherOBJ+IPD_P2), IMAGE_INDEX))
003557  000496                          WriteObject(tVideo,*(otherOBJ+IPD_P2),img_GetWord(hndl, *(otherOBJ+IPD_P2), IMAGE_INDEX)-1) ;
003558  000497                      endif
003559  000498                      newval := img_GetWord(hndl, *(otherOBJ+IPD_P2), IMAGE_INDEX) ;
003560  000499                  else if (*(otherOBJ) == OT_NEXTFRAME)
003561  000500                      if (img_GetWord(hndl, *(otherOBJ+IPD_P2), IMAGE_INDEX) < *(otherOBJ+IPD_P3)) // fix IPD_P2 not filled in yet
003562  000501                          WriteObject(tVideo,*(otherOBJ+IPD_P2),img_GetWord(hndl, *(otherOBJ+IPD_P2), IMAGE_INDEX)+1) ;
003563  000502                      endif
003564  000503                      newval := img_GetWord(hndl, *(otherOBJ+IPD_P2), IMAGE_INDEX) ;
003565  000504                  else if (*(otherOBJ) == OT_PREVSTRING)
003566  000505                      if (stringsCV[*(otherOBJ+IPD_P2)])
003567  000506                          WriteObject(tStrings,*(otherOBJ+IPD_P2),stringsCV[*(otherOBJ+IPD_P2)]-1) ;
003568  000507                      endif
003569  000508                  else if (*(otherOBJ) == OT_NEXTSTRING)
003570  000509                      if (stringsCV[*(otherOBJ+IPD_P2)] < *(otherOBJ+IPD_P3)) // fix IPD_P2 not filled in yet
003571  000510                          WriteObject(tStrings,*(otherOBJ+IPD_P2),stringsCV[*(otherOBJ+IPD_P2)]+1) ;
003572  000511                      endif
003573  000512                  endif
003574  000513              endif
003575  000514              IPidx := *(otherOBJ+TState) ;
003576  000515          wend
003577  000516      endif
003578  000517  endfunc
003579  000518        
003580  000519  func DoGFXObjects()
003581  000520  endfunc
003582  000521        
003583  000522  func main()
003584  000523      var comTX[50], cmdi, i, j, n, state, oldn ;
003585  000524      actKB := -1 ;
003586  000525      putstr("Mounting...\n");
003587  000526      if (!(disk:=file_Mount()))
003588  000527          while(!(disk :=file_Mount()))
003589  000528              putstr("Drive not mounted...");
003590  000529              pause(200);
003591  000530              gfx_Cls();
003592  000531              pause(200);
003593  000532          wend
003594  000533      endif
003595  000534  //    gfx_MoveTo(0, 0);
003596  000535  //    print(mem_Heap()," ") ;
003597  000536  //    gfx_TransparentColour(0x0020);
003598  000537  //    gfx_Transparency(ON);
003599  000538        
003600  000539      gfx_ScreenMode(PORTRAIT) ;
003601  000540        
003602  000541      // open image control
003603  000542      hndl := file_LoadImageControl("ROCKER~1.dat", "ROCKER~1.gci", 1);
003604  000543        
003605  000544      // init 'constants'
003606  000545        
003607  000546      oObjects[tDipSwitch] := oDipSwitchs ;
003608  000547      oObjects[tKnob] := oKnobs ;
003609  000548      oObjects[tRockerSwitch] := oRockerSwitchs ;
003610  000549      oObjects[tRotarySwitch] := oRotarySwitchs ;
003611  000550      oObjects[tGSlider] := oGSliders ;
003612  000551      oObjects[tTrackbar] := oTrackbars ;
003613  000552      oObjects[tWinButton] := oWinButtons ;
003614  000553      oObjects[tAngularmeter] := oAngularmeters ;
003615  000554      oObjects[tCoolgauge] := oCoolgauges ;
003616  000555      oObjects[tCustomdigits] := oCustomdigitss ;
003617  000556      oObjects[tForm] := oForms ;
003618  000557      oObjects[tGauge] := oGauges ;
003619  000558      oObjects[tImage] := oImages ;
003620  000559      oObjects[tKeyboard] := oKeyboards ;
003621  000560      oObjects[tLed] := oLeds ;
003622  000561      oObjects[tLeddigits] := oLeddigitss ;
003623  000562      oObjects[tMeter] := oMeters ;
003624  000563      oObjects[tStrings] := oStringss ;
003625  000564      oObjects[tThermometer] := oThermometers ;
003626  000565      oObjects[tUserled] := oUserleds ;
003627  000566      oObjects[tVideo] := oVideos ;
003628  000567      oObjects[tStaticText] := oStaticTexts ;
003629  000568      oObjects[tSounds] := oSoundss ;
003630  000569      oObjects[tTimer] := oTimers ;
003631  000570      hstrings := file_Open("ROCKER~1.txf", 'r') ; // Open handle to access uSD strings, uncomment if required
003632  000571      // init comms
003633  000572      com_Init(comRX,80,0);
003634  000573      setbaud(BAUD_9600);
003635  000574      com_TXbuffer(comTX, 100, 0);
003636  000575      // tag 'real' objects
003637  000576      for (i := 0; i <= MaxVisObjects; i++)
003638  000577          x := oObjects[i] ;
003639  000578          y := *(x) ;
003640  000579          for (n := 1; n <= y; n++)
003641  000580              oldn := *(x+n*2) ;
003642  000581   img_SetAttributes(hndl, oldn, I_TOUCH_DISABLE);  // ensure touch is enabled
003643  000582             if (oldn != -1)
003644  000583                  img_SetWord(hndl, oldn, IMAGE_TAG, i+1);
003645  000584                  img_Disable(hndl, oldn) ;
003646  000585              endif
003647  000586          next
003648  000587      next
003649  000588      for (i := 0; i < oKeyboards[0]; i++) // for each kb key, set tag to -1
003650  000589          for(n := oKeyboards[i+1]+1; n <= oKeyboards[i+1]+*(dKeyboard[i] + KbButtons); n++)
003651  000590              img_SetWord(hndl, n, IMAGE_TAG, -1);
003652  000591          next
003653  000592      next
003654  000593        
003655  000594      // display initial form
003656  000595      curform := -1 ;
003657  000596      ActivateForm(0) ; // need to change this according to first actual form
003658  000597        
003659  000598        
003660  000599      touch_Set(TOUCH_ENABLE);                            // enable the touch screen
003661  000600      oldn := -1 ;
003662  000601      repeat
003663  000602          // check comms for command, how to NAK invalid command
003664  000603          if (com_Count() != 0)
003665  000604              i := serin() ;
003666  000605              cs ^= i ;               // update checksum
003667  000606              if (   (cmdi > 2)
003668  000607                  && (cmd[0] == WRITE_STRU) )
003669  000608                  j := (cmdi-1) >> 1 + 2 ;
003670  000609                  if (j == CMDLenMAX)    // max length exceeded
003671  000610                      serout(NAK) ;
003672  000611                      cs := 0 ;
003673  000612                      cmdi := -1 ;
003674  000613                  else if (cmdi & 1)
003675  000614                      cmd[j] := i ;
003676  000615                      if (cmd[2] == 0)    // if string complete
003677  000616                          if (cs)
003678  000617                              serout(NAK) ;
003679  000618                              cs := 0 ;
003680  000619                          else
003681  000620                              cmd[j] := 0 ;                     // terminate it
003682  000621                              PrintStrings(cmd[1], &cmd[3], 1) ;
003683  000622                              serout(ACK) ;
003684  000623                          endif
003685  000624                          cmdi := -1 ;
003686  000625                      endif
003687  000626                  else
003688  000627                      cmd[j] := cmd[j] << 8 + i ;
003689  000628                      cmd[2]-- ;          // dec length
003690  000629                  endif
003691  000630                  cmdi++ ;
003692  000631              else // not unicode string
003693  000632                  cmd[cmdi++] := i ;
003694  000633        
003695  000634                  if (cmd[0] == WRITE_STR)        // ansi string
003696  000635                      if (cmdi == CMDLenMAX)      // max length exceeded
003697  000636                          serout(NAK) ;
003698  000637                          cs := 0 ;
003699  000638                          cmdi := 0 ;
003700  000639                      else if (cmdi > 2)
003701  000640                          if (cmd[2] == -1)
003702  000641                              if (cs)
003703  000642                                  serout(NAK) ;
003704  000643                                  cs := 0 ;
003705  000644                              else
003706  000645                                  cmd[cmdi-1] := 0 ;                     // terminate it
003707  000646                                  PrintStrings(cmd[1], &cmd[3], 1) ;
003708  000647                                  serout(ACK) ;
003709  000648                              endif
003710  000649                              cmdi := 0 ;
003711  000650                          else
003712  000651                              cmd[2]-- ;          // dec length
003713  000652                          endif
003714  000653                      endif
003715  000654                  else if (   (cmd[0] == READ_OBJ)
003716  000655                           && (cmdi == 4)         )
003717  000656                      if (cs)
003718  000657                          serout(NAK) ;
003719  000658                          cs := 0 ;
003720  000659                      else
003721  000660                          ReadObject(cmd[1], cmd[2]) ;
003722  000661                      endif
003723  000662                      cmdi := 0 ;
003724  000663                  else if (   (cmd[0] == WRITE_OBJ)    // 6 byte write command (gen option)
003725  000664                           && (cmdi == 6)          )
003726  000665                      if (cs)
003727  000666                          serout(NAK) ;
003728  000667                          cs := 0 ;
003729  000668                      else
003730  000669                          WriteObject(cmd[1], cmd[2], cmd[3] << 8 + cmd[4]) ;
003731  000670                          serout(ACK) ;
003732  000671                      endif
003733  000672                      cmdi := 0 ;
003734  000673                  else if (   (cmd[0] == WRITE_CONTRAST)
003735  000674                           && (cmdi == 3)         )
003736  000675                      if (cs)
003737  000676                          serout(NAK) ;
003738  000677                          cs := 0 ;
003739  000678                      else
003740  000679                          gfx_Contrast(cmd[1]) ;
003741  000680                          serout(ACK) ;
003742  000681                      endif
003743  000682                      cmdi := 0 ;
003744  000683                  else if (cmdi == 6)    // we have 6 bytes and we've gotten here -> something wrong
003745  000684                      serout(NAK) ;
003746  000685                      cs := 0 ;
003747  000686                      cmdi := 0 ;
003748  000687                  endif
003749  000688              endif   // not unicode string
003750  000689          endif   // a character is available
003751  000690        
003752  000691      // touch code processing
003753  000692        
003754  000693          state := touch_Get(TOUCH_STATUS);               // get touchscreen status
003755  000694          n := img_Touched(hndl,-1) ;
003756  000695          if ((state == TOUCH_PRESSED) || (state == TOUCH_RELEASED) || (state == TOUCH_MOVING))
003757  000696              if ((state != TOUCH_RELEASED) && (n != oldn) && (oldn != -1)) 
003758  000697                  state := TOUCH_RELEASED ;       // simulate release if we move off object
003759  000698              endif
003760  000699              if (state != TOUCH_RELEASED)        // if not released
003761  000700                  if (oldn != -1) 
003762  000701                      n := oldn ;
003763  000702                  else 
003764  000703                      oldn := n ;
003765  000704                      state := TOUCH_PRESSED ;
003766  000705                  endif
003767  000706                  x  := touch_Get(TOUCH_GETX);
003768  000707                  y  := touch_Get(TOUCH_GETY);
003769  000708                  TState := IPD_DOWN ;
003770  000709              else
003771  000710                  n := oldn ;                     // simulate release of what we touched
003772  000711                  oldn := -1 ;                    // prevent double release
003773  000712                  TState := IPD_RELEASE ;
003774  000713              endif
003775  000714              if (n != -1)
003776  000715                  // if touch released then find a keyboard down, if one then release it
003777  000716                  if ((state == TOUCH_RELEASED) && (actKB != -1))
003778  000717                      kbUp(oKeyboards[actKB+1], dKeyboard[actKB]) ;
003779  000718                      actKB := -1 ;
003780  000719                  else
003781  000720                      i := 0 ;
003782  000721                      while ((i < oKeyboards[0]) && ((n <= oKeyboards[i+1]) || (n > oKeyboards[i+1] + *(dKeyboard[i]+KbButtons))))
003783  000722                          i++ ;
003784  000723                      wend
003785  000724                      if (i < oKeyboards[0])
003786  000725                          if (state == TOUCH_PRESSED)
003787  000726                              actKB := i ;
003788  000727                              kbDown(oKeyboards[actKB+1], dKeyboard[actKB], kKeyboardKeystrokes[actKB], n-oKeyboards[actKB+1]) ;
003789  000728                          endif
003790  000729                      else
003791  000730                          input := IPControls[n] + IPData;
003792  000731                          inputtype := *(input) ;
003793  000732                          gosub (inputtype), (cDipswitch, cKnob, cRockerswitch, cRotaryswitch, cSlider, cTrackbar, cWinbutton) ;
003794  000733                      endif
003795  000734                  endif
003796  000735        
003797  000736              endif
003798  000737          endif
003799  000738   //       if ((n != -1) && (oldn == -1)) oldn := n ;    // save what we touched in case we move off it
003800  000739        
003801  000740          sys_EventsResume() ;
003802  000741      forever
003803  000742        
003804  000743  cDipswitch:
003805  000744      if (*(input+IPD_P1))
003806  000745          i := (x - *(input+IPD_P2)) / *(input+IPD_P3) ;
003807  000746      else
003808  000747          i := (y - *(input+IPD_P2)) / *(input+IPD_P3) ;
003809  000748      endif
003810  000749      if (i > *(input+IPD_P4)) i := *(input+IPD_P4) ;
003811  000750      object := oDipSwitchs + *(input+IPD_OBJVidx) ;
003812  000751  endret:
003813  000752      UpdateObjects(i) ;
003814  000753  endsub ;
003815  000754        
003816  000755  cKnob:
003817  000756      i := XYposToDegree(x-*(input+IPD_P1),      // x - CentreX
003818  000757                         y-*(input+IPD_P2)) ;    // y - centreY
003819  000758      if (i < *(input+IPD_P3))                   // anything in the first 'dead zone' is minvalue
003820  000759          i := 0 ;
003821  000760      else
003822  000761          if (i > *(input+IPD_P4))               // anything in the last 'dead zone' is maxvalue
003823  000762              i := *(input+IPD_P5) ;
003824  000763          else
003825  000764              i -= *(input+IPD_P3) ;             // offset by -baseangle
003826  000765          endif
003827  000766      endif
003828  000767  //  i := i * *(input+IPD_P6) / *(input+IPD_P5) ;   // convert degrees to position
003829  000768      i := TMul(i, IPD_P6, IPD_P7) ;   // convert degrees to position
003830  000769      object := oKnobs + *(input+IPD_OBJVidx) ;
003831  000770      goto endret ;
003832  000771  //    UpdateObjects(i) ;
003833  000772  //endsub ;
003834  000773        
003835  000774  cRockerswitch:
003836  000775      object := oRockerSwitchs + *(input+IPD_OBJVidx) ;
003837  000776      if (*(input+IPD_P4))
003838  000777          i := img_GetWord(hndl, *(object), IMAGE_INDEX) ;
003839  000778          if (state == TOUCH_RELEASED)           // this must only be done on a 'release'
003840  000779              i := !i & 1 ;                      // just toggle for clickrect = whole
003841  000780          endif
003842  000781      else
003843  000782          if (*(input+IPD_P1))
003844  000783              i := (y - *(input+IPD_P2)) / *(input+IPD_P3) ;         // (DipRockerOrient - top_left) / (height_width / 2)
003845  000784          else
003846  000785              i := (x - *(input+IPD_P2)) / *(input+IPD_P3) ;         // (DipRockerOrient - top_left) / (height_width / 2)
003847  000786          endif
003848  000787          if  (!*(input+IPD_P5))
003849  000788              i := !i & 1 ;        // toggle rockerPos, on top or left orientation
003850  000789          endif
003851  000790      endif
003852  000791      UpdateObjects(i) ;
003853  000792  endsub ;
003854  000793        
003855  000794  cRotaryswitch:
003856  000795      i := XYposToDegree(x-*(input+IPD_P1),      // x - CentreX
003857  000796                         y-*(input+IPD_P2)) ;    // y - centreY
003858  000797      if (i < *(input+IPD_P3))                   // anything in the first 'dead zone' is minvalue
003859  000798          i := 0 ;
003860  000799      else
003861  000800          if (i > *(input+IPD_P4))               // anything in the last 'dead zone' is maxvalue
003862  000801              i := *(input+IPD_P4)-*(input+IPD_P3) ;
003863  000802          else
003864  000803             i -= *(input+IPD_P5) ;              // offset by -switchanglestart and half a division
003865  000804          endif
003866  000805      endif
003867  000806      i := i * *(input+IPD_P6)  / (*(input+IPD_P4)-*(input+IPD_P3)) ;        // convert degrees to position
003868  000807      object := oRotarySwitchs + *(input+IPD_OBJVidx) ;
003869  000808      UpdateObjects(i) ;
003870  000809  endsub ;
003871  000810        
003872  000811  cSlider:
003873  000812  cTrackbar:
003874  000813      if (*(input+IPD_P1))
003875  000814          i := x - *(input+IPD_P2) ;
003876  000815          if (i < 0)
003877  000816              i := 0 ;
003878  000817          else if (i > *(input+IPD_P3))        // height/width - 17)
003879  000818              i := *(input+IPD_P4) ;           // maxvalue-minvalue
003880  000819          else
003881  000820  //            i := *(input+IPD_P4) * i / *(input+IPD_P3) ;    // max-min - (max-min) * posn / (height-17)
003882  000821              i := TMul(i, IPD_P4, IPD_P5) ;    // max-min - (max-min) * posn / (height-17)
003883  000822          endif
003884  000823      else
003885  000824          i := y - *(input+IPD_P2) ;
003886  000825          if (i < 0)
003887  000826              i := *(input+IPD_P4) ;           // maxvalue-minvalue
003888  000827          else if (i > *(input+IPD_P3))        // height/width - 17)
003889  000828              i := 0 ;
003890  000829          else
003891  000830  //            i := *(input+IPD_P4) - *(input+IPD_P4) * i / *(input+IPD_P3) ;    // max-min - (max-min) * posn / (height-17)
003892  000831              i := *(input+IPD_P4) - TMul(i, IPD_P4, IPD_P5) ;    // max-min - (max-min) * posn / (height-17)
003893  000832          endif
003894  000833      endif
003895  000834      if (inputtype == tGSlider)
003896  000835          object := oGSliders ;
003897  000836      else
003898  000837          object := oTrackbars ;
003899  000838      endif
003900  000839      object += *(input+IPD_OBJVidx) ;
003901  000840      UpdateObjects(i) ;
003902  000841  endsub ;
003903  000842        
003904  000843  cWinbutton:
003905  000844      object := oWinButtons + *(input+IPD_OBJVidx) ;
003906  000845      if (*(input+IPD_P1))                                 // momentary, reports 0, but should report 1
003907  000846          if (state == TOUCH_RELEASED)
003908  000847              i := 0 ;
003909  000848              TState == IPD_DOWN ;
003910  000849          else
003911  000850              i := 1 ;
003912  000851              TState == IPD_RELEASE ;
003913  000852          endif
003914  000853      else if (*(input+IPD_P2) == -1)                      // Toggle, reports 0+2, but should report 0+1
003915  000854          i := img_GetWord(hndl, *(object), IMAGE_INDEX) ; // current state
003916  000855          if (state == TOUCH_RELEASED)                     // only truly change on release
003917  000856              i := ++i & 3 ;
003918  000857          else
003919  000858              i |= 1 ;                                      // make down regardless of current state
003920  000859          endif
003921  000860      else                        // group action, up all other buttons on touch press, reports 0 for button down
003922  000861          if (state == TOUCH_PRESSED)                     // only truly change on release
003923  000862              TurnOffButtons(*(input+IPD_P2)) ;
003924  000863          endif
003925  000864      i := 2 ;
003926  000865      endif
003927  000866        
003928  000867      UpdateObjects(i) ;
003929  000868  endsub ;
003930  000869        
003931  000870  endfunc


