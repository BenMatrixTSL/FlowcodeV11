002938  000018        
002939  000019  func XYposToDegree(var curX, var curY)
002940  000020      var delta, deg, adj ;
002941  000021      if (curY < 0)
002942  000022          if (curX < 0)
002943  000023              adj := 1 ;
002944  000024              deg := 90 ;
002945  000025          else
002946  000026              adj := 2 ;
002947  000027              deg := 180 ;
002948  000028          endif
002949  000029      else
002950  000030          if (curX < 0)
002951  000031              deg := 0 ;
002952  000032              adj := 2 ;
002953  000033          else
002954  000034              deg := 270 ;
002955  000035              adj := 1 ;
002956  000036          endif
002957  000037      endif
002958  000038        
002959  000039      curX := ABS(curX) ;
002960  000040      curY := ABS(curY) ;
002961  000041      if (curX < curY)
002962  000042          adj &= 1 ;
002963  000043      else
002964  000044          adj &= 2 ;
002965  000045          SWAP(&curX, &curY) ;
002966  000046      endif
002967  000047      delta := arctan[(curX * 100) / curY] ;
002968  000048      if (adj)
002969  000049          deg += 90 - delta ;
002970  000050      else
002971  000051          deg += delta ;
002972  000052      endif
002973  000053        
002974  000054      return deg ;
002975  000055  endfunc
