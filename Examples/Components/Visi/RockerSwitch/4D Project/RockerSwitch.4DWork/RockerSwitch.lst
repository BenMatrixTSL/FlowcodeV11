003062  000127  #constant KbShiftBit        01
003063  000127  #constant KbShiftBit        01
003064  000128  #constant KbCapsBit         02
003065  000128  #constant KbCapsBit         02
003066  000129  #constant KbShiftCapsBits   03
003067  000129  #constant KbShiftCapsBits   03
003068  000130  #constant KbCtrlBit         04
003069  000130  #constant KbCtrlBit         04
003070  000131        
003071  000132  func refreshstate(var iKB, var oKB)
003072  000133      var shifted ;
003073  000134      shifted := oKB[KbState] & KbShiftCapsBits ;
003074  000135      if (!shifted || (shifted == KbShiftCapsBits))
003075  000136          shifted := 0 ;
003076  000137          oKB[KbCaps] := 0 ;
003077  000138      else
003078  000139          shifted := 1 ;
003079  000140          oKB[KbCaps] := 2 ;
003080  000141      endif
003081  000142      setkeystate(iKB,shifted) ;
003082  000143      if (oKB[KbState] & KbCapsBit)
003083  000144          setkeystate(iKB + oKB[KbLock],1) ;
003084  000145      endif
003085  000146      if ((oKB[KbState] & KbShiftBit) && (shifted))
003086  000147          setkeystate(iKB + oKB[KbShift1],1) ;
003087  000148          setkeystate(iKB + oKB[KbShift2],1) ;
003088  000149      endif
003089  000150      if (oKB[KbState] & KbCtrlBit)
003090  000151          setkeystate(iKB + oKB[KbCtrl1],1) ;
003091  000152          setkeystate(iKB + oKB[KbCtrl2],1) ;
003092  000153      endif
003093  000154  endfunc
003094  000155        
003095  000156  func kbDown(var iKB, var oKB, var KBKeys, var key)
003096  000157      var keyval ;
003097  000158      oKB[KbMvt] := 1 ;
003098  000159      oKB[KbIgn]  := 0 ;
003099  000160      if ((key == oKB[KbShift1]) || (key == oKB[KbShift2]))
003100  000161          if (oKB[KbState] & KbShiftBit)
003101  000162              oKB[KbState] &= ~KbShiftBit ;
003102  000163              oKB[KbMvt] := 0 ;
003103  000164          else
003104  000165              oKB[KbState] |= KbShiftBit ;
003105  000166          endif
003106  000167          refreshstate(iKB, oKB) ;
003107  000168          oKB[KbIgn] := 1 ;
003108  000169      else if ((key == oKB[KbCtrl1]) || (key == oKB[KbCtrl2]))
003109  000170          if (oKB[KbState] & KbCtrlBit)
003110  000171              oKB[KbState] &= ~KbCtrlBit ;
003111  000172              oKB[KbMvt] := 0 ;
003112  000173          else
003113  000174              oKB[KbState] |= KbCtrlBit ;
003114  000175          endif
003115  000176          setkeystate(iKB+oKB[KbCtrl1],oKB[KbMvt]) ;
003116  000177          key := oKB[KbCtrl2] ;
003117  000178          oKB[KbIgn] := 1 ;
003118  000179      else if (key == oKB[KbLock])
003119  000180          if (oKB[KbState] & KbCapsBit)
003120  000181              oKB[KbState] &= ~KbCapsBit ;
003121  000182              oKB[KbMvt] := 0 ;
003122  000183          else
003123  000184              oKB[KbState] |= KbCapsBit ;
003124  000185          endif
003125  000186          refreshstate(iKB, oKB) ;
003126  000187          oKB[KbIgn] := 1 ;
003127  000188      endif
003128  000189        
003129  000190      if (!oKB[KbIgn])
003130  000191          if (oKB[KbShiftCaps])
003131  000192              keyval := (oKB[KbState] & KbShiftCapsBits) * oKB[KbButtons] - 1 ;
003132  000193          else if (((oKB[KbState] & KbShiftCapsBits) == 0) || ((oKB[KbState] & KbShiftCapsBits) == KbShiftCapsBits))
003133  000194                  keyval := - 1 ;
003134  000195              else
003135  000196                  keyval := oKB[KbButtons] - 1 ;
003136  000197          endif
003137  000198          keyval := KBKeys[key+keyval] ;
003138  000199          if (oKB[KbState] & KbCtrlBit) keyval &= 0x9F ;
003139  000200          seroutCS(REPORT_EVENT) ;
003140  000201          seroutCS(tKeyboard) ;
003141  000202          seroutCS(actKB) ;
003142  000203          seroutCS(0) ;
003143  000204          seroutCS(keyval) ;
003144  000205          seroutOcs() ;
003145  000206          setkeystate(iKB+key,oKB[KbMvt]+oKB[KbCaps]) ;
003146  000207      endif
003147  000208      oKB[KbDown] := key ;
003148  000209  endfunc
003149  000210        
003150  000211  func setkeystate(var key, var idx)
003151  000212      img_SetWord(hndl, key,IMAGE_INDEX, idx);
003152  000213      img_Show(hndl,key) ;
003153  000214  endfunc
003154  000215        
003155  000216  func kbUp(var iKB, var oKB)
003156  000217      if (!oKB[KbIgn])
003157  000218          setkeystate(iKB + oKB[KbDown],oKB[KbCaps]) ;
003158  000219          if (oKB[KbState] & KbShiftBit)
003159  000220              oKB[KbState] &= ~KbShiftBit ;
003160  000221              refreshstate(iKB, oKB) ;
003161  000222          endif
003162  000223          if (oKB[KbState] & KbCtrlBit)
003163  000224              oKB[KbState] &= ~KbCtrlBit ;
003164  000225              setkeystate(iKB + oKB[KbCtrl1],0) ;
003165  000226              setkeystate(iKB + oKB[KbCtrl2],0) ;
003166  000227          endif
003167  000228          oKB[KbDown] := -1 ;
003168  000229      endif
003169  000230  endfunc
