			<macros >
				<macro >
					<flowline name='LED_PWM' description='' >
						<command class_type='call' title='Call Component Macro' component='rgb_led1' macro='Tick' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='' >
						<command class_type='call' title='Call Component Macro' component='Visi4D1' macro='Initialise' />
						<command class_type='interrupt' title='Interrupt' enable='1' name='TMR0' call='LED_PWM' >
							<settings timer='1' prescale='16' postscale='-1' rollover='-1' bitcount='-1' trigger='3' maskhi='--------------------------------------------------------------------------------------------------------------------------------------------------------------------------8' masklo='--------------------------------------------------------------------------------------------------------------------------------------------------------------------------8' >
								<option value='1' />
								<option value='0' />
								<option value='4' />
								<option value='-1' />
							</settings>
						</command>
						<command class_type='call' title='Call Component Macro' component='rgb_led1' macro='Enable' />
						<command class_type='loop' title='Loop' exp='1' type='0' start='1' count='1' breakend='0' >
							<flowline >
								<command class_type='delay' title='Delay' exp='1' type='2' />
								<command class_type='call' title='Call Component Macro' component='Visi4D1' macro='VisiReadObject' >
									<return exp='Red' />
									<argument exp='Visi4D1 :: VISI_ID_ColourPicker' />
									<argument exp='0' />
								</command>
								<command class_type='call' title='Call Component Macro' component='Visi4D1' macro='VisiReadByteFromMessage' >
									<return exp='MSB' />
									<argument exp='3' />
								</command>
								<command class_type='call' title='Call Component Macro' component='Visi4D1' macro='VisiReadByteFromMessage' >
									<return exp='LSB' />
									<argument exp='4' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='Colour = (MSB &lt;&lt; 8) + LSB' />
									<exp exp='Red = (Colour &amp; 0xF800) &gt;&gt; 8' />
									<exp exp='Green = (Colour &amp; 0x7E0) &gt;&gt; 3' />
									<exp exp='Blue = (Colour &amp; 0x1F) &lt;&lt; 3' />
									<exp exp='' />
								</command>
								<command class_type='call' title='Call Component Macro' component='rgb_led1' macro='SetColor' >
									<argument exp='Red' />
									<argument exp='Green' />
									<argument exp='Blue' />
								</command>
								<command class_type='sim' title='Simulation' macro='Debug.PrintLn' >
									<argument exp='&quot;Red:&quot; + string Red + &quot; Green:&quot; + string Green + &quot; Blue:&quot; + string Blue' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
			</macros>
