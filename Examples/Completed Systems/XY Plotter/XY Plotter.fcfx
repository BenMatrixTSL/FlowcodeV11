				<component class_type='shape' codename='Static' x='-2.441' y='-4' z='11.0874' xsz='187.086' ysz='200' zsz='60.8234' xang='0' yang='0' zang='0' xquat='0' yquat='0' zquat='0' wquat='1' visible='1' interactive='1' solid='1' layer='0' >
					<resources />
