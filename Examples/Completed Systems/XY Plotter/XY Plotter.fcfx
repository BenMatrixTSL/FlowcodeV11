						<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='LocalX = 0 OR LocalY = 0' swap='0' >
							<flowline >
