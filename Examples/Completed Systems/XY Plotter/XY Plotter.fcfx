						<command class_type='calculation' title='Calculate the error factor' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
							<exp exp='ErrorX = ErrorX + ScaleX' />
							<exp exp='ErrorY = ErrorY + ScaleY' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='XCCW' description='' >
						<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='Stepper1' macro='DecrementStep' />
						<command class_type='delay' title='Delay' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='StepperDelay' type='0' />
					</flowline>
				</macro>
				<macro >
					<flowline name='XYTravelDirection' description='' >
						<command class_type='decision' title='Set Direction of X travel' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='LocalX &gt; 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='RotateX CW' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='XDirection = 1' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='LocalX &lt; 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='RotateX CCW' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='XDirection = 0' />
								</command>
								<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='LocalX = LocalX * -1' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='LocalX = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='XDirection = XDirection' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Set Direction of Y Travel' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='LocalY &gt; 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='RotateY CW' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='YDirection = 1' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='LocalY &lt; 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='RotateY CCW' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='YDirection = 0' />
								</command>
								<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='LocalY = LocalY * -1' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='LocalY = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='YDirection = YDirection' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Start' description='Broadcast to all components that simulation is starting' >
						<return name='Return' type='u32' array='0' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='1' hide='0' customize='0' macro='Component.SetVisible' >
							<argument exp='Stepper1' />
							<argument exp='false' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='To run simulation, open the dashboard panel by selecting it in the menu &quot;View --&gt; Dashboard Panel&quot;

Then run the simulation, and press 5 on the keypad to start the XY plotter.' >
						<command class_type='call' title='Call Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Initialisation' />
						<command class_type='interrupt' title='Interrupt' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' enable='1' name='TMR1' call='AxisLimit' >
							<settings timer='1' prescale='1' postscale='-1' rollover='-1' bitcount='-1' trigger='3' maskhi='--------------------------------------------------------------------------------------------------------------------------------------------------------------------------8' masklo='--------------------------------------------------------------------------------------------------------------------------------------------------------------------------8' >
								<option value='1' />
								<option value='0' />
								<option value='-1' />
								<option value='-1' />
							</settings>
						</command>
						<command class_type='calculation' title='XY Coords and Pen' comment='' ccode='' textshow='0' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
							<exp exp='testX[0] = 0' />
							<exp exp='testX[1] = 0' />
							<exp exp='testX[2] = 100' />
							<exp exp='testX[3] = 100' />
							<exp exp='testX[4] = 0' />
							<exp exp='testX[5] = 50' />
							<exp exp='testX[6] = 100' />
							<exp exp='testX[7] = 10' />
							<exp exp='testX[8] = 10' />
							<exp exp='testX[9] = 30' />
							<exp exp='testX[10] = 30' />
							<exp exp='testX[11] = 10' />
							<exp exp='testX[12] = 40' />
							<exp exp='testX[13] = 40' />
							<exp exp='testX[14] = 60' />
							<exp exp='testX[15] = 60' />
							<exp exp='testX[16] = 70' />
							<exp exp='testX[17] = 70' />
							<exp exp='testX[18] = 90' />
							<exp exp='testX[19] = 90' />
							<exp exp='testX[20] = 70' />
							<exp exp='testX[21] = 0' />
							<exp exp='' />
							<exp exp='testY[0] = 50' />
							<exp exp='testY[1] = 100' />
							<exp exp='testY[2] = 100' />
							<exp exp='testY[3] = 50' />
							<exp exp='testY[4] = 50' />
							<exp exp='testY[5] = 0' />
							<exp exp='testY[6] = 50' />
							<exp exp='testY[7] = 70' />
							<exp exp='testY[8] = 90' />
							<exp exp='testY[9] = 90' />
							<exp exp='testY[10] = 70' />
							<exp exp='testY[11] = 70' />
							<exp exp='testY[12] = 100' />
							<exp exp='testY[13] = 70' />
							<exp exp='testY[14] = 70' />
							<exp exp='testY[15] = 100' />
							<exp exp='testY[16] = 70' />
							<exp exp='testY[17] = 90' />
							<exp exp='testY[18] = 90' />
							<exp exp='testY[19] = 70' />
							<exp exp='testY[20] = 70' />
							<exp exp='testY[21] = 0' />
							<exp exp='' />
							<exp exp='testZ[0] = 0' />
							<exp exp='testZ[1] = 1' />
							<exp exp='testZ[2] = 1' />
							<exp exp='testZ[3] = 1' />
							<exp exp='testZ[4] = 1' />
							<exp exp='testZ[5] = 1' />
							<exp exp='testZ[6] = 1' />
							<exp exp='testZ[7] = 0' />
							<exp exp='testZ[8] = 1' />
							<exp exp='testZ[9] = 1' />
							<exp exp='testZ[10] = 1' />
							<exp exp='testZ[11] = 1' />
							<exp exp='testZ[12] = 0' />
							<exp exp='testZ[13] = 1' />
							<exp exp='testZ[14] = 1' />
							<exp exp='testZ[15] = 1' />
							<exp exp='testZ[16] = 0' />
							<exp exp='testZ[17] = 1' />
							<exp exp='testZ[18] = 1' />
							<exp exp='testZ[19] = 1' />
							<exp exp='testZ[20] = 1' />
							<exp exp='testZ[21] = 0' />
						</command>
						<command class_type='loop' title='10 Sets of Coords' comment='Loop iterates as many times as there are coordinates. 
' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='1' type='2' start='1' count='22' breakend='0' >
							<flowline >
								<command class_type='calculation' title='Get Coords' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='// Obtain XY Coords' />
									<exp exp='LocalX = testX[count] - GlobalX' />
									<exp exp='LocalY = testY[count] - GlobalY' />
									<exp exp='' />
									<exp exp='// Save a temp version for loops' />
									<exp exp='LocalXTemp = LocalX' />
									<exp exp='LocalYTemp = LocalY' />
								</command>
								<command class_type='call' title='Determine direction of travel for both XY' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='XYTravelDirection' />
								<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='OldXDirection = XDirection' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='BacklashX = 0' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='BacklashX = 100' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='OldYDirection = YDirection' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='BacklashY = 0' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='47,9,47,9' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='BacklashY = 100' />
										</command>
									</flowline>
								</command>
								<command class_type='call' title='Call Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='XYScale' />
								<command class_type='delay' title='Short Delay to demonstrate arrival at each coord' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='1' hide='0' customize='0' exp='1' type='2' />
								<command class_type='comment' title='' comment='Pen Bounce used to stop pen float' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
								<command class_type='call' title='Call Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='PenBounce' />
								<command class_type='call' title='Call for Pen Up/ Down Movement' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='PenUpDown' />
								<command class_type='delay' title='Short Delay to demonstrate arrival at each coord' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='1' hide='0' customize='0' exp='1' type='2' />
								<command class_type='comment' title='' comment='Reset Motor acceleration/ deceleration delay' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
								<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='StepperDelay = 3000' />
									<exp exp='' />
								</command>
								<command class_type='loop' title='Go from current XY location to new XY location' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='Movement &gt; 0' type='0' start='1' count='10' breakend='0' >
									<flowline >
										<command class_type='call' title='Move XY from current to new' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='XYMovement' />
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='Movement = Movement - 1' />
											<exp exp='' />
											<exp exp='Count3 = Count3 + 1' />
										</command>
										<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='Count3 = 5' swap='0' >
											<flowline >
												<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='StepperDelay &gt;= MinDelay &amp;&amp; Movement &gt; 28' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
															<exp exp='StepperDelay = StepperDelay - 100' />
														</command>
													</flowline>
													<flowline />
												</command>
												<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='Movement &lt; 28' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
															<exp exp='StepperDelay = StepperDelay + 100' />
														</command>
													</flowline>
													<flowline />
												</command>
												<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='Count3 = 0' />
												</command>
											</flowline>
											<flowline />
										</command>
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='ScaleX = ScaleXTemp' />
											<exp exp='ScaleY = ScaleYTemp' />
											<exp exp='' />
											<exp exp='ScaleXFlag = 0' />
											<exp exp='ScaleYFlag = 0' />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Increment to next coords' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='GlobalX = testX[count]' />
									<exp exp='GlobalY = testY[count]' />
									<exp exp='' />
									<exp exp='count = count + 1' />
									<exp exp='' />
									<exp exp='OldXDirection = XDirection' />
									<exp exp='OldYDirection = YDirection' />
									<exp exp='' />
									<exp exp='//GlobalX = GlobalX + LocalXTemp' />
									<exp exp='//GlobalY = GlobalY + LocalYTemp' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Call Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Termination' />
						<command class_type='delay' title='Delay' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='10' type='2' />
					</flowline>
				</macro>
			</macros>
