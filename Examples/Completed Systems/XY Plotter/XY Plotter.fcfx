						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Panel.Position.GetBox' >
							<return exp='.grouppos' />
							<argument exp='XAxis' />
						</command>
						<command class_type='call' title='Call Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='ManualKeypadMovement' />
						<command class_type='loop' title='Loop' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='1' hide='0' customize='0' exp='ResetXAxis == 0' type='0' start='1' count='1' breakend='0' >
							<flowline >
								<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Panel.Collision.GetSingleAxis' >
									<return exp='switchPressX' />
									<argument exp='XAxisSW' />
									<argument exp='Holder' />
									<argument exp='0.0' />
									<argument exp='0.0' />
									<argument exp='0.0' />
									<argument exp='this' />
								</command>
								<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='switchPressX' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='ResetXAxis = switchPressX' />
										</command>
									</flowline>
									<flowline >
										<command class_type='comment' title='' comment='Change to switch 0 and 1, for x axis' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
										<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='keypad_eb014' macro='GetNumber' >
											<return exp='KeyPadPress' />
										</command>
										<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='KeyPadPress = 10' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='ResetXAxis = 1' />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
								</command>
								<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='XCCW' />
								<command class_type='delay' title='Delay' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='StepperDelay' type='0' />
							</flowline>
						</command>
						<command class_type='loop' title='Loop' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='1' hide='0' customize='0' exp='ResetYAxis = 0' type='0' start='1' count='1' breakend='0' >
							<flowline >
								<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Panel.Collision.GetSingleAxis' >
									<return exp='switchPressY' />
									<argument exp='YAxisSW' />
									<argument exp='Gantry' />
									<argument exp='0.0' />
									<argument exp='0.0' />
									<argument exp='0.0' />
									<argument exp='this' />
								</command>
								<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='switchPressY' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='ResetYAxis = switchPressY' />
										</command>
									</flowline>
									<flowline >
										<command class_type='comment' title='' comment='Change to switch 2 and 3, for y axis' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
										<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='keypad_eb014' macro='GetNumber' >
											<return exp='KeyPadPress' />
										</command>
										<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='KeyPadPress = 11' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='ResetYAxis = 1' />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
								</command>
								<command class_type='call' title='Call Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='YCCW' />
								<command class_type='delay' title='Delay' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='StepperDelay' type='0' />
							</flowline>
						</command>
						<command class_type='delay' title='Delay' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='1' hide='0' customize='0' exp='1' type='2' />
						<command class_type='loop' title='Loop' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='1' hide='0' customize='0' exp='1' type='2' start='1' count='200' breakend='0' >
							<flowline >
								<command class_type='call' title='Call Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='XCW' />
								<command class_type='call' title='Call Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='YCW' />
								<command class_type='delay' title='Delay' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='StepperDelay' type='0' />
							</flowline>
						</command>
						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Panel.Position.GetCoords' >
							<return exp='GetPenCoords' />
							<argument exp='Pen' />
							<argument exp='DrawArea' />
