						<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
							<exp exp='BacklashX = 0' />
							<exp exp='BacklashY = BacklashX' />
						</command>
						<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
							<exp exp='ScaleXTemp = ScaleX' />
							<exp exp='ScaleYTemp = ScaleY' />
							<exp exp='' />
							<exp exp='// Multiply Movement by 320 to convert' />
							<exp exp='// from mm to no. of steps.' />
							<exp exp='Movement = (Movement * 280) + BacklashX + BacklashY' />
						</command>
					</flowline>
