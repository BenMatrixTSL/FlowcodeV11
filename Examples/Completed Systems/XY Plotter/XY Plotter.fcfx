								</command>
								<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='MinDelay = 750' />
								</command>
							</flowline>
							<flowline >
								<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='LocalX = LocalY' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='Scale = LocalX' />
											<exp exp='' />
											<exp exp='ScaleX = 1' />
											<exp exp='ScaleY = 1' />
											<exp exp='' />
											<exp exp='Movement = LocalX' />
										</command>
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='MinDelay = 750' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,-7,36,-7' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='Scale = LocalY / LocalX' />
										</command>
										<command class_type='decision' title='Scaling step size for X and Y movement' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='Scale &gt;= 1' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='ScaleX = 1' />
													<exp exp='ScaleY = Scale' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='ScaleX = 1 / Scale' />
													<exp exp='ScaleY = 1' />
												</command>
											</flowline>
										</command>
										<command class_type='decision' title='Determine which axis has LEAST magitude of movement' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='LocalY &gt; LocalX' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='Movement = LocalX' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='Movement = LocalY' />
