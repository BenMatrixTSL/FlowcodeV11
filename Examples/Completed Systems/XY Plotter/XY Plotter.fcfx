						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Debug.PrintLn' >
							<argument exp='GetPenCoords[0]' />
						</command>
						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Debug.PrintLn' >
							<argument exp='GetPenCoords[1]' />
						</command>
						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Debug.PrintLn' >
							<argument exp='GetPenCoords[2]' />
						</command>
						<command class_type='delay' title='Delay' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='1' hide='0' customize='0' exp='3' type='2' />
					</flowline>
				</macro>
				<macro >
					<flowline name='DrawLine' description='' >
						<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='testZ[count]' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='DrawCount = DrawCount + 1' />
								</command>
								<command class_type='comment' title='' comment='was: if drawcount = 25' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
								<command class_type='sim' title='Get pen coords' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Panel.Position.GetCoords' >
									<return exp='GetPenCoords' />
									<argument exp='Pen' />
									<argument exp='DrawArea' />
								</command>
								<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='HighDef = 1' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='GetPenCoords[0] = GetPenCoords[0] * 10' />
											<exp exp='GetPenCoords[1] = GetPenCoords[1] * 10' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='GetPenCoords[0] = GetPenCoords[0] * 4' />
											<exp exp='GetPenCoords[1] = GetPenCoords[1] * 4' />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='rangex = GetPenCoords[0] - prev[0]' />
									<exp exp='rangey = GetPenCoords[1] - prev[1]' />
									<exp exp='range = rangex * rangex + rangey * rangey' />
									<exp exp='' />
								</command>
								<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='drawcount = 150' swap='0' >
									<flowline >
										<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Panel.Graphics.DrawBegin' >
											<argument exp='DrawArea' />
										</command>
										<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Panel.Graphics.SetColorRGB' >
											<argument exp='50' />
											<argument exp='50' />
											<argument exp='50' />
										</command>
										<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='1' hide='0' customize='0' macro='Panel.Graphics.SetColorRGB' >
											<argument exp='random () &amp; 0xFF' />
											<argument exp='random () &amp; 0xFF' />
											<argument exp='random () &amp; 0xFF' />
										</command>
										<command class_type='sim' title='Draw Point' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Panel.Graphics.DrawCircle' >
											<argument exp='GetPenCoords[0]' />
											<argument exp='GetPenCoords[1]' />
											<argument exp='5' />
											<argument exp='5' />
										</command>
										<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Panel.Graphics.DrawEnd' />
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='DrawCount = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='Prev[0] = GetPenCoords[0]' />
									<exp exp='Prev[1] = GetPenCoords[1]' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Initialisation' description='' >
						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Panel.Graphics.DrawBegin' >
							<argument exp='DrawArea' />
						</command>
						<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='HighDef = 1' swap='0' >
							<flowline >
								<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Panel.Graphics.DrawCreate' >
									<argument exp='DrawArea' />
									<argument exp='1250' />
									<argument exp='1250' />
									<argument exp='0' />
									<argument exp='0xffffff' />
								</command>
							</flowline>
							<flowline >
								<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Panel.Graphics.DrawCreate' >
									<argument exp='DrawArea' />
									<argument exp='500' />
									<argument exp='500' />
									<argument exp='0' />
									<argument exp='0xffffff' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='Stepper1' macro='EnableMotor' />
						<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='Stepper2' macro='EnableMotor' />
						<command class_type='call' title='Macro to Reset Axes' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='ResetAxes' />
						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Panel.Position.GetCoords' >
							<return exp='GetPenCoords' />
							<argument exp='Pen' />
							<argument exp='DrawArea' />
						</command>
						<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='HighDef = 1' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='GetPenCoords[0] = GetPenCoords[0] * 10' />
									<exp exp='GetPenCoords[1] = GetPenCoords[1] * 10' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='GetPenCoords[0] = GetPenCoords[0] * 4' />
									<exp exp='GetPenCoords[1] = GetPenCoords[1] * 4' />
								</command>
							</flowline>
						</command>
						<command class_type='output' title='Output' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' mode='1' port='1048580' mask='1' exp='1' />
						<command class_type='delay' title='Delay' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='200' type='1' />
						<command class_type='sim' title='#' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Panel.Graphics.DrawCircle' >
							<argument exp='GetPenCoords[0]' />
							<argument exp='GetPenCoords[1]' />
							<argument exp='20' />
							<argument exp='20' />
						</command>
						<command class_type='output' title='Output' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' mode='1' port='1048580' mask='1' exp='0' />
						<command class_type='delay' title='Delay' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='200' type='1' />
						<command class_type='sim' title='Simulation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Panel.Graphics.DrawEnd' />
						<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
							<exp exp='Prev[0] = 0' />
							<exp exp='Prev[1] = 0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='XCW' description='' >
						<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='Stepper1' macro='IncrementStep' />
						<command class_type='delay' title='Delay' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='StepperDelay' type='0' />
