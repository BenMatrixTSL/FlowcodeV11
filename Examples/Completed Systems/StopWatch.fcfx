			<macros >
				<macro >
					<flowline name='Show_Time' description='' >
						<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='led_7seg_quad1' macro='ShowDigit' >
							<argument exp='0' />
							<argument exp='TimeMinsTens' />
							<argument exp='0' />
						</command>
						<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='led_7seg_quad1' macro='ShowDigit' >
							<argument exp='1' />
							<argument exp='TimeMinsUnits' />
							<argument exp='1' />
						</command>
						<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='led_7seg_quad1' macro='ShowDigit' >
							<argument exp='2' />
							<argument exp='TimeSecsTens' />
							<argument exp='0' />
						</command>
						<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='led_7seg_quad1' macro='ShowDigit' >
							<argument exp='3' />
							<argument exp='TimeSecsUnits' />
							<argument exp='0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='TMR0_INT' description='' >
						<command class_type='comment' title='' comment='When the timer is enabled by toggling StartFlag, the timer will
count 75 iterations, then reset and increment the seconds variable.
TMR0 interrupts at a rate of 75Hz, therefore TimeSecsUnits increments
at a rate approximately equal to that of 1 per second' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
						<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='StartFlag' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='TimerCount &lt; 75' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='TimerCount = TimerCount + 1' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='TimerCount = 0' />
											<exp exp='TimeSecsUnits = TimeSecsUnits + 1' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='' >
						<command class_type='comment' title='' comment='This program simulates a stopwatch through use of TMR0 to
keep track of time, and various controls in the form of 
hardware switches to manipulate the time-counting variables.' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
						<command class_type='interrupt' title='Interrupt' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' enable='1' name='TMR0' call='TMR0_INT' >
							<settings timer='1' prescale='16' postscale='-1' rollover='-1' bitcount='-1' trigger='3' maskhi='--------------------------------------------------------------------------------------------------------------------------------------------------------------------------8' masklo='--------------------------------------------------------------------------------------------------------------------------------------------------------------------------8' >
								<option value='1' />
								<option value='0' />
								<option value='4' />
								<option value='-1' />
							</settings>
						</command>
						<command class_type='call' title='Call Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Show_Time' />
						<command class_type='loop' title='Loop' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='1' type='0' start='1' count='1' breakend='0' >
							<flowline >
								<command class_type='comment' title='' comment='Pressing the start/stop switch toggles a flag
that enables or disables the counter for increments
of time within the program.
See TMR0_INT macro for where &apos;StartFlag&apos; is used.' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
								<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='sw_push_pcb1' macro='ReadState' >
									<return exp='StartStop' />
								</command>
								<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='StartStop' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='StartFlag' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='StartFlag = false' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='StartFlag = true' />
												</command>
											</flowline>
										</command>
										<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='sw_push_pcb1' macro='WaitUntilLow' />
									</flowline>
									<flowline />
								</command>
								<command class_type='comment' title='' comment='Pressing the reset switch resets all variables used
for keeping time.' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
								<command class_type='call' title='Call Component Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='sw_push_pcb2' macro='ReadState' >
									<return exp='Reset' />
								</command>
								<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='Reset' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='TimerCount = 0' />
											<exp exp='TimeMinsTens = 0' />
											<exp exp='TimeMinsUnits = 0' />
											<exp exp='TimeSecsTens = 0' />
											<exp exp='TimeSecsUnits = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='comment' title='' comment='When the variables accounting for current time overflow
(for example when &apos;TimeSecsUnits&apos; reaches a value of 10)
the program must reset that variable and increment the next
variable. This section of the program does that prior to
displaying the current time.' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
								<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='TimeSecsUnits &gt; 9' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='TimeSecsUnits = 0' />
											<exp exp='TimeSecsTens = TimeSecsTens + 1' />
										</command>
										<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='TimeSecsTens &gt; 5' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
													<exp exp='TimeSecsTens = 0' />
													<exp exp='TimeMinsUnits = TimeMinsUnits + 1' />
												</command>
												<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='TimeMinsUnits &gt; 9' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
															<exp exp='TimeMinsUnits = 0' />
															<exp exp='TimeMinsTens = TimeMinsTens + 1' />
														</command>
														<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='TimeMinsTens &gt; 5' swap='0' >
															<flowline >
																<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
																	<exp exp='TimeMinsTens = 0' />
																</command>
															</flowline>
															<flowline />
														</command>
													</flowline>
													<flowline />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Call Macro' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Show_Time' />
							</flowline>
						</command>
					</flowline>
				</macro>
			</macros>
