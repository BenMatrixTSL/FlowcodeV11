							<exp exp='.index = 0' />
							<exp exp='.divider = 1' />
						</command>
						<command class_type='loop' title='Loop' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='.index &lt; 4' type='0' start='1' count='1' breakend='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='.number = round (.value / .divider)' />
									<exp exp='.value = .value - (.number * .divider)' />
									<exp exp='.divider = .divider / 10' />
								</command>
								<command class_type='decision' title='Decision' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='.index = 0' swap='0' >
