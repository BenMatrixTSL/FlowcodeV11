			<macros >
				<macro >
					<flowline name='TMR_INT' description='' >
						<command class_type='calculation' title='Increment Interrupt Count' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
							<exp exp='count = count + 1' />
						</command>
						<command class_type='decision' title='75 Interrupts in 1 Sec @ 19.6608MHz' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='count &lt; 75' swap='1' >
							<flowline >
								<command class_type='calculation' title='Set flag to allow LCD to update' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='update_display = 1' />
								</command>
								<command class_type='calculation' title='Store count variable into Display copy' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
									<exp exp='Display_Freq = freq' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='' >
						<command class_type='comment' title='' comment='Prints out the freqency of 
pulses incoming to the pin 
specified in macro Read_Input

Max Input freq approx 32000Hz

This can be simulated by pressing the SMT switch in the system panel
during simulation' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
						<command class_type='call' title='Init LCD' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='lcd_eb005' macro='Start' />
						<command class_type='calculation' title='Init Counters' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
							<exp exp='freq = 0' />
							<exp exp='count = 0' />
							<exp exp='update_display = 0' />
						</command>
						<command class_type='call' title='Init In Variable' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' macro='Read_input' />
						<command class_type='interrupt' title='Start Interrupt' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' enable='1' name='TMR0' call='TMR_INT' >
							<settings timer='1' prescale='256' postscale='-1' rollover='-1' bitcount='-1' trigger='3' maskhi='--------------------------------------------------------------------------------------------------------------------------------------------------------------------------8' masklo='--------------------------------------------------------------------------------------------------------------------------------------------------------------------------8' >
								<option value='1' />
								<option value='0' />
								<option value='8' />
								<option value='-1' />
							</settings>
						</command>
						<command class_type='loop' title='Main Loop' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='1' type='0' start='1' count='1' breakend='0' >
							<flowline >
								<command class_type='decision' title='Is the count ready to display?' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='update_display' swap='0' >
									<flowline >
										<command class_type='call' title='Init Cursor' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='lcd_eb005' macro='Cursor' >
