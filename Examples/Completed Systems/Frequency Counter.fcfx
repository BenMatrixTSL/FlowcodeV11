											<argument exp='&quot;Freq = &quot;' />
										</command>
										<command class_type='call' title='Output Frequency' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='lcd_eb005' macro='PrintNumber' >
											<argument exp='Display_Freq' />
										</command>
										<command class_type='call' title='Output Units' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' component='lcd_eb005' macro='PrintString' >
											<argument exp='&quot; Hz   &quot;' />
										</command>
										<command class_type='calculation' title='Reset Counters' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
											<exp exp='freq = 0' />
											<exp exp='count = 0' />
											<exp exp='update_display = 0' />
										</command>
										<command class_type='native' title='Reset Timer Count register to 0' comment='' ccode='tmr0 = 0x00;
' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' language='C' />
									</flowline>
									<flowline >
