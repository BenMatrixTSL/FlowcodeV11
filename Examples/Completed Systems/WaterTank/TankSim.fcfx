			<macros >
				<macro >
					<flowline name='Ev_Timer' description='Called back on the panel command System.TimerStart' >
						<return name='Return' type='u32' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<param name='TimerID' type='u32' description='The identifier passed to the System.TimerStart panel command' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='calc' type='f32' description='' isconst='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='calc2' type='f32' description='' isconst='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='temp_buton' type='u8' description='' isconst='0' isinit='1' usrinit='0' setinit='0' />
						<local name='pwr_switch' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='Decision' exp='inlet_flow &gt; 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='(Water_Level + inlet_flow) &lt; capacity' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='Water_Level = (Water_Level + inlet_flow)' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.calc = FLOAT inlet_flow / Water_Level' />
											<exp exp='water_temp = ((1 - .calc) * water_temp) + (.calc * inlet_temp)' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='Water_Level = capacity' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='outlet_flow &gt; 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='Water_Level &gt; outlet_flow' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='Water_Level = (Water_Level - outlet_flow)' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='Water_Level = 0' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Call Macro' macro='Set_Sim_Water_Level' />
						<command class_type='decision' title='Decision' exp='heater_control' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.calc = heater_power' />
									<exp exp='.calc2 = Water_Level' />
									<exp exp='.calc = .calc / .calc2' />
									<exp exp='water_temp = water_temp + .calc' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.calc = 1.0 / Water_Level' />
									<exp exp='water_temp = (water_temp * (1.0 - .calc)) + (.calc * room_temp)' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' exp='water_temp &lt; outlet_temp' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='water_temp &lt; inlet_temp' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='water_colour = 0xFF0000' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.calc = outlet_temp - inlet_temp' />
											<exp exp='.calc = .calc / 256' />
											<exp exp='.calc2 = water_temp - inlet_temp' />
											<exp exp='.calc2 = .calc2 / .calc' />
											<exp exp='water_colour = 255 - float2int (.calc2)' />
											<exp exp='water_colour = water_colour &lt;&lt; 16' />
											<exp exp='water_colour = water_colour | float2int (.calc2)' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='water_colour = 0x0000FF' />
								</command>
							</flowline>
						</command>
						<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
							<argument exp='Water' />
							<argument exp='&quot;Color&quot;' />
							<argument exp='water_colour' />
						</command>
						<command class_type='sim' title='Call Macro' component='water_meter' macro='SetValue' >
							<argument exp='Water_Level' />
						</command>
						<command class_type='sim' title='Call Macro' component='temp_meter' macro='SetValue' >
							<argument exp='Water_temp' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='litres_in = litres_in + inlet_flow' />
							<exp exp='litres_out = litres_out + outlet_flow' />
							<exp exp='power = power + (heater_power * heater_control)' />
						</command>
						<command class_type='call' title='Call Macro' component='dash_button' macro='ReadState' >
							<return exp='.temp_buton' />
						</command>
						<command class_type='sim' title='Simulation' macro='Debug.PrintLn' >
							<argument exp='.temp_buton' />
						</command>
						<command class_type='decision' title='Decision' exp='.temp_buton != 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='last_power = power' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
							<argument exp='readout' />
							<argument exp='&quot;Text&quot;' />
							<argument exp='&quot;Energy:&quot; + ToString$ (power - last_power) + &quot; J&quot;' />
						</command>
						<command class_type='sim' title='Call Macro' component='temp_knob' macro='GetValue' >
							<return exp='.calc' />
						</command>
						<command class_type='decision' title='Decision' exp='.calc &gt; inlet_temp' swap='0' >
							<flowline >
								<command class_type='call' title='Call Macro' macro='Set_Required_Water_Temp' >
									<argument exp='.calc' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='sim' title='Call Macro' component='temp_meter' macro='SetRange' >
							<argument exp='inlet_temp' />
							<argument exp='outlet_temp' />
						</command>
						<command class_type='sim' title='Restart Sim Timer Running' macro='System.TimerStart' >
							<argument exp='0' />
							<argument exp='200' />
						</command>
						<command class_type='call' title='Simulation' macro='Get_Empty_Sensor' />
						<command class_type='call' title='Simulation' macro='Get_Full_Sensor' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Set_Heater_Off' description='Switches on the tank heater element' >
						<command class_type='calculation' title='Calc' >
							<exp exp='heater_control = 0' />
						</command>
						<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
							<argument exp='element' />
							<argument exp='&quot;Color&quot;' />
							<argument exp='0x808080' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Set_Sim_Water_Level' description='Animates the level of the water in the simulation' >
						<local name='Water_Handle' type='h32' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='calc' type='f32' description='' isconst='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='calc2' type='f32' description='' isconst='0' isinit='0' usrinit='0.0' setinit='' />
						<command class_type='sim' title='Call Macro' macro='Panel.Position.Get' >
							<return exp='.Water_Handle' />
							<argument exp='Water' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.calc = Water_Level' />
							<exp exp='.calc2 = capacity' />
							<exp exp='.calc = .calc / .calc2' />
							<exp exp='.calc = .calc * 58.0' />
						</command>
						<command class_type='sim' title='Call Macro' macro='Panel.Position.SetScale' >
							<argument exp='.Water_Handle' />
							<argument exp='Water' />
						</command>
						<command class_type='sim' title='Call Macro' macro='Panel.Position.ScaleTo' >
							<argument exp='.Water_Handle' />
							<argument exp='32' />
							<argument exp='32' />
							<argument exp='.calc' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.calc = (.calc / 2.0) + 5.0' />
						</command>
						<command class_type='sim' title='Call Macro' macro='Panel.Position.MoveTo' >
							<argument exp='.Water_Handle' />
							<argument exp='0.0' />
							<argument exp='0.0' />
							<argument exp='.calc' />
						</command>
						<command class_type='sim' title='Call Macro' macro='Panel.Position.Animate' >
							<argument exp='Water' />
							<argument exp='Water' />
							<argument exp='.Water_Handle' />
							<argument exp='200' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Stop' description='Broadcast to all components that simulation has stopped' >
						<return name='Return' type='u32' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Start Sim Timer Running' macro='System.TimerStop' >
							<argument exp='0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Set_Outlet_Flowrate' description='Specifies the rate of outlet flow' >
						<param name='Rate' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='anim_end' type='h32' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='anim_start' type='h32' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Simulation' macro='Panel.Position.Get' >
							<return exp='.anim_start' />
							<argument exp='out_wheel' />
						</command>
						<command class_type='sim' title='Simulation' macro='Panel.Position.Get' >
							<return exp='.anim_end' />
							<argument exp='out_wheel' />
						</command>
						<command class_type='calculation' title='Calc' >
							<exp exp='outlet_flow = .Rate' />
						</command>
						<command class_type='decision' title='Decision' exp='.Rate' swap='0' >
							<flowline >
								<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
									<argument exp='pipe_out' />
									<argument exp='&quot;Color&quot;' />
									<argument exp='water_colour' />
								</command>
								<command class_type='sim' title='Simulation' macro='Panel.Position.RotateTo' >
									<argument exp='.anim_start' />
									<argument exp='.anim_start' />
									<argument exp='.anim_start' />
									<argument exp='0' />
									<argument exp='-90' />
									<argument exp='0' />
								</command>
								<command class_type='sim' title='Simulation' macro='Panel.Position.RotateTo' >
									<argument exp='.anim_end' />
									<argument exp='.anim_end' />
									<argument exp='.anim_end' />
									<argument exp='0' />
									<argument exp='0' />
									<argument exp='0' />
								</command>
							</flowline>
							<flowline >
								<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
									<argument exp='pipe_out' />
									<argument exp='&quot;Color&quot;' />
									<argument exp='0x505050' />
								</command>
								<command class_type='sim' title='Simulation' macro='Panel.Position.RotateTo' >
									<argument exp='.anim_start' />
									<argument exp='.anim_start' />
									<argument exp='.anim_start' />
									<argument exp='0' />
									<argument exp='0' />
									<argument exp='0' />
								</command>
								<command class_type='sim' title='Simulation' macro='Panel.Position.RotateTo' >
									<argument exp='.anim_end' />
									<argument exp='.anim_end' />
									<argument exp='.anim_end' />
									<argument exp='0' />
									<argument exp='-90' />
									<argument exp='0' />
								</command>
							</flowline>
						</command>
						<command class_type='sim' title='Simulation' macro='Panel.Position.Animate' >
							<argument exp='out_wheel' />
							<argument exp='.anim_start' />
							<argument exp='.anim_end' />
							<argument exp='500' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Set_Inlet_Flowrate' description='Specifies the rate of inlet flow' >
						<param name='Rate' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='anim_start' type='h32' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='anim_end' type='h32' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Simulation' macro='Panel.Position.Get' >
							<return exp='.anim_start' />
							<argument exp='in_wheel' />
						</command>
						<command class_type='sim' title='Simulation' macro='Panel.Position.Get' >
							<return exp='.anim_end' />
							<argument exp='in_wheel' />
						</command>
						<command class_type='calculation' title='Calc' >
							<exp exp='inlet_flow = .Rate' />
						</command>
						<command class_type='decision' title='Decision' exp='.Rate' swap='0' >
							<flowline >
								<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
									<argument exp='pipe_in' />
									<argument exp='&quot;Color&quot;' />
									<argument exp='.Rate &lt;&lt; 16' />
								</command>
								<command class_type='sim' title='Simulation' macro='Panel.Position.RotateTo' >
									<argument exp='.anim_start' />
									<argument exp='.anim_start' />
									<argument exp='.anim_start' />
									<argument exp='0' />
									<argument exp='-180' />
									<argument exp='0' />
								</command>
								<command class_type='sim' title='Simulation' macro='Panel.Position.RotateTo' >
									<argument exp='.anim_end' />
									<argument exp='.anim_end' />
									<argument exp='.anim_end' />
									<argument exp='0' />
									<argument exp='-90' />
									<argument exp='0' />
								</command>
							</flowline>
							<flowline >
								<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
									<argument exp='pipe_in' />
									<argument exp='&quot;Color&quot;' />
									<argument exp='0x505050' />
								</command>
								<command class_type='sim' title='Simulation' macro='Panel.Position.RotateTo' >
									<argument exp='.anim_start' />
									<argument exp='.anim_start' />
									<argument exp='.anim_start' />
									<argument exp='0' />
									<argument exp='-90' />
									<argument exp='0' />
								</command>
								<command class_type='sim' title='Simulation' macro='Panel.Position.RotateTo' >
									<argument exp='.anim_end' />
									<argument exp='.anim_end' />
									<argument exp='.anim_end' />
									<argument exp='0' />
									<argument exp='-180' />
									<argument exp='0' />
								</command>
							</flowline>
						</command>
						<command class_type='sim' title='Simulation' macro='Panel.Position.Animate' >
							<argument exp='in_wheel' />
							<argument exp='.anim_start' />
							<argument exp='.anim_end' />
							<argument exp='500' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Get_Empty_Sensor' description='Returns the value of the sensor at the bottom of the tank.' >
						<return name='Return' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='anim_start' type='h32' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='anim_end' type='h32' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Call Macro' macro='Panel.Collision.GetSingleAxis' >
							<return exp='.Return' />
							<argument exp='Water' />
							<argument exp='empty_test' />
							<argument exp='0.0' />
							<argument exp='0.0' />
							<argument exp='0.0' />
							<argument exp='this' />
						</command>
						<command class_type='decision' title='Decision' exp='.Return == true' swap='0' >
							<flowline >
								<command class_type='sim' title='Simulation' macro='Panel.Position.RotateTo' >
									<argument exp='empty_sense' />
									<argument exp='hinge1' />
									<argument exp='hinge1' />
									<argument exp='0' />
									<argument exp='-10' />
									<argument exp='0' />
								</command>
							</flowline>
							<flowline >
								<command class_type='sim' title='Simulation' macro='Panel.Position.RotateTo' >
									<argument exp='empty_sense' />
									<argument exp='hinge1' />
									<argument exp='hinge1' />
									<argument exp='0' />
									<argument exp='0' />
									<argument exp='0' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Set_Heater_On' description='Switches on the tank heater element' >
						<command class_type='calculation' title='Calc' >
							<exp exp='heater_control = 1' />
						</command>
						<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
							<argument exp='element' />
							<argument exp='&quot;Color&quot;' />
							<argument exp='0x0000FF' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Get_Water_Temp' description='Returns the current water temperature.' >
						<return name='Return' type='f32' description='' isconst='0' isinit='0' usrinit='0.0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = water_temp' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Start' description='Broadcast to all components that simulation is starting' >
						<return name='Return' type='u32' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Start Sim Timer Running' macro='System.TimerStart' >
							<argument exp='0' />
							<argument exp='400' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Set_Required_Water_Temp' description='' >
						<param name='Required_Temperature' type='f32' description='' isconst='0' isinit='0' usrinit='0.0' setinit='' />
						<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
							<argument exp='this' />
							<argument exp='&quot;outlet_temp&quot;' />
							<argument exp='.Required_Temperature' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='To run simulation, open the dashboard panel by selecting it in the menu &quot;View --&gt; Dashboard Panel&quot;

Then run the simulation, and press the RUN switch to start the water heater tank' >
						<local name='temp_handle' type='h32' description='' isconst='0' isinit='1' usrinit='0' setinit='0' />
						<local name='temp_size' type='f32' description='' isconst='0' isinit='0' usrinit='0.0' setinit='' >
							<array size='3' />
						</local>
						<local name='calc' type='f32' description='' isconst='0' isinit='1' usrinit='20.0' setinit='20.0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='last_power = 0' />
						</command>
						<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
							<argument exp='readout' />
							<argument exp='&quot;Text&quot;' />
							<argument exp='&quot;Energy: 000 J&quot;' />
						</command>
						<command class_type='sim' title='Call Macro' component='temp_knob' macro='GetValue' >
							<return exp='.calc' />
						</command>
						<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
							<argument exp='this' />
							<argument exp='&quot;outlet_temp&quot;' />
							<argument exp='.calc' />
						</command>
						<command class_type='comment' title='' comment='Dummy label pending text component change' textarea='12,0,12,0' />
						<command class_type='call' title='Simulation' component='drain_lamp' macro='TurnOff' />
						<command class_type='call' title='Simulation' component='fill_lamp' macro='TurnOff' />
						<command class_type='call' title='Simulation' component='heat_lamp' macro='TurnOff' />
						<command class_type='call' title='Simulation' component='dash_switch' macro='WaitUntilHigh' />
						<command class_type='comment' title='' comment='Start of Ben&apos;s code' textarea='12,0,12,0' />
						<command class_type='sim' title='Call Macro' component='water_meter' macro='SetLabel' >
							<argument exp='&quot;Level&quot;' />
						</command>
						<command class_type='sim' title='Call Macro' component='water_meter' macro='SetRange' >
							<argument exp='0' />
							<argument exp='capacity' />
						</command>
						<command class_type='sim' title='Call Macro' component='temp_meter' macro='SetLabel' >
							<argument exp='&quot;Temp&quot;' />
						</command>
						<command class_type='loop' title='Loop' exp='1' type='0' start='1' count='1' breakend='0' >
							<flowline >
								<command class_type='call' title='Simulation' component='dash_switch' macro='WaitUntilHigh' />
								<command class_type='call' title='Call Macro' macro='Set_Heater_On' />
								<command class_type='call' title='Simulation' component='heat_lamp' macro='TurnOn' />
								<command class_type='loop' title='Loop' exp='Test &lt; outlet_temp' type='0' start='0' count='1' breakend='0' >
									<flowline >
										<command class_type='call' title='Call Macro' macro='Get_Water_Temp' >
											<return exp='Test' />
										</command>
									</flowline>
								</command>
								<command class_type='call' title='Simulation' component='heat_lamp' macro='TurnOff' />
								<command class_type='call' title='Call Macro' macro='Set_Heater_Off' />
								<command class_type='call' title='Call Macro' macro='Set_Outlet_Flowrate' >
									<argument exp='255' />
								</command>
								<command class_type='call' title='Simulation' component='drain_lamp' macro='TurnOn' />
								<command class_type='loop' title='Loop' exp='TestByte' type='0' start='0' count='1' breakend='0' >
									<flowline >
										<command class_type='call' title='Call Macro' macro='Get_Empty_Sensor' >
											<return exp='TestByte' />
										</command>
									</flowline>
								</command>
								<command class_type='call' title='Simulation' component='drain_lamp' macro='TurnOff' />
								<command class_type='call' title='Call Macro' macro='Set_Outlet_Flowrate' >
									<argument exp='0' />
								</command>
								<command class_type='call' title='Call Macro' macro='Set_Inlet_Flowrate' >
									<argument exp='255' />
								</command>
								<command class_type='call' title='Simulation' component='fill_lamp' macro='TurnOn' />
								<command class_type='loop' title='Loop' exp='TestByte = 0' type='0' start='0' count='1' breakend='0' >
									<flowline >
										<command class_type='call' title='Call Macro' macro='Get_Full_Sensor' >
											<return exp='TestByte' />
										</command>
									</flowline>
								</command>
								<command class_type='call' title='Simulation' component='fill_lamp' macro='TurnOff' />
								<command class_type='call' title='Call Macro' macro='Set_Inlet_Flowrate' >
									<argument exp='0' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Get_Full_Sensor' description='Returns the value of the sensor at the top of the tank.' >
						<return name='Return' type='u8' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='anim_start' type='h32' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<local name='anim_end' type='h32' description='' isconst='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Call Macro' macro='Panel.Collision.GetSingleAxis' >
							<return exp='.Return' />
							<argument exp='Water' />
							<argument exp='full_test' />
							<argument exp='0.0' />
							<argument exp='0.0' />
							<argument exp='0.0' />
							<argument exp='this' />
						</command>
						<command class_type='decision' title='Decision' exp='.Return == true' swap='0' >
							<flowline >
								<command class_type='sim' title='Simulation' macro='Panel.Position.RotateTo' >
									<argument exp='full_sense' />
									<argument exp='hinge2' />
									<argument exp='hinge2' />
									<argument exp='0' />
									<argument exp='-10' />
									<argument exp='0' />
								</command>
							</flowline>
							<flowline >
								<command class_type='sim' title='Simulation' macro='Panel.Position.RotateTo' >
									<argument exp='full_sense' />
									<argument exp='hinge2' />
									<argument exp='hinge2' />
									<argument exp='0' />
									<argument exp='0' />
									<argument exp='0' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
			</macros>
