				</variable>
				<variable public='0' >
					<def class_type='variable' name='Water_Level' type='u32' description='' isconst='0' isinit='1' usrinit='2000' setinit='2000' />
				</variable>
				<variable public='0' >
					<def class_type='variable' name='water_colour' type='u32' description='' isconst='0' isinit='1' usrinit='16711680' setinit='0xFF0000' />
				</variable>
