			<macros >
				<macro >
					<flowline name='draw_grid' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='xline = 0' />
							<exp exp='yline = 0' />
							<exp exp='' />
						</command>
						<command class_type='call' title='Component Macro' component='gLCD_EB3' macro='SetForegroundColour' >
							<argument exp='128' />
							<argument exp='128' />
							<argument exp='128' />
						</command>
						<command class_type='loop' title='Loop' type='1' exp='xline &gt; Maxx' >
							<flowline >
								<command class_type='call' title='Component Macro' component='gLCD_EB3' macro='DrawLine' >
									<argument exp='xline' />
									<argument exp='yline' />
									<argument exp='xline' />
									<argument exp='yline + maxy' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='xline = xline + 50' />
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='xline = 0' />
							<exp exp='yline = 50' />
						</command>
						<command class_type='loop' title='Loop' type='1' exp='yline &gt; Maxy' >
							<flowline >
								<command class_type='call' title='Component Macro' component='gLCD_EB3' macro='DrawLine' >
									<argument exp='xline' />
									<argument exp='yline' />
									<argument exp='xline +Maxx' />
									<argument exp='yline' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='yline = yline + 50' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='UpdateTime' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='time = tostring$(Hours) + &quot; : &quot; + tostring$(Minutes)' />
						</command>
						<command class_type='call' title='Component Macro' component='settime_field' macro='SetTextLabel' >
							<argument exp='time' />
						</command>
						<command class_type='decision' title='Decision' exp='adjust_ontime' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='program_on_hours[Program_to_adjust] = Hours' />
									<exp exp='program_on_minutes[Program_to_adjust] = Minutes' />
									<exp exp='time = tostring$(program_on_hours[Program_to_adjust]) + &quot; : &quot; + tostring$(program_on_minutes[Program_to_adjust])' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='adjust_offtime' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='program_off_hours[Program_to_adjust] = Hours' />
									<exp exp='program_off_minutes[Program_to_adjust] = Minutes' />
									<exp exp='time = tostring$(program_off_hours[Program_to_adjust]) + &quot; : &quot; + tostring$(program_off_minutes[Program_to_adjust])' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetTemperatureScreen' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='call' title='Component Macro' component='DisplayManager1' macro='ClearAll' >
							<argument exp='1' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='system_temperature = system_temperature + 1' />
							<exp exp='slider_FLOAT = FLOAT (system_temperature) / 100' />
						</command>
						<command class_type='call' title='User Macro' macro='updateTemperature' />
						<command class_type='calculation' title='Store the current Screen index' >
							<exp exp='OldScreen = Next_screen' />
						</command>
						<command class_type='comment' title='' comment='if this is a program adjust trap it here.' textarea='12,0,12,0' />
						<command class_type='loop' title='Loop here until screen changes' type='0' exp='Next_screen = OldScreen' >
							<flowline >
								<command class_type='delay' title='Delay' exp='10' type='1' />
								<command class_type='call' title='Check for touch' component='FT6X06' macro='SampleSensor' >
									<return exp='Touch' />
								</command>
								<command class_type='decision' title='Touch Detected?' exp='Touch' swap='0' >
									<flowline >
										<command class_type='call' title='Component Macro' component='FT6X06' macro='ReadCoord' >
											<return exp='X' />
											<argument exp='0' />
											<argument exp='0' />
										</command>
										<command class_type='call' title='Component Macro' component='FT6X06' macro='ReadCoord' >
											<return exp='Y' />
											<argument exp='1' />
											<argument exp='0' />
										</command>
										<command class_type='call' title='check to see if display is touched' component='DisplayManager1' macro='CheckForTouch' >
											<return exp='TouchedObjectID' />
											<argument exp='X' />
											<argument exp='Y' />
										</command>
										<command class_type='decision' title='if valid object touched' exp='TouchedObjectID' swap='0' >
											<flowline >
												<command class_type='decision' title='Decision' exp='TouchedObjectID = temperature_widgetID' swap='0' >
													<flowline >
														<command class_type='call' title='Component Macro' component='DisplayManager1' macro='GetSliderValue' >
															<return exp='slider_FLOAT' />
															<argument exp='temperature_widgetID' />
														</command>
														<command class_type='calculation' title='Calculation' >
															<exp exp='temperature_BYTE = slider_FLOAT * 100' />
															<exp exp='system_temperature = temperature_BYTE' />
														</command>
														<command class_type='call' title='User Macro' macro='updateTemperature' />
													</flowline>
													<flowline />
												</command>
												<command class_type='decision' title='Decision' exp='TouchedObjectID = Increase_buttonID' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='system_temperature = system_temperature + 1' />
															<exp exp='slider_FLOAT = FLOAT (system_temperature) / 100' />
														</command>
														<command class_type='decision' title='Check value is in range' exp='system_temperature &gt; 100' swap='0' >
															<flowline >
																<command class_type='calculation' title='Calculation' >
																	<exp exp='system_temperature = 100' />
																</command>
															</flowline>
															<flowline />
														</command>
														<command class_type='call' title='Component Macro' component='DisplayManager1' macro='SetSliderValue' >
															<argument exp='temperature_widgetID' />
															<argument exp='slider_FLOAT' />
															<argument exp='1' />
														</command>
														<command class_type='call' title='User Macro' macro='updateTemperature' />
													</flowline>
													<flowline />
												</command>
												<command class_type='decision' title='Decision' exp='TouchedObjectID = Decrease_buttonID' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='system_temperature = system_temperature - 1' />
															<exp exp='slider_FLOAT = FLOAT (system_temperature) / 100' />
														</command>
														<command class_type='decision' title='Check value is in range' exp='system_temperature &lt; 0' swap='0' >
															<flowline >
																<command class_type='calculation' title='Calculation' >
																	<exp exp='system_temperature = 0' />
																</command>
															</flowline>
															<flowline />
														</command>
														<command class_type='call' title='Component Macro' component='DisplayManager1' macro='SetSliderValue' >
															<argument exp='temperature_widgetID' />
															<argument exp='slider_FLOAT' />
															<argument exp='1' />
														</command>
														<command class_type='call' title='User Macro' macro='updateTemperature' />
													</flowline>
													<flowline />
												</command>
												<command class_type='decision' title='Decision' exp='TouchedObjectID = HomebuttonID' swap='0' >
													<flowline >
														<command class_type='calculation' title='Home Screen' >
															<exp exp='Next_screen = Home_screen' />
														</command>
													</flowline>
													<flowline />
												</command>
												<command class_type='decision' title='Decision' exp='TouchedObjectID = BackButtonID' swap='0' >
													<flowline >
														<command class_type='calculation' title='Menu Screen' >
															<exp exp='Next_screen = Menu_screen' />
														</command>
														<command class_type='decision' title='' exp='screen_after_variable_adjustment &lt;&gt; 0' swap='0' >
															<flowline >
																<command class_type='calculation' title='Menu Screen' >
																	<exp exp='Next_screen = Program_screen' />
																</command>
															</flowline>
															<flowline />
														</command>
													</flowline>
													<flowline />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
									<flowline >
										<command class_type='comment' title='' comment='Call NoTouch to clear repeat rate counter' textarea='12,0,12,0' />
										<command class_type='call' title='No touch detected' component='DisplayManager1' macro='NoTouch' />
									</flowline>
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='adjust_temperature = 0' />
							<exp exp='' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='TouchHandler_ChangeScene' description='Optional macro called by the DisplayManager::CheckForTouch component macro when the defined area is touched' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Handle' type='h32' description='The handle of the component that was clicked' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='sed1' type='u32' description='not used' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='sed2' type='f32' description='not used' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<param name='sed3' type='T8' description='not used' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='.Handle' >
							<case >
								<flowline >
									<command class_type='call' title='Draw Home Screen' component='DisplayManager1' macro='DrawScene' >
										<argument exp='0' />
									</command>
								</flowline>
							</case>
							<case exp='Btn_Menu' >
								<flowline >
									<command class_type='call' title='Draw Menu Screen' component='DisplayManager1' macro='DrawScene' >
										<argument exp='2' />
									</command>
								</flowline>
							</case>
							<case exp='Btn_SetTime' >
								<flowline >
									<command class_type='call' title='Draw SetDate Screen' component='DisplayManager1' macro='DrawScene' >
										<argument exp='3' />
									</command>
								</flowline>
							</case>
							<case exp='Btn_SetDate' >
								<flowline >
									<command class_type='call' title='Draw SetDate Screen' component='DisplayManager1' macro='DrawScene' >
										<argument exp='1' />
									</command>
									<command class_type='call' title='User Macro' macro='UpdateDate' />
								</flowline>
							</case>
							<case exp='Btn_Program' >
								<flowline />
							</case>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='updateTemperature' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='temperature_string = tostring$(system_temperature)' />
						</command>
						<command class_type='call' title='Component Macro' component='Temperature_field' macro='SetTextNumber' >
							<argument exp='system_temperature' />
							<argument exp='&quot;C&quot;' />
						</command>
						<command class_type='decision' title='Decision' exp='adjust_temperature' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='program_temperature[Program_to_adjust] = system_temperature' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='TouchHandler_SetTime' description='Optional macro called by the DisplayManager::CheckForTouch component macro when the defined area is touched' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Handle' type='h32' description='The handle of the component that was clicked' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='sed1' type='u32' description='not used' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='sed2' type='f32' description='not used' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<param name='sed3' type='T8' description='not used' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='.Handle' >
							<case >
								<flowline />
							</case>
							<case exp='Btn_ST_Back' >
								<flowline >
									<command class_type='call' title='Draw Menu Screen' component='DisplayManager1' macro='DrawScene' >
										<argument exp='2' />
									</command>
								</flowline>
							</case>
							<case exp='Btn_ST_HourUp' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='Hours = Hours + 1' />
									</command>
									<command class_type='decision' title='Check value is in range' exp='Hours = 24' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='Hours = 0' />
											</command>
										</flowline>
										<flowline />
									</command>
									<command class_type='call' title='User Macro' macro='UpdateTime' />
								</flowline>
							</case>
							<case exp='Btn_ST_HourDown' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='Hours = Hours - 1' />
									</command>
									<command class_type='decision' title='Check value is in range' exp='Hours = 0' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='Hours = 23' />
											</command>
										</flowline>
										<flowline />
									</command>
									<command class_type='call' title='User Macro' macro='UpdateTime' />
								</flowline>
							</case>
							<case exp='Btn_ST_MinUp' >
								<flowline >
									<command class_type='decision' title='Check value is in range' exp='Minutes = 59' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='Minutes = 0' />
											</command>
										</flowline>
										<flowline />
									</command>
									<command class_type='calculation' title='Calculation' >
										<exp exp='Minutes = Minutes + 1' />
									</command>
									<command class_type='call' title='User Macro' macro='UpdateTime' />
								</flowline>
							</case>
							<case exp='Btn_ST_MinDown' >
								<flowline >
									<command class_type='decision' title='Check value is in range' exp='Minutes = 0' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='Minutes = 59' />
											</command>
										</flowline>
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='Minutes = Minutes - 1' />
											</command>
										</flowline>
									</command>
									<command class_type='call' title='User Macro' macro='UpdateTime' />
								</flowline>
							</case>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='UpdateDate' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='Date = tostring$(days) + &quot;/&quot; + tostring$(Months) + &quot;/&quot; + tostring$(Years)' />
						</command>
						<command class_type='call' title='Component Macro' component='DC_Text3' macro='SetTextLabel' >
							<argument exp='&quot;sddfasdf&quot;' />
						</command>
						<command class_type='call' title='Component Macro' component='date_field' macro='SetTextLabel' >
							<argument exp='Date' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ProgramScreen' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='comment' title='' comment='SET UP THE DISPLAY' textarea='12,0,12,0' />
						<command class_type='call' title='Component Macro' component='DisplayManager1' macro='ClearAll' >
							<argument exp='1' />
						</command>
						<command class_type='call' title='Component Macro' component='gLCD_EB3' macro='SetForegroundColour' >
							<argument exp='GoldR' />
							<argument exp='GoldG' />
							<argument exp='GoldB' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='adjust_offtime = 0' />
							<exp exp='adjust_offtime = 0' />
							<exp exp='program_count = 0' />
						</command>
						<command class_type='calculation' title='Store the current Screen index' >
							<exp exp='OldScreen = next_screen' />
						</command>
						<command class_type='loop' title='Loop here until screen changes' type='0' exp='Next_screen = OldScreen' >
							<flowline >
								<command class_type='delay' title='debounce' exp='10' type='1' />
								<command class_type='call' title='Check for touch' component='FT6X06' macro='SampleSensor' >
									<return exp='Touch' />
								</command>
								<command class_type='decision' title='Touch Detected?' exp='Touch' swap='0' >
									<flowline >
										<command class_type='call' title='Component Macro' component='FT6X06' macro='ReadCoord' >
											<return exp='X' />
											<argument exp='0' />
											<argument exp='0' />
										</command>
										<command class_type='call' title='Component Macro' component='FT6X06' macro='ReadCoord' >
											<return exp='Y' />
											<argument exp='1' />
											<argument exp='0' />
										</command>
										<command class_type='call' title='check to see if display is touched' component='DisplayManager1' macro='CheckForTouch' >
											<return exp='TouchedObjectID' />
											<argument exp='X' />
											<argument exp='Y' />
										</command>
										<command class_type='decision' title='if valid object touched' exp='TouchedObjectID' swap='0' >
											<flowline >
												<command class_type='comment' title='' comment='Find out which object was pressed
cycle through the arrays of touchIDs until there is a match
' textarea='12,0,12,0' />
												<command class_type='decision' title='Decision' exp='TouchedObjectID' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='program_count = 0' />
														</command>
														<command class_type='loop' title='test for an ontime widget pressed' type='0' exp='program_count &lt; 6' >
															<flowline >
																<command class_type='decision' title='Decision' exp='TouchedObjectID = program_ontime_touchID[program_count]' swap='0' >
																	<flowline >
																		<command class_type='calculation' title='set up next screen to be ontime adjust' >
																			<exp exp='Next_screen = Set_time_screen' />
																			<exp exp='screen_after_variable_adjustment = Program_screen' />
																			<exp exp='adjust_ontime = 1' />
																			<exp exp='Program_to_adjust = program_count' />
																			<exp exp='Hours = program_on_hours[program_count]' />
																			<exp exp='Minutes = program_on_minutes[program_count]' />
																		</command>
																	</flowline>
																	<flowline />
																</command>
																<command class_type='calculation' title='Calculation' >
																	<exp exp='program_count = program_count + 1' />
																</command>
															</flowline>
														</command>
														<command class_type='calculation' title='Calculation' >
															<exp exp='program_count = 0' />
														</command>
														<command class_type='loop' title='test for an offtime widget pressed' type='0' exp='program_count &lt; 6' >
															<flowline >
																<command class_type='decision' title='Decision' exp='TouchedObjectID = program_offtime_touchID[program_count]' swap='0' >
																	<flowline >
																		<command class_type='calculation' title='set up next screen to be offtime adjust' >
																			<exp exp='Next_screen = Set_time_screen' />
																			<exp exp='screen_after_variable_adjustment = Program_screen' />
																			<exp exp='adjust_offtime = 1' />
																			<exp exp='Program_to_adjust = program_count' />
																			<exp exp='Hours = program_off_hours[program_count]' />
																			<exp exp='Minutes = program_off_minutes[program_count]' />
																		</command>
																	</flowline>
																	<flowline />
																</command>
																<command class_type='calculation' title='Calculation' >
																	<exp exp='program_count = program_count + 1' />
																</command>
															</flowline>
														</command>
														<command class_type='calculation' title='Calculation' >
															<exp exp='program_count = 0' />
														</command>
														<command class_type='loop' title='test for a temperature widget pressed' type='0' exp='program_count &lt; 6' >
															<flowline >
																<command class_type='decision' title='Decision' exp='TouchedObjectID = program_temperature_touchID[program_count]' swap='0' >
																	<flowline >
																		<command class_type='calculation' title='set up next screen to be temperature adjust' >
																			<exp exp='Next_screen = Set_temperature_screen' />
																			<exp exp='screen_after_variable_adjustment = Program_screen' />
																			<exp exp='adjust_temperature = 1' />
																			<exp exp='Program_to_adjust = program_count' />
																			<exp exp='' />
																		</command>
																	</flowline>
																	<flowline />
																</command>
																<command class_type='calculation' title='Calculation' >
																	<exp exp='program_count = program_count + 1' />
																</command>
															</flowline>
														</command>
													</flowline>
													<flowline />
												</command>
												<command class_type='comment' title='' comment='if an ontime, off time, or temperature button was pressed
then the screen is set to either temperature (screen 5) 
or set time (screen 3) and
variable_to_adjust string is set
program_to_adjust is set.' textarea='12,0,12,0' />
												<command class_type='decision' title='Decision' exp='TouchedObjectID = HomebuttonID' swap='0' >
													<flowline >
														<command class_type='calculation' title='Home Screen' >
															<exp exp='Next_screen = Home_screen' />
														</command>
													</flowline>
													<flowline />
												</command>
												<command class_type='decision' title='Decision' exp='TouchedObjectID = BackButtonID' swap='0' >
													<flowline >
														<command class_type='calculation' title='Menu Screen' >
															<exp exp='Next_screen = Menu_screen' />
														</command>
													</flowline>
													<flowline />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
									<flowline >
										<command class_type='comment' title='' comment='Call NoTouch to clear repeat rate counter' textarea='12,0,12,0' />
										<command class_type='call' title='No touch detected' component='DisplayManager1' macro='NoTouch' />
									</flowline>
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='TouchHandler_SetDate' description='Optional macro called by the DisplayManager::CheckForTouch component macro when the defined area is touched' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Handle' type='h32' description='The handle of the component that was clicked' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='sed1' type='u32' description='not used' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='sed2' type='f32' description='not used' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<param name='sed3' type='T8' description='not used' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='.Handle' >
							<case >
								<flowline />
							</case>
							<case exp='Btn_SD_Back' >
								<flowline >
									<command class_type='call' title='Draw Menu Screen' component='DisplayManager1' macro='DrawScene' >
										<argument exp='2' />
									</command>
								</flowline>
							</case>
							<case exp='Btn_SD_DayUp' >
								<flowline >
									<command class_type='call' title='Component Macro' component='LEDMono1' macro='TurnOn' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='Days = Days + 1' />
									</command>
									<command class_type='decision' title='Check value is in range' exp='Days = 32' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='Days = 1' />
											</command>
										</flowline>
										<flowline />
									</command>
									<command class_type='call' title='User Macro' macro='UpdateDate' />
									<command class_type='call' title='Component Macro' component='DC_Text3' macro='SetTextNumber' >
										<argument exp='0' />
										<argument exp='&quot;&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='Btn_SD_DayDown' >
								<flowline >
									<command class_type='call' title='Component Macro' component='LEDMono1' macro='TurnOff' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='Days = Days - 1' />
									</command>
									<command class_type='decision' title='Check value is in range' exp='Days = 0' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='Days = 31' />
											</command>
										</flowline>
										<flowline />
									</command>
									<command class_type='call' title='User Macro' macro='UpdateDate' />
								</flowline>
							</case>
							<case exp='Btn_SD_MonthUp' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='Months = Months + 1' />
									</command>
									<command class_type='decision' title='Check value is in range' exp='Months = 13' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='Months = 1' />
											</command>
										</flowline>
										<flowline />
									</command>
									<command class_type='call' title='User Macro' macro='UpdateDate' />
								</flowline>
							</case>
							<case exp='Btn_SD_MonthDown' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='Months = Months - 1' />
									</command>
									<command class_type='decision' title='Check value is in range' exp='Months = 0' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='Months = 12' />
											</command>
										</flowline>
										<flowline />
									</command>
									<command class_type='call' title='User Macro' macro='UpdateDate' />
								</flowline>
							</case>
							<case exp='Btn_SD_YearUp' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='Years = Years + 1' />
									</command>
									<command class_type='call' title='User Macro' macro='UpdateDate' />
								</flowline>
							</case>
							<case exp='Btn_SD_YearDown' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='Years = Years - 1' />
									</command>
									<command class_type='call' title='User Macro' macro='UpdateDate' />
								</flowline>
							</case>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='call' title='set up all the variables, initialise all devices' macro='initialise' />
						<command class_type='call' title='Component Macro' component='DisplayManager1' macro='Initialise' />
						<command class_type='calculation' title='Set the next screen to be the home screen' >
							<exp exp='Next_screen = Home_screen' />
						</command>
						<command class_type='call' title='Draw Home Screen' component='DisplayManager1' macro='DrawScene' >
							<argument exp='0' />
						</command>
						<command class_type='loop' title='main program loop' type='0' exp='1' >
							<flowline >
								<command class_type='call' title='Check for touch' component='gLCD_EB3' macro='TouchCheck' >
									<return exp='Touch' />
								</command>
								<command class_type='decision' title='Touch Detected?' exp='Touch' swap='0' >
									<flowline >
										<command class_type='call' title='Component Macro' component='gLCD_EB3' macro='TouchReadCoord' >
											<return exp='X' />
											<argument exp='0' />
										</command>
										<command class_type='call' title='Component Macro' component='gLCD_EB3' macro='TouchReadCoord' >
											<return exp='Y' />
											<argument exp='1' />
										</command>
										<command class_type='call' title='check to see if display is touched' component='DisplayManager1' macro='CheckForTouch' >
											<return exp='TouchedObjectID' />
											<argument exp='X' />
											<argument exp='Y' />
										</command>
									</flowline>
									<flowline >
										<command class_type='comment' title='' comment='Call NoTouch to clear repeat rate counter' textarea='12,0,12,0' />
										<command class_type='call' title='No touch detected' component='DisplayManager1' macro='NoTouch' />
									</flowline>
								</command>
								<command class_type='delay' title='Delay' exp='10' type='1' />
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='initialise' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
