							<exp exp='character2 = &apos;5&apos;' />
						</command>
						<command class_type='calculation' title='Assign 3 character number (&lt;=255) to variable' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
