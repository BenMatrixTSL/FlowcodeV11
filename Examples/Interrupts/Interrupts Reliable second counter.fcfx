							<exp exp='int_count = int_count + 1' />
						</command>
						<command class_type='decision' title='Has 1 second passed?' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' exp='int_count = 150' swap='0' >
							<flowline >
								<command class_type='calculation' title='Reset Interrupt counter' comment='' ccode='' textshow='1' textmode='0' textarea='36,0,36,0' break='0' mark='0' disable='0' hide='0' customize='0' >
