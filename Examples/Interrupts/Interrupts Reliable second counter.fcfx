											<exp exp='seconds = seconds - 60' />
										</command>
										<command class_type='comment' title='' comment='Note that we are detecting if the count value is 60 or over and we
are also subtracting 60 from the count value instead of resetting to 0.
This is done so that even if our main program loop takes more then a 
second to cycle around we will not loose any accuracy.' ccode='' textshow='1' textmode='0' textarea='12,0,12,0' break='0' mark='0' disable='0' hide='0' customize='0' />
