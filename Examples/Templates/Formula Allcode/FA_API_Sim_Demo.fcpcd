				</variable>
			</variables>
			<macros >
				<macro >
					<flowline name='Main' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='sim' title='Clear LCD' component='FormulaAllCodeAPI1' macro='LCDClear' />
						<command class_type='sim' title='Print message to LCD' component='FormulaAllCodeAPI1' macro='LCDPrintString' >
							<argument exp='0' />
							<argument exp='0' />
							<argument exp='&quot;API Connected&quot;' />
						</command>
						<command class_type='calculation' title='Initialise LED control variable' >
							<exp exp='LEDs = 0x01' />
						</command>
						<command class_type='loop' title='Loop' type='3' exp='1' for1='' for3='' >
							<flowline >
								<command class_type='delay' title='Delay' exp='100' type='1' />
								<command class_type='decision' title='Decision' exp='Direction' swap='0' >
									<flowline >
										<command class_type='calculation' title='Left shift value - Binary Multiply by 2' >
											<exp exp='Check = LEDs &lt;&lt; 1' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Right shift value - Binary Divide by 2' >
											<exp exp='Check = LEDs &gt;&gt; 1' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Have we shifted too far' exp='Check = 0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Change direction - 0-&gt;1 / 1-&gt;0' >
											<exp exp='Direction = (Direction + 1) &amp; 1' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Copy shifted value back to LED control value' >
											<exp exp='LEDs = Check' />
										</command>
									</flowline>
								</command>
								<command class_type='sim' title='Write value to Robot LEDs' component='FormulaAllCodeAPI1' macro='LEDWrite' >
									<argument exp='LEDs' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
			</macros>
