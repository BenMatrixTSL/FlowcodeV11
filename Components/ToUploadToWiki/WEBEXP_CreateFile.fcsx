											<flowline >
												<command class_type='calculation' title='Add base64' >
													<exp exp='.HeaderScript = .HeaderScript + &quot;;base64&quot;' />
												</command>
											</flowline>
											<flowline />
										</command>
										<command class_type='calculation' title='Add base64' >
