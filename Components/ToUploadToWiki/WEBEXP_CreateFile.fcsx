				<macro >
					<flowline name='CreateFile' description='Creates a file from the supplied filename with the supplied contents and
triggers a download ' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Filename' type='T8' description='Default filename assigned to the file e.g. &quot;file.txt&quot;' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='2000' />
						</param>
						<param name='Data' type='T8' description='Data to assign to the file' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='2000' />
						</param>
						<command class_type='native' title='Javascript' ccode='let sPrefix = window[&apos;FCPRE_&apos; + FC_THIS];
let bEncode = window[&apos;FCENC_&apos; + FC_THIS];

var hiddenElement = document.createElement(&apos;a&apos;);

if (bEncode)
{
  hiddenElement.href = sPrefix + encodeURI(FCL_DATA);
}
else
{
  hiddenElement.href = sPrefix + FCL_DATA;
}

hiddenElement.target = &apos;_blank&apos;;
hiddenElement.download = FCL_FILENAME;
hiddenElement.click();' language='C' />
					</flowline>
				</macro>
