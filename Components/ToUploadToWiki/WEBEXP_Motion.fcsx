Returns true if the device can provide orientation information.' statediag='0' >
						<return name='Return' type='b1' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='native' title='JavaScript' ccode='  FCR_RETVAL = false;
  if (window.DeviceMotionEvent) {
