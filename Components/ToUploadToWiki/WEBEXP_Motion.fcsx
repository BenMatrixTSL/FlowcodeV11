						<return name='Return' type='s32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='native' title='JavaScript' ccode='  let data = window[&apos;FCACCEL_&apos; + FC_THIS];' language='C' />
						<command class_type='native' title='JavaScript' ccode='  FCR_RETVAL = data.interval;' language='C' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Property' description='Sent when a property has been changed by the User' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Built-in Function' macro='Component.Property.SetVisible' >
							<argument exp='this' />
							<argument exp='&quot;mCallback&quot;' />
							<argument exp='bUseCallback' />
						</command>
						<command class_type='sim' title='Built-in Function' macro='Component.Property.SetVisible' >
							<argument exp='this' />
							<argument exp='&quot;bCompensate&quot;' />
							<argument exp='bUseCallback' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_HtmlScriptHeader' description='Sent to a component to retrieve script code to be placed in the html header section' statediag='0' >
						<return name='Return' type='u32' description='Non-zero to block script code insertion' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='CompID' type='T8' description='The unique name of this component' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='HeaderScript' type='T8*' description='Text to amend for the header script' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = &quot;  var FCACCEL_&quot; + .CompID + &quot; = {};\n&quot;' />
						</command>
						<command class_type='decision' title='Decision' exp='bUseCallback' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.HeaderScript = .HeaderScript + &quot;  function FCMOTION_CB_&quot; + .CompID + &quot;(timestamp) {\n&quot;' />
								</command>
								<command class_type='decision' title='Decision' exp='bCompensate' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.HeaderScript = .HeaderScript + &quot;    let x = FCACCEL_&quot; + .CompID + &quot;.acceleration.x;\n&quot;' />
											<exp exp='.HeaderScript = .HeaderScript + &quot;    let y = FCACCEL_&quot; + .CompID + &quot;.acceleration.y;\n&quot;' />
											<exp exp='.HeaderScript = .HeaderScript + &quot;    let z = FCACCEL_&quot; + .CompID + &quot;.acceleration.z;\n&quot;' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.HeaderScript = .HeaderScript + &quot;    let x = FCACCEL_&quot; + .CompID + &quot;.accelerationIncludingGravity.x;\n&quot;' />
											<exp exp='.HeaderScript = .HeaderScript + &quot;    let y = FCACCEL_&quot; + .CompID + &quot;.accelerationIncludingGravity.y;\n&quot;' />
											<exp exp='.HeaderScript = .HeaderScript + &quot;    let z = FCACCEL_&quot; + .CompID + &quot;.accelerationIncludingGravity.z;\n&quot;' />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.HeaderScript = .HeaderScript + &quot;    if (x === null) { x = 0.0; }\n&quot;' />
									<exp exp='.HeaderScript = .HeaderScript + &quot;    if (y === null) { y = 0.0; }\n&quot;' />
									<exp exp='.HeaderScript = .HeaderScript + &quot;    if (z === null) { z = 0.0; }\n&quot;' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.HeaderScript = .HeaderScript + &quot;    FCM_&quot; + mCallback + &quot;(x, y, z, FCACCEL_&quot; + .CompID + &quot;.interval);\n&quot;' />
									<exp exp='.HeaderScript = .HeaderScript + &quot;  }\n\n&quot;' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = .HeaderScript + &quot;  function FCMOTION_EVENT_&quot; + .CompID + &quot;(event) {\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;    FCACCEL_&quot; + .CompID + &quot; = event;\n&quot;' />
							<exp exp='' />
						</command>
						<command class_type='decision' title='Decision' exp='bUseCallback' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.HeaderScript = .HeaderScript + &quot;    requestAnimationFrame(FCMOTION_CB_&quot; + .CompID + &quot;);\n&quot;' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = .HeaderScript + &quot;  }\n&quot;' />
						</command>
						<command class_type='calculation' title='Set return to zero to ensure text is added to html file' >
							<exp exp='.Return = 0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='GetAcceleration' description='Returns the device&apos;s acceleration in the specified direction' statediag='0' >
						<return name='Return' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<param name='Axis' type='s32' description='The axis to use (0=x, 1=y, 2=z)' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<param name='Compensate' type='b1' description='Set true to compensate for the effects of gravity' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='true' />
						<command class_type='decision' title='Decision' exp='(.Axis == &apos;x&apos;) || (.Axis == &apos;X&apos;)' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Axis = 0' />
								</command>
							</flowline>
							<flowline >
								<command class_type='decision' title='Decision' exp='(.Axis == &apos;y&apos;) || (.Axis == &apos;Y&apos;)' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Axis = 1' />
										</command>
									</flowline>
									<flowline >
										<command class_type='decision' title='Decision' exp='(.Axis == &apos;z&apos;) || (.Axis == &apos;Z&apos;)' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Axis = 2' />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' exp='(.Axis == 0) || (.Axis == 1) || (.Axis == 2)' swap='0' >
							<flowline />
							<flowline >
								<command class_type='native' title='JavaScript' ccode='    console.error(&quot;Wrong parameter for axis passed, defaulting to 0&quot;);' language='C' />
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Axis = 0' />
								</command>
							</flowline>
						</command>
						<command class_type='native' title='JavaScript' ccode='  let data = window[&apos;FCACCEL_&apos; + FC_THIS];' language='C' />
						<command class_type='decision' title='Decision' exp='!.Compensate' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='.Axis == 1' swap='0' >
									<flowline >
										<command class_type='native' title='JavaScript' ccode='        FCR_RETVAL = data.accelerationIncludingGravity.y;' language='C' />
									</flowline>
									<flowline >
										<command class_type='decision' title='Decision' exp='.Axis == 2' swap='0' >
											<flowline >
												<command class_type='native' title='JavaScript' ccode='        FCR_RETVAL = data.accelerationIncludingGravity.z;' language='C' />
											</flowline>
											<flowline >
												<command class_type='native' title='JavaScript' ccode='      FCR_RETVAL = data.accelerationIncludingGravity.x;' language='C' />
											</flowline>
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline >
								<command class_type='decision' title='Decision' exp='.Axis == 1' swap='0' >
									<flowline >
										<command class_type='native' title='JavaScript' ccode='        FCR_RETVAL = data.acceleration.y;' language='C' />
									</flowline>
									<flowline >
										<command class_type='decision' title='Decision' exp='.Axis == 2' swap='0' >
											<flowline >
												<command class_type='native' title='JavaScript' ccode='        FCR_RETVAL = data.acceleration.z;' language='C' />
											</flowline>
											<flowline >
												<command class_type='native' title='JavaScript' ccode='      FCR_RETVAL = data.acceleration.x;' language='C' />
											</flowline>
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
						<command class_type='native' title='JavaScript' ccode='    if (FCR_RETVAL === null)
    {
      FCR_RETVAL = 0;
    }' language='C' />
					</flowline>
				</macro>
