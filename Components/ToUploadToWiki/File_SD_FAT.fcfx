							<flowline >
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='0x20' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='0' />
									<argument exp='.i' />
