			</variables>
			<macros >
				<macro >
					<flowline name='sim_read_file_sector' description='' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='count' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='temp_str' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='1' />
						</local>
						<local name='count2' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Index' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='buf' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='16' />
						</local>
						<local name='InnerIndex' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.count = file_sector[file_idx] * 512' />
						</command>
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashRx' />
						<command class_type='call' title='Call Macro' macro='Clear_Buffer' />
						<command class_type='sim' title='Panel' macro='File.SetPos' >
							<argument exp='file_handle[file_idx]' />
							<argument exp='.count' />
							<argument exp='::File .Seek_Begin' />
						</command>
						<command class_type='decision' title='Decision' exp='(file_sector[file_idx] * 512) + 256 &lt;= file_size[file_idx]' swap='0' >
							<flowline >
								<command class_type='sim' title='Panel' macro='File.ReadArray' >
									<argument exp='file_handle[file_idx]' />
									<argument exp='card_buffer_l' />
									<argument exp='256' />
								</command>
								<command class_type='decision' title='Decision' exp='(file_sector[file_idx] * 512) + 512 &lt;= file_size[file_idx]' swap='0' >
									<flowline >
										<command class_type='sim' title='Panel' macro='File.SetPos' >
											<argument exp='file_handle[file_idx]' />
											<argument exp='.count + 256' />
											<argument exp='::File .Seek_Begin' />
										</command>
										<command class_type='sim' title='Panel' macro='File.ReadArray' >
											<argument exp='file_handle[file_idx]' />
											<argument exp='card_buffer_h' />
											<argument exp='256' />
										</command>
									</flowline>
									<flowline >
										<command class_type='sim' title='Panel' macro='File.ReadArray' >
											<argument exp='file_handle[file_idx]' />
											<argument exp='card_buffer_l' />
											<argument exp='file_size[file_idx] - ((file_sector[file_idx] * 512) + 256)' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline >
								<command class_type='sim' title='Panel' macro='File.ReadArray' >
									<argument exp='file_handle[file_idx]' />
									<argument exp='card_buffer_l' />
									<argument exp='file_size[file_idx] - (file_sector[file_idx] * 512)' />
								</command>
							</flowline>
						</command>
						<command class_type='comment' title='' comment='Crash Start Code' textarea='12,0,12,0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Index = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.Index &lt; 16' for1='' for3='' >
							<flowline >
								<command class_type='sim' title='Simulation' macro='Console.SetLineBytes' >
									<argument exp='ConsoleBufferHandle' />
									<argument exp='.Index' />
									<argument exp='card_buffer_l' />
									<argument exp='(.Index * 16)' />
									<argument exp='16' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Index = .Index + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='comment' title='' comment='Crash End' textarea='12,0,12,0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Index = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.Index &lt; 16' for1='' for3='' >
							<flowline >
								<command class_type='sim' title='Simulation' macro='Console.SetLineBytes' >
									<argument exp='ConsoleBufferHandle' />
									<argument exp='(.Index + 16)' />
									<argument exp='card_buffer_h' />
									<argument exp='(.Index * 16)' />
									<argument exp='16' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Index = .Index + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Append_Byte' description='Adds one byte to the end of the open file. The card is only written when the sector buffer fills. Returns 0 for success.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Data' type='u8' description='Data to append to the end of the file' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = ACK_OK' />
						</command>
						<command class_type='decision' title='Sector buffer full?' exp='append_offset = 512' swap='0' >
							<flowline >
								<command class_type='call' title='Write the full sector to the card' macro='SendBuffer' >
									<argument exp='file_pointer[file_idx]' />
								</command>
								<command class_type='call' title='Move to the next sector of the file' macro='Seek_File_Sector' >
									<return exp='.Return' />
									<argument exp='file_sector[file_idx] + 1' />
								</command>
								<command class_type='decision' title='Last sector in the chain?' exp='.Return = ACK_END_OF_FILE' swap='0' >
									<flowline >
										<command class_type='call' title='Add a new cluster to the file' macro='Add_Sector_To_File' >
											<return exp='.Return' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Failed? e.g. card full' exp='.Return != ACK_OK' swap='0' >
									<flowline >
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='append_offset = 0' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Write the byte into the buffer' macro='WriteByteToBuffer' >
							<argument exp='append_offset' />
							<argument exp='.Data' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='append_offset = append_offset + 1' />
							<exp exp='file_size[file_idx] = file_size[file_idx] + 1' />
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadStringFromFile' description='Reads a string from the currently open file. Auto increments the position in the file.&#10;An empty string signifies the end of the file has been reached.' statediag='0' >
						<return name='Return' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;\x00&quot;' setinit='' >
							<array size='2000' />
						</return>
						<param name='NumBytes' type='u16' description='Maximum number of bytes to attempt to read' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='EndChar' type='u8' description='Ends the string if the value specified is found, default is 0' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Idx' type='u16' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Data_Byte' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Sector_Size' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = &quot;&quot;' />
						</command>
						<command class_type='call' title='Call Macro' macro='ReadFileLength' >
							<return exp='.Sector_Size' />
						</command>
						<command class_type='decision' title='EOF?' exp='read_address[file_idx] = 512' swap='0' >
							<flowline >
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.Idx &lt; .NumBytes' for1='' for3='' >
							<flowline >
								<command class_type='decision' title='Decision' exp='read_address[file_idx] &gt;= .Sector_Size' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return[.Idx] = 0' />
										</command>
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.Data_Byte' />
									<argument exp='read_address[file_idx]' />
								</command>
								<command class_type='decision' title='Decision' exp='(.Data_Byte = .EndChar) || (.Data_Byte = 0)' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return[.Idx] = 0' />
										</command>
										<command class_type='calculation' title='Exit Loop' >
											<exp exp='.Idx = .NumBytes' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return[.Idx] = .Data_Byte' />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='read_address[file_idx] = read_address[file_idx] + 1' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Idx = .Idx + 1' />
								</command>
								<command class_type='decision' title='Decision' exp='read_address[file_idx] = 512' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='read_address[file_idx] = 0' />
										</command>
										<command class_type='call' title='Call Macro' macro='MoveToNextFileSector' >
											<return exp='.Data_Byte' />
											<argument exp='0' />
										</command>
										<command class_type='decision' title='Decision' exp='.Data_Byte &gt; 0' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='read_address[file_idx] = 512' />
												</command>
												<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
											</flowline>
											<flowline />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadFloatArrayFromFile' description='Reads a binary Float array from the currently open file. &#13;&#10;Auto increments the position in the file.&#13;&#10;Returns the number of values read.' statediag='0' >
						<return name='Return' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Data' type='f32' description='Data variable to populate with data' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' >
							<array size='1000' />
						</param>
						<param name='Length' type='u16' description='Number of values to read' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='MSBFirst' type='b1' description='0=LSB then MSB, 1=MSB then LSB' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Ret' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
							<exp exp='.Ret = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='(.Return &lt; .Length) &amp;&amp; (.Ret &lt; 256)' for1='' for3='' >
							<flowline >
								<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='sim_read_byte_from_file' >
											<return exp='.Ret' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='User Macro' macro='ReadByteFromFile' >
											<return exp='.Ret' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Decision' exp='.Ret &lt; 256' swap='0' >
									<flowline >
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
											<argument exp='0' />
											<argument exp='.Ret' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='sim_read_byte_from_file' >
											<return exp='.Ret' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='User Macro' macro='ReadByteFromFile' >
											<return exp='.Ret' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Decision' exp='.Ret &lt; 256' swap='0' >
									<flowline >
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
											<argument exp='1' />
											<argument exp='.Ret' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='sim_read_byte_from_file' >
											<return exp='.Ret' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='User Macro' macro='ReadByteFromFile' >
											<return exp='.Ret' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Decision' exp='.Ret &lt; 256' swap='0' >
									<flowline >
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
											<argument exp='2' />
											<argument exp='.Ret' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='sim_read_byte_from_file' >
											<return exp='.Ret' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='User Macro' macro='ReadByteFromFile' >
											<return exp='.Ret' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Decision' exp='.Ret &lt; 256' swap='0' >
									<flowline >
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
											<argument exp='3' />
											<argument exp='.Ret' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Data[.Return] = TypeConversions1 :: GetFloat ()' />
											<exp exp='.Return = .Return + 1' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='WriteByteToBuffer' description='Writes a single byte to the current 512 byte local sector buffer.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Address' type='u16' description='Address Range 0 - 511' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Data' type='u8' description='Data Byte to write to the buffer' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='Decision' exp='.Address &gt; 255' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Address = .Address - 256' />
								</command>
								<command class_type='decision' title='Decision' exp='.Address &gt; 255' swap='0' >
									<flowline >
										<command class_type='output' title='Output' disable='1' mode='1' port='1048579' mask='2' exp='1' usechipref='1' />
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='card_buffer_h[.Address] = .Data' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='card_buffer_l[.Address] = .Data' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='MoveToNextFileSector' description='Attempts to move to the next sector in the file.&#10;When reading a file you would leave force next sector set to 0.&#10;When writing a file you would  leave force next sector set to 1 to allow new sectors to be created as the file grows.&#10;Returns 0 for success' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Force_Next_Sector' type='u8' description='0 = Don&apos;t add new sector, 1 = Add new sector if we are at the end of the file' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Try to move to the next sector' macro='Seek_File_Sector' >
							<return exp='.Return' />
							<argument exp='file_sector[file_idx] + 1' />
						</command>
						<command class_type='decision' title='If forcing next sector?' exp='.Force_Next_Sector' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='.Return = ACK_END_OF_FILE' swap='0' >
									<flowline >
										<command class_type='call' title='If last sector in the chain then add new link' macro='Add_Sector_To_File' >
											<return exp='.Return' />
										</command>
									</flowline>
									<flowline >
										<command class_type='comment' title='' comment='Next sector exists and has been read or error in sector chain' textarea='110,19,110,19' />
									</flowline>
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='AppendFloatArrayToFile' description='Adds a binary float array to the end of the file.&#13;&#10;Returns 0 for success.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Data' type='f32' description='Binary data array to append to the file' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' >
							<array size='1000' />
						</param>
						<param name='Length' type='u16' description='Number of values to append' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Idx' type='u16' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Temp' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
							<flowline />
							<flowline >
								<command class_type='call' title='Move to the end of the file' macro='Append_Start' >
									<return exp='.Return' />
								</command>
							</flowline>
						</command>
						<command class_type='loop' title='Loop' type='0' exp='(.Idx &lt; .Length) &amp;&amp; (.Return = 0)' for1='' for3='' >
							<flowline >
								<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
									<flowline >
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetFloat' >
											<argument exp='.Data[.Idx]' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
											<return exp='.Temp' />
											<argument exp='0' />
										</command>
										<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
											<return exp='.Return' />
											<argument exp='.Temp' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetFloat' >
											<argument exp='.Data[.Idx]' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
											<return exp='.Temp' />
											<argument exp='1' />
										</command>
										<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
											<return exp='.Return' />
											<argument exp='.Temp' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetFloat' >
											<argument exp='.Data[.Idx]' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
											<return exp='.Temp' />
											<argument exp='2' />
										</command>
										<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
											<return exp='.Return' />
											<argument exp='.Temp' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetFloat' >
											<argument exp='.Data[.Idx]' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
											<return exp='.Temp' />
											<argument exp='3' />
										</command>
										<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
											<return exp='.Return' />
											<argument exp='.Temp' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetFloat' >
											<argument exp='.Data[.Idx]' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
											<return exp='.Temp' />
											<argument exp='0' />
										</command>
										<command class_type='call' title='User Macro' macro='Append_Byte' >
											<return exp='.Return' />
											<argument exp='.Temp' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetFloat' >
											<argument exp='.Data[.Idx]' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
											<return exp='.Temp' />
											<argument exp='1' />
										</command>
										<command class_type='call' title='User Macro' macro='Append_Byte' >
											<return exp='.Return' />
											<argument exp='.Temp' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetFloat' >
											<argument exp='.Data[.Idx]' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
											<return exp='.Temp' />
											<argument exp='2' />
										</command>
										<command class_type='call' title='User Macro' macro='Append_Byte' >
											<return exp='.Return' />
											<argument exp='.Temp' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetFloat' >
											<argument exp='.Data[.Idx]' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
											<return exp='.Temp' />
											<argument exp='3' />
										</command>
										<command class_type='call' title='User Macro' macro='Append_Byte' >
											<return exp='.Return' />
											<argument exp='.Temp' />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Idx = .Idx + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
							<flowline />
							<flowline >
								<command class_type='call' title='Write to the card and update the file size' macro='Append_End' />
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadINTArrayFromFile' description='Reads a binary INT array from the currently open file. &#13;&#10;Auto increments the position in the file.&#13;&#10;Returns the number of values read.' statediag='0' >
						<return name='Return' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Data' type='u16' description='Data variable to populate with data' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' >
							<array size='1000' />
						</param>
						<param name='Length' type='u16' description='Number of values to read' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='MSBFirst' type='b1' description='0=LSB then MSB, 1=MSB then LSB' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Ret' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
							<exp exp='.Ret = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='(.Return &lt; .Length) &amp;&amp; (.Ret &lt; 256)' for1='' for3='' >
							<flowline >
								<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='sim_read_byte_from_file' >
											<return exp='.Ret' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='User Macro' macro='ReadByteFromFile' >
											<return exp='.Ret' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Decision' exp='.Ret &lt; 256' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' exp='.MSBFirst' swap='0' >
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='1' />
													<argument exp='.Ret' />
												</command>
											</flowline>
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='0' />
													<argument exp='.Ret' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='sim_read_byte_from_file' >
											<return exp='.Ret' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='User Macro' macro='ReadByteFromFile' >
											<return exp='.Ret' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Decision' exp='.Ret &lt; 256' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' exp='.MSBFirst' swap='0' >
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='0' />
													<argument exp='.Ret' />
												</command>
											</flowline>
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='1' />
													<argument exp='.Ret' />
												</command>
											</flowline>
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Data[.Return] = TypeConversions1 :: GetInt (0)' />
											<exp exp='.Return = .Return + 1' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Append_End' description='Writes the last sector of an append to the card and updates the file size in the directory entry.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<local name='idx' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='j' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='Append was started?' exp='append_offset &lt;= 512' swap='0' >
							<flowline >
								<command class_type='call' title='Write the current sector to the card' macro='SendBuffer' >
									<argument exp='file_pointer[file_idx]' />
								</command>
								<command class_type='call' title='Read the sector holding the directory entry' macro='GetBuffer' >
									<argument exp='file_address[file_idx]' />
								</command>
								<command class_type='calculation' title='Position of the file size in the entry' >
									<exp exp='.idx = 28 + (file_entry[file_idx] &lt;&lt; 5)' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
									<argument exp='file_size[file_idx]' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
									<return exp='.j' />
									<argument exp='0' />
								</command>
								<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
									<argument exp='.idx' />
									<argument exp='.j' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
									<return exp='.j' />
									<argument exp='1' />
								</command>
								<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
									<argument exp='.idx + 1' />
									<argument exp='.j' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
									<return exp='.j' />
									<argument exp='2' />
								</command>
								<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
									<argument exp='.idx + 2' />
									<argument exp='.j' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
									<return exp='.j' />
									<argument exp='3' />
								</command>
								<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
									<argument exp='.idx + 3' />
									<argument exp='.j' />
								</command>
								<command class_type='call' title='Update file length onto card' macro='SendBuffer' >
									<argument exp='file_address[file_idx]' />
								</command>
								<command class_type='call' title='Read current sector' macro='GetBuffer' >
									<argument exp='file_pointer[file_idx]' />
								</command>
								<command class_type='call' title='Bytes of file data in this sector' macro='ReadFileLength' >
									<return exp='sector_bytes' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='sim_delete_file' description='' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Filename' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='12' />
						</param>
						<local name='Filepath' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='200' />
						</local>
						<local name='i' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Len' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='char' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashTx' />
						<command class_type='sim' title='Scrub File Handle' macro='System.DeleteHandle' >
							<argument exp='file_handle[file_idx]' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Len = Length$ (root_dir)' />
							<exp exp='.char = root_dir[.Len - 1]' />
						</command>
						<command class_type='decision' title='Decision' exp='(.char = &apos;)&apos;) || (.char = &apos;\\&apos;)' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Filepath = root_dir' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Filepath = root_dir + &quot;\\&quot;' />
								</command>
							</flowline>
						</command>
						<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='file_idx' >
							<case >
								<flowline >
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='.i = Length$ (sim_folder_path_0)' />
									</command>
									<command class_type='decision' title='Decision' exp='.i' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Filepath = .Filepath + sim_folder_path_0' />
											</command>
										</flowline>
										<flowline />
									</command>
								</flowline>
							</case>
							<case exp='1' >
								<flowline >
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='.i = Length$ (sim_folder_path_1)' />
									</command>
									<command class_type='decision' title='Decision' exp='.i' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Filepath = .Filepath + sim_folder_path_1' />
											</command>
										</flowline>
										<flowline />
									</command>
								</flowline>
							</case>
							<case exp='2' >
								<flowline >
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='.i = Length$ (sim_folder_path_2)' />
									</command>
									<command class_type='decision' title='Decision' exp='.i' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Filepath = .Filepath + sim_folder_path_2' />
											</command>
										</flowline>
										<flowline />
									</command>
								</flowline>
							</case>
							<case exp='3' >
								<flowline >
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='.i = Length$ (sim_folder_path_3)' />
									</command>
									<command class_type='decision' title='Decision' exp='.i' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Filepath = .Filepath + sim_folder_path_3' />
											</command>
										</flowline>
										<flowline />
									</command>
								</flowline>
							</case>
							<case exp='4' >
								<flowline >
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='.i = Length$ (sim_folder_path_4)' />
									</command>
									<command class_type='decision' title='Decision' exp='.i' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Filepath = .Filepath + sim_folder_path_4' />
											</command>
										</flowline>
										<flowline />
									</command>
								</flowline>
							</case>
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Filepath = .Filepath + .Filename' />
						</command>
						<command class_type='sim' title='Simulation' macro='Console.WriteText' >
							<argument exp='ConsoleHandle' />
							<argument exp='&quot;Delete File: &quot; + .Filepath + &quot; -&quot;' />
						</command>
						<command class_type='sim' title='Panel' macro='File.GetType' >
							<return exp='.i' />
							<argument exp='.Filepath' />
						</command>
						<command class_type='decision' title='Decision' exp='.i = 1' swap='0' >
							<flowline >
								<command class_type='sim' title='Panel' macro='File.Delete' >
									<argument exp='.Filepath' />
								</command>
								<command class_type='sim' title='Simulation' macro='Console.WriteText' >
									<argument exp='ConsoleHandle' />
									<argument exp='&quot; OK\n&quot;' />
								</command>
								<command class_type='calculation' title='File open correctly' >
									<exp exp='.Return = 0x00' />
								</command>
							</flowline>
							<flowline >
								<command class_type='sim' title='Simulation' macro='Console.WriteText' >
									<argument exp='ConsoleHandle' />
									<argument exp='&quot; Error File Not Found\n&quot;' />
								</command>
								<command class_type='calculation' title='File not found' >
									<exp exp='.Return = ERROR_FILE_NOT_FOUND' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='AppendByteToFile' description='Adds a single byte to the end of the currently open file, useful for inserting the value 0 into binary file types.&#10;Returns 0 for success.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Data' type='u8' description='Data to append to the end of the file' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Move to the end of the file' macro='Append_Start' >
							<return exp='.Return' />
						</command>
						<command class_type='decision' title='Decision' exp='.Return = ACK_OK' swap='0' >
							<flowline >
								<command class_type='call' title='Call Macro' macro='Append_Byte' >
									<return exp='.Return' />
									<argument exp='.Data' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Write to the card and update the file size' macro='Append_End' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Stop' description='Broadcast to all components that simulation has stopped' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='idx' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.idx &lt; max_concurrent_files' for1='' for3='' >
							<flowline >
								<command class_type='sim' title='Panel' macro='File.Flush' >
									<argument exp='file_handle[file_idx]' />
								</command>
								<command class_type='sim' title='Panel' macro='System.DeleteHandle' >
									<argument exp='file_handle[.idx]' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.idx = .idx + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='sim' title='Simulation' macro='Component.Property.SetValue' >
							<argument exp='this' />
							<argument exp='&quot;IsSim&quot;' />
							<argument exp='0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Pvt_Copy_CAL_Props' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='CAL_type' type='h32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Property' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<local name='Idx' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Len' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='PropStr' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<local name='sRef' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<local name='Ref' type='s32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Clear the property option list' macro='Component.Property.SetFilter' >
							<argument exp='this' />
							<argument exp='.Property' />
							<argument exp='&quot;&quot;' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Idx = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.Len' start='0' for1='' for3='' >
							<flowline >
								<command class_type='sim' title='Get reference value of indexed property option list item' macro='Component.Property.GetListIndex' >
									<return exp='.sRef' />
									<argument exp='.CAL_type' />
									<argument exp='.Property' />
									<argument exp='.Idx' />
								</command>
								<command class_type='decision' title='If have a reference' exp='.sRef[0] != &apos;\0&apos;' swap='0' >
									<flowline >
										<command class_type='sim' title='Get property option string associated with reference value' macro='Component.Property.GetListItem' >
											<return exp='.PropStr' />
											<argument exp='.CAL_type' />
											<argument exp='.Property' />
											<argument exp='.sRef' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.PropStr = &quot;&quot;' />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Length of option string' >
									<exp exp='.Len = Length$ (.PropStr)' />
								</command>
								<command class_type='decision' title='Property string exists' exp='.Len' swap='0' >
									<flowline >
										<command class_type='sim' title='Add property option to component list' macro='Component.Property.AddListItem' >
											<argument exp='this' />
											<argument exp='.Property' />
											<argument exp='.sRef' />
											<argument exp='.PropStr' />
										</command>
									</flowline>
									<flowline >
										<command class_type='comment' title='' comment='End of option list' textarea='12,0,12,0' />
									</flowline>
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Idx = .Idx + 1' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadFileSector' description='Overwrites local buffer with the current file sector from the disk.&#10;Used to restore the local sector buffer with the actual sector stored on the card.&#10;Return = 0 : Local buffer refreshed with current card sector &#10;Return &gt; 0 : Error' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Call Macro' macro='GetBuffer' >
							<return exp='.Return' />
							<argument exp='file_pointer[file_idx]' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='CloseFile' description='Closes the current open file' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='file_address[file_idx] = 0' />
							<exp exp='file_entry[file_idx] = 0' />
							<exp exp='file_pointer[file_idx] = 0' />
							<exp exp='file_sector[file_idx] = 0' />
							<exp exp='sector_bytes = 0' />
							<exp exp='file_size[file_idx] = 0' />
							<exp exp='read_address[file_idx] = 0' />
						</command>
						<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='file_handle[file_idx] = 0' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadByteFromFile' description='Reads a byte from the currently open file. Auto increments the position in the file.&#10;A return value of 0 may signify the end of the file has been reached (depending on the contents of the file).' statediag='0' >
						<return name='Return' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Idx' type='u16' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Data_Byte' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='Decision' exp='EOFtype = 1' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 512' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='EOF?' exp='read_address[file_idx] = 512' swap='0' >
							<flowline >
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='read_address[file_idx] &gt;= sector_bytes' swap='0' >
							<flowline >
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
							<return exp='.Return' />
							<argument exp='read_address[file_idx]' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='read_address[file_idx] = read_address[file_idx] + 1' />
						</command>
						<command class_type='decision' title='Decision' exp='read_address[file_idx] = 512' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='read_address[file_idx] = 0' />
								</command>
								<command class_type='call' title='Call Macro' macro='MoveToNextFileSector' >
									<return exp='.Data_Byte' />
									<argument exp='0' />
								</command>
								<command class_type='decision' title='Decision' exp='.Data_Byte &gt; 0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='read_address[file_idx] = 512' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
					</flowline>
				</macro>
				<macro >
					<flowline name='DeleteFile' description='Searches for and deletes a file in the current folder location on the card. Default = Root&#10;Returns 0 for success.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Filename' type='T8*' description='8.3 format filename e.g.&quot;file.txt&quot;' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='13' />
						</param>
						<local name='i' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='idx' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='j' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='fat_address' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='loaded' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='offset' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Convert filename to 8.3' macro='Format_File_String' >
							<argument exp='.Filename' />
						</command>
						<command class_type='call' title='Search the current folder for the name' macro='Find_Folder_Entry' >
							<return exp='.i' />
						</command>
						<command class_type='decision' title='Not found?' exp='.i &gt; 15' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = ERROR_FILE_NOT_FOUND' />
								</command>
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Position of the entry in the sector' >
							<exp exp='.idx = .i &lt;&lt; 5' />
						</command>
						<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
							<return exp='.j' />
							<argument exp='.idx + 26' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
							<argument exp='0' />
							<argument exp='.j' />
						</command>
						<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
							<return exp='.j' />
							<argument exp='.idx + 27' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
							<argument exp='1' />
							<argument exp='.j' />
						</command>
						<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
							<flowline >
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.j' />
									<argument exp='.idx + 20' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='2' />
									<argument exp='.j' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.j' />
									<argument exp='.idx + 21' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='3' />
									<argument exp='.j' />
								</command>
							</flowline>
							<flowline >
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='2' />
									<argument exp='0' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='3' />
									<argument exp='0' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetLong' >
							<return exp='cluster' />
						</command>
						<command class_type='call' title='Overwrite stored cluster value' macro='WriteByteToBuffer' >
							<argument exp='.idx + 26' />
							<argument exp='0' />
						</command>
						<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
							<argument exp='.idx + 27' />
							<argument exp='0' />
						</command>
						<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
							<flowline >
								<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
									<argument exp='.idx + 20' />
									<argument exp='0' />
								</command>
								<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
									<argument exp='.idx + 21' />
									<argument exp='0' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Clear file size' macro='WriteByteToBuffer' >
							<argument exp='.idx + 28' />
							<argument exp='0' />
						</command>
						<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
							<argument exp='.idx + 29' />
							<argument exp='0' />
						</command>
						<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
							<argument exp='.idx + 30' />
							<argument exp='0' />
						</command>
						<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
							<argument exp='.idx + 31' />
							<argument exp='0' />
						</command>
						<command class_type='call' title='Set first byte to &quot;Free File&quot; flag' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='0xE5' />
						</command>
						<command class_type='call' title='Write updated contents to the card' macro='SendBuffer' >
							<argument exp='file_pointer[file_idx]' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.loaded = 0' />
						</command>
						<command class_type='loop' title='While the file has clusters left to free' type='0' exp='(cluster &gt; 1) &amp;&amp; (cluster &lt; not_address_marker)' for1='' for3='' >
							<flowline >
								<command class_type='calculation' title='Locate the FAT entry for this cluster' >
									<exp exp='.fat_address = fat_start + (cluster / fats_per_sector)' />
									<exp exp='.offset = (cluster &amp; (fats_per_sector - 1)) * sector_address_length' />
								</command>
								<command class_type='decision' title='Moved on to a different FAT sector?' exp='.fat_address != .loaded' swap='0' >
									<flowline >
										<command class_type='decision' title='Changes to write back first?' exp='.loaded != 0' swap='0' >
											<flowline >
												<command class_type='call' title='Write changes to FAT' macro='SendBuffer' >
													<argument exp='.loaded' />
												</command>
												<command class_type='call' title='Mirror onto FAT2' macro='SendBuffer' >
													<argument exp='.loaded + fat_size' />
												</command>
											</flowline>
											<flowline />
										</command>
										<command class_type='call' title='Read FAT sector' macro='GetBuffer' >
											<argument exp='.fat_address' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.loaded = .fat_address' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Read next cluster value' macro='ReadByteFromBuffer' >
									<return exp='.j' />
									<argument exp='.offset' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='0' />
									<argument exp='.j' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.j' />
									<argument exp='.offset + 1' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='1' />
									<argument exp='.j' />
								</command>
								<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
									<flowline >
										<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
											<return exp='.j' />
											<argument exp='.offset + 2' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
											<argument exp='2' />
											<argument exp='.j' />
										</command>
										<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
											<return exp='.j' />
											<argument exp='.offset + 3' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
											<argument exp='3' />
											<argument exp='.j' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
											<argument exp='2' />
											<argument exp='0' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
											<argument exp='3' />
											<argument exp='0' />
										</command>
									</flowline>
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetLong' >
									<return exp='cluster' />
								</command>
								<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
									<flowline >
										<command class_type='calculation' title='Top 4 bits of a FAT32 entry are reserved' >
											<exp exp='cluster = cluster &amp; 0x0FFFFFFF' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Overwrite FAT entry' macro='WriteByteToBuffer' >
									<argument exp='.offset' />
									<argument exp='0' />
								</command>
								<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
									<argument exp='.offset + 1' />
									<argument exp='0' />
								</command>
								<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
									<flowline >
										<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
											<argument exp='.offset + 2' />
											<argument exp='0' />
										</command>
										<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
											<argument exp='.offset + 3' />
											<argument exp='0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Changes to write back?' exp='.loaded != 0' swap='0' >
							<flowline >
								<command class_type='call' title='Write changes to FAT' macro='SendBuffer' >
									<argument exp='.loaded' />
								</command>
								<command class_type='call' title='Mirror onto FAT2' macro='SendBuffer' >
									<argument exp='.loaded + fat_size' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = ACK_OK' />
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadByteFromIndex' description='Reads an arbitrary byte of data from the current open file.&#10;Return = Data byte read from the local sector buffer. ' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Address' type='u32' description='Contains the position of the byte to be read from the file' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='SectorAddress' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='ByteAddress' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculate File Sector Address' >
							<exp exp='.SectorAddress = (.Address &gt;&gt; 9) + 1' />
						</command>
						<command class_type='calculation' title='Calculate Byte Address' >
							<exp exp='.ByteAddress = .Address &amp; 0x1FF' />
						</command>
						<command class_type='decision' title='Not currently in the right sector?' exp='.SectorAddress != file_sector[file_idx]' swap='0' >
							<flowline >
								<command class_type='call' title='Move there by following the FAT' macro='Seek_File_Sector' >
									<argument exp='.SectorAddress' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='read_address[file_idx] = .ByteAddress + 1' />
						</command>
						<command class_type='call' title='Read Data Byte' macro='ReadByteFromBuffer' >
							<return exp='.Return' />
							<argument exp='.ByteAddress' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Initialise' description='' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='temp_str' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<command class_type='calculation' title='Calculation' >
							<exp exp='sim_folder_path_0 = &quot;&quot;' />
							<exp exp='sim_folder_path_1 = &quot;&quot;' />
							<exp exp='sim_folder_path_2 = &quot;&quot;' />
							<exp exp='sim_folder_path_3 = &quot;&quot;' />
							<exp exp='sim_folder_path_4 = &quot;&quot;' />
						</command>
						<command class_type='call' title='Call Macro' macro='sim_LoadHighSpeedPrescaleOptions' />
						<command class_type='sim' title='Simulation' component='cal_spi' macro='GetList' >
							<return exp='.temp_str' />
							<argument exp='&quot;PR_SCALE&quot;' />
						</command>
						<command class_type='sim' title='Simulation' macro='Component.Property.SetFilter' >
							<argument exp='this' />
							<argument exp='&quot;PR_SCALE&quot;' />
							<argument exp='.temp_str' />
						</command>
						<command class_type='sim' title='Simulation' macro='Component.Property.SetFilter' >
							<argument exp='this' />
							<argument exp='&quot;PR_SCALE2&quot;' />
							<argument exp='.temp_str' />
						</command>
						<command class_type='sim' title='Simulation' macro='Console.AddText' >
							<return exp='ConsoleHandle' />
							<argument exp='&quot;FAT Data&quot;' />
							<argument exp='0' />
						</command>
						<command class_type='sim' title='Simulation' macro='Console.AddMemory' >
							<return exp='ConsoleBufferHandle' />
							<argument exp='&quot;FAT Buffer&quot;' />
							<argument exp='512' />
							<argument exp='16' />
							<argument exp='0' />
							<argument exp='0' />
						</command>
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='SetConsoleHandle' >
							<argument exp='ConsoleHandle' />
						</command>
						<command class_type='sim' title='Simulation' macro='Component.Property.SetValue' >
							<argument exp='this' />
							<argument exp='&quot;IsSim&quot;' />
							<argument exp='0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='AppendLongArrayToFile' description='Adds a binary Long array to the end of the file.&#13;&#10;Returns 0 for success.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Data' type='u32' description='Binary data array to append to the file' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' >
							<array size='1000' />
						</param>
						<param name='Length' type='u16' description='Number of values to append' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='MSBFirst' type='b1' description='0=LSB then MSB, 1=MSB then LSB' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Idx' type='u16' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Temp' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
							<flowline />
							<flowline >
								<command class_type='call' title='Move to the end of the file' macro='Append_Start' >
									<return exp='.Return' />
								</command>
							</flowline>
						</command>
						<command class_type='loop' title='Loop' type='0' exp='(.Idx &lt; .Length) &amp;&amp; (.Return = 0)' for1='' for3='' >
							<flowline >
								<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' exp='.MSBFirst' swap='0' >
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
													<argument exp='.Data[.idx]' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
													<return exp='.Temp' />
													<argument exp='3' />
												</command>
												<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
													<argument exp='.Data[.idx]' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
													<return exp='.Temp' />
													<argument exp='2' />
												</command>
												<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
													<argument exp='.Data[.idx]' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
													<return exp='.Temp' />
													<argument exp='1' />
												</command>
												<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
													<argument exp='.Data[.idx]' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
													<return exp='.Temp' />
													<argument exp='0' />
												</command>
												<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
											</flowline>
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
													<argument exp='.Data[.idx]' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
													<return exp='.Temp' />
													<argument exp='0' />
												</command>
												<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
													<argument exp='.Data[.idx]' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
													<return exp='.Temp' />
													<argument exp='1' />
												</command>
												<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
													<argument exp='.Data[.idx]' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
													<return exp='.Temp' />
													<argument exp='2' />
												</command>
												<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
													<argument exp='.Data[.idx]' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
													<return exp='.Temp' />
													<argument exp='3' />
												</command>
												<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline >
										<command class_type='decision' title='Decision' exp='.MSBFirst' swap='0' >
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
													<argument exp='.Data[.idx]' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
													<return exp='.Temp' />
													<argument exp='3' />
												</command>
												<command class_type='call' title='User Macro' macro='Append_Byte' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
													<argument exp='.Data[.idx]' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
													<return exp='.Temp' />
													<argument exp='2' />
												</command>
												<command class_type='call' title='User Macro' macro='Append_Byte' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
													<argument exp='.Data[.idx]' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
													<return exp='.Temp' />
													<argument exp='1' />
												</command>
												<command class_type='call' title='User Macro' macro='Append_Byte' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
													<argument exp='.Data[.idx]' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
													<return exp='.Temp' />
													<argument exp='0' />
												</command>
												<command class_type='call' title='User Macro' macro='Append_Byte' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
											</flowline>
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
													<argument exp='.Data[.idx]' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
													<return exp='.Temp' />
													<argument exp='0' />
												</command>
												<command class_type='call' title='User Macro' macro='Append_Byte' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
													<argument exp='.Data[.idx]' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
													<return exp='.Temp' />
													<argument exp='1' />
												</command>
												<command class_type='call' title='User Macro' macro='Append_Byte' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
													<argument exp='.Data[.idx]' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
													<return exp='.Temp' />
													<argument exp='2' />
												</command>
												<command class_type='call' title='User Macro' macro='Append_Byte' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
													<argument exp='.Data[.idx]' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
													<return exp='.Temp' />
													<argument exp='3' />
												</command>
												<command class_type='call' title='User Macro' macro='Append_Byte' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
											</flowline>
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Idx = .Idx + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
							<flowline />
							<flowline >
								<command class_type='call' title='Write to the card and update the file size' macro='Append_End' />
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Send_Command' description='' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Command' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Address' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='i' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='j' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='buf' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='6' />
						</local>
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Enable_CS' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.i = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.i != 0xFF' for1='' for3='' >
							<flowline >
								<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Byte' >
									<return exp='.i' />
									<argument exp='0xFF' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.j = .j + 1' />
								</command>
								<command class_type='decision' title='Timeout' exp='.j = 0xFE' swap='0' >
									<flowline >
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
							<argument exp='.Address' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.buf[0] = .Command | 0x40' />
							<exp exp='.buf[1] = TypeConversions1 :: GetByte (3)' />
							<exp exp='.buf[2] = TypeConversions1 :: GetByte (2)' />
							<exp exp='.buf[3] = TypeConversions1 :: GetByte (1)' />
							<exp exp='.buf[4] = TypeConversions1 :: GetByte (0)' />
						</command>
						<command class_type='decision' title='Decision' exp='.Command = CMD_SEND_IF_COND' swap='0' >
							<flowline >
								<command class_type='calculation' title='Compulsory CRC' >
									<exp exp='.buf[5] = 0x87' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Ignore CRC' >
									<exp exp='.buf[5] = 0x95' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Transaction' >
							<argument exp='.buf' />
							<argument exp='6' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.i = 0xFE' />
						</command>
						<command class_type='loop' title='Wait for response of 1' type='0' exp='.i' start='0' for1='' for3='' >
							<flowline >
								<command class_type='call' title='' component='cal_spi' macro='Master_Byte' >
									<return exp='.Return' />
									<argument exp='0xFF' />
								</command>
								<command class_type='decision' title='Decision' exp='.Return != 0xFF' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.i = 0' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.i = .i - 1' />
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Check Response of Command 58' exp='.Command = CMD_READ_OCR' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='.Return = 0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.buf[0] = 0xFF' />
											<exp exp='.buf[1] = 0xFF' />
											<exp exp='.buf[2] = 0xFF' />
											<exp exp='.buf[3] = 0xFF' />
											<exp exp='.buf[4] = 0xFF' />
										</command>
										<command class_type='call' title='' component='cal_spi' macro='Master_Transaction' >
											<argument exp='.buf' />
											<argument exp='5' />
										</command>
										<command class_type='decision' title='Are we a SDHC card?' exp='.buf[0] &amp; 0x40' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='sdhc_flag = 1' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='sdhc_flag = 0' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='' component='cal_spi' macro='Master_Byte' >
											<argument exp='0xFF' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline >
								<command class_type='call' title='' component='cal_spi' macro='Master_Byte' >
									<argument exp='0xFF' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Disable_CS' />
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadStringFromScan' description='Returns a string of the name of the file or folder retreived from the Scan_Current_folder function.' statediag='0' >
						<return name='Return' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='2000' />
						</return>
						<local name='idx' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='loop' title='Loop' type='0' exp='.idx &lt; 13' for1='' for3='' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return[.idx] = name_ext[.idx]' />
								</command>
								<command class_type='decision' title='Decision' exp='name_ext[.idx] = 0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.idx = 13' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.idx = .idx + 1' />
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_ChipChange' description='Sent when the target device has changed' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Target' type='T8' description='The name of the new target device' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<local name='temp_str' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<command class_type='call' title='Call Macro' macro='sim_LoadHighSpeedPrescaleOptions' />
						<command class_type='sim' title='Simulation' component='cal_spi' macro='GetList' >
							<return exp='.temp_str' />
							<argument exp='&quot;PR_SCALE&quot;' />
						</command>
						<command class_type='sim' title='Simulation' macro='Component.Property.SetFilter' >
							<argument exp='this' />
							<argument exp='&quot;PR_SCALE&quot;' />
							<argument exp='.temp_str' />
						</command>
						<command class_type='sim' title='Simulation' macro='Component.Property.SetFilter' >
							<argument exp='this' />
							<argument exp='&quot;PR_SCALE2&quot;' />
							<argument exp='.temp_str' />
						</command>
						<command class_type='call' title='Call Macro' macro='CheckAutoConfig' />
					</flowline>
				</macro>
				<macro >
					<flowline name='CreateFile' description='Creates a file in the current folder location on the card. Default = Root&#10;Returns 0 for success&#10;File must be opened using &quot;Open_File&quot; after creation before writing any data.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Filename' type='T8*' description='8.3 format filename e.g.&quot;file.txt&quot;' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='13' />
						</param>
						<local name='i' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='j' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='idx' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Convert filename to 8.3 format' macro='Format_File_String' >
							<argument exp='.Filename' />
						</command>
						<command class_type='call' title='Search the current folder for the name and for a free slot' macro='Find_Folder_Entry' >
							<return exp='.i' />
						</command>
						<command class_type='decision' title='Found?' exp='.i &lt; 16' swap='0' >
							<flowline >
								<command class_type='calculation' title='File already exists' >
									<exp exp='.Return = 0x01' />
								</command>
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='No free slot in the folder?' exp='.i = ERROR_FILE_NOT_FOUND' swap='0' >
							<flowline >
								<command class_type='decision' title='FAT16 root directory? Fixed size, cannot grow' exp='(fat_system = 0) &amp;&amp; (folder_start[file_idx] = root_start)' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return = ERROR_ROOT_FULL' />
										</command>
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Add a new cluster to the end of the folder' macro='Add_Sector_To_File' >
									<return exp='.j' />
								</command>
								<command class_type='decision' title='Card full?' exp='.j != ACK_OK' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return = .j' />
										</command>
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Blank every sector of the new cluster' macro='Clear_Buffer' />
								<command class_type='calculation' title='Calculation' >
									<exp exp='.j = 0' />
								</command>
								<command class_type='loop' title='Loop' type='0' exp='.j &lt; sects_per_clust' for1='' for3='' >
									<flowline >
										<command class_type='call' title='Call Macro' macro='SendBuffer' >
											<argument exp='file_pointer[file_idx] + .j' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.j = .j + 1' />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='First slot of the new cluster' >
									<exp exp='.i = 16' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Read the sector holding the free slot' macro='GetBuffer' >
							<argument exp='file_pointer[file_idx]' />
						</command>
						<command class_type='calculation' title='Position of the free slot in the sector' >
							<exp exp='.idx = (.i - 16) &lt;&lt; 5' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.j = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.j &lt; 11' for1='' for3='' >
							<flowline >
								<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
									<argument exp='.idx' />
									<argument exp='name_ext[.j]' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.j = .j + 1' />
									<exp exp='.idx = .idx + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='File Attribute' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='0x20' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = .idx + 1' />
						</command>
						<command class_type='call' title='Reserved for NT' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='0x18' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = .idx + 1' />
						</command>
						<command class_type='call' title='' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='0' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = .idx + 1' />
						</command>
						<command class_type='call' title='Creation Time' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='CREATE_TIME' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = .idx + 1' />
						</command>
						<command class_type='call' title='' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='CREATE_TIME &gt;&gt; 8' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = .idx + 1' />
						</command>
						<command class_type='call' title='Creation Date' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='CREATE_DATE' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = .idx + 1' />
						</command>
						<command class_type='call' title='' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='CREATE_DATE &gt;&gt; 8' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = .idx + 1' />
						</command>
						<command class_type='call' title='Access Date' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='CREATE_DATE' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = .idx + 1' />
						</command>
						<command class_type='call' title='' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='CREATE_DATE &gt;&gt; 8' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = .idx + 1' />
						</command>
						<command class_type='call' title='' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='0' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = .idx + 1' />
						</command>
						<command class_type='call' title='' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='0' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = .idx + 1' />
						</command>
						<command class_type='call' title='Modified time' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='CREATE_TIME' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = .idx + 1' />
						</command>
						<command class_type='call' title='' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='CREATE_TIME &gt;&gt; 8' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = .idx + 1' />
						</command>
						<command class_type='call' title='Modified date' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='CREATE_DATE' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = .idx + 1' />
						</command>
						<command class_type='call' title='' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='CREATE_DATE &gt;&gt; 8' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = .idx + 1' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.j = 26' />
						</command>
						<command class_type='loop' title='Write sector location and length' type='0' exp='.j &lt; 32' for1='' for3='' >
							<flowline >
								<command class_type='call' title='' macro='WriteByteToBuffer' >
									<argument exp='.idx' />
									<argument exp='0' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.idx = .idx + 1' />
									<exp exp='.j = .j + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Call Macro' macro='SendBuffer' >
							<argument exp='file_pointer[file_idx]' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = ACK_OK' />
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
					</flowline>
				</macro>
				<macro >
					<flowline name='ScanCurrentFolder' description='Method for retreiving file or folder names for the card to allow for dynamic file opening or playback. Does not currently simulate.&#10;0 - Filetype found and stored into string array, 1 - End of folder reached, 2 - Filetype mismatch 3 - Empty' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Current_Idx' type='u16' description='Contains the current pointer in the directory table. Values from 0 to 511 to completley search the current folder for a files or folders' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Scan_Type' type='u8' description='Sets the scan to search for Files or Folders. 0 = Scan for files, 1 = Scan for folders' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='i' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='idx' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='j' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Move to start of folder' >
							<exp exp='file_pointer[file_idx] = folder_start[file_idx]' />
							<exp exp='.i = 0' />
						</command>
						<command class_type='loop' title='While address is not in the current sector and the folder has not ended' type='0' exp='(.Current_Idx &gt;= 16) &amp;&amp; (.i = 0)' for1='' for3='' >
							<flowline >
								<command class_type='calculation' title='Modify Address Value' >
									<exp exp='.Current_Idx = .Current_Idx - 16' />
								</command>
								<command class_type='call' title='Move to next sector in folder' macro='Next_Folder_Sector' >
									<return exp='.i' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Entry is inside the folder?' exp='.i = 0' swap='0' >
							<flowline >
								<command class_type='call' title='Read Sector Of Root Directory' macro='GetBuffer' >
									<argument exp='file_pointer[file_idx]' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.idx = .Current_Idx * 32' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='.idx' />
								</command>
								<command class_type='decision' title='Deleted Entry?' exp='.i = 0xE5' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return = ACK_FILE_EMPTY' />
										</command>
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Unused Entry? Nothing is stored beyond it' exp='.i = 0x00' swap='0' >
									<flowline >
										<command class_type='calculation' title='End of the folder' >
											<exp exp='.Return = ACK_END_OF_FILE' />
										</command>
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='.idx + 2' />
								</command>
								<command class_type='decision' title='Empty Entry?' exp='.i = 0x00' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return = ACK_FILE_EMPTY' />
										</command>
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='.idx + 11' />
								</command>
								<command class_type='decision' title='Files or Folders?' exp='.scan_type' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' exp='(.i &amp; 0x10) = 0' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Return = ACK_FILE_TYPE' />
												</command>
												<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
											</flowline>
											<flowline />
										</command>
									</flowline>
									<flowline >
										<command class_type='decision' title='Decision' exp='(.i &amp; 0x20) = 0' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Return = ACK_FILE_TYPE' />
												</command>
												<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
											</flowline>
											<flowline />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.i = 0' />
								</command>
								<command class_type='loop' title='Read string from address' type='2' exp='11' for1='' for3='' >
									<flowline >
										<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
											<return exp='.j' />
											<argument exp='.idx + .i' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='name_ext[.i] = .j' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.i = .i + 1' />
											<exp exp='' />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Null Termination' >
									<exp exp='name_ext[11] = 0' />
								</command>
								<command class_type='decision' title='If scanning for a file then rearrange filename back to string' exp='.Scan_Type = 0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.i = 0' />
										</command>
										<command class_type='loop' title='Find the end of the 8 character name' type='2' exp='8' for1='' for3='' >
											<flowline >
												<command class_type='decision' title='If the padding space has been found' exp='name_ext[.i] = 0x20' swap='0' >
													<flowline >
														<command class_type='goto' title='Goto Connection Point' labelid='1' labelname='' labeltype='0' />
													</flowline>
													<flowline />
												</command>
												<command class_type='calculation' title='Calculation' >
													<exp exp='.i = .i + 1' />
													<exp exp='' />
												</command>
											</flowline>
										</command>
										<command class_type='label' title='Connection Point' labelid='1' labelname='B' labeltype='4' />
										<command class_type='calculation' title='Add the &apos;.&apos; seperator to the filename' >
											<exp exp='name_ext[.i] = &apos;.&apos;' />
										</command>
										<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
											<return exp='.j' />
											<argument exp='.idx + 8' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='name_ext[.i + 1] = .j' />
										</command>
										<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
											<return exp='.j' />
											<argument exp='.idx + 9' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='name_ext[.i + 2] = .j' />
										</command>
										<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
											<return exp='.j' />
											<argument exp='.idx + 10' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='name_ext[.i + 3] = .j' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.i = .i + 4' />
										</command>
										<command class_type='loop' title='Loop' type='0' exp='.i &lt; 13' for1='' for3='' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='name_ext[.i] = 0' />
												</command>
												<command class_type='calculation' title='Calculation' >
													<exp exp='.i = .i + 1' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = ACK_OK' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = ACK_END_OF_FILE' />
								</command>
							</flowline>
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
					</flowline>
				</macro>
				<macro >
					<flowline name='SendBuffer' description='' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Address' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='idx' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='Decision' exp='sdhc_flag = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Address = .Address &lt;&lt; 9' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Call Macro' macro='Send_Command' >
							<return exp='.Return' />
							<argument exp='CMD_WRITE_SINGLE_BLOCK' />
							<argument exp='.Address' />
						</command>
						<command class_type='decision' title='Decision' exp='.Return' swap='0' >
							<flowline >
								<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Disable_CS' />
								<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Byte' >
									<argument exp='0xFF' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = ERROR_NO_ACK' />
								</command>
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Enable_CS' />
						<command class_type='call' title='Send Start Byte' component='cal_spi' macro='Master_Byte' >
							<argument exp='0xFE' />
						</command>
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Transaction' >
							<argument exp='card_buffer_l' />
							<argument exp='256' />
						</command>
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Transaction' >
							<argument exp='card_buffer_h' />
							<argument exp='256' />
						</command>
						<command class_type='call' title='Send two dummy bytes to skip CRC' component='cal_spi' macro='Master_Byte' >
							<argument exp='0xFF' />
						</command>
						<command class_type='call' title='' component='cal_spi' macro='Master_Byte' >
							<argument exp='0xFF' />
						</command>
						<command class_type='call' title='Check if card is still busy' component='cal_spi' macro='Master_Byte' >
							<return exp='.Return' />
							<argument exp='0xFF' />
						</command>
						<command class_type='decision' title='Decision' exp='(.Return &amp; 0x1F) != 0x05' swap='0' >
							<flowline >
								<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Disable_CS' />
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = ERROR_TIMEOUT' />
								</command>
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = 0' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='loop' title='Wait for card to complete write cycle' type='0' exp='.Return = 0' for1='' for3='' >
							<flowline >
								<command class_type='call' title='Check if card is still busy' component='cal_spi' macro='Master_Byte' >
									<return exp='.Return' />
									<argument exp='0xFF' />
								</command>
								<command class_type='decision' title='Decision' exp='.Return' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.idx = .idx + 1' />
										</command>
										<command class_type='decision' title='Decision' exp='.idx &gt; 0xFFFE' swap='0' >
											<flowline >
												<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Disable_CS' />
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Return = ERROR_TIMEOUT' />
												</command>
												<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
											</flowline>
											<flowline />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Disable_CS' />
						<command class_type='call' title='' component='cal_spi' macro='Master_Byte' >
							<argument exp='0xFF' />
						</command>
						<command class_type='comment' title='' comment='Not sure how often this double check is needed but for now leave it in.' textarea='12,0,12,0' />
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Enable_CS' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = 0' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='loop' title='Double check card is no longer busy' type='0' exp='.Return = 0' for1='' for3='' >
							<flowline >
								<command class_type='call' title='Check if card is still busy' component='cal_spi' macro='Master_Byte' >
									<return exp='.Return' />
									<argument exp='0xFF' />
								</command>
								<command class_type='decision' title='Decision' exp='.Return' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.idx = .idx + 1' />
										</command>
										<command class_type='decision' title='Decision' exp='.idx &gt; 0xFFFE' swap='0' >
											<flowline >
												<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Disable_CS' />
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Return = ERROR_TIMEOUT' />
												</command>
												<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
											</flowline>
											<flowline />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Disable_CS' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = ACK_OK' />
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Seek_File_Sector' description='Moves to a sector of the open file by following the cluster chain in the FAT, then loads that sector into the local sector buffer.&#10;Sectors in between are not read. Moving backwards restarts from the first cluster of the file.&#10;Returns 0 for success, 1 if the file ends before the target sector (the last sector is loaded instead).' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Target' type='u32' description='Sector of the file to move to, 1 = first sector' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='next' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='fat_address' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='loaded' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='offset' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='j' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = ACK_OK' />
							<exp exp='.loaded = 0' />
						</command>
						<command class_type='decision' title='Target is behind the current position?' exp='.Target &lt; file_sector[file_idx]' swap='0' >
							<flowline >
								<command class_type='calculation' title='Restart from the first cluster of the file' >
									<exp exp='file_pointer[file_idx] = ((file_start[file_idx] - 2) * sects_per_clust) + data_start' />
									<exp exp='file_sector[file_idx] = 1' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='loop' title='Step through the file until the target sector is reached' type='0' exp='(file_sector[file_idx] &lt; .Target) &amp;&amp; (.Return = ACK_OK)' for1='' for3='' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.next = file_pointer[file_idx] + 1' />
								</command>
								<command class_type='decision' title='Still inside the current cluster?' exp='((.next - data_start) &amp; (sects_per_clust - 1)) != 0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Move to next sector in file' >
											<exp exp='file_pointer[file_idx] = .next' />
											<exp exp='file_sector[file_idx] = file_sector[file_idx] + 1' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Cluster holding the current sector' >
											<exp exp='.next = ((file_pointer[file_idx] - data_start) / sects_per_clust) + 2' />
										</command>
										<command class_type='calculation' title='Locate the FAT entry for this cluster' >
											<exp exp='.fat_address = fat_start + (.next / fats_per_sector)' />
											<exp exp='.offset = (.next &amp; (fats_per_sector - 1)) * sector_address_length' />
										</command>
										<command class_type='decision' title='FAT sector not in the buffer yet?' exp='.fat_address != .loaded' swap='0' >
											<flowline >
												<command class_type='call' title='Read FAT sector' macro='GetBuffer' >
													<argument exp='.fat_address' />
												</command>
												<command class_type='calculation' title='Calculation' >
													<exp exp='.loaded = .fat_address' />
												</command>
											</flowline>
											<flowline />
										</command>
										<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
											<return exp='.j' />
											<argument exp='.offset' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
											<argument exp='0' />
											<argument exp='.j' />
										</command>
										<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
											<return exp='.j' />
											<argument exp='.offset + 1' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
											<argument exp='1' />
											<argument exp='.j' />
										</command>
										<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
											<flowline >
												<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
													<return exp='.j' />
													<argument exp='.offset + 2' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='2' />
													<argument exp='.j' />
												</command>
												<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
													<return exp='.j' />
													<argument exp='.offset + 3' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='3' />
													<argument exp='.j' />
												</command>
											</flowline>
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='2' />
													<argument exp='0' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='3' />
													<argument exp='0' />
												</command>
											</flowline>
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetLong' >
											<return exp='.next' />
										</command>
										<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
											<flowline >
												<command class_type='calculation' title='Top 4 bits of a FAT32 entry are reserved' >
													<exp exp='.next = .next &amp; 0x0FFFFFFF' />
												</command>
											</flowline>
											<flowline />
										</command>
										<command class_type='decision' title='Another cluster in the chain?' exp='(.next &gt; 1) &amp;&amp; (.next &lt; not_address_marker)' swap='0' >
											<flowline >
												<command class_type='calculation' title='Move to first sector of the next cluster' >
													<exp exp='file_pointer[file_idx] = ((.next - 2) * sects_per_clust) + data_start' />
													<exp exp='file_sector[file_idx] = file_sector[file_idx] + 1' />
												</command>
											</flowline>
											<flowline >
												<command class_type='decision' title='End of file marker?' exp='.next &gt; eof_marker' swap='0' >
													<flowline >
														<command class_type='calculation' title='End of file' >
															<exp exp='.Return = ACK_END_OF_FILE' />
														</command>
													</flowline>
													<flowline >
														<command class_type='decision' title='Bad cluster marker?' exp='.next = eof_marker' swap='0' >
															<flowline >
																<command class_type='calculation' title='Bad cluster' >
																	<exp exp='.Return = ERROR_BAD_CLUSTER' />
																</command>
															</flowline>
															<flowline >
																<command class_type='decision' title='Free cluster in the chain?' exp='.next &lt; 2' swap='0' >
																	<flowline >
																		<command class_type='calculation' title='Reserved Cluster - FAT error' >
																			<exp exp='.Return = ERROR_FREE_SECTOR' />
																		</command>
																	</flowline>
																	<flowline >
																		<command class_type='calculation' title='Calculation' >
																			<exp exp='.Return = ERROR_RESERVED' />
																		</command>
																	</flowline>
																</command>
															</flowline>
														</command>
													</flowline>
												</command>
											</flowline>
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Load the sector into the buffer' macro='GetBuffer' >
							<return exp='.j' />
							<argument exp='file_pointer[file_idx]' />
						</command>
						<command class_type='decision' title='Decision' exp='.Return = ACK_OK' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = .j' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Bytes of file data in this sector' macro='ReadFileLength' >
							<return exp='sector_bytes' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='sim_open_file' description='' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Filename' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='12' />
						</param>
						<local name='i' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Filepath' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='512' />
						</local>
						<local name='count' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='temp_str' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='1' />
						</local>
						<local name='char' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Len' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashRx' />
						<command class_type='sim' title='Panel' macro='File.Flush' >
							<argument exp='file_handle[file_idx]' />
						</command>
						<command class_type='sim' title='Scrub File Handle' macro='System.DeleteHandle' >
							<argument exp='file_handle[file_idx]' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Len = Length$ (root_dir)' />
							<exp exp='.char = root_dir[.Len - 1]' />
						</command>
						<command class_type='decision' title='Decision' exp='(.char = &apos;)&apos;) || (.char = &apos;\\&apos;)' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Filepath = root_dir' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Filepath = root_dir + &quot;\\&quot;' />
								</command>
							</flowline>
						</command>
						<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='file_idx' >
							<case >
								<flowline >
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='.i = Length$ (sim_folder_path_0)' />
									</command>
									<command class_type='decision' title='Decision' exp='.i' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Filepath = .Filepath + sim_folder_path_0' />
											</command>
										</flowline>
										<flowline />
									</command>
								</flowline>
							</case>
							<case exp='1' >
								<flowline >
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='.i = Length$ (sim_folder_path_1)' />
									</command>
									<command class_type='decision' title='Decision' exp='.i' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Filepath = .Filepath + sim_folder_path_1' />
											</command>
										</flowline>
										<flowline />
									</command>
								</flowline>
							</case>
							<case exp='2' >
								<flowline >
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='.i = Length$ (sim_folder_path_2)' />
									</command>
									<command class_type='decision' title='Decision' exp='.i' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Filepath = .Filepath + sim_folder_path_2' />
											</command>
										</flowline>
										<flowline />
									</command>
								</flowline>
							</case>
							<case exp='3' >
								<flowline >
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='.i = Length$ (sim_folder_path_3)' />
									</command>
									<command class_type='decision' title='Decision' exp='.i' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Filepath = .Filepath + sim_folder_path_3' />
											</command>
										</flowline>
										<flowline />
									</command>
								</flowline>
							</case>
							<case exp='4' >
								<flowline >
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='.i = Length$ (sim_folder_path_4)' />
									</command>
									<command class_type='decision' title='Decision' exp='.i' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Filepath = .Filepath + sim_folder_path_4' />
											</command>
										</flowline>
										<flowline />
									</command>
								</flowline>
							</case>
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Filepath = .Filepath + .Filename' />
						</command>
						<command class_type='sim' title='Simulation' macro='Console.WriteText' >
							<argument exp='ConsoleHandle' />
							<argument exp='&quot;Open File: &quot; + .Filepath + &quot; - &quot;' />
						</command>
						<command class_type='sim' title='Panel' macro='File.GetType' >
							<return exp='.i' />
							<argument exp='.Filepath' />
						</command>
						<command class_type='decision' title='Decision' exp='.i = 1' swap='0' >
							<flowline >
								<command class_type='sim' title='Panel' macro='File.GetSize' >
									<return exp='file_size[file_idx]' />
									<argument exp='.Filepath' />
								</command>
								<command class_type='sim' title='Simulation' disable='1' macro='Debug.PrintLn' >
									<argument exp='&quot;Filesize &quot; + STRING file_size[file_idx]' />
								</command>
								<command class_type='sim' title='Panel' macro='File.Open' >
									<return exp='file_handle[file_idx]' />
									<argument exp='.Filepath' />
									<argument exp='1' />
									<argument exp='1' />
									<argument exp='0' />
								</command>
								<command class_type='sim' title='Panel' macro='File.SetPos' >
									<argument exp='file_handle[file_idx]' />
									<argument exp='file_size[file_idx]' />
									<argument exp='0' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='file_sector[file_idx] = 0' />
								</command>
								<command class_type='call' title='Call Macro' macro='sim_read_file_sector' />
								<command class_type='calculation' title='Calculation' >
									<exp exp='read_address[file_idx] = 0' />
								</command>
								<command class_type='sim' title='Simulation' macro='Console.WriteText' >
									<argument exp='ConsoleHandle' />
									<argument exp='&quot;OK - Filesize: &quot; + STRING file_size[file_idx] + &quot; Bytes\n&quot;' />
								</command>
								<command class_type='calculation' title='File open correctly' >
									<exp exp='.Return = 0x00' />
								</command>
							</flowline>
							<flowline >
								<command class_type='sim' title='Simulation' macro='Console.WriteText' >
									<argument exp='ConsoleHandle' />
									<argument exp='&quot;Error File Not Found\n&quot;' />
								</command>
								<command class_type='calculation' title='File not found' >
									<exp exp='.Return = ERROR_FILE_NOT_FOUND' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadByteFromScan' description='Returns a byte of the name of the file or folder retreived from the Scan_Current_folder function.&#10;Return = ASCII byte at position Idx from the folder name or file name at position Current_Idx in the directory' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='idx' type='u8' description='0 - 11 for a file, 0 - 7 for a folder' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='Decision' exp='.idx &gt; 11' swap='0' >
							<flowline >
								<command class_type='calculation' title='Out of bounds - Return 0' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Return Character From String' >
									<exp exp='.Return = name_ext[.idx]' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='GetBuffer' description='' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Address' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='count' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='Decision' exp='sdhc_flag = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Address = .Address &lt;&lt; 9' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Call Macro' macro='Send_Command' >
							<return exp='.Return' />
							<argument exp='CMD_READ_SINGLE_BLOCK' />
							<argument exp='.Address' />
						</command>
						<command class_type='decision' title='Decision' exp='.Return != 0' swap='0' >
							<flowline >
								<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Disable_CS' />
								<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Byte' >
									<argument exp='0xFF' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = ERROR_NO_ACK' />
								</command>
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Enable_CS' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.count = 10000' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='(.Return != 0xFE) &amp;&amp; (.count)' start='0' for1='' for3='' >
							<flowline >
								<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Byte' >
									<return exp='.Return' />
									<argument exp='0xFF' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.count = .count - 1' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' exp='.count = 0' swap='0' >
							<flowline >
								<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Disable_CS' />
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = ERROR_TIMEOUT' />
								</command>
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.count = 0' />
						</command>
						<command class_type='loop' title='Initialise data array' type='0' exp='.count &lt; 256' for1='' for3='' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='card_buffer_l[.count] = 0xFF' />
									<exp exp='card_buffer_h[.count] = 0xFF' />
									<exp exp='.count = .count + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Transaction' >
							<argument exp='card_buffer_l' />
							<argument exp='256' />
						</command>
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Transaction' >
							<argument exp='card_buffer_h' />
							<argument exp='256' />
						</command>
						<command class_type='call' title='Skip 16-bit CRC' component='cal_spi' macro='Master_Byte' >
							<argument exp='0xFF' />
						</command>
						<command class_type='call' title='' component='cal_spi' macro='Master_Byte' >
							<argument exp='0xFF' />
						</command>
						<command class_type='call' title='Trailing Byte' component='cal_spi' macro='Master_Byte' >
							<argument exp='0xFF' />
						</command>
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Disable_CS' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = ACK_OK' />
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
					</flowline>
				</macro>
				<macro >
					<flowline name='sim_append_byte_to_file' description='' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='data' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='i' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='str' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='2' />
						</local>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 1' />
						</command>
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashTx' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.str[0] = .data' />
							<exp exp='.str[1] = 0' />
						</command>
						<command class_type='sim' title='Simulation' macro='Console.WriteText' >
							<argument exp='ConsoleHandle' />
							<argument exp='&quot;Append To File: &quot; + .Str' />
						</command>
						<command class_type='calculation' title='Work out length of string' >
							<exp exp='.i = 1' />
						</command>
						<command class_type='sim' title='Set position in file to EOF' macro='File.SetPos' >
							<argument exp='file_handle[file_idx]' />
							<argument exp='0' />
							<argument exp='::File .Seek_End' />
						</command>
						<command class_type='sim' title='Append data to file' macro='File.WriteArray' >
							<argument exp='file_handle[file_idx]' />
							<argument exp='.Str' />
							<argument exp='.i' />
						</command>
						<command class_type='calculation' title='Add new data to file size' >
							<exp exp='file_size[file_idx] = file_size[file_idx] + .i' />
						</command>
						<command class_type='sim' title='Append data to file' macro='File.Flush' >
							<argument exp='file_handle[file_idx]' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Init_Card' description='' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='sd_version' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='idx' type='s16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Init SPI' component='cal_spi' macro='Master_Init' />
						<command class_type='call' title='Set to initial SPI rate' component='cal_spi' macro='SetPrescaler' >
							<argument exp='PR_SCALE' />
						</command>
						<command class_type='delay' title='Wait for Card to power up' exp='50' type='1' />
						<command class_type='loop' title='Loop' type='2' exp='10' for1='' for3='' >
							<flowline >
								<command class_type='call' title='Send 10 * 8 clock pulses' component='cal_spi' macro='Master_Byte' >
									<argument exp='0xFF' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Enable_CS' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.Return != 0x01' start='0' for1='' for3='' >
							<flowline >
								<command class_type='call' title='Resets Card' macro='Send_Command' >
									<return exp='.Return' />
									<argument exp='CMD_GO_IDLE_STATE' />
									<argument exp='0' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.idx = .idx + 1' />
								</command>
								<command class_type='decision' title='Decision' exp='.idx &gt; 0x20' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return = ERROR_NO_CARD' />
										</command>
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Disable_CS' />
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Byte' >
							<argument exp='0xFF' />
						</command>
						<command class_type='call' title='Call Component Macro' component='cal_spi' macro='Master_Byte' >
							<argument exp='0xFF' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.sd_version = 2' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.Return != 0x01' start='0' for1='' for3='' >
							<flowline >
								<command class_type='call' title='Call Macro' macro='Send_Command' >
									<return exp='.Return' />
									<argument exp='CMD_SEND_IF_COND' />
									<argument exp='0x01AA' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.idx = .idx + 1' />
								</command>
								<command class_type='decision' title='Decision' exp='.idx &gt; 0xFE' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.sd_version = 1' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='card_type = 1' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return = 0x01' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.Return != 0x00' start='0' for1='' for3='' >
							<flowline >
								<command class_type='call' title='Call Macro' macro='Send_Command' >
									<return exp='.Return' />
									<argument exp='CMD_APP' />
									<argument exp='0' />
								</command>
								<command class_type='call' title='Call Macro' macro='Send_Command' >
									<return exp='.Return' />
									<argument exp='CMD_SEND_OP_COND' />
									<argument exp='0x40000000' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.idx = .idx + 1' />
								</command>
								<command class_type='decision' title='Decision' exp='.idx &gt; 512' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' disable='1' >
											<exp exp='.Return = 0' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return = ERROR_NO_RESPONSE' />
										</command>
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = 0' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='sdhc_flag = 0' />
						</command>
						<command class_type='decision' title='Decision' exp='.sd_version = 2' swap='0' >
							<flowline >
								<command class_type='loop' title='Loop' type='0' exp='.Return != 0' start='0' for1='' for3='' >
									<flowline >
										<command class_type='call' title='Call Macro' macro='Send_Command' >
											<return exp='.Return' />
											<argument exp='CMD_READ_OCR' />
											<argument exp='0' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.idx = .idx + 1' />
										</command>
										<command class_type='decision' title='Decision' exp='.idx &gt; 0xFE' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='card_type = 0' />
												</command>
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Return = 0' />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Decision' exp='sdhc_flag = 1' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='card_type = 2' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='card_type = 3' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Set to max SPI rate' component='cal_spi' macro='SetPrescaler' >
							<argument exp='PR_SCALE2' />
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadTime' description='' statediag='0' dllpath='$(appdir)API.DLL\DateTime.dll' dllcall='115' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Unit' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Append_Start' description='Moves to the end of the open file ready for Append_Byte. Returns 0 for success.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='target' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='append_offset = 0xFFFF' />
							<exp exp='.target = (file_size[file_idx] &gt;&gt; 9) + 1' />
							<exp exp='.Return = ACK_OK' />
						</command>
						<command class_type='decision' title='Not already in the last sector of the file?' exp='.target != file_sector[file_idx]' swap='0' >
							<flowline >
								<command class_type='call' title='Move there by following the FAT' macro='Seek_File_Sector' >
									<return exp='.Return' />
									<argument exp='.target' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='File ends exactly at the end of its last cluster?' exp='.Return = ACK_END_OF_FILE' swap='0' >
							<flowline >
								<command class_type='call' title='Add a new cluster to the file' macro='Add_Sector_To_File' >
									<return exp='.Return' />
								</command>
								<command class_type='decision' title='Decision' exp='.Return = ACK_OK' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='append_offset = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline >
								<command class_type='decision' title='Decision' exp='.Return = ACK_OK' swap='0' >
									<flowline >
										<command class_type='calculation' title='Next free byte in the sector' >
											<exp exp='append_offset = file_size[file_idx] &amp; 0x1FF' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Add_Sector_To_File' description='Finds a free cluster, links it onto the chain after the cluster holding the current sector and loads its first sector.&#10;Returns 0 for success or ERROR_CARD_FULL if every cluster is in use, in which case nothing is changed.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='cand' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='fat_address' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='offset' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='j' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Cluster holding the current sector' >
							<exp exp='.Return = ERROR_CARD_FULL' />
							<exp exp='cluster = ((file_pointer[file_idx] - data_start) / sects_per_clust) + 2' />
						</command>
						<command class_type='call' title='Find a free cluster, starting after the current one' macro='Find_Free_Cluster' >
							<return exp='.cand' />
							<argument exp='cluster' />
						</command>
						<command class_type='decision' title='Card full?' exp='.cand = 0' swap='0' >
							<flowline >
								<command class_type='call' title='Put the current sector back in the buffer' macro='GetBuffer' >
									<argument exp='file_pointer[file_idx]' />
								</command>
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Locate the FAT entry for this cluster' >
							<exp exp='.fat_address = fat_start + (.cand / fats_per_sector)' />
							<exp exp='.offset = (.cand &amp; (fats_per_sector - 1)) * sector_address_length' />
						</command>
						<command class_type='call' title='Write EOF marker into new FAT address' macro='WriteByteToBuffer' >
							<argument exp='.offset' />
							<argument exp='0xFF' />
						</command>
						<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
							<argument exp='.offset + 1' />
							<argument exp='0xFF' />
						</command>
						<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
							<flowline >
								<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
									<argument exp='.offset + 2' />
									<argument exp='0xFF' />
								</command>
								<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
									<argument exp='.offset + 3' />
									<argument exp='0x0F' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Entry for the current cluster is in a different FAT sector?' exp='.fat_address != (fat_start + (cluster / fats_per_sector))' swap='0' >
							<flowline >
								<command class_type='call' title='Write changes to FAT' macro='SendBuffer' >
									<argument exp='.fat_address' />
								</command>
								<command class_type='call' title='Mirror onto FAT2' macro='SendBuffer' >
									<argument exp='.fat_address + fat_size' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.fat_address = fat_start + (cluster / fats_per_sector)' />
								</command>
								<command class_type='call' title='Read FAT sector' macro='GetBuffer' >
									<argument exp='.fat_address' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Position of the entry for the current cluster' >
							<exp exp='.offset = (cluster &amp; (fats_per_sector - 1)) * sector_address_length' />
						</command>
						<command class_type='call' title='Link the current cluster to the new one' component='TypeConversions1' macro='SetLong' >
							<argument exp='.cand' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
							<return exp='.j' />
							<argument exp='0' />
						</command>
						<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
							<argument exp='.offset' />
							<argument exp='.j' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
							<return exp='.j' />
							<argument exp='1' />
						</command>
						<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
							<argument exp='.offset + 1' />
							<argument exp='.j' />
						</command>
						<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
							<flowline >
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
									<return exp='.j' />
									<argument exp='2' />
								</command>
								<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
									<argument exp='.offset + 2' />
									<argument exp='.j' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
									<return exp='.j' />
									<argument exp='3' />
								</command>
								<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
