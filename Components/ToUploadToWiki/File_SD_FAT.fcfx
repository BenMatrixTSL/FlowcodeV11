									<argument exp='0x17' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='1' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetInt' >
									<return exp='fat_size' />
									<argument exp='0' />
								</command>
								<command class_type='calculation' title='Start address of root directory' >
									<exp exp='root_start = (.num_fats * fat_size) + fat_start' />
								</command>
								<command class_type='calculation' title='Start address of data clusters in sectors' >
									<exp exp='data_start = root_start + root_sectors' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Total sectors on the volume, 16-bit field' macro='ReadByteFromBuffer' >
							<return exp='.i' />
							<argument exp='0x13' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
