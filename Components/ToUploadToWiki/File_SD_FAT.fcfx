							<argument exp='.fat_address + fat_size' />
						</command>
						<command class_type='calculation' title='Move to first sector of the new cluster' >
							<exp exp='cluster = .cand' />
							<exp exp='file_sector[file_idx] = file_sector[file_idx] + 1' />
							<exp exp='file_pointer[file_idx] = ((cluster - 2) * sects_per_clust) + data_start' />
						</command>
						<command class_type='call' title='Load next sector into buffer' macro='GetBuffer' >
							<argument exp='file_pointer[file_idx]' />
						</command>
						<command class_type='call' title='Bytes of file data in this sector' macro='ReadFileLength' >
							<return exp='sector_bytes' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = ACK_OK' />
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
					</flowline>
