								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='0x23' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='3' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetLong' >
									<return exp='.total_sectors' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Highest cluster number the FAT has room for' >
							<exp exp='max_cluster = fat_size' />
							<exp exp='max_cluster = (max_cluster * fats_per_sector) - 1' />
						</command>
						<command class_type='decision' title='Volume size known?' exp='.total_sectors &gt; (data_start - .partition_start)' swap='0' >
							<flowline >
								<command class_type='calculation' title='Highest cluster number that fits on the volume' >
									<exp exp='.total_sectors = ((.total_sectors - (data_start - .partition_start)) / sects_per_clust) + 1' />
								</command>
								<command class_type='decision' title='Decision' exp='.total_sectors &lt; max_cluster' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='max_cluster = .total_sectors' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.i = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.i &lt; max_concurrent_files' for1='' for3='' >
							<flowline >
								<command class_type='calculation' title='Reset all file pointers to the root directory' >
									<exp exp='folder_start[.i] = root_start' />
									<exp exp='read_address[.i] = 0' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.i = .i + 1' />
								</command>
							</flowline>
						</command>
