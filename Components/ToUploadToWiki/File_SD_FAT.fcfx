										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
											<argument exp='3' />
											<argument exp='.i' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetLong' >
											<return exp='.root_size' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Number of sectors in root directory' >
									<exp exp='root_sectors = .root_size &gt;&gt; 4' />
								</command>
								<command class_type='call' title='FAT size in sectors' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='0x16' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
