				<macro >
					<flowline name='sim_move_to_next_file_sector' description='' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='force_next_sector' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashRx' />
						<command class_type='sim' title='Simulation' macro='Console.WriteText' >
							<argument exp='ConsoleHandle' />
							<argument exp='&quot;Move To Next File Sector: &quot;' />
						</command>
						<command class_type='decision' title='Decision' exp='file_size[file_idx] &gt; ((file_sector[file_idx] + 1) * 512)' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='file_sector[file_idx] = file_sector[file_idx] + 1' />
								</command>
								<command class_type='sim' title='Simulation' macro='Console.WriteText' >
									<argument exp='ConsoleHandle' />
									<argument exp='&quot;Sector &quot; + STRING file_sector[file_idx] + &quot; of &quot; + STRING (file_size[file_idx] / 512) + &quot;\n&quot;' />
								</command>
								<command class_type='call' title='Try to move to the next sector' macro='sim_read_file_sector' >
									<return exp='.Return' />
								</command>
							</flowline>
							<flowline >
								<command class_type='decision' title='Decision' exp='.force_next_sector' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='file_sector[file_idx] = file_sector[file_idx] + 1' />
										</command>
										<command class_type='sim' title='Simulation' macro='Console.WriteText' >
											<argument exp='ConsoleHandle' />
											<argument exp='&quot;New Sector Appended\n&quot;' />
										</command>
										<command class_type='call' title='Call Macro' disable='1' macro='Clear_Buffer' />
										<command class_type='calculation' title='ACK OK' >
											<exp exp='.Return = ACK_OK' />
										</command>
									</flowline>
									<flowline >
										<command class_type='sim' title='Simulation' macro='Console.WriteText' >
											<argument exp='ConsoleHandle' />
											<argument exp='&quot;End Of File Reached\n&quot;' />
										</command>
										<command class_type='calculation' title='ACK OK' >
											<exp exp='.Return = ACK_END_OF_FILE' />
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='sim_LoadHighSpeedPrescaleOptions' description='Modified version of SPI Prescalers to pass the index rather than the value' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<local name='DeviceFamily' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<local name='PrescaleStr' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<command class_type='sim' title='Simulation' macro='FCD.GetItemValue' >
							<return exp='.DeviceFamily' />
							<argument exp='&quot;device&quot;' />
							<argument exp='&quot;product&quot;' />
							<argument exp='&quot;&quot;' />
						</command>
						<command class_type='decision' title='Decision' exp='(Compare$ (&quot;PIC&quot;, .DeviceFamily,1) == 0)' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.PrescaleStr = &quot;000Fosc/4\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;001Fosc/16\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;002Fosc/64&quot;' />
								</command>
								<command class_type='sim' title='Simulation' macro='Component.Property.SetFilter' >
									<argument exp='this' />
									<argument exp='&quot;PR_SCALE2&quot;' />
									<argument exp='.PrescaleStr' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='(Compare$ (&quot;PIC16&quot;, .DeviceFamily,1) == 0)' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.PrescaleStr = &quot;000Fosc/2\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;001Fosc/4\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;002Fosc/6\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;003Fosc/8\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;004Fosc/12\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;005Fosc/16\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;006Fosc/20\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;007Fosc/24\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;008Fosc/28\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;009Fosc/32\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;010Fosc/48\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;011Fosc/64\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;012Fosc/128\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;013Fosc/192\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;014Fosc/256\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;015Fosc/512&quot;' />
								</command>
								<command class_type='sim' title='Simulation' macro='Component.Property.SetFilter' >
									<argument exp='this' />
									<argument exp='&quot;PR_SCALE2&quot;' />
									<argument exp='.PrescaleStr' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (&quot;AVR&quot;, .DeviceFamily,1) == 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.PrescaleStr = &quot;000Fosc/2\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;001Fosc/4\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;002Fosc/8\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;003Fosc/16\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;004Fosc/32\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;005Fosc/64\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;006Fosc/128&quot;' />
								</command>
								<command class_type='sim' title='Simulation' macro='Component.Property.SetFilter' >
									<argument exp='this' />
									<argument exp='&quot;PR_SCALE2&quot;' />
									<argument exp='.PrescaleStr' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (&quot;ARM&quot;, .DeviceFamily,1) == 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;000Fosc/4\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;001Fosc/6\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;002Fosc/12\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;003Fosc/16\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;004Fosc/24\n&quot;' />
									<exp exp='.PrescaleStr = .PrescaleStr + &quot;005Fosc/48&quot;' />
								</command>
								<command class_type='sim' title='Simulation' macro='Component.Property.SetFilter' >
									<argument exp='this' />
									<argument exp='&quot;PR_SCALE2&quot;' />
									<argument exp='.PrescaleStr' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Next_Folder_Sector' description='Moves file_pointer on to the next sector of the current folder, following the cluster chain in the FAT where required.&#10;Overwrites the local sector buffer when a FAT sector has to be read.&#10;Returns 0 if file_pointer now holds the next sector, 1 if the end of the folder has been reached.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='next_sector' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='clust' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='fat_address' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='offset' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='j' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = ACK_END_OF_FILE' />
							<exp exp='.next_sector = file_pointer[file_idx] + 1' />
						</command>
						<command class_type='decision' title='FAT16 root directory? Fixed size and not part of a cluster chain' exp='(fat_system = 0) &amp;&amp; (folder_start[file_idx] = root_start)' swap='0' >
							<flowline >
								<command class_type='decision' title='Still inside the root directory?' exp='.next_sector &lt; (root_start + root_sectors)' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='file_pointer[file_idx] = .next_sector' />
											<exp exp='.Return = ACK_OK' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline >
								<command class_type='decision' title='Still inside the current cluster?' exp='((.next_sector - data_start) &amp; (sects_per_clust - 1)) != 0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='file_pointer[file_idx] = .next_sector' />
											<exp exp='.Return = ACK_OK' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Cluster holding the current folder sector' >
											<exp exp='.clust = ((file_pointer[file_idx] - data_start) / sects_per_clust) + 2' />
										</command>
										<command class_type='calculation' title='Locate the FAT entry for this cluster' >
											<exp exp='.fat_address = fat_start + (.clust / fats_per_sector)' />
											<exp exp='.offset = (.clust &amp; (fats_per_sector - 1)) * sector_address_length' />
										</command>
										<command class_type='call' title='Read FAT sector' macro='GetBuffer' >
											<return exp='.j' />
											<argument exp='.fat_address' />
										</command>
										<command class_type='decision' title='FAT sector read OK?' exp='.j = ACK_OK' swap='0' >
											<flowline >
												<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
													<return exp='.j' />
													<argument exp='.offset' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='0' />
													<argument exp='.j' />
												</command>
												<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
													<return exp='.j' />
													<argument exp='.offset + 1' />
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='1' />
													<argument exp='.j' />
												</command>
												<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
													<flowline >
														<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
															<return exp='.j' />
															<argument exp='.offset + 2' />
														</command>
														<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
															<argument exp='2' />
															<argument exp='.j' />
														</command>
														<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
															<return exp='.j' />
															<argument exp='.offset + 3' />
														</command>
														<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
															<argument exp='3' />
															<argument exp='.j' />
														</command>
													</flowline>
													<flowline >
														<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
															<argument exp='2' />
															<argument exp='0' />
														</command>
														<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
															<argument exp='3' />
															<argument exp='0' />
														</command>
													</flowline>
												</command>
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetLong' >
													<return exp='.clust' />
												</command>
												<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
													<flowline >
														<command class_type='calculation' title='Top 4 bits of a FAT32 entry are reserved' >
															<exp exp='.clust = .clust &amp; 0x0FFFFFFF' />
														</command>
													</flowline>
													<flowline />
												</command>
												<command class_type='decision' title='Another cluster in the chain?' exp='(.clust &gt; 1) &amp;&amp; (.clust &lt; not_address_marker)' swap='0' >
													<flowline >
														<command class_type='calculation' title='Move to first sector of the next cluster' >
															<exp exp='file_pointer[file_idx] = ((.clust - 2) * sects_per_clust) + data_start' />
															<exp exp='.Return = ACK_OK' />
														</command>
													</flowline>
													<flowline />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='OpenFolder' description='&quot;..&quot; - Jumps up a directory, if at root then remains in root&#10;&quot;root&quot; - Jumps directly back to the root directory&#10;&quot;foldername&quot; - Opens folder named foldername' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Folder_Name' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='13' />
						</param>
						<local name='i' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='idx' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='j' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='Root Directory?' exp='(.Folder_Name[0] = &apos;r&apos;) || (.Folder_Name[0] = &apos;R&apos;)' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='(.Folder_Name[1] = &apos;o&apos;) || (.Folder_Name[1] = &apos;O&apos;)' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' exp='(.Folder_Name[2] = &apos;o&apos;) || (.Folder_Name[2] = &apos;O&apos;)' swap='0' >
											<flowline >
												<command class_type='decision' title='Decision' exp='(.Folder_Name[3] = &apos;t&apos;) || (.Folder_Name[3] = &apos;T&apos;)' swap='0' >
													<flowline >
														<command class_type='calculation' title='Assign Root start address to folder start' >
															<exp exp='folder_start[file_idx] = root_start' />
															<exp exp='.Return = ACK_OK' />
														</command>
														<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
													</flowline>
													<flowline />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Up A Level?' exp='.Folder_Name[0] = &apos;.&apos;' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='.Folder_Name[1] = &apos;.&apos;' swap='0' >
									<flowline >
										<command class_type='calculation' title='Assign search string with &quot;..&quot;' >
											<exp exp='name_ext[0] = 0x2E' />
											<exp exp='name_ext[1] = 0x2E' />
											<exp exp='name_ext[2] = 0x20' />
											<exp exp='name_ext[3] = 0x20' />
											<exp exp='name_ext[4] = 0x20' />
											<exp exp='name_ext[5] = 0x20' />
											<exp exp='name_ext[6] = 0x20' />
											<exp exp='name_ext[7] = 0x20' />
											<exp exp='name_ext[8] = 0x20' />
											<exp exp='name_ext[9] = 0x20' />
											<exp exp='name_ext[10] = 0x20' />
											<exp exp='name_ext[11] = 0' />
										</command>
										<command class_type='goto' title='Goto Connection Point' labelid='1' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Format folder string to match 8 character folder name' macro='Format_File_String' >
							<argument exp='.Folder_Name' />
						</command>
						<command class_type='label' title='Connection Point' labelid='1' labelname='B' labeltype='4' />
						<command class_type='call' title='Search the current folder for the name' macro='Find_Folder_Entry' >
							<return exp='.i' />
						</command>
						<command class_type='decision' title='Not found?' exp='.i &gt; 15' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = ERROR_FILE_NOT_FOUND' />
								</command>
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Position of the entry in the sector' >
							<exp exp='.idx = .i &lt;&lt; 5' />
						</command>
						<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
							<return exp='.j' />
							<argument exp='.idx + 26' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
							<argument exp='0' />
							<argument exp='.j' />
						</command>
						<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
							<return exp='.j' />
							<argument exp='.idx + 27' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
							<argument exp='1' />
							<argument exp='.j' />
						</command>
						<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
							<flowline >
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.j' />
									<argument exp='.idx + 20' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='2' />
									<argument exp='.j' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.j' />
									<argument exp='.idx + 21' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='3' />
									<argument exp='.j' />
								</command>
							</flowline>
							<flowline >
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='2' />
									<argument exp='0' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='3' />
									<argument exp='0' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetLong' >
							<return exp='cluster' />
						</command>
						<command class_type='decision' title='Decision' exp='cluster &gt; 1' swap='0' >
							<flowline >
								<command class_type='calculation' title='Assign folder start address' >
									<exp exp='folder_start[file_idx] = data_start + ((cluster - 2) * sects_per_clust)' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Assign folder start address as root start' >
									<exp exp='folder_start[file_idx] = root_start' />
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = ACK_OK' />
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadByteFromBuffer' description='Reads a byte of data from the local sector buffer.&#10;Return = Data byte read from the local sector buffer. ' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Address' type='u16' description='0 - 511 - Contains the position of the byte to be read' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='Decision' exp='.Address &gt; 255' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = card_buffer_h[.Address - 256]' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = card_buffer_l[.Address]' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadFileLength' description='Returns the number of bytes in the current sector that are used by the current open file.&#10;Return = 512 - Sector is filled with file data&#10;Return &lt; 512 - Last sector of the file, Retval specifies how many bytes of data are remaining in the sector' statediag='0' >
						<return name='Return' type='s16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='temp' type='s32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' textarea='36,0,36,55' >
							<exp exp='.temp = (file_sector[file_idx]) &lt;&lt; 9' />
						</command>
						<command class_type='decision' title='If file size is greater then sector limit' exp='.temp &lt;= file_size[file_idx]' swap='0' >
							<flowline >
								<command class_type='calculation' title='Return Sector Full' >
									<exp exp='.Return = 512' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Return Index of Next Byte' >
									<exp exp='.return = file_size[file_idx] &amp; 0x1FF' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Renamed' description='' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Name' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<command class_type='sim' title='' macro='Tree.GetName' >
							<return exp='.Name' />
							<argument exp='this' />
						</command>
						<command class_type='sim' title='' macro='Component.Property.SetValue' >
							<argument exp='LibraryComponent1' />
							<argument exp='&quot;Name&quot;' />
							<argument exp='.Name' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='AppendINTArrayToFile' description='Adds a binary INT array to the end of the file.&#13;&#10;Returns 0 for success.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Data' type='u16' description='Binary data array to append to the file' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' >
							<array size='1000' />
						</param>
						<param name='Length' type='u16' description='Number of values to append' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='MSBFirst' type='b1' description='0=LSB then MSB, 1=MSB then LSB' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Idx' type='u16' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Temp' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
							<flowline />
							<flowline >
								<command class_type='call' title='Move to the end of the file' macro='Append_Start' >
									<return exp='.Return' />
								</command>
							</flowline>
						</command>
						<command class_type='loop' title='Loop' type='0' exp='(.Idx &lt; .Length) &amp;&amp; (.Return = 0)' for1='' for3='' >
							<flowline >
								<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' exp='.MSBFirst' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Temp = .Data[.Idx] &gt;&gt; 8' />
												</command>
												<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Temp = .Data[.Idx]' />
												</command>
												<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Temp = .Data[.Idx]' />
												</command>
												<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Temp = .Data[.Idx] &gt;&gt; 8' />
												</command>
												<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline >
										<command class_type='decision' title='Decision' exp='.MSBFirst' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Temp = .Data[.Idx] &gt;&gt; 8' />
												</command>
												<command class_type='call' title='User Macro' macro='Append_Byte' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Temp = .Data[.Idx]' />
												</command>
												<command class_type='call' title='User Macro' macro='Append_Byte' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Temp = .Data[.Idx]' />
												</command>
												<command class_type='call' title='User Macro' macro='Append_Byte' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Temp = .Data[.Idx] &gt;&gt; 8' />
												</command>
												<command class_type='call' title='User Macro' macro='Append_Byte' >
													<return exp='.Return' />
													<argument exp='.Temp' />
												</command>
											</flowline>
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Idx = .Idx + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
							<flowline />
							<flowline >
								<command class_type='call' title='Write to the card and update the file size' macro='Append_End' />
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='sim_append_string_to_file' description='' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Str' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<local name='i' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashTx' />
						<command class_type='sim' title='Simulation' macro='Console.WriteText' >
							<argument exp='ConsoleHandle' />
							<argument exp='&quot;Append To File: &quot; + .Str' />
						</command>
						<command class_type='calculation' title='Work out length of string' >
							<exp exp='.i = Length$ (.Str)' />
						</command>
						<command class_type='sim' title='Set position in file to EOF' macro='File.SetPos' >
							<argument exp='file_handle[file_idx]' />
							<argument exp='0' />
							<argument exp='::File .Seek_End' />
						</command>
						<command class_type='sim' title='Append data to file' macro='File.WriteArray' >
							<argument exp='file_handle[file_idx]' />
							<argument exp='.Str' />
							<argument exp='.i' />
						</command>
						<command class_type='calculation' title='Add new data to file size' >
							<exp exp='file_size[file_idx] = file_size[file_idx] + .i' />
						</command>
						<command class_type='sim' title='Append data to file' macro='File.Flush' >
							<argument exp='file_handle[file_idx]' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_GetVarSize' description='Sent to a component to amend the size of the expected array' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='VarName' type='T8' description='The original Flowcode variable' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='Elements' type='u32*' description='The number of elements in the array' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='comp' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.comp = Compare$ (.VarName,&quot;file_address&quot;,1)' />
						</command>
						<command class_type='decision' title='Decision' exp='.comp = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Elements = max_concurrent_files' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.comp = Compare$ (.VarName,&quot;file_entry&quot;,1)' />
						</command>
						<command class_type='decision' title='Decision' exp='.comp = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Elements = max_concurrent_files' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.comp = Compare$ (.VarName,&quot;file_pointer&quot;,1)' />
						</command>
						<command class_type='decision' title='Decision' exp='.comp = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Elements = max_concurrent_files' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.comp = Compare$ (.VarName,&quot;file_sector&quot;,1)' />
						</command>
						<command class_type='decision' title='Decision' exp='.comp = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Elements = max_concurrent_files' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.comp = Compare$ (.VarName,&quot;file_size&quot;,1)' />
						</command>
						<command class_type='decision' title='Decision' exp='.comp = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Elements = max_concurrent_files' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.comp = Compare$ (.VarName,&quot;file_start&quot;,1)' />
						</command>
						<command class_type='decision' title='Decision' exp='.comp = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Elements = max_concurrent_files' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.comp = Compare$ (.VarName,&quot;folder_start&quot;,1)' />
						</command>
						<command class_type='decision' title='Decision' exp='.comp = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Elements = max_concurrent_files' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.comp = Compare$ (.VarName,&quot;read_address&quot;,1)' />
						</command>
						<command class_type='decision' title='Decision' exp='.comp = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Elements = max_concurrent_files' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='OpenFile' description='Searches for and opens a file for reading or writing from within the current directory on the disk.&#10;Returns 0 for success.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Filename' type='T8*' description='8.3 filename of the file we are trying to open e.g. &quot;file.txt&quot;' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='13' />
						</param>
						<local name='i' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='idx' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='j' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='fat_address' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='offset' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Convert filename to 8.3 format' macro='Format_File_String' >
							<argument exp='.Filename' />
						</command>
						<command class_type='call' title='Search the current folder for the name' macro='Find_Folder_Entry' >
							<return exp='.i' />
						</command>
						<command class_type='decision' title='Not found?' exp='.i &gt; 15' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = ERROR_FILE_NOT_FOUND' />
								</command>
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Position of the entry in the sector' >
							<exp exp='.idx = .i &lt;&lt; 5' />
						</command>
						<command class_type='calculation' title='Store file address' >
							<exp exp='file_entry[file_idx] = .i' />
							<exp exp='file_address[file_idx] = file_pointer[file_idx]' />
							<exp exp='file_sector[file_idx] = 1' />
						</command>
						<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
							<return exp='.j' />
							<argument exp='.idx + 26' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
							<argument exp='0' />
							<argument exp='.j' />
						</command>
						<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
							<return exp='.j' />
							<argument exp='.idx + 27' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
							<argument exp='1' />
							<argument exp='.j' />
						</command>
						<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
							<flowline >
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.j' />
									<argument exp='.idx + 20' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='2' />
									<argument exp='.j' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.j' />
									<argument exp='.idx + 21' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='3' />
									<argument exp='.j' />
								</command>
							</flowline>
							<flowline >
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='2' />
									<argument exp='0' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='3' />
									<argument exp='0' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetLong' >
							<return exp='cluster' />
						</command>
						<command class_type='call' title='Read file size in bytes' macro='ReadByteFromBuffer' >
							<return exp='.j' />
							<argument exp='.idx + 28' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
							<argument exp='0' />
							<argument exp='.j' />
						</command>
						<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
							<return exp='.j' />
							<argument exp='.idx + 29' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
							<argument exp='1' />
							<argument exp='.j' />
						</command>
						<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
							<return exp='.j' />
							<argument exp='.idx + 30' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
							<argument exp='2' />
							<argument exp='.j' />
						</command>
						<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
							<return exp='.j' />
							<argument exp='.idx + 31' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
							<argument exp='3' />
							<argument exp='.j' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetLong' >
							<return exp='file_size[file_idx]' />
						</command>
						<command class_type='decision' title='Empty file?' exp='cluster = 0' swap='0' >
							<flowline >
								<command class_type='call' title='Find a free cluster for the empty file' macro='Find_Free_Cluster' >
									<return exp='cluster' />
									<argument exp='1' />
								</command>
								<command class_type='decision' title='Card full?' exp='cluster = 0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return = ERROR_CARD_FULL' />
										</command>
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Locate the FAT entry for this cluster' >
									<exp exp='.fat_address = fat_start + (cluster / fats_per_sector)' />
									<exp exp='.offset = (cluster &amp; (fats_per_sector - 1)) * sector_address_length' />
								</command>
								<command class_type='call' title='Write EOF marker into new FAT address' macro='WriteByteToBuffer' >
									<argument exp='.offset' />
									<argument exp='0xFF' />
								</command>
								<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
									<argument exp='.offset + 1' />
									<argument exp='0xFF' />
								</command>
								<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
									<flowline >
										<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
											<argument exp='.offset + 2' />
											<argument exp='0xFF' />
										</command>
										<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
											<argument exp='.offset + 3' />
											<argument exp='0x0F' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Write changes to FAT' macro='SendBuffer' >
									<argument exp='.fat_address' />
								</command>
								<command class_type='call' title='Mirror onto FAT2' macro='SendBuffer' >
									<argument exp='.fat_address + fat_size' />
								</command>
								<command class_type='call' title='Read sector of directory containing file' macro='GetBuffer' >
									<argument exp='file_address[file_idx]' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
									<argument exp='cluster' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
									<return exp='.j' />
									<argument exp='0' />
								</command>
								<command class_type='call' title='Store the first cluster in the directory entry' macro='WriteByteToBuffer' >
									<argument exp='.idx + 26' />
									<argument exp='.j' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
									<return exp='.j' />
									<argument exp='1' />
								</command>
								<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
									<argument exp='.idx + 27' />
									<argument exp='.j' />
								</command>
								<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
									<flowline >
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
											<return exp='.j' />
											<argument exp='2' />
										</command>
										<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
											<argument exp='.idx + 20' />
											<argument exp='.j' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetByte' >
											<return exp='.j' />
											<argument exp='3' />
										</command>
										<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
											<argument exp='.idx + 21' />
											<argument exp='.j' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Call Macro' macro='SendBuffer' >
									<argument exp='file_address[file_idx]' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Move to the first sector of the file' >
							<exp exp='file_start[file_idx] = cluster' />
							<exp exp='file_pointer[file_idx] = data_start + ((cluster - 2) * sects_per_clust)' />
							<exp exp='read_address[file_idx] = 0' />
						</command>
						<command class_type='call' title='Call Macro' macro='GetBuffer' >
							<argument exp='file_pointer[file_idx]' />
						</command>
						<command class_type='call' title='Bytes of file data in this sector' macro='ReadFileLength' >
							<return exp='sector_bytes' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = ACK_OK' />
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
					</flowline>
				</macro>
				<macro >
					<flowline name='WriteFileSector' description='Overwrites the current sector on the memory card with the contents of the local sector buffer. See write_byte_to_buffer function.&#10;Return = 0 - File sector written successfully.&#10;Return &gt; 0 - File sector write error' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='idx' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='temp' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='j' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.temp = file_size[file_idx] &gt;&gt; 9' />
						</command>
						<command class_type='decision' title='Is this the last sector in the file?' exp='.temp = file_sector[file_idx] - 1' swap='0' >
							<flowline >
								<command class_type='call' title='Read bytes in current sector' macro='ReadFileLength' >
									<return exp='.temp' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.temp = 512 - .temp' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='file_size[file_idx] = file_size[file_idx] + .temp' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Call Macro' macro='SendBuffer' >
							<argument exp='file_pointer[file_idx]' />
						</command>
						<command class_type='call' title='Call Macro' macro='GetBuffer' >
							<argument exp='file_address[file_idx]' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.idx = 28 + (file_entry[file_idx] &lt;&lt; 5)' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetLong' >
							<argument exp='file_size[file_idx]' />
						</command>
						<command class_type='call' title='Update file length in buffer' component='TypeConversions1' macro='GetByte' >
							<return exp='.j' />
							<argument exp='0' />
						</command>
						<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
							<argument exp='.idx' />
							<argument exp='.j' />
						</command>
						<command class_type='call' title='Update file length in buffer' component='TypeConversions1' macro='GetByte' >
							<return exp='.j' />
							<argument exp='1' />
						</command>
						<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
							<argument exp='.idx + 1' />
							<argument exp='.j' />
						</command>
						<command class_type='call' title='Update file length in buffer' component='TypeConversions1' macro='GetByte' >
							<return exp='.j' />
							<argument exp='2' />
						</command>
						<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
							<argument exp='.idx + 2' />
							<argument exp='.j' />
						</command>
						<command class_type='call' title='Update file length in buffer' component='TypeConversions1' macro='GetByte' >
							<return exp='.j' />
							<argument exp='3' />
						</command>
						<command class_type='call' title='Call Macro' macro='WriteByteToBuffer' >
							<argument exp='.idx + 3' />
							<argument exp='.j' />
						</command>
						<command class_type='call' title='update file length onto card' macro='SendBuffer' >
							<argument exp='file_address[file_idx]' />
						</command>
						<command class_type='comment' title='' comment='This gets the current file sector data which may be unnessisary.&#10;We leave it in for now just incase.' textarea='12,0,12,0' />
						<command class_type='call' title='Call Macro' macro='GetBuffer' >
							<argument exp='file_pointer[file_idx]' />
						</command>
						<command class_type='call' title='Bytes of file data in this sector' macro='ReadFileLength' >
							<return exp='sector_bytes' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = ACK_OK' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='sim_write_file_sector' description='' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='count' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.count = file_sector[file_idx] * 512' />
						</command>
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashTx' />
						<command class_type='sim' title='Panel' macro='File.SetPos' >
							<argument exp='file_handle[file_idx]' />
							<argument exp='.count' />
							<argument exp='::File .Seek_Begin' />
						</command>
						<command class_type='sim' title='Panel' macro='File.WriteArray' >
							<argument exp='file_handle[file_idx]' />
							<argument exp='card_buffer_l' />
							<argument exp='256' />
						</command>
						<command class_type='sim' title='Panel' macro='File.SetPos' >
							<argument exp='file_handle[file_idx]' />
							<argument exp='.count + 256' />
							<argument exp='::File .Seek_Begin' />
						</command>
						<command class_type='sim' title='Panel' macro='File.WriteArray' >
							<argument exp='file_handle[file_idx]' />
							<argument exp='card_buffer_h' />
							<argument exp='256' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='file_size[file_idx] = file_size[file_idx] + 512' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetFileIndex' description='Sets the current file index and used to switch between several open file streams. &#10;Default = 0.&#10;' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='File_Index' type='u8' description='File index ranges from 0 to (Max Concurrent Files - 1)' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='Decision' exp='.File_Index &lt; max_concurrent_files' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='file_idx = .File_Index' />
								</command>
								<command class_type='call' title='Bytes of file data in this sector' macro='ReadFileLength' >
									<return exp='sector_bytes' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='sim_update_file_sector' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<local name='count' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.count = file_sector[file_idx] * 512' />
						</command>
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashTx' />
						<command class_type='sim' title='Panel' macro='File.SetPos' >
							<argument exp='file_handle[file_idx]' />
							<argument exp='.count' />
							<argument exp='::File .Seek_Begin' />
						</command>
						<command class_type='sim' title='Panel' macro='File.WriteArray' >
							<argument exp='file_handle[file_idx]' />
							<argument exp='card_buffer_l' />
							<argument exp='256' />
						</command>
						<command class_type='sim' title='Panel' macro='File.SetPos' >
							<argument exp='file_handle[file_idx]' />
							<argument exp='.count + 256' />
							<argument exp='::File .Seek_Begin' />
						</command>
						<command class_type='sim' title='Panel' macro='File.WriteArray' >
							<argument exp='file_handle[file_idx]' />
							<argument exp='card_buffer_h' />
							<argument exp='256' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='sim_create_file' description='' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Filename' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='12' />
						</param>
						<local name='Filepath' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='200' />
						</local>
						<local name='FileHandle' type='h32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='i' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Len' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='char' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashTx' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Len = Length$ (root_dir)' />
							<exp exp='.char = root_dir[.Len - 1]' />
						</command>
						<command class_type='decision' title='Decision' exp='(.char = &apos;)&apos;) || (.char = &apos;\\&apos;)' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Filepath = root_dir' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Filepath = root_dir + &quot;\\&quot;' />
								</command>
							</flowline>
						</command>
						<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='file_idx' >
							<case >
								<flowline >
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='.i = Length$ (sim_folder_path_0)' />
									</command>
									<command class_type='decision' title='Decision' exp='.i' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Filepath = .Filepath + sim_folder_path_0' />
											</command>
										</flowline>
										<flowline />
									</command>
								</flowline>
							</case>
							<case exp='1' >
								<flowline >
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='.i = Length$ (sim_folder_path_1)' />
									</command>
									<command class_type='decision' title='Decision' exp='.i' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Filepath = .Filepath + sim_folder_path_1' />
											</command>
										</flowline>
										<flowline />
									</command>
								</flowline>
							</case>
							<case exp='2' >
								<flowline >
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='.i = Length$ (sim_folder_path_2)' />
									</command>
									<command class_type='decision' title='Decision' exp='.i' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Filepath = .Filepath + sim_folder_path_2' />
											</command>
										</flowline>
										<flowline />
									</command>
								</flowline>
							</case>
							<case exp='3' >
								<flowline >
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='.i = Length$ (sim_folder_path_3)' />
									</command>
									<command class_type='decision' title='Decision' exp='.i' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Filepath = .Filepath + sim_folder_path_3' />
											</command>
										</flowline>
										<flowline />
									</command>
								</flowline>
							</case>
							<case exp='4' >
								<flowline >
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='block' title='' hide='1' start='1' />
									<command class_type='block' title='' hide='1' start='0' />
									<command class_type='calculation' title='Calculation' >
										<exp exp='.i = Length$ (sim_folder_path_4)' />
									</command>
									<command class_type='decision' title='Decision' exp='.i' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Filepath = .Filepath + sim_folder_path_4' />
											</command>
										</flowline>
										<flowline />
									</command>
								</flowline>
							</case>
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Filepath = .Filepath + .Filename' />
						</command>
						<command class_type='sim' title='Simulation' macro='Console.WriteText' >
							<argument exp='ConsoleHandle' />
							<argument exp='&quot;Create File: &quot; + .Filepath + &quot; -&quot;' />
						</command>
						<command class_type='sim' title='Panel' macro='File.GetType' >
							<return exp='.i' />
							<argument exp='.Filepath' />
						</command>
						<command class_type='decision' title='Decision' exp='.i = 0' swap='0' >
							<flowline >
								<command class_type='sim' title='Panel' macro='File.Create' >
									<return exp='.FileHandle' />
									<argument exp='.Filepath' />
									<argument exp='0' />
									<argument exp='0' />
								</command>
								<command class_type='sim' title='Simulation' macro='Console.WriteText' >
									<argument exp='ConsoleHandle' />
									<argument exp='&quot; OK\n&quot;' />
								</command>
								<command class_type='sim' title='Panel' disable='1' macro='File.Flush' >
									<argument exp='.FileHandle' />
								</command>
								<command class_type='calculation' title='File created correctly' >
									<exp exp='.Return = 0x00' />
								</command>
							</flowline>
							<flowline >
								<command class_type='sim' title='Simulation' macro='Console.WriteText' >
									<argument exp='ConsoleHandle' />
									<argument exp='&quot; Error File Exists\n&quot;' />
								</command>
								<command class_type='calculation' title='File already exists' >
									<exp exp='.Return = 0x01' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='AppendStringToFile' description='Adds the contents of the data string parameter to the end of the currently open file.&#10;Returns 0 for success.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Data_String' type='T8*' description='Data to append to the end of the file' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<local name='idx' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='str_len' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.str_len = Length$ (.Data_String)' />
							<exp exp='.idx = 0' />
						</command>
						<command class_type='call' title='Move to the end of the file' macro='Append_Start' >
							<return exp='.Return' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='(.idx &lt; .str_len) &amp;&amp; (.Return = ACK_OK)' for1='' for3='' >
							<flowline >
								<command class_type='call' title='Write character from string into buffer' macro='Append_Byte' >
									<return exp='.Return' />
									<argument exp='.Data_String[.idx]' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.idx = .idx + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Write to the card and update the file size' macro='Append_End' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_AddVar' description='Sent to a component to allow dynamic amendment of global constant declarations' statediag='0' >
						<return name='Return' type='u32' description='Non-zero to include definition - initialised on call' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='VarName' type='T8' description='The original Flowcode variable' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='ExpandName' type='T8' description='The expanded variable name' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='Expansion' type='T8*' description='The expanded string to inline to the code' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<local name='data' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='3' />
						</local>
						<local name='temp' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<local name='length' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='NewData' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 1' />
						</command>
						<command class_type='decision' title='Create Time' exp='Compare$ (.VarName,&quot;CREATE_TIME&quot;,1) == 0' swap='0' >
							<flowline >
								<command class_type='call' title='Call Macro' macro='ReadTime' >
									<return exp='.data[0]' />
									<argument exp='0' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadTime' >
									<return exp='.data[1]' />
									<argument exp='1' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadTime' >
									<return exp='.data[2]' />
									<argument exp='2' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.data[2] = .data[2] / 2' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.length = Length$ (.Expansion)' />
									<exp exp='.temp = Left$ (.Expansion, .length - 7)' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.NewData = .data[2] | (.data[1] &lt;&lt; 5) | (.data[0] &lt;&lt; 11)' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.temp = .temp + STRING .NewData' />
									<exp exp='.temp = .temp + &quot;;\n&quot;' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Expansion = .temp' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Create Time' exp='Compare$ (.VarName,&quot;CREATE_DATE&quot;,1) == 0' swap='0' >
							<flowline >
								<command class_type='call' title='Call Macro' macro='ReadDate' >
									<return exp='.data[0]' />
									<argument exp='0' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadDate' >
									<return exp='.data[1]' />
									<argument exp='1' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadDate' >
									<return exp='.data[2]' />
									<argument exp='2' />
								</command>
								<command class_type='calculation' title='Year from 1980 - 15+20 = 35' >
									<exp exp='.data[0] = .data[0] + 20' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.length = Length$ (.Expansion)' />
									<exp exp='.temp = Left$ (.Expansion, .length - 7)' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.NewData = .data[2] | (.data[1] &lt;&lt; 5) | (.data[0] &lt;&lt; 9)' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.temp = .temp + STRING .NewData' />
									<exp exp='.temp = .temp + &quot;;\n&quot;' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Expansion = .temp' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Create Time' exp='Compare$ (.VarName,&quot;file_handle&quot;,1) == 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Create Time' exp='Compare$ (.VarName,&quot;sim_folder_path_0&quot;,1) == 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Create Time' exp='Compare$ (.VarName,&quot;sim_folder_path_1&quot;,1) == 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Create Time' exp='Compare$ (.VarName,&quot;sim_folder_path_2&quot;,1) == 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Create Time' exp='Compare$ (.VarName,&quot;sim_folder_path_3&quot;,1) == 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Create Time' exp='Compare$ (.VarName,&quot;sim_folder_path_4&quot;,1) == 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Create Time' exp='Compare$ (.VarName,&quot;sim_card_connected&quot;,1) == 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='sim_read_byte_from_file' description='Reads a byte from the currently open file. Auto increments the position in the file.&#10;A return value of 0 may signify the end of the file has been reached (depending on the contents of the file).' statediag='0' >
						<return name='Return' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Idx' type='u16' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Data_Byte' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Sector_Size' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='call' title='Call Macro' macro='ReadFileLength' >
							<return exp='.Sector_Size' />
						</command>
						<command class_type='decision' title='EOF?' exp='read_address[file_idx] = 512' swap='0' >
							<flowline >
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='read_address[file_idx] &gt;= .Sector_Size' swap='0' >
							<flowline >
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashRx' />
						<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
							<return exp='.Return' />
							<argument exp='read_address[file_idx]' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='read_address[file_idx] = read_address[file_idx] + 1' />
						</command>
						<command class_type='decision' title='Decision' exp='read_address[file_idx] = 512' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='read_address[file_idx] = 0' />
								</command>
								<command class_type='call' title='Call Macro' macro='sim_move_to_next_file_sector' >
									<return exp='.Data_Byte' />
									<argument exp='0' />
								</command>
								<command class_type='decision' title='Decision' exp='.Data_Byte &gt; 0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='read_address[file_idx] = 512' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadDate' description='' statediag='0' dllpath='$(appdir)API.DLL\DateTime.dll' dllcall='115' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Unit' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Find_Free_Cluster' description='Searches the FAT for a free cluster. Tries every data cluster once, starting after Start and wrapping round at the end of the card.&#10;Leaves the FAT sector that holds the entry for the returned cluster in the local sector buffer.&#10;Returns the cluster number, or 0 if every cluster is in use.' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Start' type='u32' description='Cluster to start searching after' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='count' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='loaded' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='fat_address' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='fat_pointer' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='offset' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='j' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
							<exp exp='.count = 0' />
							<exp exp='.loaded = 0' />
						</command>
						<command class_type='decision' title='Decision' exp='max_cluster &gt; 1' swap='0' >
							<flowline >
								<command class_type='calculation' title='Number of data clusters on the card' >
									<exp exp='.count = max_cluster - 1' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='loop' title='Until a free cluster is found or all have been tried' type='0' exp='(.count &gt; 0) &amp;&amp; (.Return = 0)' for1='' for3='' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Start = .Start + 1' />
								</command>
								<command class_type='decision' title='Wrap round to the first data cluster' exp='(.Start &gt; max_cluster) || (.Start &lt; 2)' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Start = 2' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Locate the FAT entry for this cluster' >
									<exp exp='.fat_address = fat_start + (.Start / fats_per_sector)' />
									<exp exp='.offset = (.Start &amp; (fats_per_sector - 1)) * sector_address_length' />
								</command>
								<command class_type='decision' title='FAT sector not in the buffer yet?' exp='.fat_address != .loaded' swap='0' >
									<flowline >
										<command class_type='call' title='Read FAT Sector' macro='GetBuffer' >
											<argument exp='.fat_address' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.loaded = .fat_address' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.j' />
									<argument exp='.offset' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='0' />
									<argument exp='.j' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.j' />
									<argument exp='.offset + 1' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='1' />
									<argument exp='.j' />
								</command>
								<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
									<flowline >
										<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
											<return exp='.j' />
											<argument exp='.offset + 2' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
											<argument exp='2' />
											<argument exp='.j' />
										</command>
										<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
											<return exp='.j' />
											<argument exp='.offset + 3' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
											<argument exp='3' />
											<argument exp='.j' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
											<argument exp='2' />
											<argument exp='0' />
										</command>
										<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
											<argument exp='3' />
											<argument exp='0' />
										</command>
									</flowline>
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetLong' >
									<return exp='.fat_pointer' />
								</command>
								<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
									<flowline >
										<command class_type='calculation' title='Top 4 bits of a FAT32 entry are reserved' >
											<exp exp='.fat_pointer = .fat_pointer &amp; 0x0FFFFFFF' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Free cluster?' exp='.fat_pointer = 0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return = .Start' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.count = .count - 1' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='sim_read_byte_from_index' description='Reads a byte of data from the local sector buffer.&#10;Return = Data byte read from the local sector buffer. ' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Address' type='u32' description='Contains the position of the byte to be read from the file' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='buffer' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='1' />
						</local>
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashRx' />
						<command class_type='sim' title='Panel' macro='File.SetPos' >
							<argument exp='file_handle[file_idx]' />
							<argument exp='.Address' />
							<argument exp='::File .Seek_Begin' />
						</command>
						<command class_type='sim' title='Panel' macro='File.ReadArray' >
							<argument exp='file_handle[file_idx]' />
							<argument exp='.buffer' />
							<argument exp='1' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='read_address[file_idx] = (.Address + 1) &amp; 0x1FF' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = .buffer[0]' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadLongArrayFromFile' description='Reads a binary Long array from the currently open file. &#13;&#10;Auto increments the position in the file.&#13;&#10;Returns the number of values read.' statediag='0' >
						<return name='Return' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Data' type='u32' description='Data variable to populate with data' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' >
							<array size='1000' />
						</param>
						<param name='Length' type='u16' description='Number of values to read' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='MSBFirst' type='b1' description='0=LSB then MSB, 1=MSB then LSB' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Ret' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
							<exp exp='.Ret = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='(.Return &lt; .Length) &amp;&amp; (.Ret &lt; 256)' for1='' for3='' >
							<flowline >
								<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='sim_read_byte_from_file' >
											<return exp='.Ret' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='User Macro' macro='ReadByteFromFile' >
											<return exp='.Ret' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Decision' exp='.Ret &lt; 256' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' exp='.MSBFirst' swap='0' >
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='3' />
													<argument exp='.Ret' />
												</command>
											</flowline>
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='0' />
													<argument exp='.Ret' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='sim_read_byte_from_file' >
											<return exp='.Ret' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='User Macro' macro='ReadByteFromFile' >
											<return exp='.Ret' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Decision' exp='.Ret &lt; 256' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' exp='.MSBFirst' swap='0' >
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='2' />
													<argument exp='.Ret' />
												</command>
											</flowline>
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='1' />
													<argument exp='.Ret' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='sim_read_byte_from_file' >
											<return exp='.Ret' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='User Macro' macro='ReadByteFromFile' >
											<return exp='.Ret' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Decision' exp='.Ret &lt; 256' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' exp='.MSBFirst' swap='0' >
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='1' />
													<argument exp='.Ret' />
												</command>
											</flowline>
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='2' />
													<argument exp='.Ret' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='sim_read_byte_from_file' >
											<return exp='.Ret' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='User Macro' macro='ReadByteFromFile' >
											<return exp='.Ret' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Decision' exp='.Ret &lt; 256' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' exp='.MSBFirst' swap='0' >
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='0' />
													<argument exp='.Ret' />
												</command>
											</flowline>
											<flowline >
												<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
													<argument exp='3' />
													<argument exp='.Ret' />
												</command>
											</flowline>
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Data[.Return] = TypeConversions1 :: GetLong ()' />
											<exp exp='.Return = .Return + 1' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Clear_Buffer' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<local name='count' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.count = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.count &lt; 256' for1='' for3='' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='card_buffer_l[.count] = 0' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='card_buffer_h[.count] = 0' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.count = .count + 1' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Format_File_String' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Filename' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='13' />
						</param>
						<local name='i' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='j' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='filename_copy' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='13' />
						</local>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.i = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.i &lt; 11' for1='' for3='' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='name_ext[.i] = 0x20' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.i = .i + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Null Termination' >
							<exp exp='name_ext[11] = 0' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.filename_copy = ToUpper$ (.Filename)' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.i = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.i &lt; 8' for1='' for3='' >
							<flowline >
								<command class_type='decision' title='Decision' exp='.filename_copy[.i] = &apos;.&apos;' swap='0' >
									<flowline >
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='.filename_copy[.i] = 0' swap='0' >
									<flowline >
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='name_ext[.i] = .filename_copy[.i]' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.i = .i + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
						<command class_type='decision' title='Decision' exp='.filename_copy[.i] = &apos;.&apos;' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.j = .i + 1' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.i = 8' />
								</command>
								<command class_type='loop' title='Loop' type='0' exp='.i &lt; 11' for1='' for3='' >
									<flowline >
										<command class_type='decision' title='Decision' exp='.filename_copy[.j] = 0' swap='0' >
											<flowline >
												<command class_type='goto' title='Goto Connection Point' labelid='1' labelname='' labeltype='0' />
											</flowline>
											<flowline />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='name_ext[.i] = .filename_copy[.j]' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.i = .i + 1' />
											<exp exp='.j = .j + 1' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='label' title='Connection Point' labelid='1' labelname='B' labeltype='4' />
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadFileSize' description='Reads the entire size of the current file in bytes.' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Return file size' >
							<exp exp='.return = file_size[file_idx]' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='UpdateFileSector' description='Updates a file sector with new data set from using WriteByteToBuffer.&#13;&#10;Note this cannot alter the size of the file.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='call' title='Call Macro' macro='SendBuffer' >
							<argument exp='file_pointer[file_idx]' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='CheckAutoConfig' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<local name='str' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<command class_type='sim' title='' macro='FCD.GetItemValue' >
							<return exp='.str' />
							<argument exp='&quot;feature.fat&quot;' />
							<argument exp='&quot;spi&quot;' />
							<argument exp='&quot;&quot;' />
						</command>
						<command class_type='decision' title='Decision' exp='Length$ (.str)' swap='0' >
							<flowline >
								<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
									<argument exp='this' />
									<argument exp='&quot;Channel&quot;' />
									<argument exp='.str' />
								</command>
								<command class_type='sim' title='' macro='FCD.GetItemValue' >
									<return exp='.str' />
									<argument exp='&quot;feature.fat&quot;' />
									<argument exp='&quot;cs&quot;' />
									<argument exp='&quot;&quot;' />
								</command>
								<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
									<argument exp='this' />
									<argument exp='&quot;cs_pin&quot;' />
									<argument exp='.str' />
								</command>
								<command class_type='sim' title='' macro='FCD.GetItemValue' >
									<return exp='.str' />
									<argument exp='&quot;feature.fat&quot;' />
									<argument exp='&quot;remap&quot;' />
									<argument exp='&quot;0&quot;' />
								</command>
								<command class_type='decision' title='Compare$ (.str,&quot;1&quot;,1) == 0' exp='Compare$ (.str,&quot;1&quot;,1) == 0' swap='0' >
									<flowline >
										<command class_type='sim' title='' macro='FCD.GetItemValue' >
											<return exp='.str' />
											<argument exp='&quot;feature.fat&quot;' />
											<argument exp='&quot;mosi&quot;' />
											<argument exp='&quot;0&quot;' />
										</command>
										<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
											<argument exp='this' />
											<argument exp='&quot;MosiRemap&quot;' />
											<argument exp='.str' />
										</command>
										<command class_type='sim' title='' macro='FCD.GetItemValue' >
											<return exp='.str' />
											<argument exp='&quot;feature.fat&quot;' />
											<argument exp='&quot;miso&quot;' />
											<argument exp='&quot;0&quot;' />
										</command>
										<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
											<argument exp='this' />
											<argument exp='&quot;MisoRemap&quot;' />
											<argument exp='.str' />
										</command>
										<command class_type='sim' title='' macro='FCD.GetItemValue' >
											<return exp='.str' />
											<argument exp='&quot;feature.fat&quot;' />
											<argument exp='&quot;clk&quot;' />
											<argument exp='&quot;0&quot;' />
										</command>
										<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
											<argument exp='this' />
											<argument exp='&quot;ClkRemap&quot;' />
											<argument exp='.str' />
										</command>
										<command class_type='sim' title='Call Macro' macro='Component.Property.SetWritable' >
											<argument exp='this' />
											<argument exp='&quot;MosiRemap&quot;' />
											<argument exp='0' />
										</command>
										<command class_type='sim' title='Call Macro' macro='Component.Property.SetWritable' >
											<argument exp='this' />
											<argument exp='&quot;MisoRemap&quot;' />
											<argument exp='0' />
										</command>
										<command class_type='sim' title='Call Macro' macro='Component.Property.SetWritable' >
											<argument exp='this' />
											<argument exp='&quot;ClkRemap&quot;' />
											<argument exp='0' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='sim' title='Call Macro' macro='Component.Property.SetWritable' >
									<argument exp='this' />
									<argument exp='&quot;Channel&quot;' />
									<argument exp='0' />
								</command>
								<command class_type='sim' title='Call Macro' macro='Component.Property.SetWritable' >
									<argument exp='this' />
									<argument exp='&quot;cs_pin&quot;' />
									<argument exp='0' />
								</command>
							</flowline>
							<flowline >
								<command class_type='sim' title='Call Macro' macro='Component.Property.SetWritable' >
									<argument exp='this' />
									<argument exp='&quot;Channel&quot;' />
									<argument exp='1' />
								</command>
								<command class_type='sim' title='Call Macro' macro='Component.Property.SetWritable' >
									<argument exp='this' />
									<argument exp='&quot;cs_pin&quot;' />
									<argument exp='1' />
								</command>
								<command class_type='sim' title='Call Macro' macro='Component.Property.SetWritable' >
									<argument exp='this' />
									<argument exp='&quot;MosiRemap&quot;' />
									<argument exp='1' />
								</command>
								<command class_type='sim' title='Call Macro' macro='Component.Property.SetWritable' >
									<argument exp='this' />
									<argument exp='&quot;MisoRemap&quot;' />
									<argument exp='1' />
								</command>
								<command class_type='sim' title='Call Macro' macro='Component.Property.SetWritable' >
									<argument exp='this' />
									<argument exp='&quot;ClkRemap&quot;' />
									<argument exp='1' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Resize' description='Sent to the mouse target when the user has altered the position of a component child' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Component' type='h32' description='The component that has been altered' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='PrevPos' type='h32' description='The position of the object before the start of positioning' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Final' type='b1' description='True if this is the end of a drag operation' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Built-in Function' macro='System.Forward' >
							<argument exp='LibraryComponent1' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='sim_read_string_from_file' description='Reads a string from the currently open file. Auto increments the position in the file.&#10;An empty string signifies the end of the file has been reached.' statediag='0' >
						<return name='Return' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;\x00&quot;' setinit='' >
							<array size='2000' />
						</return>
						<param name='NumBytes' type='u16' description='Maximum number of bytes to attempt to read' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='EndChar' type='u8' description='Ends the string if the value specified is found, default is 0' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Idx' type='u16' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Data_Byte' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Sector_Size' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = &quot;&quot;' />
						</command>
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashRx' />
						<command class_type='call' title='Call Macro' macro='ReadFileLength' >
							<return exp='.Sector_Size' />
						</command>
						<command class_type='decision' title='EOF?' exp='read_address[file_idx] = 512' swap='0' >
							<flowline >
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.Idx &lt; .NumBytes' for1='' for3='' >
							<flowline >
								<command class_type='decision' title='Decision' exp='read_address[file_idx] &gt;= .Sector_Size' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return[.Idx] = 0' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='read_address[file_idx] = 512' />
										</command>
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.Data_Byte' />
									<argument exp='read_address[file_idx]' />
								</command>
								<command class_type='decision' title='Decision' exp='.Data_Byte = 0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='read_address[file_idx] = 512' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return[.Idx] = 0' />
										</command>
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return[.Idx] = .Data_Byte' />
								</command>
								<command class_type='decision' title='Decision' exp='.Data_Byte = .EndChar' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' exp='(.Idx + 1) &lt; .Numbytes' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Return[.Idx + 1] = 0' />
												</command>
											</flowline>
											<flowline />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Idx = .NumBytes' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='sim' title='Simulation' disable='1' macro='Debug.Print' >
									<argument exp='STRING read_address[file_idx] + &quot; - &quot;' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='read_address[file_idx] = read_address[file_idx] + 1' />
								</command>
								<command class_type='sim' title='Simulation' disable='1' macro='Debug.PrintLn' >
									<argument exp='STRING read_address[file_idx]' />
								</command>
								<command class_type='decision' title='Decision' exp='read_address[file_idx] = 512' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='read_address[file_idx] = 0' />
										</command>
										<command class_type='call' title='Call Macro' macro='sim_move_to_next_file_sector' >
											<return exp='.Data_Byte' />
											<argument exp='0' />
										</command>
										<command class_type='decision' title='Decision' exp='.Data_Byte &gt; 0' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Return[.Idx] = 0' />
												</command>
												<command class_type='calculation' title='Calculation' >
													<exp exp='read_address[file_idx] = 512' />
												</command>
												<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
											</flowline>
											<flowline >
												<command class_type='call' title='Call Macro' macro='ReadFileLength' >
													<return exp='.Sector_Size' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Idx = .Idx + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
					</flowline>
				</macro>
				<macro >
					<flowline name='SetTimeAndDate' description='Sets the current time and date.&#13;&#10;&#10;Time = (Hour &lt;&lt; 11) + (Min &lt;&lt; 5) + (Sec &gt;&gt; 1)&#13;&#10;Date = (YearFrom1980 &lt;&lt; 9) + (Month &lt;&lt; 5) + (Day)&#13;&#10;Additional details can be found here: http://www.maverick-os.dk/FileSystemFormats/FAT16_FileSystem.html#TimeFormat' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Time' type='u16' description='Sets the current Time in FAT Time format hhhhhmmmmmmsssss - S=Secs/2' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Date' type='u16' description='Sets the current Date in FAT Date format yyyyyyymmmmddddd - Y=Years since 1980' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='CREATE_DATE = .Date' />
							<exp exp='CREATE_TIME = .Time' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='sim_scan_current_folder' description='' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Current_Idx' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Scan_Type' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = ACK_OK' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Start' description='Broadcast to all components that simulation is starting' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='sim_folder_path_0 = &quot;&quot;' />
							<exp exp='sim_folder_path_1 = &quot;&quot;' />
							<exp exp='sim_folder_path_2 = &quot;&quot;' />
							<exp exp='sim_folder_path_3 = &quot;&quot;' />
							<exp exp='sim_folder_path_4 = &quot;&quot;' />
						</command>
						<command class_type='sim' title='Simulation' macro='Component.Property.SetValue' >
							<argument exp='this' />
							<argument exp='&quot;IsSim&quot;' />
							<argument exp='1' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='AppendByteArrayToFile' description='Adds a binary byte array to the end of the file.&#13;&#10;Returns 0 for success.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Data' type='u8' description='Binary data array to append to the file' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='1000' />
						</param>
						<param name='Length' type='u16' description='Number of values to append' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Idx' type='u16' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
							<flowline />
							<flowline >
								<command class_type='call' title='Move to the end of the file' macro='Append_Start' >
									<return exp='.Return' />
								</command>
							</flowline>
						</command>
						<command class_type='loop' title='Loop' type='0' exp='(.Idx &lt; .Length) &amp;&amp; (.Return = 0)' for1='' for3='' >
							<flowline >
								<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='sim_append_byte_to_file' >
											<return exp='.Return' />
											<argument exp='.Data[.Idx]' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='User Macro' macro='Append_Byte' >
											<return exp='.Return' />
											<argument exp='.Data[.Idx]' />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Idx = .Idx + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
							<flowline />
							<flowline >
								<command class_type='call' title='Write to the card and update the file size' macro='Append_End' />
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadByteArrayFromFile' description='Reads a binary byte array from the currently open file. &#13;&#10;Auto increments the position in the file.&#13;&#10;Returns the number of values read.' statediag='0' >
						<return name='Return' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Data' type='u8' description='Data variable to populate with data' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='1000' />
						</param>
						<param name='Length' type='u16' description='Number of values to read' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Idx' type='u16' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Ret' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
							<exp exp='.Ret = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='(.Return &lt; .Length) &amp;&amp; (.Ret &lt; 256)' for1='' for3='' >
							<flowline >
								<command class_type='decision' title='Decision' exp='IsSim' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='sim_read_byte_from_file' >
											<return exp='.Ret' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='User Macro' macro='ReadByteFromFile' >
											<return exp='.Ret' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Decision' exp='.Ret &lt; 256' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Data[.Return] = .Ret' />
											<exp exp='.Return = .Return + 1' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Find_Folder_Entry' description='Searches the current folder for the 8.3 name held in name_ext.&#10;Returns 0 to 15 if found: the entry number within the sector at file_pointer, which is left in the local sector buffer.&#10;Returns 16 to 31 if not found: 16 + the entry number of the first free slot, in the sector at file_pointer.&#10;Returns ERROR_FILE_NOT_FOUND if not found and the folder has no free slot: file_pointer is left on the last sector of the folder.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='i' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='k' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='c' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='idx' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='folder_end' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='free_sector' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='free_entry' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Move to start of folder' >
							<exp exp='.free_sector = 0' />
							<exp exp='.folder_end = 0' />
							<exp exp='file_pointer[file_idx] = folder_start[file_idx]' />
						</command>
						<command class_type='loop' title='For every sector of the folder' type='0' exp='.folder_end = 0' for1='' for3='' >
							<flowline >
								<command class_type='call' title='Read sector of directory' macro='GetBuffer' >
									<argument exp='file_pointer[file_idx]' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.i = 0' />
								</command>
								<command class_type='loop' title='For each of the 16 entries in the sector' type='0' exp='.i &lt; 16' for1='' for3='' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.idx = .i &lt;&lt; 5' />
										</command>
										<command class_type='call' title='First character of the name' macro='ReadByteFromBuffer' >
											<return exp='.c' />
											<argument exp='.idx' />
										</command>
										<command class_type='decision' title='Unused or deleted entry?' exp='(.c = 0x00) || (.c = 0xE5)' swap='0' >
											<flowline >
												<command class_type='decision' title='First free slot seen?' exp='.free_sector = 0' swap='0' >
													<flowline >
														<command class_type='calculation' title='Remember it' >
															<exp exp='.free_sector = file_pointer[file_idx]' />
															<exp exp='.free_entry = .i' />
														</command>
													</flowline>
													<flowline />
												</command>
												<command class_type='decision' title='End of the folder? Nothing is stored beyond an unused entry' exp='.c = 0x00' swap='0' >
													<flowline >
														<command class_type='goto' title='Goto Connection Point' labelid='1' labelname='' labeltype='0' />
													</flowline>
													<flowline />
												</command>
											</flowline>
											<flowline >
												<command class_type='call' title='File attributes' macro='ReadByteFromBuffer' >
													<return exp='.k' />
													<argument exp='.idx + 11' />
												</command>
												<command class_type='decision' title='Not a volume label or long file name slot?' exp='(.k &amp; 0x08) = 0' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='.k = 0' />
														</command>
														<command class_type='loop' title='Compare the 11 characters, stop at the first difference' type='0' exp='.k &lt; 11' for1='' for3='' >
															<flowline >
																<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
																	<return exp='.c' />
																	<argument exp='.idx + .k' />
																</command>
																<command class_type='decision' title='Lower case on the card?' exp='(.c &gt;= &apos;a&apos;) &amp;&amp; (.c &lt;= &apos;z&apos;)' swap='0' >
																	<flowline >
																		<command class_type='calculation' title='Calculation' >
																			<exp exp='.c = .c - 32' />
																		</command>
																	</flowline>
																	<flowline />
																</command>
																<command class_type='decision' title='Decision' exp='.c = name_ext[.k]' swap='0' >
																	<flowline >
																		<command class_type='calculation' title='Calculation' >
																			<exp exp='.k = .k + 1' />
																		</command>
																	</flowline>
																	<flowline >
																		<command class_type='calculation' title='Calculation' >
																			<exp exp='.k = 12' />
																		</command>
																	</flowline>
																</command>
															</flowline>
														</command>
														<command class_type='decision' title='Names match?' exp='.k = 11' swap='0' >
															<flowline >
																<command class_type='calculation' title='Calculation' >
																	<exp exp='.Return = .i' />
																</command>
																<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
															</flowline>
															<flowline />
														</command>
													</flowline>
													<flowline />
												</command>
											</flowline>
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.i = .i + 1' />
										</command>
									</flowline>
								</command>
								<command class_type='call' title='Move to next sector in folder' macro='Next_Folder_Sector' >
									<return exp='.folder_end' />
								</command>
							</flowline>
						</command>
						<command class_type='label' title='Connection Point' labelid='1' labelname='B' labeltype='4' />
						<command class_type='decision' title='Free slot found?' exp='.free_sector != 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='file_pointer[file_idx] = .free_sector' />
									<exp exp='.Return = .free_entry + 16' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = ERROR_FILE_NOT_FOUND' />
								</command>
							</flowline>
						</command>
						<command class_type='label' title='Connection Point' labelid='0' labelname='A' labeltype='4' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
					</flowline>
				</macro>
				<macro >
					<flowline name='sim_init_fat' description='' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashRx' />
						<command class_type='sim' title='Panel' macro='File.GetType' >
							<return exp='.Return' />
							<argument exp='root_dir' />
						</command>
						<command class_type='decision' title='Looking for a directory type' exp='.Return = 2' swap='0' >
							<flowline >
								<command class_type='sim' title='Simulation' macro='Console.WriteText' >
									<argument exp='ConsoleHandle' />
									<argument exp='&quot;Initialise Card - &quot;' />
								</command>
								<command class_type='sim' title='Simulation' macro='Console.WriteText' >
									<argument exp='ConsoleHandle' />
									<argument exp='&quot;OK\n&quot;' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='SimInitPrinted = 0' />
								</command>
								<command class_type='calculation' title='File already exists' >
									<exp exp='.Return = 0x00' />
								</command>
							</flowline>
							<flowline >
								<command class_type='decision' title='Decision' exp='SimInitPrinted &lt; 2' swap='0' >
									<flowline >
										<command class_type='sim' title='Simulation' macro='Console.WriteText' >
											<argument exp='ConsoleHandle' />
											<argument exp='&quot;Initialise Card - &quot;' />
										</command>
										<command class_type='sim' title='Simulation' macro='Console.WriteText' >
											<argument exp='ConsoleHandle' />
											<argument exp='&quot;Simulation Root Folder Not Found\n&quot;' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='SimInitPrinted = 2' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='File already exists' >
									<exp exp='.Return = 0xFE' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Initialise' description='Attempts to communicate with the SD card and if successful sets up the file system.&#10;&#13;&#10;Returns: 0=OK / 236 = MBR Invalid / 237 = MBR Fail / 254=No Response / 255=No Card' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='retval' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='i' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='num_fats' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='bytes_per_sect' type='u16' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='reserved_sectors' type='u16' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='partition_start' type='u32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='root_size' type='u32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='total_sectors' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Startup Card' macro='Init_Card' >
							<return exp='.Return' />
						</command>
						<command class_type='decision' title='Decision' exp='.Return' swap='0' >
							<flowline >
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='delay' title='Delay' exp='50' type='1' />
						<command class_type='call' title='Read Master Boot Record if Available' macro='GetBuffer' >
							<return exp='.Return' />
							<argument exp='0' />
						</command>
						<command class_type='decision' title='Decision' exp='.Return' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = ERROR_READING_MBR' />
								</command>
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
							<return exp='.i' />
							<argument exp='0' />
						</command>
						<command class_type='decision' title='Decision' exp='(.i != 0xE9) &amp;&amp; (.i != 0xEB)' swap='0' >
							<flowline >
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='510' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='0' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='511' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='1' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetInt' >
									<return exp='.partition_start' />
									<argument exp='0' />
								</command>
								<command class_type='decision' title='Is the MBR valid?' exp='.partition_start != 0xAA55' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return = ERROR_INVALID_MBR' />
										</command>
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='454' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='0' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='455' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='1' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='456' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='2' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='457' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='3' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetLong' >
									<return exp='.partition_start' />
								</command>
								<command class_type='call' title='Call Macro' macro='GetBuffer' >
									<argument exp='.partition_start' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='0' />
								</command>
								<command class_type='decision' title='Is the new MBR valid?' exp='(.i != 0xE9) &amp;&amp; (.i != 0xEB)' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return = ERROR_READING_MBR2' />
										</command>
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Read bytes per sector' macro='ReadByteFromBuffer' >
							<return exp='.i' />
							<argument exp='0x0B' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
							<argument exp='0' />
							<argument exp='.i' />
						</command>
						<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
							<return exp='.i' />
							<argument exp='0x0C' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
							<argument exp='1' />
							<argument exp='.i' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetInt' >
							<return exp='.bytes_per_sect' />
							<argument exp='0' />
						</command>
						<command class_type='decision' title='If not equal to 512 then there is a problem' exp='.bytes_per_sect != 512' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = ERROR_SECT_BYTES' />
								</command>
								<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' labeltype='0' />
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Read number of sectors per cluster' macro='ReadByteFromBuffer' >
							<return exp='sects_per_clust' />
							<argument exp='0x0D' />
						</command>
						<command class_type='call' title='Read the number of reserved sectors at the start of the disk' macro='ReadByteFromBuffer' >
							<return exp='.i' />
							<argument exp='0x0E' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
							<argument exp='0' />
							<argument exp='.i' />
						</command>
						<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
							<return exp='.i' />
							<argument exp='0x0F' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
							<argument exp='1' />
							<argument exp='.i' />
						</command>
						<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetInt' >
							<return exp='.reserved_sectors' />
							<argument exp='0' />
						</command>
						<command class_type='call' title='Read number of FATs' macro='ReadByteFromBuffer' >
							<return exp='.num_fats' />
							<argument exp='0x10' />
						</command>
						<command class_type='call' title='Read type of FAT file system 16 or 32' macro='ReadByteFromBuffer' >
							<return exp='.i' />
							<argument exp='0x55' />
						</command>
						<command class_type='decision' title='32-bit FAT?' exp='.i = &apos;3&apos;' swap='0' >
							<flowline >
								<command class_type='calculation' title='FAT32' >
									<exp exp='fat_system = 1' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='sector_address_length = 4' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='fats_per_sector = 128' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='not_address_marker = 0x0FFFFFF0' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='eof_marker = 0x0FFFFFF7' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='FAT16' >
									<exp exp='fat_system = 0' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='sector_address_length = 2' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='fats_per_sector = 256' />
									<exp exp='' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='not_address_marker = 0xFFF0' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='eof_marker = 0xFFF7' />
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Address of the start of FAT in sectors' >
							<exp exp='fat_start = .partition_start + .reserved_sectors' />
						</command>
						<command class_type='decision' title='Decision' exp='fat_system' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='root_sectors = sects_per_clust' />
								</command>
								<command class_type='call' title='Read FAT size in sectors' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='0x24' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='0' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='0x25' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='1' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='0x26' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='2' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='0x27' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='3' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetLong' >
									<return exp='fat_size' />
								</command>
								<command class_type='call' title='First cluster address in root' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='0x2C' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='0' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='0x2D' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='1' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='0x2E' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='2' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='0x2F' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='3' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetLong' >
									<return exp='.root_size' />
								</command>
								<command class_type='calculation' title='Start address of data in sectors' >
									<exp exp='data_start = (.num_fats * fat_size) + fat_start' />
								</command>
								<command class_type='calculation' title='Start address of root in sectors' >
									<exp exp='root_start = ((.root_size - 2) * sects_per_clust) + data_start' />
								</command>
							</flowline>
							<flowline >
								<command class_type='call' title='Work out size of root' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='0x11' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='0' />
									<argument exp='.i' />
								</command>
								<command class_type='call' title='Call Macro' macro='ReadByteFromBuffer' >
									<return exp='.i' />
									<argument exp='0x12' />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='SetByte' >
									<argument exp='1' />
									<argument exp='.i' />
