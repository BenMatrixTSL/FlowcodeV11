								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='call' title='Call Macro' macro='RxReadByte' >
							<return exp='.rx_byte' />
							<argument exp='.Channel' />
						</command>
						<command class_type='decision' title='Decision' exp='.rx_byte != .byte5' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
