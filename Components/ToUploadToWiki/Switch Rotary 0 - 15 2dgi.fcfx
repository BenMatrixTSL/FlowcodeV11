				<macro >
					<flowline name='GetPositionSim' description='Reads the button state as 0 for released or 1 for pressed
Performs debounce if required' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Component Macro' component='GdiGauge1' macro='GetValue' >
							<return exp='.Return' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Prv_SetPins' description='Sets the pins of the component depending on the gauge setting' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<local name='Position' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='NotCommon' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='sim' title='Component Macro' component='GdiGauge1' macro='GetValue' >
							<return exp='.Position' />
						</command>
						<command class_type='decision' title='Decision' exp='Common' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.NotCommon = 0' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.NotCommon = 1' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' exp='RotaryType' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='Pin1 = (.Position == 0) XOR .NotCommon' />
									<exp exp='Pin2 = (.Position == 1) XOR .NotCommon' />
									<exp exp='Pin3 = (.Position == 2) XOR .NotCommon' />
									<exp exp='Pin4 = (.Position == 3) XOR .NotCommon' />
									<exp exp='Pin5 = (.Position == 4) XOR .NotCommon' />
									<exp exp='Pin6 = (.Position == 5) XOR .NotCommon' />
									<exp exp='Pin7 = (.Position == 6) XOR .NotCommon' />
									<exp exp='Pin8 = (.Position == 7) XOR .NotCommon' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='Pin9 = (.Position == 8) XOR .NotCommon' />
									<exp exp='Pin10 = (.Position == 9) XOR .NotCommon' />
									<exp exp='Pin11 = (.Position == 10) XOR .NotCommon' />
									<exp exp='Pin12 = (.Position == 11) XOR .NotCommon' />
									<exp exp='Pin13 = (.Position == 12) XOR .NotCommon' />
									<exp exp='Pin14 = (.Position == 13) XOR .NotCommon' />
									<exp exp='Pin15 = (.Position == 14) XOR .NotCommon' />
									<exp exp='Pin16 = (.Position == 15) XOR .NotCommon' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='Pin1 = (.Position &amp; 1) XOR .NotCommon' />
									<exp exp='' />
								</command>
								<command class_type='decision' title='Decision' exp='NumPositions &gt;= 2' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='Pin2 = ((.Position &amp; 2) != 0) XOR .NotCommon' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='NumPositions &gt;= 4' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='Pin3 = ((.Position &amp; 4) != 0) XOR .NotCommon' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='NumPositions &gt;= 8' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='Pin4 = ((.Position &amp; 8) != 0) XOR .NotCommon' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
