								</command>
								<command class_type='sim' title='Built-in Function' macro='Expand.MacroName' >
									<return exp='.sMacro' />
									<argument exp='.sMacro' />
									<argument exp='.hParent' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.HeaderScript = .HeaderScript + &quot;    &quot; + .sMacro + &quot;();\n&quot;' />
