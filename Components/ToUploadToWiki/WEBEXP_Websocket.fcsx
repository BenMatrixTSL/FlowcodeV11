						<command class_type='comment' title='' comment='Comment' textarea='12,0,12,0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = .HeaderScript + &quot;  function WS_Close_&quot; + .CompID + &quot;(ev)\n  {\n&quot;' />
						</command>
						<command class_type='decision' title='Decision' exp='bDebug' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.HeaderScript = .HeaderScript + &quot;    console.log(\&quot;WebSocket closed (\&quot; + ev.code + \&quot;): \&quot; + ev.reason);\n&quot;' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Length$(macOnClose) &gt; 0' swap='0' >
							<flowline >
								<command class_type='sim' title='Built-in Function' macro='Component.Property.GetValue' >
									<return exp='.sMacro' />
