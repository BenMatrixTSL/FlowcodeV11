						<local name='sMsg' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.sUrl = sUrl' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.bDebug = (bDebug != 0)' />
						</command>
						<command class_type='decision' title='Decision' exp='bConnected' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
								</command>
								<command class_type='decision' title='Decision' exp='.bDebug' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.sMsg = &quot;Connecting WebSocket failed: Already connected&quot;' />
										</command>
										<command class_type='native' title='Javascript' ccode='console.log(FCL_SMSG);' language='C' />
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline >
								<command class_type='decision' title='Decision' exp='.bDebug' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.sMsg = &quot;Connecting WebSocket: &quot; + .sUrl' />
										</command>
										<command class_type='native' title='Javascript' ccode='console.log(FCL_SMSG);' language='C' />
									</flowline>
									<flowline />
								</command>
								<command class_type='native' title='Javascript' ccode='window.addEventListener(&quot;pageshow&quot;, (event) =&gt; {
	if (event.persisted) {
		window[&apos;WS_&apos; + FC_THIS] = new WebSocket(FCL_SURL);
		window[&apos;WS_&apos; + FC_THIS].binaryType = &quot;arraybuffer&quot;;
		window[&apos;WS_Listeners_&apos; + FC_THIS]();
	}
});' language='C' />
								<command class_type='native' title='Javascript' ccode='window[&apos;WS_&apos; + FC_THIS] = new WebSocket(FCL_SURL);
window[&apos;WS_&apos; + FC_THIS].binaryType = &quot;arraybuffer&quot;;
window[&apos;WS_Listeners_&apos; + FC_THIS]();' language='C' />
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 1' />
								</command>
								<command class_type='native' title='Javascript' ccode='// Close the websocket when the user leaves.
window.addEventListener(&quot;pagehide&quot;, () =&gt; {
	if (window[&apos;WS_&apos; + FC_THIS]) {' language='C' />
								<command class_type='decision' title='Decision' exp='.bDebug' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.sMsg = &quot;Closing WebSocket: &quot; + .sUrl' />
										</command>
										<command class_type='native' title='Javascript' ccode='console.log(FCL_SMSG);' language='C' />
									</flowline>
									<flowline />
								</command>
								<command class_type='native' title='Javascript' ccode='		window[&apos;WS_&apos; + FC_THIS].close();
		window[&apos;WS_&apos; + FC_THIS] = null;
	}
});
' language='C' />
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='GetState' description='Returns the state of the current connection:
  0  = connecting
  1  = open
  2  = closing
  3  = closed or not created' statediag='0' >
						<return name='Return' type='s32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
