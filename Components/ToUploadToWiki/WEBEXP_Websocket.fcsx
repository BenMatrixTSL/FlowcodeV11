							<array size='20' />
						</local>
						<local name='hParent' type='h32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = &quot;  var WS_&quot; + .CompID + &quot; = null;\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;  //var WS_Con_&quot; + .CompID + &quot; = false;\n&quot;' />
						</command>
						<command class_type='comment' title='' comment='Comment' textarea='12,0,12,0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = .HeaderScript + &quot;  function WS_Listeners_&quot; + .CompID + &quot;()\n  {\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;    WS_&quot; + .CompID + &quot;.addEventListener(&apos;open&apos;, window[&apos;WS_Open_&quot; + .CompID + &quot;&apos;]);\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;    WS_&quot; + .CompID + &quot;.addEventListener(&apos;close&apos;, window[&apos;WS_Close_&quot; + .CompID + &quot;&apos;]);\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;    WS_&quot; + .CompID + &quot;.addEventListener(&apos;message&apos;, window[&apos;WS_Msg_&quot; + .CompID + &quot;&apos;]);\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;    WS_&quot; + .CompID + &quot;.addEventListener(&apos;error&apos;, window[&apos;WS_Err_&quot; + .CompID + &quot;&apos;]);\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;  }\n&quot;' />
						</command>
						<command class_type='comment' title='' comment='Comment' textarea='12,0,12,0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = .HeaderScript + &quot;  function WS_Open_&quot; + .CompID + &quot;()\n  {\n&quot;' />
						</command>
						<command class_type='decision' title='Decision' exp='bDebug' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.HeaderScript = .HeaderScript + &quot;    console.log(\&quot;WebSocket opened\&quot;);\n&quot;' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Length$(macOnOpen) &gt; 0' swap='0' >
							<flowline >
								<command class_type='sim' title='Built-in Function' macro='Component.Property.GetValue' >
									<return exp='.sMacro' />
