					</flowline>
				</macro>
				<macro >
					<flowline name='WriteConfigRegisters' description='Write configuration registers to ADS1220' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='calculation' title='Write all 4 control registers starting from 0' >
							<exp exp='spi_buffer[0] = 0x43' />
							<exp exp='spi_buffer[1] = ConfigReg0' />
							<exp exp='spi_buffer[2] = ConfigReg1' />
							<exp exp='spi_buffer[3] = ConfigReg2' />
							<exp exp='spi_buffer[4] = ConfigReg3' />
						</command>
						<command class_type='call' title='CS Pin Low' component='cal_spi1' macro='Master_Enable_CS' />
						<command class_type='call' title='SPI Transaction' component='cal_spi1' macro='Master_Transaction' >
							<argument exp='spi_buffer' />
							<argument exp='5' />
						</command>
						<command class_type='call' title='CS Pin High' component='cal_spi1' macro='Master_Disable_CS' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Initialise' description='Initialize the ADS1220 ADC' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Initialize SPI Master' component='cal_spi1' macro='Master_Init' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='ConfigReg0 = 0' />
							<exp exp='ConfigReg1 = 0' />
							<exp exp='ConfigReg2 = 0' />
							<exp exp='ConfigReg3 = 0' />
						</command>
						<command class_type='call' title='Write Configuration' macro='WriteConfigRegisters' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SampleDiffVolts' description='Performs a differential ADC sample and returns voltage in volts' statediag='0' >
						<return name='Return' type='f32' description='Differential voltage in volts' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<param name='ChannelA' type='u8' description='Positive channel: 0-3 (AN0-AN3)' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ChannelB' type='u8' description='Negative channel: 0-3 (AN0-AN3)' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Gain' type='u8' description='PGA Gain: 0=1x, 1=2x, 2=4x, 3=8x, 4=16x, 5=32x, 6=64x, 7=128x' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='RawValue' type='s32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='GainValue' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='1' setinit='' />
						<command class_type='call' title='Read Raw Value' macro='SampleDiffRAW' >
							<return exp='.RawValue' />
							<argument exp='.ChannelA' />
							<argument exp='.ChannelB' />
							<argument exp='.Gain' />
						</command>
						<command class_type='switch' title='Switch' exp='.Gain &amp; 0x07' >
							<case >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 1' />
									</command>
								</flowline>
							</case>
							<case exp='0' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 1' />
									</command>
								</flowline>
							</case>
							<case exp='1' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 2' />
									</command>
								</flowline>
							</case>
							<case exp='2' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 4' />
									</command>
								</flowline>
							</case>
							<case exp='3' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 8' />
									</command>
								</flowline>
							</case>
							<case exp='4' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 16' />
									</command>
								</flowline>
							</case>
							<case exp='5' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 32' />
									</command>
								</flowline>
							</case>
							<case exp='6' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 64' />
									</command>
								</flowline>
							</case>
							<case exp='7' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 128' />
									</command>
								</flowline>
							</case>
						</command>
						<command class_type='calculation' title='Convert to voltage' >
							<exp exp='.Return = (FLOAT .RawValue / FLOAT 8388608.0) * ReferenceVoltage / FLOAT .GainValue' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadSample' description='' statediag='0' >
						<return name='Return' type='s32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='TOUT' type='u16' description='' isconst='0' isHidden='0' isinit='1' usrinit='10000' setinit='10000' />
						<local name='S1' type='f32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0.0' setinit='0' />
						<local name='S2' type='f32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0.0' setinit='0' />
						<command class_type='decision' title='Decision' exp='IsSim &amp;&amp; (SimComms = 0)' swap='0' >
							<flowline >
								<command class_type='decision' title='Single Ended Conversion?' exp='ConfigReg0 &amp; 0x80' swap='0' >
									<flowline >
										<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
											<return exp='.S1' />
											<argument exp='(ConfigReg0 &amp; 0x70) &gt;&gt; 4' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.S1 = .S1 * 8388607.0' />
											<exp exp='.Return = .S1' />
										</command>
									</flowline>
									<flowline >
										<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='(ConfigReg0 &amp; 0x70) &gt;&gt; 4' >
											<case >
												<flowline >
													<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
														<return exp='.S1' />
														<argument exp='0' />
													</command>
													<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
														<return exp='.S2' />
														<argument exp='1' />
													</command>
												</flowline>
											</case>
											<case exp='1' >
												<flowline >
													<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
														<return exp='.S1' />
														<argument exp='0' />
													</command>
													<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
														<return exp='.S2' />
														<argument exp='2' />
													</command>
												</flowline>
											</case>
											<case exp='2' >
												<flowline >
													<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
														<return exp='.S1' />
														<argument exp='0' />
													</command>
													<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
														<return exp='.S2' />
														<argument exp='3' />
													</command>
												</flowline>
											</case>
											<case exp='3' >
												<flowline >
													<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
														<return exp='.S1' />
														<argument exp='1' />
													</command>
													<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
														<return exp='.S2' />
														<argument exp='2' />
													</command>
												</flowline>
											</case>
											<case exp='4' >
												<flowline >
													<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
														<return exp='.S1' />
														<argument exp='1' />
													</command>
													<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
														<return exp='.S2' />
														<argument exp='3' />
													</command>
												</flowline>
											</case>
											<case exp='5' >
												<flowline >
													<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
														<return exp='.S1' />
														<argument exp='2' />
													</command>
													<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
														<return exp='.S2' />
														<argument exp='3' />
													</command>
												</flowline>
											</case>
											<case exp='6' >
												<flowline >
													<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
														<return exp='.S1' />
														<argument exp='1' />
													</command>
													<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
														<return exp='.S2' />
														<argument exp='0' />
													</command>
												</flowline>
											</case>
											<case exp='7' >
												<flowline >
													<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
														<return exp='.S1' />
														<argument exp='3' />
													</command>
													<command class_type='sim' title='Component Macro' component='SensorLibrary' macro='GetValue' >
														<return exp='.S2' />
														<argument exp='2' />
													</command>
												</flowline>
											</case>
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.S1 = .S1 - .S2' />
											<exp exp='.S1 = .S1 * 8388607.0' />
											<exp exp='.Return = .S1' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline >
								<command class_type='call' title='CS Pin Low' component='cal_spi1' macro='Master_Enable_CS' />
								<command class_type='decision' title='Continuous Mode?' exp='ConfigReg1 &amp; 0x04' swap='0' >
									<flowline />
									<flowline >
										<command class_type='calculation' title='Send START/SYNC command' >
											<exp exp='spi_buffer[0] = 0x08' />
										</command>
										<command class_type='call' title='SPI Transaction' component='cal_spi1' macro='Master_Transaction' >
											<argument exp='spi_buffer' />
											<argument exp='1' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Wait for DRDY' exp='UseReady' swap='0' >
									<flowline >
										<command class_type='loop' title='Wait for up to 0.1s' type='0' exp='DRDYPin = 1' >
											<flowline >
												<command class_type='delay' title='Delay' exp='10' type='0' />
												<command class_type='calculation' title='Calculation' >
													<exp exp='.TOUT = .TOUT - 1' />
												</command>
												<command class_type='decision' title='Decision' exp='.TOUT = 0' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='.Return = 0' />
														</command>
														<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' />
													</flowline>
													<flowline />
												</command>
											</flowline>
										</command>
										<command class_type='calculation' title='Send READ DATA command' >
											<exp exp='spi_buffer[0] = 0' />
											<exp exp='spi_buffer[1] = 0' />
											<exp exp='spi_buffer[2] = 0' />
										</command>
										<command class_type='call' title='SPI Transaction' component='cal_spi1' macro='Master_Transaction' >
											<argument exp='spi_buffer' />
											<argument exp='3' />
										</command>
										<command class_type='call' title='Combine 24-bit value' component='TypeConversions1' macro='SetBytes' >
											<argument exp='spi_buffer[2]' />
											<argument exp='spi_buffer[1]' />
											<argument exp='spi_buffer[0]' />
											<argument exp='0' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Send READ DATA command' >
											<exp exp='spi_buffer[0] = 0x10' />
											<exp exp='spi_buffer[1] = 0' />
											<exp exp='spi_buffer[2] = 0' />
											<exp exp='spi_buffer[3] = 0' />
										</command>
										<command class_type='call' title='SPI Transaction' component='cal_spi1' macro='Master_Transaction' >
											<argument exp='spi_buffer' />
											<argument exp='4' />
										</command>
										<command class_type='call' title='Combine 24-bit value' component='TypeConversions1' macro='SetBytes' >
											<argument exp='spi_buffer[3]' />
											<argument exp='spi_buffer[2]' />
											<argument exp='spi_buffer[1]' />
											<argument exp='0' />
										</command>
										<command class_type='decision' title='Continuous Mode?' disable='1' exp='ConfigReg1 &amp; 0x04' swap='0' >
											<flowline >
												<command class_type='calculation' title='Send READ DATA command' >
													<exp exp='spi_buffer[0] = 0' />
													<exp exp='spi_buffer[1] = 0' />
													<exp exp='spi_buffer[2] = 0' />
												</command>
												<command class_type='call' title='SPI Transaction' component='cal_spi1' macro='Master_Transaction' >
													<argument exp='spi_buffer' />
													<argument exp='3' />
												</command>
												<command class_type='call' title='Combine 24-bit value' component='TypeConversions1' macro='SetBytes' >
													<argument exp='spi_buffer[2]' />
													<argument exp='spi_buffer[1]' />
													<argument exp='spi_buffer[0]' />
													<argument exp='0' />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
								</command>
								<command class_type='call' title='CS Pin High' component='cal_spi1' macro='Master_Disable_CS' />
								<command class_type='call' title='Component Macro' component='TypeConversions1' macro='GetLong' >
									<return exp='.Return' />
								</command>
								<command class_type='label' title='Declare Connection Point' labelid='0' labelname='A' />
								<command class_type='decision' title='Check if negative' exp='.Return &gt; 8388607' swap='0' >
									<flowline >
										<command class_type='calculation' title='Sign extend for 24-bit signed' >
											<exp exp='.Return = .Return - 16777216' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Property' description='Sent when a property has been changed by the User' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='Decision' exp='VRef = 0' swap='0' >
							<flowline >
								<command class_type='sim' title='Built-in Function' macro='Component.Property.SetValue' >
									<argument exp='this' />
									<argument exp='&quot;ReferenceVoltage&quot;' />
									<argument exp='&quot;2.048&quot;' />
								</command>
								<command class_type='sim' title='Built-in Function' macro='Component.Property.SetWritable' >
									<argument exp='this' />
									<argument exp='&quot;ReferenceVoltage&quot;' />
									<argument exp='0' />
								</command>
							</flowline>
							<flowline >
								<command class_type='sim' title='Built-in Function' macro='Component.Property.SetWritable' >
									<argument exp='this' />
									<argument exp='&quot;ReferenceVoltage&quot;' />
									<argument exp='1' />
								</command>
							</flowline>
						</command>
						<command class_type='sim' title='Built-in Function' macro='Component.Property.SetValue' >
							<argument exp='this' />
							<argument exp='&quot;TempCoefficient&quot;' />
							<argument exp='&quot;0.00385055&quot;' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Renamed' description='' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Name' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<command class_type='sim' title='' macro='Tree.GetName' >
							<return exp='.Name' />
							<argument exp='this' />
						</command>
						<command class_type='sim' title='' macro='Component.Property.SetValue' >
							<argument exp='SensorLibrary' />
							<argument exp='&quot;Name&quot;' />
							<argument exp='.Name' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadRTDResistance' description='Reads the RTD sensor and returns resistance in ohms' statediag='0' >
						<return name='Return' type='f32' description='RTD resistance in ohms' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='RawValue' type='s32' description='24-bit ADC raw value' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='GainValue' type='f32' description='PGA gain value (1.0, 2.0, 4.0, etc.)' isconst='0' isHidden='0' isinit='0' usrinit='1.0' setinit='1.0' />
						<local name='GainReg' type='u8' description='Gain setting from ConfigReg0' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Temp' type='f32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0.0' setinit='0' />
						<command class_type='call' title='User Macro' macro='ReadSample' >
							<return exp='.RawValue' />
						</command>
						<command class_type='calculation' title='Extract PGA gain from ConfigReg0 (bits 4-6)' >
							<exp exp='.GainReg = (ConfigReg0 &gt;&gt; 1) &amp; 0x07' />
						</command>
						<command class_type='switch' title='Convert gain register to gain value' exp='.GainReg' >
							<case >
								<flowline >
									<command class_type='calculation' title='Gain 1x' >
										<exp exp='.GainValue = 1.0' />
									</command>
								</flowline>
							</case>
							<case exp='1' >
								<flowline >
									<command class_type='calculation' title='Gain 2x' >
										<exp exp='.GainValue = 2.0' />
									</command>
								</flowline>
							</case>
							<case exp='2' >
								<flowline >
									<command class_type='calculation' title='Gain 4x' >
										<exp exp='.GainValue = 4.0' />
									</command>
								</flowline>
							</case>
							<case exp='3' >
								<flowline >
									<command class_type='calculation' title='Gain 8x' >
										<exp exp='.GainValue = 8.0' />
									</command>
								</flowline>
							</case>
							<case exp='4' >
								<flowline >
									<command class_type='calculation' title='Gain 16x' >
										<exp exp='.GainValue = 16.0' />
									</command>
								</flowline>
							</case>
							<case exp='5' >
								<flowline >
									<command class_type='calculation' title='Gain 32x' >
										<exp exp='.GainValue = 32.0' />
									</command>
								</flowline>
							</case>
							<case exp='6' >
								<flowline >
									<command class_type='calculation' title='Gain 64x' >
										<exp exp='.GainValue = 64.0' />
									</command>
								</flowline>
							</case>
							<case exp='7' >
								<flowline >
									<command class_type='calculation' title='Gain 128x' >
										<exp exp='.GainValue = 128.0' />
									</command>
								</flowline>
							</case>
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='decision' title='2 Wire RTD' exp='RTDConfig = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculate RTD resistance 2 Wire' >
									<exp exp='.Return = FLOAT RefResistor * .RawValue / (8388608.0 * .GainValue)' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='3 Wire RTD - Low side ref' exp='RTDConfig = 1' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculate RTD resistance using 3W low-side reference' >
									<exp exp='.Return = FLOAT RefResistor * .RawValue / (4194304.0 * .GainValue)' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='4 Wire RTD' exp='RTDConfig = 2' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculate RTD resistance 2 Wire' >
									<exp exp='.Return = FLOAT RefResistor * .RawValue / (8388608.0 * .GainValue)' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_SimStart' description='Broadcast to all components that simulation is starting' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Built-in Function' macro='Component.Property.SetValue' >
							<argument exp='this' />
							<argument exp='&quot;IsSim&quot;' />
							<argument exp='1' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SampleSglRaw' description='Performs a single-ended ADC sample on the selected channel and returns 24-bit raw value' statediag='0' >
						<return name='Return' type='s32' description='24-bit ADC reading' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Channel' type='u8' description='Range: 0-3 (AN0-AN3)' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Gain' type='u8' description='PGA Gain: 0=1x, 1=2x, 2=4x, 3=8x, 4=16x, 5=32x, 6=64x, 7=128x' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='temp' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='Decision' exp='.Channel &lt; 4' swap='0' >
							<flowline >
								<command class_type='calculation' title='Work out channel' >
									<exp exp='.temp = 0x80 | ((.Channel &amp; 0x03) &lt;&lt; 4)' />
									<exp exp='.temp = .temp | ((.Gain &amp; 0x07) &lt;&lt; 1)' />
								</command>
								<command class_type='decision' title='Is the channel already set correctly?' exp='ConfigReg0 = .temp' swap='0' >
									<flowline />
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='ConfigReg0 = .temp' />
										</command>
										<command class_type='call' title='CS Pin Low' component='cal_spi1' macro='Master_Enable_CS' />
										<command class_type='calculation' title='Build Write Command' >
											<exp exp='spi_buffer[0] = 0x40' />
											<exp exp='spi_buffer[1] = ConfigReg0' />
										</command>
										<command class_type='call' title='SPI Transaction' component='cal_spi1' macro='Master_Transaction' >
											<argument exp='spi_buffer' />
											<argument exp='2' />
										</command>
										<command class_type='call' title='CS Pin High' component='cal_spi1' macro='Master_Disable_CS' />
									</flowline>
								</command>
								<command class_type='call' title='User Macro' macro='ReadSample' >
									<return exp='.Return' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Invalid channel' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadRTDTemperature' description='Reads the RTD sensor and returns temperature in degrees Celsius using linear approximation - matches GitHub library get_temperature_from_rtd_ohms_with_linear_approx' statediag='0' >
						<return name='Return' type='f32' description='Temperature in degrees Celsius' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='Rt' type='f32' description='RTD resistance' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='R0' type='f32' description='Base resistance at 0°C' isconst='0' isHidden='0' isinit='0' usrinit='100.0' setinit='100.0' />
						<local name='Temp' type='f32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0.0' setinit='0' />
						<command class_type='call' title='Read RTD Resistance' macro='ReadRTDResistance' >
							<return exp='.Rt' />
						</command>
						<command class_type='decision' title='Select R0 based on RTD type' exp='RTDType = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='PT100' >
									<exp exp='.R0 = 100.0' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='PT1000' >
									<exp exp='.R0 = 1000.0' />
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Calculate temperature using linear approximation: T = (R - R0) / (R0 × α)' >
							<exp exp='.Temp = (.R0 * TempCoefficient)' />
							<exp exp='.Return = (.Rt - .R0)' />
							<exp exp='.Return = .Return / .Temp' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SampleSglVolts' description='Performs a single-ended ADC sample and returns voltage in volts' statediag='0' >
						<return name='Return' type='f32' description='Voltage in volts' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<param name='Channel' type='u8' description='Range: 0-3 (AN0-AN3)' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Gain' type='u8' description='PGA Gain: 0=1x, 1=2x, 2=4x, 3=8x, 4=16x, 5=32x, 6=64x, 7=128x' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='RawValue' type='s32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='GainValue' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='1' setinit='' />
						<command class_type='call' title='Read Raw Value' macro='SampleSglRaw' >
							<return exp='.RawValue' />
							<argument exp='.Channel' />
							<argument exp='.Gain' />
						</command>
						<command class_type='switch' title='Switch' exp='.Gain' >
							<case >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 1' />
									</command>
								</flowline>
							</case>
							<case exp='0' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 1' />
									</command>
								</flowline>
							</case>
							<case exp='1' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 2' />
									</command>
								</flowline>
							</case>
							<case exp='2' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 4' />
									</command>
								</flowline>
							</case>
							<case exp='3' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 8' />
									</command>
								</flowline>
							</case>
							<case exp='4' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 16' />
									</command>
								</flowline>
							</case>
							<case exp='5' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 32' />
									</command>
								</flowline>
							</case>
							<case exp='6' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 64' />
									</command>
								</flowline>
							</case>
							<case exp='7' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.GainValue = 128' />
									</command>
								</flowline>
							</case>
						</command>
						<command class_type='calculation' title='Convert to voltage' >
							<exp exp='.Return = (FLOAT .RawValue / FLOAT 8388608.0) * ReferenceVoltage / FLOAT .GainValue' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_CompileStart' description='Broadcast to all components that compilation is starting' statediag='0' >
						<return name='Return' type='u32' description='Non-zero to prevent compilation' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Built-in Function' macro='Component.Property.SetValue' >
							<argument exp='this' />
							<argument exp='&quot;IsSim&quot;' />
							<argument exp='0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SampleDiffRAW' description='Performs a differential ADC sample between two channels and returns 24-bit raw value.
Not all channel combinations are possible, see datasheet p40 section MUX.
Returns 0 if the channel selection is invalid.' statediag='0' >
						<return name='Return' type='s32' description='24-bit differential ADC reading' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ChannelA' type='u8' description='Positive channel: 0-3 (AN0-AN3)' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ChannelB' type='u8' description='Negative channel: 0-3 (AN0-AN3)' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Gain' type='u8' description='PGA Gain: 0=1x, 1=2x, 2=4x, 3=8x, 4=16x, 5=32x, 6=64x, 7=128x' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='temp' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='Decision' exp='(.ChannelA &lt; 4) &amp;&amp; (.ChannelB &lt; 4) &amp;&amp; (.ChannelA != .ChannelB)' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='.ChannelA = 0' swap='0' >
									<flowline >
										<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='.ChannelB' >
											<case >
												<flowline >
													<command class_type='calculation' title='Invalid channel' >
														<exp exp='.Return = 0' />
													</command>
													<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' />
												</flowline>
											</case>
											<case exp='1' >
												<flowline >
													<command class_type='calculation' title='Work out channel' >
														<exp exp='.temp = 0x00' />
													</command>
												</flowline>
											</case>
											<case exp='2' >
												<flowline >
													<command class_type='calculation' title='Work out channel' >
														<exp exp='.temp = 0x10' />
													</command>
												</flowline>
											</case>
											<case exp='3' >
												<flowline >
													<command class_type='calculation' title='Work out channel' >
														<exp exp='.temp = 0x20' />
													</command>
												</flowline>
											</case>
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='.ChannelA = 1' swap='0' >
									<flowline >
										<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='.ChannelB' >
											<case >
												<flowline >
													<command class_type='calculation' title='Invalid channel' >
														<exp exp='.Return = 0' />
													</command>
													<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' />
												</flowline>
											</case>
											<case exp='2' >
												<flowline >
													<command class_type='calculation' title='Work out channel' >
														<exp exp='.temp = 0x30' />
													</command>
												</flowline>
											</case>
											<case exp='3' >
												<flowline >
													<command class_type='calculation' title='Work out channel' >
														<exp exp='.temp = 0x40' />
													</command>
												</flowline>
											</case>
											<case exp='0' >
												<flowline >
													<command class_type='calculation' title='Work out channel' >
														<exp exp='.temp = 0x60' />
													</command>
												</flowline>
											</case>
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='.ChannelA = 2' swap='0' >
									<flowline >
										<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='.ChannelB' >
											<case >
												<flowline >
													<command class_type='calculation' title='Invalid channel' >
														<exp exp='.Return = 0' />
													</command>
													<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' />
												</flowline>
											</case>
											<case exp='3' >
												<flowline >
													<command class_type='calculation' title='Work out channel' >
														<exp exp='.temp = 0x50' />
													</command>
												</flowline>
											</case>
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='.ChannelA = 3' swap='0' >
									<flowline >
										<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='.ChannelB' >
											<case >
												<flowline >
													<command class_type='calculation' title='Invalid channel' >
														<exp exp='.Return = 0' />
													</command>
													<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' />
												</flowline>
											</case>
											<case exp='2' >
												<flowline >
													<command class_type='calculation' title='Work out channel' >
														<exp exp='.temp = 0x70' />
													</command>
												</flowline>
											</case>
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.temp = .temp | ((.Gain &amp; 0x07) &lt;&lt; 1)' />
								</command>
								<command class_type='decision' title='Is the channel already set correctly?' exp='ConfigReg0 = .temp' swap='0' >
									<flowline />
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='ConfigReg0 = .temp' />
										</command>
										<command class_type='call' title='CS Pin Low' component='cal_spi1' macro='Master_Enable_CS' />
										<command class_type='calculation' title='Build Write Command' >
											<exp exp='spi_buffer[0] = 0x40' />
											<exp exp='spi_buffer[1] = ConfigReg0' />
										</command>
										<command class_type='call' title='SPI Transaction' component='cal_spi1' macro='Master_Transaction' >
											<argument exp='spi_buffer' />
											<argument exp='2' />
										</command>
										<command class_type='call' title='CS Pin High' component='cal_spi1' macro='Master_Disable_CS' />
									</flowline>
								</command>
								<command class_type='call' title='User Macro' macro='ReadSample' >
									<return exp='.Return' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Invalid channel' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
						</command>
						<command class_type='label' title='Declare Connection Point' labelid='0' labelname='A' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='Main program entry point - demonstrates component usage' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='call' title='Initialize ADC' macro='Initialise' />
						<command class_type='call' title='Sample Single Channel Raw' macro='SampleSglRaw' >
							<argument exp='0' />
							<argument exp='0' />
						</command>
						<command class_type='call' title='Sample Single Channel Volts' macro='SampleSglVolts' >
							<argument exp='0' />
							<argument exp='0' />
						</command>
						<command class_type='call' title='Sample Differential Raw' macro='SampleDiffRAW' >
							<argument exp='0' />
							<argument exp='1' />
							<argument exp='0' />
						</command>
						<command class_type='call' title='Sample Differential Volts' macro='SampleDiffVolts' >
							<argument exp='0' />
							<argument exp='1' />
							<argument exp='0' />
						</command>
						<command class_type='call' title='Read RTD Temperature' macro='ReadRTDTemperature' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Initialise' description='Initialize the ADS1220 ADC with default settings' statediag='0' >
						<return name='Return' type='u8' description='0 = Success' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Initialize SPI Master' component='cal_spi1' macro='Master_Init' />
						<command class_type='delay' title='Delay' exp='10' type='1' />
						<command class_type='call' title='CS Pin Low' component='cal_spi1' macro='Master_Enable_CS' />
						<command class_type='calculation' title='Send RESET command' >
							<exp exp='spi_buffer[0] = 0x06' />
						</command>
						<command class_type='call' title='SPI Transaction' component='cal_spi1' macro='Master_Transaction' >
							<argument exp='spi_buffer' />
							<argument exp='1' />
						</command>
						<command class_type='call' title='CS Pin High' component='cal_spi1' macro='Master_Disable_CS' />
						<command class_type='delay' title='Delay' exp='10' type='1' />
						<command class_type='calculation' title='Configure Register 0' >
							<exp exp='ConfigReg0 = 0' />
							<exp exp='ConfigReg0 = ConfigReg0 | (PGAGain &lt;&lt; 1)' />
						</command>
						<command class_type='calculation' title='Configure Register 1' >
							<exp exp='ConfigReg1 = 0' />
							<exp exp='ConfigReg1 = ConfigReg1 | (DataRate &lt;&lt; 5)' />
							<exp exp='ConfigReg1 = ConfigReg1 | (OperatingMode &lt;&lt; 3)' />
							<exp exp='ConfigReg1 = ConfigReg1 | (ConversionMode &lt;&lt; 2)' />
						</command>
						<command class_type='calculation' title='Configure Register 2' >
							<exp exp='ConfigReg2 = 0' />
							<exp exp='ConfigReg2 = ConfigReg2 | (VRef &lt;&lt; 6)' />
							<exp exp='ConfigReg2 = ConfigReg2 | (FIRFilter &lt;&lt; 4)' />
							<exp exp='ConfigReg2 = ConfigReg2 | (IDACCurrent)' />
						</command>
						<command class_type='calculation' title='Configure Register 3' >
							<exp exp='ConfigReg3 = 0' />
							<exp exp='ConfigReg3 = ConfigReg3 | (I1MUX &lt;&lt; 5)' />
							<exp exp='ConfigReg3 = ConfigReg3 | (I2MUX &lt;&lt; 2)' />
							<exp exp='ConfigReg3 = ConfigReg3 | ((1 - UseReady) &lt;&lt; 1)' />
						</command>
						<command class_type='call' title='Write Configuration' macro='WriteConfigRegisters' />
						<command class_type='decision' title='Continuouse Conversion needs kick starting' exp='ConversionMode' swap='0' >
							<flowline >
								<command class_type='calculation' title='Send START/SYNC command' >
									<exp exp='spi_buffer[0] = 0x08' />
								</command>
								<command class_type='call' title='SPI Transaction' component='cal_spi1' macro='Master_Transaction' >
									<argument exp='spi_buffer' />
									<argument exp='1' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
					</flowline>
				</macro>
			</macros>
			<component class_type='ref' guid='c67171df-0ad6-4b11-8361-cfe14b072847' vmin='21' vmaj='21' codename='cal_spi1' panelId='-1' x='-1' y='1' z='0.25' xsz='0.1' ysz='0.1' zsz='0.1' xang='0' yang='0' zang='0' xquat='0' yquat='0' zquat='0' wquat='1' visible='1' scadavisible='1' interactive='1' solid='1' layer='1' poslock='0' ancTop='0' ancBottom='0' ancLeft='0' ancRight='0' ancMinX='0' ancMinY='0' comp2dType='0' >
