				<macro >
					<flowline name='IsAbsolute' description='Returns true if the device is providing absolute orientation information.

Absolute data will be in reference to the Earth&apos;s coordinate frame.' statediag='0' >
						<return name='Return' type='b1' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='native' title='JavaScript' ccode='  if (window.DeviceOrientationEvent) {
    FCR_RETVAL = window[&apos;FCORIENT_ABS_&apos; + FC_THIS];
  } else {
    FCR_RETVAL = false;
  }' language='C' />
					</flowline>
				</macro>
