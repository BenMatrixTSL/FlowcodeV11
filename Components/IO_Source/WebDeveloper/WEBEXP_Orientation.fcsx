				<macro >
					<flowline name='Initialise' description='Begins monitoring of the device&apos;s orientation information.

Returns true if the device can provide orientation information.' statediag='0' >
						<return name='Return' type='b1' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='native' title='JavaScript' ccode='  FCR_RETVAL = false;
  if (window.DeviceOrientationEvent) {
    if (&apos;ondeviceorientationabsolute&apos; in window) {
      FCR_RETVAL = true;
      window.addEventListener(&apos;deviceorientationabsolute&apos;, window[&apos;FCORIENT_EVENT_&apos; + FC_THIS], true);
    } else if (&apos;ondeviceorientation&apos; in window) {
      FCR_RETVAL = true;
      window.addEventListener(&apos;deviceorientation&apos;, window[&apos;FCORIENT_EVENT_&apos; + FC_THIS], true);
    }
  }' language='C' />
					</flowline>
				</macro>
