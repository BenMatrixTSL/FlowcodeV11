				<macro >
					<flowline name='Ev_HtmlScriptHeader' description='Sent to a component to retrieve script code to be placed in the html header section' statediag='0' >
						<return name='Return' type='u32' description='Non-zero to block script code insertion' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='CompID' type='T8' description='The unique name of this component' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='HeaderScript' type='T8*' description='Text to amend for the header script' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = &quot;  var FCORIENTATION_&quot; + .CompID + &quot; = [0, 0, 0];\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;  var FCORIENT_ABS_&quot; + .CompID + &quot; = false;\n&quot;' />
						</command>
						<command class_type='decision' title='Decision' exp='bUseCallback' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.HeaderScript = .HeaderScript + &quot;  function FCORIENT_CB_&quot; + .CompID + &quot;(timestamp) {&quot;' />
									<exp exp='.HeaderScript = .HeaderScript + &quot;    FCM_&quot; + mCallback' />
									<exp exp='' />
									<exp exp='//parameters' />
									<exp exp='.HeaderScript = .HeaderScript + &quot;(&quot;' />
									<exp exp='.HeaderScript = .HeaderScript + &quot;FCORIENTATION_&quot; + .CompID + &quot;[0], &quot;' />
									<exp exp='.HeaderScript = .HeaderScript + &quot;FCORIENTATION_&quot; + .CompID + &quot;[1], &quot;' />
									<exp exp='.HeaderScript = .HeaderScript + &quot;FCORIENTATION_&quot; + .CompID + &quot;[2], &quot;' />
									<exp exp='.HeaderScript = .HeaderScript + &quot;FCORIENT_ABS_&quot; + .CompID' />
									<exp exp='.HeaderScript = .HeaderScript + &quot;);\n&quot;' />
									<exp exp='' />
									<exp exp='.HeaderScript = .HeaderScript + &quot;  }\n\n&quot;' />
									<exp exp='' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = .HeaderScript + &quot;  function FCORIENT_EVENT_&quot; + .CompID + &quot;(event) {&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;    FCORIENTATION_&quot; + .CompID + &quot;[0] = event.alpha === null ? 0 : event.alpha;\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;    FCORIENTATION_&quot; + .CompID + &quot;[1] = event.beta === null ? 0 : event.beta;\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;    FCORIENTATION_&quot; + .CompID + &quot;[2] = event.gamma === null ? 0 : event.gamma;\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;    FCORIENT_ABS_&quot; + .CompID + &quot; = event.absolute;\n\n&quot;' />
							<exp exp='' />
						</command>
						<command class_type='decision' title='Decision' exp='bUseCallback' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.HeaderScript = .HeaderScript + &quot;  requestAnimationFrame(FCORIENT_CB_&quot; + .CompID + &quot;);\n&quot;' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = .HeaderScript + &quot;  }\n&quot;' />
						</command>
						<command class_type='calculation' title='Set return to zero to ensure text is added to html file' >
							<exp exp='.Return = 0' />
						</command>
					</flowline>
