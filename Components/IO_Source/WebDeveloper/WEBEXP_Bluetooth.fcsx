					</flowline>
				</macro>
				<macro >
					<flowline name='RequestDevice' description='Attempts to connect with a Bluetooth BLE device.' statediag='0' >
						<return name='Return' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='2000' />
						</return>
						<command class_type='calculation' title='Set the return to null' >
							<exp exp='.Return = &quot;&quot;' />
						</command>
						<command class_type='native' title='Javascript' ccode='if (&quot;bluetooth&quot; in navigator)&#10;{&#10;  try&#10;  {&#10;    //Request BLE device&#10;    console.log(&apos;Requesting BLE device&apos;);&#10;    const filter = window[&apos;FCFLTR_&apos; + FC_THIS];&#10;    window[&apos;FCDEVICE_&apos; + FC_THIS] = await navigator.bluetooth.requestDevice( filter );&#10;    &#10;    //Add a handler for disconnection&#10;    window[&apos;FCDEVICE_&apos; + FC_THIS].addEventListener(&apos;gattserverdisconnected&apos;, window[&apos;OnDisconnect_&apos; + FC_THIS]);&#10;    &#10;    //Connect to GATT server&#10;    console.log(&apos;Connecting to GATT server&apos;);&#10;    window[&apos;FCSERVER_&apos; + FC_THIS] = await window[&apos;FCDEVICE_&apos; + FC_THIS].gatt.connect();&#10;&#10;    //Get the service&#10;    console.log(&apos;Getting service&apos;);&#10;    window[&apos;FCSERVICE_&apos; + FC_THIS] = await window[&apos;FCSERVER_&apos; + FC_THIS].getPrimaryService(window[&apos;FCSERVICE_UUID_&apos; + FC_THIS]);&#10;&#10;    //Get characteristic&#10;    console.log(&apos;Getting characteristic&apos;);&#10;    window[&apos;FCCHARAC_&apos; + FC_THIS] = await window[&apos;FCSERVICE_&apos; + FC_THIS].getCharacteristic(window[&apos;FCCHARAC_UUID_&apos; + FC_THIS]);&#10;&#10;    //Subscribe to notifications&#10;    console.log(&apos;Subscribing to notifications&apos;);&#10;    await window[&apos;FCCHARAC_&apos; + FC_THIS].startNotifications();&#10;    window[&apos;FCCHARAC_&apos; + FC_THIS].addEventListener(&apos;characteristicvaluechanged&apos;, window[&apos;CharacteristicChanged_&apos; + FC_THIS]);&#10;&#10;    FCR_RETVAL = true;&#10;  }&#10;  &#10;  catch (err)&#10;  {&#10;    console.log(&quot;Bluetooth error: &quot; + err.message);&#10;  }&#10;}&#10;else&#10;{&#10;  console.log(&quot;Bluetooth not available!&quot;);&#10;}' customize='1' language='C' />
						<command class_type='call' title='This forces the function to be &apos;async&apos;' macro='Prv_NullMacro' await='1' />
					</flowline>
				</macro>
