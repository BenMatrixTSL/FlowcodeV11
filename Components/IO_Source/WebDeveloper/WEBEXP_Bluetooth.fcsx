			<apis >
				<api name='Disconnect' alt='Disconnect' type='1' proto='1' />
				<api name='WriteString' alt='WriteString' type='1' proto='1' />
				<api name='WriteArray' alt='WriteArray' type='1' proto='1' />
				<api name='WriteSingleValue' alt='WriteSingleValue' type='1' proto='1' />
				<api name='RequestDevice' alt='RequestDevice' type='1' proto='1' />
			</apis>
			<variables />
			<macros >
				<macro >
					<flowline name='Prv_NullMacro' description='Call this to force a calling macro to be async' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Disconnect' description='Disconnects from the remote BLE device' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='native' title='JavaScript' ccode='if (&quot;bluetooth&quot; in navigator)&#10;{&#10;  if ((window[&apos;FCDEVICE_&apos; + FC_THIS] != null) &amp;&amp; (window[&apos;FCDEVICE_&apos; + FC_THIS].connected))&#10;  {&#10;    //Disconnect from the GATT server&#10;    console.log(&apos;Disconnecting from GATT server&apos;);&#10;    await window[&apos;FCDEVICE_&apos; + FC_THIS].gatt.disconnect();&#10;  }&#10;  else&#10;  {&#10;    console.log(&quot;Not connected!&quot;);&#10;  }&#10;}&#10;else&#10;{&#10;  console.log(&quot;Bluetooth not available!&quot;);&#10;}' customize='1' language='C' />
						<command class_type='call' title='This forces the function to be &apos;async&apos;' macro='Prv_NullMacro' await='1' />
					</flowline>
				</macro>
				<macro >
					<flowline name='WriteString' description='Writes a string value to GATT Characteristic on a connected BLE device' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='sText' type='T8' description='The text to send' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='2000' />
						</param>
						<command class_type='native' title='JavaScript' ccode='if (&quot;bluetooth&quot; in navigator)&#10;{&#10;  if (!window[&apos;FCCHARAC_&apos; + FC_THIS])&#10;  {&#10;    console.log(&quot;Bluetooth device not connected!&quot;);&#10;  }&#10;  else&#10;  {&#10;    const encoder = new TextEncoder();&#10;    const data = encoder.encode(FCL_STEXT);&#10;    try&#10;    {&#10;      await window[&apos;FCCHARAC_&apos; + FC_THIS].writeValueWithoutResponse(data);&#10;    }&#10;    catch (err)&#10;    {&#10;      console.log(&quot;Send error: &quot; + err.message);&#10;    }&#10;  }&#10;}&#10;else&#10;{&#10;  console.log(&quot;Bluetooth not available!&quot;);&#10;}' customize='1' language='C' />
						<command class_type='call' title='User Macro' macro='Prv_NullMacro' await='1' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Property' description='Sent when a property has been changed by the User' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='iDataType' type='s32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='bNoArray' type='b1' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='bNoEndianness' type='b1' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.iDataType = iDataType' />
						</command>
						<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='.iDataType' >
							<case >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.bNoArray = 0' />
										<exp exp='.bNoEndianness = 0' />
									</command>
								</flowline>
							</case>
							<case exp='0' >
								<flowline >
									<command class_type='calculation' title='String' >
										<exp exp='.bNoArray = 1' />
										<exp exp='.bNoEndianness = 1' />
									</command>
								</flowline>
							</case>
							<case exp='1' >
								<flowline >
									<command class_type='calculation' title='Int8' >
										<exp exp='.bNoArray = 0' />
										<exp exp='.bNoEndianness = 1' />
									</command>
								</flowline>
							</case>
							<case exp='4' >
								<flowline >
									<command class_type='calculation' title='Uint8' >
										<exp exp='.bNoArray = 0' />
										<exp exp='.bNoEndianness = 1' />
									</command>
								</flowline>
							</case>
						</command>
						<command class_type='decision' title='Decision' exp='.bNoArray' swap='0' >
							<flowline >
								<command class_type='sim' title='Size will always be a single value' macro='Component.Property.SetWritable' >
									<argument exp='this' />
									<argument exp='&quot;bSingleValue&quot;' />
									<argument exp='0' />
								</command>
								<command class_type='sim' title='Size will always be a single value' macro='Component.Property.SetValue' >
									<argument exp='this' />
									<argument exp='&quot;bSingleValue&quot;' />
									<argument exp='&quot;1&quot;' />
								</command>
							</flowline>
							<flowline >
								<command class_type='sim' title='Size can be a single value or an array' macro='Component.Property.SetWritable' >
									<argument exp='this' />
									<argument exp='&quot;bSingleValue&quot;' />
									<argument exp='1' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' exp='.bNoEndianness' swap='0' >
							<flowline >
								<command class_type='sim' title='Endianness is not settable' macro='Component.Property.SetWritable' >
									<argument exp='this' />
									<argument exp='&quot;bLittleEndian&quot;' />
									<argument exp='0' />
								</command>
								<command class_type='sim' title='Default to little-endian as this is the BLE standard' macro='Component.Property.SetValue' >
									<argument exp='this' />
									<argument exp='&quot;bLittleEndian&quot;' />
									<argument exp='&quot;1&quot;' />
								</command>
							</flowline>
							<flowline >
								<command class_type='sim' title='Endianness can be altered' macro='Component.Property.SetWritable' >
									<argument exp='this' />
									<argument exp='&quot;bLittleEndian&quot;' />
									<argument exp='1' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_HtmlScriptHeader' description='Sent to a component to retrieve script code to be placed in the html header section' statediag='0' >
						<return name='Return' type='u32' description='Non-zero to block script code insertion' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='CompID' type='T8' description='The unique name of this component' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='HeaderScript' type='T8*' description='Text to amend for the header script' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<local name='sTemp' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<local name='hParent' type='h32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='iDataType' type='s32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = .HeaderScript + &quot;var FCDEVICE_&quot; + .CompID + &quot; = null;\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;var FCSERVER_&quot; + .CompID + &quot; = null;\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;var FCSERVICE_&quot; + .CompID + &quot; = null;\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;var FCCHARAC_&quot; + .CompID + &quot; = null;\n&quot;' />
						</command>
						<command class_type='comment' title='' comment='Comment' textarea='12,0,12,0' />
						<command class_type='decision' title='Decision' exp='Length$(sFilters) &gt; 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.HeaderScript = .HeaderScript + &quot;var FCFLTR_&quot; + .CompID + &quot; = { &quot; + sFilters + &quot; };\n&quot;' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.HeaderScript = .HeaderScript + &quot;var FCFLTR_&quot; + .CompID + &quot; = { acceptAllDevices:true };\n&quot;' />
								</command>
							</flowline>
						</command>
						<command class_type='comment' title='' comment='Comment' textarea='12,0,12,0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = .HeaderScript + &quot;var FCSERVICE_UUID_&quot; + .CompID + &quot; = &quot; + sService + &quot;;\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;var FCCHARAC_UUID_&quot; + .CompID + &quot; = &quot; + sCharacteristic + &quot;;\n&quot;' />
						</command>
						<command class_type='comment' title='' comment='Comment' textarea='12,0,12,0' />
						<command class_type='decision' title='Decision' exp='Length$(macOnDisconnect) &gt; 0' swap='0' >
							<flowline >
								<command class_type='sim' title='Built-in Function' macro='Component.Property.GetValue' >
									<return exp='.sTemp' />
									<argument exp='this' />
									<argument exp='&quot;macOnDisconnect&quot;' />
								</command>
								<command class_type='sim' title='Built-in Function' macro='Component.GetParent' >
									<return exp='.hParent' />
									<argument exp='this' />
								</command>
								<command class_type='sim' title='Built-in Function' macro='Expand.MacroName' >
									<return exp='.sTemp' />
									<argument exp='.sTemp' />
									<argument exp='.hParent' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.HeaderScript = .HeaderScript + &quot;  function OnDisconnect_&quot; + .CompID + &quot;()\n&quot;' />
									<exp exp='.HeaderScript = .HeaderScript + &quot;  {\n&quot;' />
									<exp exp='.HeaderScript = .HeaderScript + &quot;    &quot; + .sTemp + &quot;();\n&quot;' />
									<exp exp='.HeaderScript = .HeaderScript + &quot;  }\n&quot;' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='comment' title='' comment='Comment' textarea='12,0,12,0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.iDataType = iDataType' />
						</command>
						<command class_type='decision' title='Decision' exp='Length$(macOnValueChanged) &gt; 0' swap='0' >
							<flowline >
								<command class_type='sim' title='Built-in Function' macro='Component.Property.GetValue' >
									<return exp='.sTemp' />
									<argument exp='this' />
									<argument exp='&quot;macOnValueChanged&quot;' />
								</command>
								<command class_type='sim' title='Built-in Function' macro='Component.GetParent' >
									<return exp='.hParent' />
									<argument exp='this' />
								</command>
								<command class_type='sim' title='Built-in Function' macro='Expand.MacroName' >
									<return exp='.sTemp' />
									<argument exp='.sTemp' />
									<argument exp='.hParent' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.HeaderScript = .HeaderScript + &quot;  function CharacteristicChanged_&quot; + .CompID + &quot;(event)\n&quot;' />
									<exp exp='.HeaderScript = .HeaderScript + &quot;  {\n&quot;' />
									<exp exp='.HeaderScript = .HeaderScript + &quot;    const value = event.target.value;\n&quot;' />
								</command>
								<command class_type='decision' title='Is it numeric?' exp='.iDataType != 0' swap='0' >
									<flowline >
										<command class_type='decision' title='Endianness?' exp='bLittleEndian' swap='0' >
											<flowline >
												<command class_type='calculation' title='Little-endian' >
													<exp exp='.HeaderScript = .HeaderScript + &quot;    const bLittleEndian = true;\n&quot;' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Big-endian' >
													<exp exp='.HeaderScript = .HeaderScript + &quot;    const bLittleEndian = false;\n&quot;' />
												</command>
											</flowline>
										</command>
										<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='.iDataType' >
											<case >
												<flowline >
													<command class_type='calculation' title='Int8' >
														<exp exp='.HeaderScript = .HeaderScript + &quot;    const count = Math.floor(value.byteLength);\n&quot;' />
														<exp exp='.HeaderScript = .HeaderScript + &quot;    const dataArray = new Int8Array(count);\n&quot;' />
														<exp exp='.HeaderScript = .HeaderScript + &quot;    for (let i = 0; i &lt; count; i++)\n&quot;' />
														<exp exp='.HeaderScript = .HeaderScript + &quot;    {\n&quot;' />
														<exp exp='.HeaderScript = .HeaderScript + &quot;      dataArray[i] = value.getInt8(i);\n&quot;' />
														<exp exp='.HeaderScript = .HeaderScript + &quot;    }\n&quot;' />
													</command>
												</flowline>
											</case>
											<case exp='2' >
												<flowline >
													<command class_type='calculation' title='Int16' >
														<exp exp='.HeaderScript = .HeaderScript + &quot;    //Each Int16 is 2 bytes\n&quot;' />
														<exp exp='.HeaderScript = .HeaderScript + &quot;    const count = Math.floor(value.byteLength / 2);\n&quot;' />
														<exp exp='.HeaderScript = .HeaderScript + &quot;    const dataArray = new Int16Array(count);\n&quot;' />
														<exp exp='.HeaderScript = .HeaderScript + &quot;    for (let i = 0; i &lt; count; i++)\n&quot;' />
														<exp exp='.HeaderScript = .HeaderScript + &quot;    {\n&quot;' />
														<exp exp='.HeaderScript = .HeaderScript + &quot;      dataArray[i] = value.getInt16(i * 2, bLittleEndian);\n&quot;' />
														<exp exp='.HeaderScript = .HeaderScript + &quot;    }\n&quot;' />
													</command>
												</flowline>
											</case>
											<case exp='3' >
												<flowline >
													<command class_type='calculation' title='Int32' >
														<exp exp='.HeaderScript = .HeaderScript + &quot;    //Each Int32 is 4 bytes\n&quot;' />
														<exp exp='.HeaderScript = .HeaderScript + &quot;    const count = Math.floor(value.byteLength / 4);\n&quot;' />
