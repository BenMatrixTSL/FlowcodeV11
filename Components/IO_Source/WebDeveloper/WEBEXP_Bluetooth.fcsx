						<command class_type='native' title='JavaScript' ccode='if (&quot;bluetooth&quot; in navigator)&#10;{&#10;  if (!window[&apos;FCCHARAC_&apos; + FC_THIS])&#10;  {&#10;    console.log(&quot;Bluetooth device not connected!&quot;);&#10;  }&#10;  else&#10;  {&#10;    try&#10;    {&#10;      await window[&apos;FCM_&apos; + FC_THIS + &apos;_WriteValue&apos;](FCL_IDATA);&#10;    }&#10;    catch (err)&#10;    {&#10;      console.log(&quot;Send error: &quot; + err.message);&#10;    }&#10;  }&#10;}&#10;else&#10;{&#10;  console.log(&quot;Bluetooth not available!&quot;);&#10;}' customize='1' language='C' />
						<command class_type='call' title='User Macro' macro='Prv_NullMacro' await='1' />
