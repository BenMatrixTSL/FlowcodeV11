										<exp exp='.HeaderScript = .HeaderScript + &quot;    //Each Float16 is 2 bytes\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    const buffer = new ArrayBuffer(count * 2);\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    const view = new DataView(buffer);\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    data.forEach((val, index) =&gt; {\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;      view.setFloat16(index * 2, val, bLittleEndian);\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    });\n&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='8' >
								<flowline >
									<command class_type='calculation' title='Float32' >
										<exp exp='.HeaderScript = .HeaderScript + &quot;    //Each Float32 is 4 bytes\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    const buffer = new ArrayBuffer(count * 4);\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    const view = new DataView(buffer);\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    data.forEach((val, index) =&gt; {\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;      view.setFloat32(index * 4, val, bLittleEndian);\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    });\n&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='9' >
								<flowline >
									<command class_type='calculation' title='Float64' >
										<exp exp='.HeaderScript = .HeaderScript + &quot;    //Each Float64 is 8 bytes\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    const buffer = new ArrayBuffer(count * 8);\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    const view = new DataView(buffer);\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    data.forEach((val, index) =&gt; {\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;      view.setFloat64(index * 8, val, bLittleEndian);\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    });\n&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='10' >
								<flowline >
									<command class_type='calculation' title='BigInt64' >
										<exp exp='.HeaderScript = .HeaderScript + &quot;    //Each BigInt64 is 8 bytes\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    const buffer = new ArrayBuffer(count * 8);\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    const view = new DataView(buffer);\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    data.forEach((val, index) =&gt; {\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;      view.setBigInt64(index * 8, val, bLittleEndian);\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    });\n&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='11' >
								<flowline >
									<command class_type='calculation' title='BigUint64' >
										<exp exp='.HeaderScript = .HeaderScript + &quot;    //Each BigUint64 is 8 bytes\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    const buffer = new ArrayBuffer(count * 8);\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    const view = new DataView(buffer);\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    data.forEach((val, index) =&gt; {\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;      view.setBigUint64(index * 8, val, bLittleEndian);\n&quot;' />
										<exp exp='.HeaderScript = .HeaderScript + &quot;    });\n&quot;' />
									</command>
								</flowline>
							</case>
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = .HeaderScript + &quot;    await FCCHARAC_&quot; + .CompID + &quot;.writeValueWithoutResponse(buffer);\n&quot;' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = .HeaderScript + &quot;  }\n&quot;' />
