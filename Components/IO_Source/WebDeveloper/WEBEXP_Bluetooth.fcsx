		<definition guid='cb997a87-2257-4fed-917f-89732d879150' vstate='40' vmin='1' vmaj='1' srcleaf='WEBEXP_Bluetooth.fcsx' visiblename='Bluetooth' description='Allows connection to a bluetooth device from the browser.' category=' Comms' category2='' category3='' bIs2dOnly='1' bIs3dOnly='0' bIsWysiwyg='0' catenable='1' author='MatrixTSL' manuname='' manucode='' sysinfo='1052939' keywords='' dynamic='1' scadaCompatible='1' embeddedCompatible='0' showmacros='1' iconpath='..\..\Icons\Components\Bluetooth.png' />
		<component class_type='root' codename='Bluetooth' panelId='-1' x='0' y='0' z='0' xsz='1' ysz='1' zsz='1' xang='0' yang='0' zang='0' xquat='0' yquat='0' zquat='0' wquat='1' visible='1' scadavisible='1' interactive='1' solid='1' layer='0' poslock='0' ancTop='0' ancBottom='0' ancLeft='0' ancRight='0' ancMinX='0' ancMinY='0' angle2d='0' comp2dType='0' varnames='$(type)_$(module)__$(variable:u)' >
			<resources />
			<properties >
				<property name='Filters' target='sFilters' typeid='11' hidden='0' locked='0' info='Limits the list of available Bluetooth devices, for example:&#13;&#10;&#13;&#10;    filters: [ { services: [0x1802, 0x1803] } ]&#13;&#10;&#13;&#10;    filters: [ { name: &quot;My Cool Device&quot; } ]&#13;&#10;&#13;&#10;    filters: [ { namePrefix: &quot;Mtx&quot; } ]&#13;&#10;&#13;&#10;    filters: [ { services: [&quot;heart_rate&quot;] } ],&#13;&#10;    optionalServices: [&quot;battery_service&quot;]&#13;&#10;&#13;&#10;(leave blank for all devices)&#13;&#10;' />
				<property name='OnDisconnect' target='macOnDisconnect' typeid='24' hidden='0' locked='0' info='Called when the Bluetooth device  is disconnected' filter='NamOnBluetoothDisconnect&#10;DesCalled when the Bluetooth device disconnects' />
				<property name='OnValueChanged' target='macOnValueChanged' typeid='24' hidden='0' locked='0' info='Called when the Bluetooth characteristic value changes' filter='NamOnValueChanged&#10;DesCalled when the Bluetooth characteristic changes&#10;Pardata|HANDLE|The characteristic data value' />
				<property name='Service' target='sService' typeid='10' hidden='0' locked='0' info='The Primary Service of the Bluetooth GATT Server' />
				<property name='Characteristic' target='sCharacteristic' typeid='10' hidden='0' locked='0' info='The Bluetooth GATT Characteristic' />
				<property name='Data' hidden='0' >
					<property name='Type' target='iDataType' typeid='12' hidden='0' locked='0' info='The data type of the characteristic value' filter='000Text&#10;001Int8&#10;002Int16&#10;003Int32&#10;004Uint8&#10;005Uint16&#10;006Uint32&#10;007Float16&#10;008Float32&#10;009Float64&#10;010BigInt64&#10;011BigUint64' />
					<property name='Size' target='bSingleValue' typeid='7' hidden='0' locked='1' info='Whether the characteristic contains a single data value or an array of multiple values' filter='Single Value,Array' />
					<property name='Endianness' target='bLittleEndian' typeid='7' hidden='0' locked='1' info='The byte-order (&quot;endianness&quot;) of the data for numbers stored as 16-, 32- or 64-bit&#13;&#10;(This is usually little-endian for BLE data)' filter='Little-endian,Big-endian' />
				</property>
			</properties>
			<values >
				<value target='sFilters' data='' />
				<value target='macOnDisconnect' data='' />
				<value target='macOnValueChanged' data='' />
				<value target='sService' data='' />
				<value target='sCharacteristic' data='' />
				<value target='iDataType' data='000' />
				<value target='bSingleValue' data='1' />
				<value target='bLittleEndian' data='1' />
			</values>
			<events >
