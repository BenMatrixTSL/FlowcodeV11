				<macro >
					<flowline name='WriteArray' description='Writes an array of integer or float values to GATT Characteristic on a connected BLE device' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='iData' type='s32' description='The array data to send' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' >
							<array size='20' />
						</param>
						<param name='Count' type='s32' description='Number of array values to write' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='native' title='JavaScript' ccode='if (&quot;bluetooth&quot; in navigator)&#10;{&#10;  if (!window[&apos;FCCHARAC_&apos; + FC_THIS])&#10;  {&#10;    console.log(&quot;Bluetooth device not connected!&quot;);&#10;  }&#10;  else&#10;  {&#10;    try&#10;    {&#10;      await window[&apos;FCM_&apos; + FC_THIS + &apos;_WriteArray&apos;](FCL_IDATA, FCL_COUNT);&#10;    }&#10;    catch (err)&#10;    {&#10;      console.log(&quot;Send error: &quot; + err.message);&#10;    }&#10;  }&#10;}&#10;else&#10;{&#10;  console.log(&quot;Bluetooth not available!&quot;);&#10;}' customize='1' language='C' />
						<command class_type='call' title='User Macro' macro='Prv_NullMacro' await='1' />
					</flowline>
				</macro>
