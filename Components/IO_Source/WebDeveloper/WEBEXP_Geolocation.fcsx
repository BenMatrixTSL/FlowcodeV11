			<resources />
			<properties >
				<property name='OnSuccess' target='mOnSuccess' typeid='24' hidden='0' locked='0' info='Called when position info is successfully found.

Latitude, longitude and altitude are provided as parameters. The raw object is also provided for advanced information.' filter='NamOn%cSuccess
DesCalled when position info is successfully found
ParLatitude|FLOAT|The returned latitude in decimal degrees
ParLongitude|FLOAT|The returned longitude in decimal degrees
ParAccuracy|FLOAT|The accuracy of the latitude and longitude (in metres)
ParAltitude|FLOAT|The returned altitude in metres (-99999 if unavailable)
ParRawObject|HANDLE|The raw position object (provides more info for advanced use)' />
				<property name='OnFailure' target='mOnFailure' typeid='24' hidden='0' locked='0' info='Called when position info is not returned successfully' filter='NamOn%cFailure
DesCalled when position info is not returned successfully
ParError|BYTE|The error code returned (1=PERMISSION_DENIED, 2=POSITION_UNAVAILABLE, 3=TIMEOUT)
ParMessage|STRING|The error message' />
				<property name='Options' hidden='0' >
					<property name='MaximumAge' target='iMaxAge' typeid='21' hidden='0' locked='0' info='Maximum age (in ms) of a possible cached position that is acceptable to return.

A value of 0 means the device must always attempt to retrieve to actual current position.' />
					<property name='Timeout' target='iTimeout' typeid='21' hidden='0' locked='0' info='The maximum time (in ms) that the device can take when trying to retrieve a position.' />
					<property name='HighAccuracy' target='bHighAccuracy' typeid='7' hidden='0' locked='0' info='Using High Accuracy will provide a more accurate position, but may be slower and increase power consumption.' />
				</property>
			</properties>
			<values >
				<value target='mOnSuccess' data='' />
				<value target='mOnFailure' data='' />
				<value target='iMaxAge' data='0' />
				<value target='iTimeout' data='100000' />
				<value target='bHighAccuracy' data='0' />
			</values>
			<events >
				<event class='Compile' event='HtmlScriptHeader' target='Ev_HtmlScriptHeader' />
			</events>
			<apis >
				<api name='Cancel' alt='Cancel' type='1' proto='1' />
				<api name='GetPosition' alt='GetPosition' type='1' proto='1' />
			</apis>
			<variables />
			<macros >
				<macro >
					<flowline name='Cancel' description='Cancels any continuous retrieval of location information.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='native' title='JavaScript' ccode='  if (navigator.geolocation) {
    let watch_id = window[&apos;FCGEO_WATCH_&apos; + FC_THIS];
    
    if (watch_id &gt;= 0) {
      navigator.geolocation.clearWatch(watch_id);
    }
    
    window[&apos;FCGEO_WATCH_&apos; + FC_THIS] = -1;
  }' language='C' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_HtmlScriptHeader' description='Sent to a component to retrieve script code to be placed in the html header section' statediag='0' >
						<return name='Return' type='u32' description='Non-zero to block script code insertion' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='CompID' type='T8' description='The unique name of this component' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='HeaderScript' type='T8*' description='Text to amend for the header script' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<local name='sHighAccuracy' type='T8' description='' isconst='0' isHidden='0' isinit='1' usrinit='&quot;&quot;' setinit='&quot;&quot;' >
							<array size='2000' />
						</local>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = &quot;var FCGEO_WATCH_&quot; + .CompID + &quot; = -1;\n&quot;' />
						</command>
						<command class_type='decision' title='Decision' exp='bHighAccuracy' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.sHighAccuracy = &quot;true&quot;' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.sHighAccuracy = &quot;false&quot;' />
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = .HeaderScript + &quot;var FCGEO_OPTIONS_&quot; + .CompID + &quot; = {\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;  enableHighAccuracy: &quot; + .sHighAccuracy + &quot;,\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;  timeout: &quot; + ToString$(iTimeout) + &quot;,\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;  maximumAge: &quot; + ToString$(iMaxAge) + &quot;,\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;};\n\n&quot;' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = .HeaderScript + &quot;function FCGEO_SUCCESS_&quot; + .CompID + &quot;(position) {\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;  const latitude = position.coords.latitude;\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;  const longitude = position.coords.longitude;\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;  const accuracy = position.coords.accuracy;\n\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;  var altitude = -99999;\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;  if (position.coords.altitude) {\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;    altitude = position.coords.altitude;\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;  }\n\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;  FCM_&quot; + mOnSuccess + &quot;(latitude, longitude, accuracy, altitude, position);\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;}\n\n&quot;' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HeaderScript = .HeaderScript + &quot;function FCGEO_FAILURE_&quot; + .CompID + &quot;(error) {\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;  const code = error.code;\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;  const message = error.message;\n\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;  FCM_&quot; + mOnFailure + &quot;(code, message);\n&quot;' />
							<exp exp='.HeaderScript = .HeaderScript + &quot;}\n\n&quot;' />
						</command>
						<command class_type='calculation' title='Set return to zero to ensure text is added to html file' >
							<exp exp='.Return = 0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='GetPosition' description='Asks the device to return position information.

The OnSuccess callback will be called with appropriate location information is successful.
If unsuccessful, the OnFailure callback will provide the reason for failure.

Returns false if geolocation is not supported by the browser.' statediag='0' >
						<return name='Return' type='b1' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Continuous' type='b1' description='Set to true to continually monitor the position and receive a callback whenever the location has changed' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='false' />
						<command class_type='native' title='JavaScript' ccode='  if (!navigator.geolocation) {
    FCR_RETVAL = false;
  } else {
    let success = window[&apos;FCGEO_SUCCESS_&apos; + FC_THIS];
    let failure = window[&apos;FCGEO_FAILURE_&apos; + FC_THIS];
    let options = window[&apos;FCGEO_OPTIONS_&apos; + FC_THIS];
    
    if (FCL_CONTINUOUS) {
      window[&apos;FCGEO_WATCH_&apos; + FC_THIS] = navigator.geolocation.watchPosition(success, failure, options);
    } else {
      navigator.geolocation.getCurrentPosition(success, failure, options);
    }
    FCR_RETVAL = true;
  }' language='C' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='' statediag='0' >
