		<definition guid='45ce3fab-d9df-40fe-8ef5-04d8e6e590e5' vstate='40' vmin='0' vmaj='1' srcleaf='WEBEXP_Geolocation.fcsx' visiblename='Location' description='Component that provides the mobile device&apos;s physical location' category=' Data' category2='' category3='' bIs2dOnly='1' bIs3dOnly='0' bIsWysiwyg='0' catenable='1' author='MatrixTSL' manuname='' manucode='' sysinfo='4363' keywords='' dynamic='1' scadaCompatible='1' embeddedCompatible='0' showmacros='1' iconpath='..\..\Icons\Components\GPS.png' />
