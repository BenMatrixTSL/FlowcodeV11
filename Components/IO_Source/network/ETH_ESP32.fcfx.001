						<property name='IP3' target='ip3' typeid='21' hidden='0' locked='0' info='Fourth octet of the static IP address (e.g. 100 in 192.168.1.100). Ignored when DHCP is enabled.' expansion='ETH_IP3' initialiser='($(value))' />
