						<property name='Subnet0' target='subnet0' typeid='21' hidden='0' locked='0' info='First octet of the subnet mask (e.g. 255 for 255.255.255.0). Ignored when DHCP is enabled.' expansion='ETH_SN0' initialiser='($(value))' />
						<property name='Subnet1' target='subnet1' typeid='21' hidden='0' locked='0' info='Second octet of the subnet mask. Ignored when DHCP is enabled.' expansion='ETH_SN1' initialiser='($(value))' />
						<property name='Subnet2' target='subnet2' typeid='21' hidden='0' locked='0' info='Third octet of the subnet mask. Ignored when DHCP is enabled.' expansion='ETH_SN2' initialiser='($(value))' />
						<property name='Subnet3' target='subnet3' typeid='21' hidden='0' locked='0' info='Fourth octet of the subnet mask (e.g. 0 for 255.255.255.0). Ignored when DHCP is enabled.' expansion='ETH_SN3' initialiser='($(value))' />
