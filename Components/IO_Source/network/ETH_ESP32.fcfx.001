					<flowline name='ReadIP' description='Collects a single byte from the local IP address.
For example 192.168.0.1
Index = 3 : Return = 192 / Index = 0 : Return = 1' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Index' type='u8' description='Range: 0 to 3 Where 3 = the first number and 0 = the last number' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='native' title='C Code' ccode='// e.g. 127.0.0.1 eth_ip_addr = 0x7f000001UL
// Hence if Index 0 wants least significant octet ...
FCR_RETVAL = (MX_UINT8)((eth_ip_addr.addr &gt;&gt; (8* (3-FCL_INDEX)))&amp;0xFF);' cmdcolor='4206456' cmdcolor_sec='10785756' cmdcolor_txt='16777215' cmdgradient='4' cmdopacity='0.64' language='C' />
					</flowline>
