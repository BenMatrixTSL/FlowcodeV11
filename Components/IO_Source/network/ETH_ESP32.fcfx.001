' expansion='ETH_DEBUG' initialiser='($(value))' />
				<property name='PHY Hardware' folder='property_2' hidden='0' >
					<property name='PHY Type' target='PhyType' typeid='16' hidden='0' locked='0' info='Ethernet PHY chip connected to the ESP32 RMII interface.
ESP32-POE / ESP32-POE-ISO / ESP32-GATEWAY use the LAN8710A (LAN87xx driver).
WT32-ETH01 uses the LAN8720A (LAN87xx driver).' filter='000LAN87xx (LAN8710 / LAN8720)
001IP101
002RTL8201
003DP83848
004KSZ80xx' expansion='ETH_PHY_TYPE' initialiser='$(value)' />
					<property name='PHY Address' target='PhyAddr' typeid='14' hidden='0' locked='0' info='SMI address of the PHY chip, normally 0 or 1.
Set to -1 to auto detect.' expansion='ETH_PHY_ADDR' initialiser='($(value))' />
					<property name='PHY Power GPIO' target='PhyPower' typeid='14' hidden='0' locked='0' info='GPIO number used to switch on power to the PHY.
ESP32-POE uses GPIO12. Set to -1 if the PHY is always powered.' expansion='ETH_PHY_POWER' initialiser='($(value))' />
					<property name='PHY Reset GPIO' target='PhyReset' typeid='14' hidden='0' locked='0' info='GPIO number connected to the PHY reset pin.
Set to -1 if not connected (ESP32-POE).' expansion='ETH_PHY_RESET' initialiser='($(value))' />
					<property name='MDC GPIO' target='Mdc' typeid='21' hidden='0' locked='0' info='GPIO number used for the SMI management clock (MDC).
ESP32-POE uses GPIO23.' expansion='ETH_MDC' initialiser='($(value))' />
					<property name='MDIO GPIO' target='Mdio' typeid='21' hidden='0' locked='0' info='GPIO number used for the SMI management data (MDIO).
ESP32-POE uses GPIO18.' expansion='ETH_MDIO' initialiser='($(value))' />
					<property name='RMII Clock' target='ClkMode' typeid='16' hidden='0' locked='0' info='Source of the 50MHz RMII reference clock.
ESP32-POE / ESP32-GATEWAY: Inverted output on GPIO17.
WT32-ETH01: External input on GPIO0.' filter='000External 50MHz input on GPIO0
001Output on GPIO0
002Output on GPIO16
003Inverted output on GPIO17' expansion='ETH_CLK_MODE' initialiser='$(value)' />
				</property>
				<property name='Network Configuration' folder='property_3' hidden='0' >
					<property name='Connect Timeout' target='ConnectTimeout' typeid='21' hidden='0' locked='0' info='Maximum number of seconds Initialise waits for the cable link and, when DHCP is enabled, an IP address before giving up.
Default 20' expansion='ETH_CONNECT_TIMEOUT' initialiser='($(value))' />
					<property name='DHCP' target='DHCP' typeid='7' hidden='0' locked='0' info='Enable DHCP to automatically obtain the IP address, subnet mask, gateway and DNS server from a DHCP server.
When enabled the static IP Address, Subnet Mask and Gateway IP properties are not used.' expansion='ETH_DHCP' initialiser='($(value))' />
					<property name='IP Address' hidden='0' >
						<property name='IP0' target='ip0' typeid='21' hidden='0' locked='0' info='First octet of the static IP address (e.g. 192 in 192.168.1.100). Ignored when DHCP is enabled.' expansion='ETH_IP0' initialiser='($(value))' />
						<property name='IP1' target='ip1' typeid='21' hidden='0' locked='0' info='Second octet of the static IP address. Ignored when DHCP is enabled.' expansion='ETH_IP1' initialiser='($(value))' />
