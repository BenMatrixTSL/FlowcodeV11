				<macro >
					<flowline name='Ev_Resize' description='Sent to the mouse target when the user has altered the position of a component child' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Component' type='h32' description='The component that has been altered' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='PrevPos' type='h32' description='The position of the object before the start of positioning' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Final' type='b1' description='True if this is the end of a drag operation' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='PanelType' type='s16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='RootHandle' type='h32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Handle' type='h32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='LHandle' type='h32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Version' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Built-in Function' macro='Component.GetPanel' >
							<return exp='.PanelType' />
							<argument exp='this' />
						</command>
						<command class_type='decision' title='Decision' exp='.PanelType &lt; 0' swap='0' >
							<flowline />
							<flowline >
								<command class_type='comment' title='' comment='GDI 2d panels' textarea='12,0,12,0' />
								<command class_type='sim' title='Built-in Function' macro='System.GetFCVersion' >
									<return exp='.Version' />
								</command>
								<command class_type='decision' title='Decision' exp='.Version &gt;= 655363' swap='0' >
									<flowline >
										<command class_type='comment' title='' comment='Not needed for this advanced connection type' textarea='12,0,12,0' />
									</flowline>
									<flowline >
										<command class_type='decision' title='Decision' exp='LinkTo' swap='0' >
											<flowline >
												<command class_type='call' title='User Macro' macro='Prv_DrawGdiLink' />
											</flowline>
											<flowline >
												<command class_type='call' title='User Macro' macro='Prv_HideGdiLink' />
											</flowline>
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
