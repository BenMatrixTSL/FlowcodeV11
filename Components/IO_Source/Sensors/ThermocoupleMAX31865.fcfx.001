			</apis>
			<variables >
				<variable public='0' >
					<def class_type='variable' name='RTDData' type='u16' description='Raw RTD ADC code from last sample' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
				</variable>
			</variables>
			<macros >
				<macro >
					<flowline name='ReadTemperature' description='Performs a sample and returns temperature in Degrees C.' statediag='0' >
						<return name='Return' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='Rt' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='R0' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='Z1' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='Z2' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='Z3' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='Z4' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='Temp' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<command class_type='call' title='User Macro' macro='Sample' >
							<return exp='RTDData' />
						</command>
						<command class_type='calculation' title='Convert RTD code to resistance' >
							<exp exp='.Rt = FLOAT RTDData' />
							<exp exp='.Rt = .Rt * RefResistor / 32768.0' />
						</command>
						<command class_type='decision' title='Select R0' exp='RTDType = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='PT100' >
									<exp exp='.R0 = 100.0' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='PT1000 or other' >
									<exp exp='.R0 = 1000.0' />
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Set Z constants' >
							<exp exp='.Z1 = -0.0039083' />
							<exp exp='.Z2 = (0.0039083 * 0.0039083) - (4.0 * -0.0000005775)' />
							<exp exp='.Z3 = 4.0 * -0.0000005775 / .R0' />
							<exp exp='.Z4 = 2.0 * -0.0000005775' />
						</command>
						<command class_type='calculation' title='Solve quadratic for temperature' >
							<exp exp='.Temp = .Z2 + (.Z3 * .Rt)' />
							<exp exp='.Temp = .Z1 + sqrt(.Temp)' />
							<exp exp='.Temp = .Temp / .Z4' />
							<exp exp='.Return = .Temp' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='EnableBias' description='Enables or disables the MAX31865 bias current.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Enable' type='u8' description='0 = Off, 1 = On' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Config' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Read config' macro='ReadRegister' >
							<return exp='.Config' />
							<argument exp='0x00' />
						</command>
						<command class_type='decision' title='Decision' exp='.Enable' swap='0' >
							<flowline >
								<command class_type='calculation' title='Turn bias on' >
									<exp exp='.Config = .Config | 0x80' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Turn bias off' >
									<exp exp='.Config = .Config &amp; 0x7F' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Write config' macro='WriteRegister' >
							<argument exp='0x00' />
							<argument exp='.Config' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetThresholds' description='Writes the upper and lower thresholds for faults.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Lower' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Upper' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='MAX31865_LFAULTLSB_REG' macro='WriteRegister' >
							<argument exp='0x06' />
							<argument exp='.Lower &amp; 0xFF' />
						</command>
						<command class_type='call' title='MAX31865_LFAULTMSB_REG ' macro='WriteRegister' >
							<argument exp='0x05' />
							<argument exp='(.Lower &gt;&gt; 8)' />
						</command>
						<command class_type='call' title='MAX31865_HFAULTLSB_REG ' macro='WriteRegister' >
							<argument exp='0x04' />
							<argument exp='.Upper &amp; 0xFF' />
						</command>
						<command class_type='call' title='MAX31865_HFAULTMSB_REG ' macro='WriteRegister' >
							<argument exp='0x03' />
							<argument exp='(.Upper &gt;&gt; 8)' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetWires' description='Sets the RTD wiring mode (2/3/4-wire).' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Wires' type='u8' description='2, 3 or 4 wires' isconst='0' isHidden='0' isinit='0' usrinit='2' setinit='' />
						<local name='Config' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Read config' macro='ReadRegister' >
							<return exp='.Config' />
							<argument exp='0x00' />
						</command>
						<command class_type='decision' title='Decision' exp='.Wires = 3' swap='0' >
							<flowline >
								<command class_type='calculation' title='3-wire mode' >
									<exp exp='.Config = .Config | 0x10' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='2/4-wire mode' >
									<exp exp='.Config = .Config &amp; 0xEF' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Write config' macro='WriteRegister' >
							<argument exp='0x00' />
							<argument exp='.Config' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Initialise' description='Initialisation routine for the component once the component is linked to its parent' statediag='0' >
						<return name='Return' type='u32' description='Non-zero to prevent initialisation' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
					</flowline>
				</macro>
				<macro >
					<flowline name='ClearFault' description='Clears any latched fault flags in the MAX31865.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<local name='Config' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Read config' macro='ReadRegister' >
							<return exp='.Config' />
							<argument exp='0x00' />
						</command>
						<command class_type='calculation' title='Set fault clear bit' >
							<exp exp='.Config = .Config | 0x02' />
						</command>
						<command class_type='call' title='Write config' macro='WriteRegister' >
							<argument exp='0x00' />
							<argument exp='.Config' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadFault' description='Reads the MAX31865 fault status register.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Read fault register' macro='ReadRegister' >
							<return exp='.Return' />
							<argument exp='0x07' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadTemperatureFarenheit' description='Performs a sample and returns temperature in farenheit.' statediag='0' >
						<return name='Return' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='Temp' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<command class_type='call' title='User Macro' macro='ReadTemperatureFarenheit' >
							<return exp='.Temp' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = (.Temp * 1.8) + 32.0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Sample' description='Performs a single MAX31865 conversion and returns the raw sensor reading.' statediag='0' >
						<return name='Return' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Config' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='MSB' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='LSB' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Read config' macro='ReadRegister' >
							<return exp='.Config' />
							<argument exp='0x00' />
						</command>
						<command class_type='calculation' title='Enable bias' >
							<exp exp='.Config = .Config | 0x80' />
						</command>
						<command class_type='call' title='Write config' macro='WriteRegister' >
							<argument exp='0x00' />
							<argument exp='.Config' />
						</command>
						<command class_type='delay' title='Bias settle' exp='10' type='1' />
						<command class_type='calculation' title='Start one-shot conversion' >
							<exp exp='.Config = .Config | 0x40' />
						</command>
						<command class_type='call' title='Write config' macro='WriteRegister' >
							<argument exp='0x00' />
							<argument exp='.Config' />
						</command>
						<command class_type='delay' title='Conversion time' exp='65' type='1' />
						<command class_type='call' title='Read RTD MSB' macro='ReadRegister' >
							<return exp='.MSB' />
							<argument exp='0x01' />
						</command>
						<command class_type='call' title='Read RTD LSB' macro='ReadRegister' >
							<return exp='.LSB' />
							<argument exp='0x02' />
						</command>
						<command class_type='calculation' title='Combine and shift away fault bit' >
							<exp exp='.Return = (.MSB &lt;&lt; 8) | .LSB' />
							<exp exp='.Return = .Return &gt;&gt; 1' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetNotchFilter' description='Sets the notch filter to 50Hz (1) or 60Hz (0).' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Mode' type='u8' description='0 = 50Hz, 1 = 60Hz' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Config' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Read config' macro='ReadRegister' >
							<return exp='.Config' />
							<argument exp='0x00' />
						</command>
						<command class_type='decision' title='Decision' exp='.Mode' swap='0' >
							<flowline >
								<command class_type='calculation' title='60Hz filter' >
									<exp exp='.Config = .Config &amp; 0xFE' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='50Hz filter' >
									<exp exp='.Config = .Config | 0x01' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Write config' macro='WriteRegister' >
							<argument exp='0x00' />
							<argument exp='.Config' />
						</command>
					</flowline>
