					<flowline name='Initialise' description='Initialises the SPI bus and basic MAX31865 configuration.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='call' title='Call Component Macro' component='cal_spi1' macro='Master_Init' />
