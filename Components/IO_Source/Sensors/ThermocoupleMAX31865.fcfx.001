						<param name='Address' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Data' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Set write bit' >
							<exp exp='.Address = .Address | 0x80' />
						</command>
						<command class_type='call' title='Enable CS' component='cal_spi1' macro='Master_Enable_CS' />
						<command class_type='call' title='Send address' component='cal_spi1' macro='Master_Byte' >
