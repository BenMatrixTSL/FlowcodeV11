					</flowline>
				</macro>
				<macro >
					<flowline name='AutoConvert' description='Enables or disables automatic continuous conversion.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Enable' type='u8' description='0 = One-shot, 1 = Continuous' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Config' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Read config' macro='ReadRegister' >
							<return exp='.Config' />
							<argument exp='0x00' />
						</command>
						<command class_type='decision' title='Decision' exp='.Enable' swap='0' >
							<flowline >
								<command class_type='calculation' title='Enable auto convert' >
									<exp exp='.Config = .Config | 0x40' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Disable auto convert' >
									<exp exp='.Config = .Config &amp; 0xBF' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Write config' macro='WriteRegister' >
							<argument exp='0x00' />
							<argument exp='.Config' />
						</command>
					</flowline>
				</macro>
			</macros>
