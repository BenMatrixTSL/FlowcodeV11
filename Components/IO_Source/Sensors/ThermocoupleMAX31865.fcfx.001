				<api name='EnableBias' alt='EnableBias' type='1' proto='1' />
				<api name='SetWires' alt='SetWires' type='1' proto='1' />
				<api name='ClearFault' alt='ClearFault' type='1' proto='1' />
				<api name='ReadFault' alt='ReadFault' type='1' proto='1' />
