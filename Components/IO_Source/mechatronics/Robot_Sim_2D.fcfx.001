			<variables >
				<variable public='0' >
					<def class_type='variable' name='SpeedLeft' type='f32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0.0' setinit='0' />
				</variable>
				<variable public='0' >
					<def class_type='variable' name='Position' type='f32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0.0' setinit='{0}' >
						<array size='4' />
					</def>
				</variable>
				<variable public='0' >
					<def class_type='variable' name='DegToRad' type='f32' description='' isconst='1' isHidden='0' isinit='1' usrinit='0.01745329983532428741455078125' setinit='0.0174533' />
				</variable>
				<variable public='0' >
					<def class_type='variable' name='AngleVector' type='f32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0.0' setinit='0' />
				</variable>
				<variable public='0' >
					<def class_type='variable' name='InitialPosition' type='h32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
				</variable>
				<variable public='0' >
					<def class_type='variable' name='SpeedRight' type='f32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0.0' setinit='0' />
				</variable>
			</variables>
			<macros >
				<macro >
					<flowline name='Ev_Timer' description='Called back on the panel command System.TimerStart' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='TimerID' type='u32' description='The identifier passed to the System.TimerStart panel command' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Velocity' type='f32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0.0' setinit='0' />
						<command class_type='calculation' title='Take averagespeed to calculate velocity' >
							<exp exp='.Velocity = ((SpeedLeft + SpeedRight) / 2.0)' />
						</command>
						<command class_type='calculation' title='Work out rotation' >
							<exp exp='AngleVector = AngleVector + ((SpeedRight - SpeedLeft) / TimerFreq)' />
						</command>
						<command class_type='calculation' title='Work out movement' >
							<exp exp='Position[0] = Position[0] - ((sin(AngleVector * DegToRad) * .Velocity) / TimerFreq)' />
							<exp exp='Position[1] = Position[1] - ((cos(AngleVector * DegToRad) * .Velocity) / TimerFreq)' />
						</command>
						<command class_type='sim' title='Apply position' macro='Panel.Position.SetActual2dPosition' >
							<argument exp='RobotGroup' />
							<argument exp='Position[0]' />
							<argument exp='Position[1]' />
							<argument exp='Position[2]' />
							<argument exp='Position[3]' />
							<argument exp='0' />
						</command>
						<command class_type='sim' title='Apply rotation' macro='Panel.Position.RotateTo' >
							<argument exp='RobotGroup' />
							<argument exp='RobotGroup' />
							<argument exp='RobotGroup' />
							<argument exp='0' />
							<argument exp='0' />
							<argument exp='AngleVector' />
						</command>
						<command class_type='sim' title='Built-in Function' macro='System.TimerStart' >
							<argument exp='0' />
							<argument exp='TimerMs' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Stop' description='Broadcast to all components that simulation has stopped' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Stop movement' macro='System.TimerStop' >
							<argument exp='0' />
						</command>
						<command class_type='sim' title='Restore initial position' macro='Panel.Position.Set' >
							<argument exp='RobotGroup' />
							<argument exp='InitialPosition' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Pause' description='Broadcast to all components that simulation has paused' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Stop movement while paused' macro='System.TimerStop' >
							<argument exp='0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Property' description='Sent when a property has been changed by the User' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Calc' type='f32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0.0' setinit='0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Calc = 1.0 / TimerFreq' />
							<exp exp='.Calc = .Calc * 1000.0' />
						</command>
						<command class_type='sim' title='Built-in Function' macro='Component.Property.SetValue' >
							<argument exp='this' />
							<argument exp='&quot;TimerMs&quot;' />
							<argument exp='.Calc' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='RangeAtVector' description='Checks the collision range at the specified angle.' statediag='0' >
						<return name='Return' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<param name='Angle' type='f32' description='0-360 - 0 = facing directly ahead, 1=1 degree clockwise' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='X' type='f32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0.0' setinit='0' />
						<local name='Y' type='f32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0.0' setinit='0' />
						<local name='Vector' type='f32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0.0' setinit='{0}' >
							<array size='2' />
						</local>
						<local name='Origin' type='f32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0.0' setinit='{0}' >
							<array size='2' />
						</local>
						<command class_type='calculation' title='Convert Angle To Radians' >
							<exp exp='.Angle = AngleVector - .Angle' />
							<exp exp='.Angle = .Angle * DegToRad' />
						</command>
						<command class_type='calculation' title='Work out X,Y Components' >
							<exp exp='.X = -Sin(.Angle)' />
							<exp exp='.Y = -Cos(.Angle)' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Origin[0] = (Position[0] + (Position[2] / 2.0)) + (.X * 50.0)' />
							<exp exp='.Origin[1] = (Position[1] + (Position[3] / 2.0)) + (.Y * 50.0)' />
							<exp exp='.Vector[0] = .X' />
							<exp exp='.Vector[1] = .Y' />
						</command>
						<command class_type='sim' title='Show extend of XY search' disable='1' macro='Panel.Position.SetActual2dPosition' >
							<argument exp='Shape6' />
							<argument exp='Position[0] + (Position[2] / 2.0) + (.X * 40.0)' />
							<argument exp='Position[1] + (Position[3] / 2.0) + (.Y * 40.0)' />
							<argument exp='0.00001' />
							<argument exp='0.00001' />
							<argument exp='1' />
						</command>
						<command class_type='sim' title='Built-in Function' macro='Panel.Get2dCompFromVector2' >
							<argument exp='RobotGroup' />
							<argument exp='.Origin' />
							<argument exp='.Vector' />
							<argument exp='0' />
							<argument exp='200.0' />
							<argument exp='.Return' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='CreateLineSim' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<local name='idx' type='u16' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Handle' type='h32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='loop' title='Loop' type='2' forvar='.idx' exp='4' for1='' for3='' >
							<flowline >
								<command class_type='sim' title='Create primitive' macro='Panel.AddNewComponent' >
									<argument exp='&quot;component:GdiShape&quot;' />
									<argument exp='&quot;simshape&quot; + ToString$(.idx)' />
									<argument exp='0' />
								</command>
								<command class_type='sim' title='Get primitive handle' macro='Component.FindChild' >
									<return exp='.Handle' />
									<argument exp='this' />
									<argument exp='&quot;simshape&quot; + ToString$(.idx)' />
								</command>
								<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='.idx' >
									<case >
										<flowline >
											<command class_type='sim' title='Scale Item' macro='Panel.Position.SetActual2dPosition' >
												<argument exp='.Handle' />
												<argument exp='150' />
												<argument exp='150' />
												<argument exp='10' />
												<argument exp='200' />
												<argument exp='1' />
											</command>
										</flowline>
									</case>
									<case exp='1' >
										<flowline >
											<command class_type='sim' title='Scale Item' macro='Panel.Position.SetActual2dPosition' >
												<argument exp='.Handle' />
												<argument exp='150' />
												<argument exp='150' />
												<argument exp='200' />
												<argument exp='10' />
												<argument exp='0' />
											</command>
										</flowline>
									</case>
									<case exp='2' >
										<flowline />
									</case>
									<case exp='3' >
										<flowline />
									</case>
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_PropertyEx' description='Sent when a property has been changed by the User (specific property and value identified)' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Property' type='T8' description='The name of the property being changed' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='Value' type='T8' description='The new value for the property (for list properties, this is the 3-digit index)' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<local name='idx' type='u16' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='decision' title='Decision' exp='.Property = &quot;SimType&quot;' swap='0' >
							<flowline >
								<command class_type='call' title='User Macro' macro='DeleteAllSimItems' />
								<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='SimType' >
									<case >
										<flowline />
									</case>
									<case exp='1' >
										<flowline >
											<command class_type='call' title='User Macro' macro='CreateLineSim' />
										</flowline>
									</case>
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetSpeeds' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Left' type='f32' description='Speed scale value' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<param name='Right' type='f32' description='Speed scale value' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='SpeedLeft = .Left' />
							<exp exp='SpeedRight = .Right' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Start' description='Broadcast to all components that simulation is starting' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Save initial robot position' macro='Panel.Position.Get' >
							<return exp='InitialPosition' />
							<argument exp='RobotGroup' />
						</command>
						<command class_type='sim' title='Populate position working variables' macro='Panel.Position.GetActual2dPosition' >
							<return exp='Position' />
							<argument exp='RobotGroup' />
						</command>
						<command class_type='sim' title='Start movement timer' macro='System.TimerStart' >
							<argument exp='0' />
							<argument exp='TimerMs' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<local name='Range' type='f32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0.0' setinit='0' />
						<command class_type='call' title='Component Macro' macro='SetSpeeds' >
							<argument exp='-10' />
							<argument exp='10' />
						</command>
						<command class_type='loop' title='Loop' type='3' exp='1' for1='' for3='' >
							<flowline >
								<command class_type='call' title='User Macro' macro='RangeAtVector' >
									<return exp='.Range' />
									<argument exp='0' />
								</command>
								<command class_type='delay' title='Delay' exp='100' type='1' />
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Resume' description='Broadcast to all components that simulation has resumed' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Resume movement' macro='System.TimerStart' >
							<argument exp='0' />
							<argument exp='TimerMs' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='DeleteAllSimItems' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<local name='Handle' type='h32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Name' type='T8' description='' isconst='0' isHidden='0' isinit='1' usrinit='&quot;&quot;' setinit='&quot;&quot;' >
							<array size='20' />
						</local>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Handle = this' />
						</command>
						<command class_type='sim' title='Built-in Function' macro='Tree.Traverse' >
							<argument exp='.Handle' />
							<argument exp='this' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.Handle' for1='' for3='' >
							<flowline >
								<command class_type='sim' title='Built-in Function' macro='Tree.GetName' >
									<return exp='.Name' />
									<argument exp='.Handle' />
								</command>
								<command class_type='decision' title='Decision' exp='Contains$(.Name,&quot;simshape&quot;,0) = 0' swap='0' >
									<flowline >
										<command class_type='sim' title='Built-in Function' disable='1' macro='Debug.PrintLn' >
											<argument exp='.Name + &quot; Deleting&quot;' />
										</command>
										<command class_type='sim' title='Built-in Function' macro='Component.Delete' >
											<argument exp='.Handle' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Handle = this' />
										</command>
									</flowline>
									<flowline >
										<command class_type='sim' title='Built-in Function' disable='1' macro='Debug.PrintLn' >
											<argument exp='.Name' />
										</command>
									</flowline>
								</command>
								<command class_type='sim' title='Built-in Function' macro='Tree.Traverse' >
									<argument exp='.Handle' />
									<argument exp='this' />
								</command>
							</flowline>
						</command>
					</flowline>
