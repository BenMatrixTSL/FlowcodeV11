						<local name='rx' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='call' title='Call Component Macro' component='cal_uart' macro='Receive' >
							<return exp='.rx' />
							<argument exp='0' />
						</command>
