				</macro>
				<macro >
					<flowline name='Prv_CalculateChecksum' description='Calculate checksum for STS protocol packet. Checksum is NOT of sum of ID, Length, Instruction, and Parameters.' statediag='0' >
						<return name='Return' type='u8' description='Calculated checksum value' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='PacketID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Length' type='u8' description='Packet length' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Instruction' type='u8' description='Instruction byte' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ParamCount' type='u8' description='Number of parameter bytes' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Sum' type='u16' description='Sum of bytes for checksum calculation' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Idx' type='u8' description='Loop index' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='calculation' title='Start with ID, Length, and Instruction' >
							<exp exp='.Sum = .PacketID + .Length + .Instruction' />
						</command>
						<command class_type='loop' title='Add all parameter bytes' type='0' exp='.Idx &lt; .ParamCount' >
							<flowline >
								<command class_type='calculation' title='Add parameter byte to sum' >
									<exp exp='.Sum = .Sum + PacketBuffer[.Idx]' />
									<exp exp='.Idx = .Idx + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Checksum is NOT of the sum' >
							<exp exp='.Return = ~.Sum' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Initialise' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='call' title='Component Macro' component='cal_uart' macro='Init' />
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadAcceleration' description='Read current acceleration value in steps per second squared.' statediag='0' >
						<return name='Return' type='u8' description='Acceleration value (0-254), or 0 if error' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_ACCEL' />
							<exp exp='PacketBuffer[1] = 1' />
						</command>
						<command class_type='call' title='Send read packet' macro='Prv_SendPacket' >
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_READ' />
							<argument exp='2' />
						</command>
						<command class_type='call' title='Receive response' macro='Prv_ReceiveResponse' >
							<argument exp='100' />
						</command>
						<command class_type='decision' title='Check if response received' exp='ResponseLength &gt;= 1' swap='0' >
							<flowline >
								<command class_type='calculation' title='Get acceleration value' >
									<exp exp='.Return = ResponseBuffer[2]' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
			</macros>
