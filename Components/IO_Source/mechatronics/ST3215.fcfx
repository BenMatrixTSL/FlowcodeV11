			<macros >
				<macro >
					<flowline name='ReadTemperature' description='Read temperature in degrees Celsius.' statediag='0' >
						<return name='Return' type='u8' description='Temperature in Celsius, or 0 if error' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_TEMP' />
							<exp exp='PacketBuffer[1] = 1' />
						</command>
						<command class_type='call' title='Send read packet' macro='Prv_SendPacket' >
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_READ' />
							<argument exp='2' />
						</command>
						<command class_type='call' title='Receive response' macro='Prv_ReceiveResponse' >
							<argument exp='100' />
						</command>
						<command class_type='decision' title='Check if response received' exp='ResponseLength &gt;= 1' swap='0' >
							<flowline >
								<command class_type='calculation' title='Get temperature value' >
									<exp exp='.Return = ResponseBuffer[2]' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetTorqueLimit' description='Set torque limit value (0-1000). Controls maximum torque output.' statediag='0' >
						<return name='Return' type='b1' description='True if successful' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='TorqueLimit' type='u16' description='Torque limit value (0-1000)' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address and torque limit bytes' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_TORQUE_LIMIT' />
							<exp exp='PacketBuffer[1] = .TorqueLimit' />
							<exp exp='PacketBuffer[2] = .TorqueLimit &gt;&gt; 8' />
						</command>
						<command class_type='call' title='Send write packet' macro='Prv_SendPacket' >
							<return exp='.Return' />
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_WRITE' />
							<argument exp='3' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadStatus' description='Read servo status flags. Returns status byte with bits: Voltage, Sensor, Temperature, Current, Angle, Overload' statediag='0' >
						<return name='Return' type='u8' description='Status byte, or 0 if error' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_STATUS' />
							<exp exp='PacketBuffer[1] = 1' />
						</command>
						<command class_type='call' title='Send read packet' macro='Prv_SendPacket' >
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_READ' />
							<argument exp='2' />
						</command>
						<command class_type='call' title='Receive response' macro='Prv_ReceiveResponse' >
							<argument exp='100' />
						</command>
						<command class_type='decision' title='Check if response received' exp='ResponseLength &gt;= 1' swap='0' >
							<flowline >
								<command class_type='calculation' title='Get status value' >
									<exp exp='.Return = ResponseBuffer[2]' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_AddInterrupts' description='Sent to a component to allow dynamic amendment of the interrupts for a component' statediag='0' >
						<return name='Return' type='u32' description='Non-zero to block code insertion' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='HandlerCode' type='T8*' description='Text to amend for all component interrupts' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<local name='ISR_Macro' type='T8' description='' isconst='0' isHidden='0' isinit='1' usrinit='&quot;&quot;' setinit='&quot;&quot;' >
							<array size='20' />
						</local>
						<local name='UART_Str' type='T8' description='' isconst='0' isHidden='0' isinit='1' usrinit='&quot;&quot;' setinit='&quot;&quot;' >
							<array size='20' />
						</local>
						<command class_type='sim' title='Simulation' macro='Expand.MacroBody' >
							<return exp='.ISR_Macro' />
							<argument exp='&quot;Uart_isr&quot;' />
							<argument exp='this' />
							<argument exp='0' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.UART_Str = &quot;MX_UART_INT_CH&quot; + STRING UARTidx + &quot;_FUNC\n\n&quot;' />
							<exp exp='.UART_Str = .UART_Str + &quot;MX_UINT8 FCL_RX;\n\n&quot;' />
							<exp exp='.UART_Str = .UART_Str + &quot;if (MX_UART_INT_CH&quot; + STRING UARTidx + &quot;_DET)\n{\n\n&quot;' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.ISR_Macro = .UART_Str + .ISR_Macro' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.ISR_Macro = .ISR_Macro + &quot;MX_UART_INT_CH&quot; + STRING UARTidx + &quot;_CLR;&quot;' />
							<exp exp='.ISR_Macro = .ISR_Macro + &quot;\n\n}\n\nMX_UART_INT_FUNC_END\n&quot;' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.HandlerCode = .HandlerCode + &quot;\n\n&quot; + .ISR_Macro' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetAcceleration' description='Set servo acceleration in steps per second squared.' statediag='0' >
						<return name='Return' type='b1' description='True if successful' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Acceleration' type='u8' description='Acceleration value (0-254)' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address and acceleration byte' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_ACCEL' />
							<exp exp='PacketBuffer[1] = .Acceleration' />
						</command>
						<command class_type='call' title='Send write packet' macro='Prv_SendPacket' >
							<return exp='.Return' />
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_WRITE' />
							<argument exp='2' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ChangeID' description='Change the servo ID. New ID must be 0-253. EEPROM must be unlocked.' statediag='0' >
						<return name='Return' type='b1' description='True if successful' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Current servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='NewID' type='u8' description='New servo ID (0-253)' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address and new ID value' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_ID' />
							<exp exp='PacketBuffer[1] = .NewID' />
						</command>
						<command class_type='call' title='Send write packet' macro='Prv_SendPacket' >
							<return exp='.Return' />
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_WRITE' />
							<argument exp='2' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Initialise' description='Initialisation routine for the component once the component is linked to its parent' statediag='0' >
						<return name='Return' type='u32' description='Non-zero to prevent initialisation' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='0' />
					</flowline>
				</macro>
				<macro >
					<flowline name='StartServo' description='Enable torque (start servo).' statediag='0' >
						<return name='Return' type='b1' description='True if successful' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address and value (1 = enable)' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_TORQUE_ENABLE' />
							<exp exp='PacketBuffer[1] = 1' />
						</command>
						<command class_type='call' title='Send write packet' macro='Prv_SendPacket' >
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_WRITE' />
							<argument exp='2' />
						</command>
						<command class_type='call' title='Receive and verify response' macro='Prv_ReceiveResponse' >
							<return exp='.Return' />
							<argument exp='100' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ListServos' description='Scan and return a list of all responsive servos. 
Returns number of servos found.' statediag='0' >
						<return name='Return' type='u8' description='Number of servos found' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoList' type='u8' description='Array to store found servo IDs' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='MaxCount' type='u8' description='Max number of servos to try and return. 0=Don&apos;t limit' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='ServoID' type='u8' description='Current servo ID being tested' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Found' type='b1' description='Whether current servo responded' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='calculation' title='Initialize count' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='loop' title='Scan all possible servo IDs' type='0' exp='.ServoID &lt; 254' >
							<flowline >
								<command class_type='call' title='Ping servo' macro='PingServo' >
									<return exp='.Found' />
									<argument exp='.ServoID' />
								</command>
								<command class_type='decision' title='If servo responded' exp='.Found' swap='0' >
									<flowline >
										<command class_type='calculation' title='Add to list' >
											<exp exp='.ServoList[.Return] = .ServoID' />
											<exp exp='.Return = .Return + 1' />
										</command>
										<command class_type='decision' title='Decision' exp='.Return = .MaxCount' swap='0' >
											<flowline >
												<command class_type='calculation' title='End Loop' >
													<exp exp='.ServoID = 253' />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Next servo ID' >
									<exp exp='.ServoID = .ServoID + 1' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadPosition' description='Read current position of servo. Returns position in steps.' statediag='0' >
						<return name='Return' type='s16' description='Position in steps, or -1 if error' isconst='0' isHidden='0' isinit='0' usrinit='-1' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_CURRENT_POS' />
							<exp exp='PacketBuffer[1] = 2' />
						</command>
						<command class_type='call' title='Send read packet' macro='Prv_SendPacket' >
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_READ' />
							<argument exp='2' />
						</command>
						<command class_type='call' title='Receive response' macro='Prv_ReceiveResponse' >
							<argument exp='100' />
						</command>
						<command class_type='decision' title='Check if response received' exp='ResponseLength &gt;= 2' swap='0' >
							<flowline >
								<command class_type='calculation' title='Combine bytes to form position' >
									<exp exp='.Return = ResponseBuffer[2] + (ResponseBuffer[3] &lt;&lt; 8)' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='IsMoving' description='Check if the servo is currently moving. Returns True if moving, False otherwise.' statediag='0' >
						<return name='Return' type='b1' description='True if moving' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_MOVING' />
							<exp exp='PacketBuffer[1] = 1' />
						</command>
						<command class_type='call' title='Send read packet' macro='Prv_SendPacket' >
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_READ' />
							<argument exp='2' />
						</command>
						<command class_type='call' title='Receive response' macro='Prv_ReceiveResponse' >
							<argument exp='100' />
						</command>
						<command class_type='decision' title='Check if response received and moving' exp='(ResponseLength &gt;= 1) &amp;&amp; (ResponseBuffer[2] = 1)' swap='0' >
							<flowline >
								<command class_type='calculation' title='Set return to true' >
									<exp exp='.Return = 1' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Set return to false' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadTorqueLimit' description='Read torque limit value (0-1000).' statediag='0' >
						<return name='Return' type='u16' description='Torque limit value, or 0 if error' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_TORQUE_LIMIT' />
							<exp exp='PacketBuffer[1] = 2' />
						</command>
						<command class_type='call' title='Send read packet' macro='Prv_SendPacket' >
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_READ' />
							<argument exp='2' />
						</command>
						<command class_type='call' title='Receive response' macro='Prv_ReceiveResponse' >
							<argument exp='100' />
						</command>
						<command class_type='decision' title='Check if response received' exp='ResponseLength &gt;= 2' swap='0' >
							<flowline >
								<command class_type='calculation' title='Combine bytes to form torque limit' >
									<exp exp='.Return = ResponseBuffer[2] + (ResponseBuffer[3] &lt;&lt; 8)' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='StopServo' description='Disable torque (stop servo).' statediag='0' >
						<return name='Return' type='b1' description='True if successful' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address and value (0 = disable)' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_TORQUE_ENABLE' />
							<exp exp='PacketBuffer[1] = 0' />
						</command>
						<command class_type='call' title='Send write packet' macro='Prv_SendPacket' >
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_WRITE' />
							<argument exp='2' />
						</command>
						<command class_type='call' title='Receive and verify response' macro='Prv_ReceiveResponse' >
							<return exp='.Return' />
							<argument exp='100' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadVoltage' description='Read voltage in volts (0.1V resolution). Returns voltage * 10.' statediag='0' >
						<return name='Return' type='u8' description='Voltage * 10, or 0 if error' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_VOLTAGE' />
							<exp exp='PacketBuffer[1] = 1' />
						</command>
						<command class_type='call' title='Send read packet' macro='Prv_SendPacket' >
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_READ' />
							<argument exp='2' />
						</command>
						<command class_type='call' title='Receive response' macro='Prv_ReceiveResponse' >
							<argument exp='100' />
						</command>
						<command class_type='decision' title='Check if response received' exp='ResponseLength &gt;= 1' swap='0' >
							<flowline >
								<command class_type='calculation' title='Get voltage value' >
									<exp exp='.Return = ResponseBuffer[2]' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Rotate' description='Rotate servo continuously in specified direction. Speed range: 50-1000. Direction: 0=forward, 1=reverse.' statediag='0' >
						<return name='Return' type='b1' description='True if successful' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Speed' type='u16' description='Rotation speed (50-1000)' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Direction' type='u8' description='Direction: 0=forward, 1=reverse' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='SpeedWithDirection' type='u16' description='Speed value with direction bit' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='ModeResult' type='b1' description='Result of setting mode' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='calculation' title='Set mode to constant speed mode first' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_MODE' />
							<exp exp='PacketBuffer[1] = ST3215_MODE_SPEED' />
						</command>
						<command class_type='call' title='Send write packet to mode register' macro='Prv_SendPacket' >
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_WRITE' />
							<argument exp='2' />
						</command>
						<command class_type='call' title='Receive response for mode set' macro='Prv_ReceiveResponse' >
							<return exp='.ModeResult' />
							<argument exp='100' />
						</command>
						<command class_type='calculation' title='Set speed with direction bit (BIT10 = direction)' >
							<exp exp='.SpeedWithDirection = .Speed' />
							<exp exp='.SpeedWithDirection = .SpeedWithDirection + (.Direction &lt;&lt; 10)' />
						</command>
						<command class_type='calculation' title='Store register address and speed bytes with direction' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_SPEED' />
							<exp exp='PacketBuffer[1] = .SpeedWithDirection' />
							<exp exp='PacketBuffer[2] = .SpeedWithDirection &gt;&gt; 8' />
						</command>
						<command class_type='call' title='Send write packet to speed register' macro='Prv_SendPacket' >
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_WRITE' />
							<argument exp='3' />
						</command>
						<command class_type='call' title='Receive and verify response' macro='Prv_ReceiveResponse' >
							<return exp='.Return' />
							<argument exp='100' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Property' description='Sent when a property has been changed by the User' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='0' />
						<local name='TempStr' type='T8' description='' isconst='0' isHidden='0' isinit='1' usrinit='&quot;&quot;' setinit='&quot;&quot;' >
							<array size='20' />
						</local>
						<command class_type='sim' title='Built-in Function' macro='Component.Property.GetValue' >
							<return exp='.TempStr' />
							<argument exp='cal_uart' />
							<argument exp='&quot;CHANNEL&quot;' />
						</command>
						<command class_type='sim' title='Built-in Function' macro='Component.Property.SetValue' >
							<argument exp='this' />
							<argument exp='&quot;UARTidx&quot;' />
							<argument exp='.TempStr' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Prv_ReceiveResponse' description='Receive response packet from servo' statediag='0' >
						<return name='Return' type='b1' description='True if valid response received' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Timeout' type='u16' description='Timeout in milliseconds' isconst='0' isHidden='0' isinit='0' usrinit='100' setinit='' />
						<local name='Header1' type='u8' description='First header byte' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Header2' type='u8' description='Second header byte' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Idx' type='u8' description='Loop index' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='TimeoutCount' type='u16' description='Timeout counter' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='calculation' title='Initialize response length' >
							<exp exp='ResponseLength = 0' />
							<exp exp='.Return = 0' />
						</command>
						<command class_type='loop' title='Wait for header byte 1' type='0' exp='(.Header1 != ST3215_HEADER1) &amp;&amp; (.TimeoutCount &lt; .Timeout)' >
							<flowline >
								<command class_type='decision' title='Decision' exp='CircularBuffer1::GetNumberBytes()' swap='0' >
									<flowline >
										<command class_type='call' title='Check for received byte' component='CircularBuffer1' macro='GetByte' >
											<return exp='.Header1' />
										</command>
									</flowline>
									<flowline >
										<command class_type='delay' title='Delay' exp='1' type='1' />
										<command class_type='calculation' title='Increment timeout' >
											<exp exp='.TimeoutCount = .TimeoutCount + 1' />
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Check if header 1 received' exp='.Header1 = ST3215_HEADER1' swap='0' >
							<flowline >
								<command class_type='loop' title='Wait for header byte 2' type='0' exp='(.Header2 = 0) &amp;&amp; (.TimeoutCount &lt; .Timeout)' >
									<flowline >
										<command class_type='decision' title='Decision' exp='CircularBuffer1::GetNumberBytes() &gt;= 3' swap='0' >
											<flowline >
												<command class_type='call' title='Check for received byte' component='CircularBuffer1' macro='GetByte' >
													<return exp='.Header2' />
												</command>
											</flowline>
											<flowline >
												<command class_type='delay' title='Delay' exp='1' type='1' />
												<command class_type='calculation' title='Increment timeout' >
													<exp exp='.TimeoutCount = .TimeoutCount + 1' />
												</command>
											</flowline>
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Check if header 2 is correct' exp='.Header2 = ST3215_HEADER2' swap='0' >
									<flowline >
										<command class_type='call' title='Receive ID' component='CircularBuffer1' macro='GetByte' >
											<return exp='ResponseBuffer[0]' />
										</command>
										<command class_type='call' title='Receive Length' component='CircularBuffer1' macro='GetByte' >
											<return exp='ResponseBuffer[1]' />
										</command>
										<command class_type='calculation' title='Calculate number of data bytes' >
											<exp exp='ResponseLength = ResponseBuffer[1] - 2' />
										</command>
										<command class_type='loop' title='Receive all data bytes' type='0' exp='.Idx &lt; ResponseLength' >
											<flowline >
												<command class_type='decision' title='Decision' exp='CircularBuffer1::GetNumberBytes() &gt;= 3' swap='0' >
													<flowline >
														<command class_type='call' title='Receive Length' component='CircularBuffer1' macro='GetByte' >
															<return exp='ResponseBuffer[.Idx + 2]' />
														</command>
														<command class_type='calculation' title='Increment index' >
															<exp exp='.Idx = .Idx + 1' />
														</command>
														<command class_type='decision' title='Decision' exp='.Idx &gt; 17' swap='0' >
															<flowline >
																<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' />
															</flowline>
															<flowline />
														</command>
													</flowline>
													<flowline >
														<command class_type='delay' title='Delay' exp='1' type='1' />
														<command class_type='calculation' title='Increment timeout' >
															<exp exp='.TimeoutCount = .TimeoutCount + 1' />
														</command>
													</flowline>
												</command>
											</flowline>
										</command>
										<command class_type='calculation' title='Mark as successful' >
											<exp exp='.Return = 1' />
										</command>
										<command class_type='label' title='Declare Connection Point' labelid='0' labelname='A' />
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadMode' description='Read current operational mode. Returns: 0=position, 1=speed, 2=PWM, 3=step' statediag='0' >
						<return name='Return' type='u8' description='Mode value, or 255 if error' isconst='0' isHidden='0' isinit='0' usrinit='255' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_MODE' />
							<exp exp='PacketBuffer[1] = 1' />
						</command>
						<command class_type='call' title='Send read packet' macro='Prv_SendPacket' >
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_READ' />
							<argument exp='2' />
						</command>
						<command class_type='call' title='Receive response' macro='Prv_ReceiveResponse' >
							<argument exp='100' />
						</command>
						<command class_type='decision' title='Check if response received' exp='ResponseLength &gt;= 1' swap='0' >
							<flowline >
								<command class_type='calculation' title='Get mode value' >
									<exp exp='.Return = ResponseBuffer[2]' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetMode' description='Set operational mode. Mode: 0=position, 1=speed, 2=PWM, 3=step' statediag='0' >
						<return name='Return' type='b1' description='True if successful' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Mode' type='u8' description='Mode: 0=position, 1=speed, 2=PWM, 3=step' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address and mode value' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_MODE' />
							<exp exp='PacketBuffer[1] = .Mode' />
						</command>
						<command class_type='call' title='Send write packet' macro='Prv_SendPacket' >
							<return exp='.Return' />
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_WRITE' />
							<argument exp='2' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetSpeed' description='Set servo speed in steps per second.' statediag='0' >
						<return name='Return' type='b1' description='True if successful' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Speed' type='u16' description='Speed in steps per second (0-3400)' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address and speed bytes' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_SPEED' />
							<exp exp='PacketBuffer[1] = .Speed' />
							<exp exp='PacketBuffer[2] = .Speed &gt;&gt; 8' />
						</command>
						<command class_type='call' title='Send write packet' macro='Prv_SendPacket' >
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_WRITE' />
							<argument exp='3' />
						</command>
						<command class_type='call' title='Receive and verify response' macro='Prv_ReceiveResponse' >
							<return exp='.Return' />
							<argument exp='100' />
						</command>
						<command class_type='calculation' title='Calculation' disable='1' >
							<exp exp='.Return = 1' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='MoveToAngle' description='Move servo to a target angle. Angle range: -180 to 180 degrees.' statediag='0' >
						<return name='Return' type='b1' description='True if successful' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Angle' type='f32' description='Angle range: -180 to 180 degrees.' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='Position' type='u16' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='calculation' title='Convert angle to step position' >
							<exp exp='.Angle = .Angle + 180.0' />
							<exp exp='.Angle = .Angle * 11.37777' />
							<exp exp='.Position = .Angle' />
							<exp exp='.Position = .Position &amp; 0x0FFF' />
						</command>
						<command class_type='call' title='User Macro' macro='MoveTo' >
							<return exp='.Return' />
							<argument exp='.ServoID' />
							<argument exp='.Position' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='LockEEPROM' description='Lock EEPROM to prevent writes from being saved after power loss.' statediag='0' >
						<return name='Return' type='b1' description='True if successful' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address and lock value (1 = lock)' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_LOCK' />
							<exp exp='PacketBuffer[1] = 1' />
						</command>
						<command class_type='call' title='Send write packet' macro='Prv_SendPacket' >
							<return exp='.Return' />
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_WRITE' />
							<argument exp='2' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadCorrection' description='Read position correction value in steps.' statediag='0' >
						<return name='Return' type='s16' description='Correction value in steps, or 0 if error' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Store register address' >
							<exp exp='PacketBuffer[0] = ST3215_ADDR_CORRECTION' />
							<exp exp='PacketBuffer[1] = 2' />
						</command>
						<command class_type='call' title='Send read packet' macro='Prv_SendPacket' >
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_READ' />
							<argument exp='2' />
						</command>
						<command class_type='call' title='Receive response' macro='Prv_ReceiveResponse' >
							<argument exp='100' />
						</command>
						<command class_type='decision' title='Check if response received' exp='ResponseLength &gt;= 2' swap='0' >
							<flowline >
								<command class_type='calculation' title='Combine bytes to form correction value' >
									<exp exp='.Return = ResponseBuffer[2] + (ResponseBuffer[3] &lt;&lt; 8)' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
