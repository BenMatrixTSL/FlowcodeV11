							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='PingServo' description='Check if a servo is responding. Returns True if successful, False otherwise.' statediag='0' >
						<return name='Return' type='b1' description='True if servo responds' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID to ping (0-253)' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Send ping packet' macro='Prv_SendPacket' >
							<argument exp='.ServoID' />
							<argument exp='ST3215_CMD_PING' />
							<argument exp='0' />
						</command>
						<command class_type='call' title='Receive response' macro='Prv_ReceiveResponse' >
							<return exp='.Return' />
							<argument exp='20' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Prv_SendPacket' description='Send an STS protocol packet to the servo' statediag='0' >
						<return name='Return' type='b1' description='True if successful' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID (0-253)' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Instruction' type='u8' description='Instruction byte' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ParamCount' type='u8' description='Number of parameter bytes' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Length' type='u8' description='Packet length' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Checksum' type='u8' description='Calculated checksum' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Idx' type='u8' description='Loop index' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='calculation' title='Calculate packet length (parameters + 2)' >
							<exp exp='.Length = .ParamCount + 2' />
						</command>
						<command class_type='call' title='Calculate checksum' macro='Prv_CalculateChecksum' >
							<return exp='.Checksum' />
							<argument exp='.ServoID' />
							<argument exp='.Length' />
							<argument exp='.Instruction' />
							<argument exp='.ParamCount' />
						</command>
						<command class_type='call' title='Send header byte 1' component='cal_uart' macro='Send' >
							<argument exp='ST3215_HEADER1' />
						</command>
						<command class_type='call' title='Send header byte 2' component='cal_uart' macro='Send' >
							<argument exp='ST3215_HEADER2' />
						</command>
						<command class_type='call' title='Send servo ID' component='cal_uart' macro='Send' >
							<argument exp='.ServoID' />
						</command>
						<command class_type='call' title='Send length' component='cal_uart' macro='Send' >
							<argument exp='.Length' />
						</command>
						<command class_type='call' title='Send instruction' component='cal_uart' macro='Send' >
							<argument exp='.Instruction' />
						</command>
						<command class_type='loop' title='Send all parameter bytes' type='0' exp='.Idx &lt; .ParamCount' >
							<flowline >
								<command class_type='call' title='Send parameter byte' component='cal_uart' macro='Send' >
									<argument exp='PacketBuffer[.Idx]' />
								</command>
								<command class_type='calculation' title='Increment index' >
									<exp exp='.Idx = .Idx + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Send checksum' component='cal_uart' macro='Send' >
							<argument exp='.Checksum' />
						</command>
						<command class_type='call' title='Component Macro' component='CircularBuffer1' macro='FlushBuffer' />
						<command class_type='calculation' title='Return success' >
							<exp exp='.Return = 1' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReadLoad' description='Read motor load in percentage. Returns load percentage.' statediag='0' >
						<return name='Return' type='u8' description='Load percentage, or 0 if error' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ServoID' type='u8' description='Servo ID' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
