			<macros >
				<macro >
					<flowline name='Compress' description='Collects a single value from the input buffer, applies the compressor and passes the result to the output buffer.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<local name='Val' type='s32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Level_Q8' type='s32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Gain_Q12' type='s32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Sample' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='Level' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='Out' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<command class_type='decision' title='Decision' exp='BuffSizeIn &gt; 1' swap='0' >
							<flowline >
								<command class_type='decision' title='Float input?' exp='BuffTypeIn = 5' swap='0' >
									<flowline >
										<command class_type='calculation' title='Read float sample' >
											<exp exp='.Sample = Ref1 :: get_float (IndexIn)' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Read integer sample' >
											<exp exp='.Val = Ref1 :: get (IndexIn)' />
										</command>
										<command class_type='decision' title='32-bit integer?' exp='BuffTypeIn &gt; 2' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Sample = FLOAT .Val' />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='IndexIn = IndexIn + 1' />
								</command>
								<command class_type='decision' title='Decision' exp='IndexIn = BuffSizeIn' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='IndexIn = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline >
								<command class_type='decision' title='Float input?' exp='BuffTypeIn = 5' swap='0' >
									<flowline >
										<command class_type='calculation' title='Read float sample' >
											<exp exp='.Sample = Ref1 :: get_float (0)' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Read integer sample' >
											<exp exp='.Val = Ref1 :: get (0)' />
										</command>
										<command class_type='decision' title='32-bit integer?' exp='BuffTypeIn &gt; 2' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Sample = FLOAT .Val' />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Fixed point or floating point?' exp='BuffType &lt; 3' swap='0' >
							<flowline >
								<command class_type='decision' title='Compressor enabled?' exp='Enabled' swap='0' >
									<flowline >
										<command class_type='calculation' title='Signal relative to centre' >
											<exp exp='.Val = .Val - IntCentre' />
											<exp exp='.Level_Q8 = .Val' />
										</command>
										<command class_type='decision' title='Absolute level' exp='.Level_Q8 &lt; 0' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Level_Q8 = 0 - .Level_Q8' />
												</command>
											</flowline>
											<flowline />
										</command>
										<command class_type='calculation' title='Level in Q8 fixed point' >
											<exp exp='.Level_Q8 = .Level_Q8 &lt;&lt; 8' />
										</command>
										<command class_type='decision' title='Rising or falling?' exp='.Level_Q8 &gt; IEnv' swap='0' >
											<flowline >
												<command class_type='calculation' title='Attack' >
													<exp exp='IEnv = IEnv + ((.Level_Q8 - IEnv) &gt;&gt; IAttack)' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Release' >
													<exp exp='IEnv = IEnv + ((.Level_Q8 - IEnv) &gt;&gt; IRelease)' />
												</command>
											</flowline>
										</command>
										<command class_type='decision' title='Above threshold?' exp='IEnv &gt; IThresh' swap='0' >
											<flowline >
												<command class_type='calculation' title='Compressed envelope' >
													<exp exp='.Gain_Q12 = IThresh + ((IEnv - IThresh) &gt;&gt; IRatio)' />
												</command>
												<command class_type='decision' title='8-bit data?' exp='BuffType = 0' swap='0' >
													<flowline >
														<command class_type='calculation' title='Gain (Q12), 8-bit envelope fits in 16 bits' >
															<exp exp='.Gain_Q12 = (.Gain_Q12 &lt;&lt; 12) / IEnv' />
														</command>
													</flowline>
													<flowline >
														<command class_type='calculation' title='Gain (Q12), split shift keeps 16-bit data within 32 bits' >
															<exp exp='.Gain_Q12 = (.Gain_Q12 &lt;&lt; 6) / (IEnv &gt;&gt; 6)' />
														</command>
													</flowline>
												</command>
												<command class_type='calculation' title='Apply gain reduction' >
													<exp exp='IGain = .Gain_Q12' />
													<exp exp='.Val = ((.Val * .Gain_Q12) + 2048) &gt;&gt; 12' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Unity gain' >
													<exp exp='IGain = 4096' />
												</command>
											</flowline>
										</command>
										<command class_type='calculation' title='Apply makeup gain' >
											<exp exp='.Val = (((.Val * IMakeup) + 128) &gt;&gt; 8) + IntCentre' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='comment' title='' comment='Saturate to the range of the output buffer type' textarea='12,0,12,0' />
								<command class_type='decision' title='Decision' exp='BuffType = 0' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' exp='.Val &gt; 255' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Val = 255' />
												</command>
											</flowline>
											<flowline />
										</command>
										<command class_type='decision' title='Decision' exp='.Val &lt; 0' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Val = 0' />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='BuffType = 1' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' exp='.Val &gt; 65535' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Val = 65535' />
												</command>
											</flowline>
											<flowline />
										</command>
										<command class_type='decision' title='Decision' exp='.Val &lt; 0' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Val = 0' />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='BuffType = 2' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' exp='.Val &gt; 32767' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Val = 32767' />
												</command>
											</flowline>
											<flowline />
										</command>
										<command class_type='decision' title='Decision' exp='.Val &lt; -32768' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Val = -32768' />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline >
								<command class_type='decision' title='Load property values on first use' exp='Initialised = 0' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='Prv_Initialise' />
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Compressor enabled?' exp='Enabled' swap='0' >
									<flowline >
										<command class_type='calculation' title='Signal relative to centre' >
											<exp exp='.Sample = .Sample - SignalCentre' />
											<exp exp='.Level = fabs (.Sample)' />
										</command>
										<command class_type='decision' title='Rising or falling?' exp='.Level &gt; Envelope' swap='0' >
											<flowline >
												<command class_type='calculation' title='Attack' >
													<exp exp='Envelope = Envelope + AttackCoef * (.Level - Envelope)' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Release' >
													<exp exp='Envelope = Envelope + ReleaseCoef * (.Level - Envelope)' />
												</command>
											</flowline>
										</command>
										<command class_type='decision' title='Above threshold?' exp='Envelope &gt; Threshold' swap='0' >
											<flowline >
												<command class_type='calculation' title='Gain reduction' >
													<exp exp='Gain = pow (Envelope / Threshold, RatioExp)' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Unity gain' >
													<exp exp='Gain = 1.0' />
												</command>
											</flowline>
										</command>
										<command class_type='calculation' title='Apply gain' >
											<exp exp='.Out = (.Sample * Gain * Makeup) + SignalCentre' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Bypass' >
											<exp exp='.Out = .Sample' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Float output?' exp='BuffType = 5' swap='0' >
									<flowline />
									<flowline >
										<command class_type='comment' title='' comment='Saturate to the range of the output buffer type' textarea='12,0,12,0' />
										<command class_type='decision' title='Decision' exp='BuffType = 3' swap='0' >
											<flowline >
												<command class_type='decision' title='Decision' exp='.Out &gt; 2147483520.0' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='.Out = 2147483520.0' />
														</command>
													</flowline>
													<flowline />
												</command>
												<command class_type='decision' title='Decision' exp='.Out &lt; 0.0' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='.Out = 0.0' />
														</command>
													</flowline>
													<flowline />
												</command>
											</flowline>
											<flowline />
										</command>
										<command class_type='decision' title='Decision' exp='BuffType = 4' swap='0' >
											<flowline >
												<command class_type='decision' title='Decision' exp='.Out &gt; 2147483520.0' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='.Out = 2147483520.0' />
														</command>
													</flowline>
													<flowline />
												</command>
												<command class_type='decision' title='Decision' exp='.Out &lt; -2147483520.0' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='.Out = -2147483520.0' />
														</command>
													</flowline>
													<flowline />
												</command>
											</flowline>
											<flowline />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Val = fround (.Out, 0)' />
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' exp='BuffSize &gt; 1' swap='0' >
							<flowline >
								<command class_type='decision' title='Float output?' exp='BuffType = 5' swap='0' >
									<flowline >
										<command class_type='call' title='Write float sample' component='Buff1' macro='put_float' >
											<argument exp='IndexOut' />
											<argument exp='.Out' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='Write integer sample' component='Buff1' macro='put' >
											<argument exp='IndexOut' />
											<argument exp='.Val' />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='IndexOut = IndexOut + 1' />
								</command>
								<command class_type='decision' title='Decision' exp='IndexOut = BuffSize' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='IndexOut = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline >
								<command class_type='decision' title='Float output?' exp='BuffType = 5' swap='0' >
									<flowline >
										<command class_type='call' title='Write float sample' component='Buff1' macro='put_float' >
											<argument exp='0' />
											<argument exp='.Out' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='Write integer sample' component='Buff1' macro='put' >
											<argument exp='0' />
											<argument exp='.Val' />
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='CompressArray' description='Passes an entire buffer through the compressor and outputs the compressed version of the buffer at the other end.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<local name='Idx' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='loop' title='Loop' type='0' exp='(.Idx &lt; BuffSizeIn) &amp;&amp; (.Idx &lt; BuffSize)' >
							<flowline >
								<command class_type='call' title='User Macro' macro='Compress' />
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Idx = .Idx + 1' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ControlCompressor' description='Enables or disables the compressor, enabled by default. When disabled samples pass through unchanged.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='State' type='b1' description='0=Disable, 1=Enable' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='Enabled = .State' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Reset' description='Clears the envelope follower so the compressor starts again from no gain reduction.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='decision' title='Fixed point or floating point?' exp='BuffType &lt; 3' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='IEnv = 0' />
									<exp exp='IGain = 4096' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='Envelope = 0.0' />
									<exp exp='Gain = 1.0' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetThreshold' description='Float and 32-bit buffer types only. Sets the level, measured from the signal centre, above which compression is applied.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Level' type='f32' description='Threshold level in buffer units, must be greater than zero' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<command class_type='decision' title='32-bit and float buffer types only' exp='BuffType &gt; 2' swap='0' >
							<flowline >
								<command class_type='decision' title='Load property values on first use' exp='Initialised = 0' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='Prv_Initialise' />
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='.Level &lt;= 0.0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Avoid divide by zero' >
											<exp exp='.Level = 0.000001' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='Threshold = .Level' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetRatio' description='Float and 32-bit buffer types only. Sets the compression ratio, e.g. 4.0 for 4:1. A level 4dB above the threshold comes out 1dB above it. Large ratios act as a limiter.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Ratio' type='f32' description='Compression ratio, 1.0 or greater. 1.0 = no compression' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<command class_type='decision' title='32-bit and float buffer types only' exp='BuffType &gt; 2' swap='0' >
							<flowline >
								<command class_type='decision' title='Load property values on first use' exp='Initialised = 0' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='Prv_Initialise' />
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='.Ratio &lt; 1.0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Ratio = 1.0' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='RatioExp = (1.0 / .Ratio) - 1.0' />
								</command>
								<command class_type='sim' title='Simulation' macro='Component.Property.SetValue' >
									<argument exp='GdiText1' />
									<argument exp='&quot;sText&quot;' />
									<argument exp='FloatToString$ (.Ratio, 1) + &quot;:1&quot;' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetAttackTime' description='Float and 32-bit buffer types only. Sets how quickly the compressor responds to a signal rising above the threshold.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Time_ms' type='f32' description='Attack time constant in milliseconds, 0 = instant' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<command class_type='decision' title='32-bit and float buffer types only' exp='BuffType &gt; 2' swap='0' >
							<flowline >
								<command class_type='decision' title='Load property values on first use' exp='Initialised = 0' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='Prv_Initialise' />
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='User Macro' macro='Prv_CalcCoef' >
									<return exp='AttackCoef' />
									<argument exp='.Time_ms' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetReleaseTime' description='Float and 32-bit buffer types only. Sets how quickly the compressor recovers once the signal falls.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Time_ms' type='f32' description='Release time constant in milliseconds, 0 = instant' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<command class_type='decision' title='32-bit and float buffer types only' exp='BuffType &gt; 2' swap='0' >
							<flowline >
								<command class_type='decision' title='Load property values on first use' exp='Initialised = 0' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='Prv_Initialise' />
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='User Macro' macro='Prv_CalcCoef' >
									<return exp='ReleaseCoef' />
									<argument exp='.Time_ms' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetMakeupGain' description='Float and 32-bit buffer types only. Sets the gain applied after compression to restore the overall signal level.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Multiplier' type='f32' description='Linear gain multiplier, 1.0 = no change' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<command class_type='decision' title='32-bit and float buffer types only' exp='BuffType &gt; 2' swap='0' >
							<flowline >
								<command class_type='decision' title='Load property values on first use' exp='Initialised = 0' swap='0' >
									<flowline >
										<command class_type='call' title='User Macro' macro='Prv_Initialise' />
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='Makeup = .Multiplier' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='GetGain' description='Float and 32-bit buffer types only. Returns the gain applied on the last sample, excluding makeup gain. 1.0 = no gain reduction, 0.5 = halved.' statediag='0' >
						<return name='Return' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<command class_type='decision' title='32-bit and float buffer types only' exp='BuffType &gt; 2' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = Gain' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='GetEnvelope' description='Float and 32-bit buffer types only. Returns the detected signal level, measured from the signal centre.' statediag='0' >
						<return name='Return' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<command class_type='decision' title='32-bit and float buffer types only' exp='BuffType &gt; 2' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = Envelope' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetThresholdInt' description='8/16-bit integer buffer types only. Sets the level, measured from the signal centre, above which compression is applied.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Level' type='s32' description='Threshold level in buffer units, 1 to 65535' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='8/16-bit integer buffer types only' exp='BuffType &lt; 3' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='.Level &lt; 1' swap='0' >
									<flowline >
										<command class_type='calculation' title='Avoid divide by zero' >
											<exp exp='.Level = 1' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='decision' title='Decision' exp='.Level &gt; 65535' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Level = 65535' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='IThresh = .Level &lt;&lt; 8' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetRatioShift' description='8/16-bit integer buffer types only. Sets the compression ratio as a power of two: 0 = 1:1, 1 = 2:1, 2 = 4:1, 3 = 8:1, 4 = 16:1, 5 = 32:1, 24 = limiter.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Shift' type='u8' description='Ratio = 2 ^ Shift, 0 to 5 or 24 for a limiter' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='8/16-bit integer buffer types only' exp='BuffType &lt; 3' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='.Shift &gt; 24' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Shift = 24' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='IRatio = .Shift' />
								</command>
								<command class_type='decision' title='Decision' exp='.Shift = 24' swap='0' >
									<flowline >
										<command class_type='sim' title='Simulation' macro='Component.Property.SetValue' >
											<argument exp='GdiText1' />
											<argument exp='&quot;sText&quot;' />
											<argument exp='&quot;Limit&quot;' />
										</command>
									</flowline>
									<flowline >
										<command class_type='sim' title='Simulation' macro='Component.Property.SetValue' >
											<argument exp='GdiText1' />
											<argument exp='&quot;sText&quot;' />
											<argument exp='STRING (1 &lt;&lt; .Shift) + &quot;:1&quot;' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetAttackShift' description='8/16-bit integer buffer types only. Sets how quickly the compressor responds to a rising signal. The time constant is 2 ^ Shift samples.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Shift' type='u8' description='0 = instant, 1 = 2 samples, 2 = 4 samples ... 15 = 32768 samples' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='8/16-bit integer buffer types only' exp='BuffType &lt; 3' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='.Shift &gt; 15' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Shift = 15' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='IAttack = .Shift' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetReleaseShift' description='8/16-bit integer buffer types only. Sets how quickly the compressor recovers once the signal falls. The time constant is 2 ^ Shift samples.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Shift' type='u8' description='0 = instant, 1 = 2 samples, 2 = 4 samples ... 15 = 32768 samples' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='8/16-bit integer buffer types only' exp='BuffType &lt; 3' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='.Shift &gt; 15' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Shift = 15' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='IRelease = .Shift' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SetMakeupGainQ8' description='8/16-bit integer buffer types only. Sets the gain applied after compression in 1/256 steps, e.g. 256 = x1, 384 = x1.5, 512 = x2.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Gain' type='u16' description='Makeup gain x 256, 0 to 8192 (x32)' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='8/16-bit integer buffer types only' exp='BuffType &lt; 3' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='.Gain &gt; 8192' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Gain = 8192' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='IMakeup = .Gain' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='GetGainQ8' description='8/16-bit integer buffer types only. Returns the gain applied on the last sample in 1/256 steps, excluding makeup gain. 256 = no gain reduction, 128 = halved.' statediag='0' >
						<return name='Return' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='8/16-bit integer buffer types only' exp='BuffType &lt; 3' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = IGain &gt;&gt; 4' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='GetEnvelopeInt' description='8/16-bit integer buffer types only. Returns the detected signal level, measured from the signal centre.' statediag='0' >
						<return name='Return' type='s32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='8/16-bit integer buffer types only' exp='BuffType &lt; 3' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = IEnv &gt;&gt; 8' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Prv_Initialise' description='Loads the floating point runtime settings from the component properties.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='decision' title='32-bit and float buffer types only' exp='BuffType &gt; 2' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='Initialised = 1' />
									<exp exp='Threshold = InitThreshold' />
									<exp exp='RatioExp = (1.0 / InitRatio) - 1.0' />
									<exp exp='Makeup = InitMakeup' />
									<exp exp='Envelope = 0.0' />
									<exp exp='Gain = 1.0' />
								</command>
								<command class_type='call' title='User Macro' macro='Prv_CalcCoef' >
									<return exp='AttackCoef' />
									<argument exp='InitAttack' />
								</command>
								<command class_type='call' title='User Macro' macro='Prv_CalcCoef' >
									<return exp='ReleaseCoef' />
									<argument exp='InitRelease' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Prv_CalcCoef' description='Converts a time constant in milliseconds into a one pole smoothing coefficient at the configured sample rate.' statediag='0' >
						<return name='Return' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<param name='Time_ms' type='f32' description='Time constant in milliseconds' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<command class_type='decision' title='32-bit and float buffer types only' exp='BuffType &gt; 2' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='.Time_ms &lt;= 0.0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Instant response' >
											<exp exp='.Return = 1.0' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return = 1.0 - exp (0.0 - 1000.0 / (.Time_ms * SampleRate))' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Start' description='Broadcast to all components that simulation is starting' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Floating point settings load on first use' >
							<exp exp='Initialised = 0' />
							<exp exp='Enabled = 1' />
						</command>
						<command class_type='calculation' title='Fixed point settings' >
							<exp exp='IThresh = IntThreshold &lt;&lt; 8' />
							<exp exp='IRatio = IntRatioShift' />
							<exp exp='IAttack = IntAttackShift' />
							<exp exp='IRelease = IntReleaseShift' />
							<exp exp='IMakeup = IntMakeupQ8' />
							<exp exp='IEnv = 0' />
							<exp exp='IGain = 4096' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_AddVar' description='Sent to a component to allow dynamic amendment of global constant declarations' statediag='0' >
						<return name='Return' type='u32' description='Non-zero to include definition - initialised on call' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='VarName' type='T8' description='The original Flowcode variable' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='ExpandName' type='T8' description='The expanded variable name' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='Expansion' type='T8*' description='The expanded string to inline to the code' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<local name='cmp' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 1' />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;Initialised&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffType &lt; 3' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;Threshold&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffType &lt; 3' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;RatioExp&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffType &lt; 3' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;AttackCoef&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffType &lt; 3' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;ReleaseCoef&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffType &lt; 3' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;Makeup&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffType &lt; 3' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;Envelope&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffType &lt; 3' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;Gain&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffType &lt; 3' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;IThresh&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffType &gt; 2' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Expansion = &quot;MX_GLOBAL MX_SINT32 &quot; + .ExpandName + &quot; = &quot; + STRING (IntThreshold * 256) + &quot;;\n&quot;' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;IRatio&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffType &gt; 2' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Expansion = &quot;MX_GLOBAL MX_UINT8 &quot; + .ExpandName + &quot; = &quot; + STRING IntRatioShift + &quot;;\n&quot;' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;IAttack&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffType &gt; 2' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Expansion = &quot;MX_GLOBAL MX_UINT8 &quot; + .ExpandName + &quot; = &quot; + STRING IntAttackShift + &quot;;\n&quot;' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;IRelease&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffType &gt; 2' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Expansion = &quot;MX_GLOBAL MX_UINT8 &quot; + .ExpandName + &quot; = &quot; + STRING IntReleaseShift + &quot;;\n&quot;' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;IMakeup&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffType &gt; 2' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Expansion = &quot;MX_GLOBAL MX_UINT16 &quot; + .ExpandName + &quot; = &quot; + STRING IntMakeupQ8 + &quot;;\n&quot;' />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;IEnv&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffType &gt; 2' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;IGain&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffType &gt; 2' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;IndexIn&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffSizeIn = 1' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$ (.VarName,&quot;IndexOut&quot;,0) = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='BuffSize = 1' swap='0' >
									<flowline >
										<command class_type='calculation' title='Unused Variable - Don&apos;t add to C' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Property' description='Sent when a property has been changed by the User' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='temp_str' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<local name='Calc' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='Div' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='KneeY' type='s16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='IVal' type='s32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Handle' type='h32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Simulation' macro='Tree.GetName' >
							<return exp='.temp_str' />
							<argument exp='this' />
						</command>
						<command class_type='sim' title='Simulation' macro='Component.Property.SetValue' >
							<argument exp='GdiText2' />
							<argument exp='&quot;sText&quot;' />
							<argument exp='.temp_str' />
						</command>
						<command class_type='sim' title='Simulation' macro='Component.Property.GetValue' >
							<return exp='.temp_str' />
							<argument exp='Ref1' />
							<argument exp='&quot;BuffSize&quot;' />
						</command>
						<command class_type='sim' title='Simulation' macro='Component.Property.SetValue' >
							<argument exp='this' />
							<argument exp='&quot;BuffSizeIn&quot;' />
							<argument exp='.temp_str' />
						</command>
						<command class_type='sim' title='Simulation' macro='Component.Property.GetValue' >
							<return exp='.temp_str' />
							<argument exp='Ref1' />
							<argument exp='&quot;BuffType&quot;' />
						</command>
						<command class_type='sim' title='Simulation' macro='Component.Property.SetValue' >
							<argument exp='this' />
							<argument exp='&quot;BuffTypeIn&quot;' />
							<argument exp='.temp_str' />
						</command>
						<command class_type='sim' title='Match output buffer type with input buffer type' macro='Component.Property.SetValue' >
							<argument exp='this' />
							<argument exp='&quot;BuffType&quot;' />
							<argument exp='.temp_str' />
						</command>
						<command class_type='decision' title='Decision' exp='BuffSize &lt; 1' swap='0' >
							<flowline >
								<command class_type='sim' title='Simulation' macro='Component.Property.SetValue' >
									<argument exp='this' />
									<argument exp='&quot;BuffSize&quot;' />
									<argument exp='1' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='sim' title='Simulation' macro='Component.Property.CopyValue' >
							<argument exp='this' />
							<argument exp='Buff1' />
							<argument exp='&quot;BuffSize&quot;' />
						</command>
						<command class_type='sim' title='Simulation' macro='Component.Property.CopyValue' >
							<argument exp='this' />
							<argument exp='Buff1' />
							<argument exp='&quot;BuffType&quot;' />
						</command>
						<command class_type='sim' title='Built-in Function' macro='Component.GetParent' >
							<return exp='.Handle' />
							<argument exp='this' />
						</command>
						<command class_type='decision' title='Decision' exp='.Handle' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Div = 25.0' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Div = 1.0' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' exp='Direction' swap='0' >
							<flowline >
								<command class_type='sim' title='Built-in Function' macro='Panel.Position.MoveTo' >
									<argument exp='Ref1' />
									<argument exp='35.0 / .div' />
									<argument exp='0.0' />
									<argument exp='1.0 / .div' />
								</command>
								<command class_type='sim' title='Built-in Function' macro='Component.Property.SetValue' >
									<argument exp='Ref1' />
									<argument exp='&quot;Orientation&quot;' />
									<argument exp='2' />
								</command>
								<command class_type='sim' title='Built-in Function' macro='Panel.Position.MoveTo' >
									<argument exp='Buff1' />
									<argument exp='-35.0 / .div' />
									<argument exp='0.0' />
									<argument exp='1.0 / .div' />
								</command>
								<command class_type='sim' title='Built-in Function' macro='Component.Property.SetValue' >
									<argument exp='Buff1' />
									<argument exp='&quot;Orientation&quot;' />
									<argument exp='2' />
								</command>
