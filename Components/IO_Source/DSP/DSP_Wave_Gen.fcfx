									<argument exp='this' />
									<argument exp='&quot;CalculateData&quot;' />
									<argument exp='0' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Custom?' exp='wave_type = 7' swap='0' >
							<flowline >
