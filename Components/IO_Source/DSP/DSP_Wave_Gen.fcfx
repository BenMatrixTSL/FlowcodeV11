													<argument exp='this' />
													<argument exp='&quot;wave_duty&quot;' />
													<argument exp='0' />
												</command>
											</flowline>
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Noise' exp='wave_type = 5' swap='0' >
