									</flowline>
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Calculate Frequency' >
							<exp exp='.Calc = sample_rate / wave_period' />
						</command>
						<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
							<argument exp='this' />
							<argument exp='&quot;calc_freq&quot;' />
							<argument exp='.Calc' />
						</command>
						<command class_type='calculation' title='Calculate Period' >
							<exp exp='.Calc = 1 / .Calc' />
						</command>
						<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
							<argument exp='this' />
							<argument exp='&quot;calc_period&quot;' />
							<argument exp='.Calc' />
