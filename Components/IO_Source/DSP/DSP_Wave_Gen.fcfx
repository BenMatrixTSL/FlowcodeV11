										<argument exp='&quot;1&quot;' />
									</command>
									<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
										<argument exp='this' />
										<argument exp='&quot;max_a&quot;' />
										<argument exp='32767' />
									</command>
									<command class_type='sim' title='Call Macro' macro='Component.Property.SetValue' >
										<argument exp='this' />
										<argument exp='&quot;min_a&quot;' />
										<argument exp='-32768' />
									</command>
								</flowline>
							</case>
						</command>
						<command class_type='decision' title='Sine or Cosine' exp='(wave_type = 0 || wave_type = 8) || (wave_type = 5)' swap='0' >
							<flowline >
								<command class_type='sim' title='Built-in Function' macro='Component.Property.SetVisible' >
									<argument exp='this' />
