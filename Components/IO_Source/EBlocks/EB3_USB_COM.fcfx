				</macro>
				<macro >
					<flowline name='ReceiveNumber' description='Attempts to receive a number as ASCII characters and convert back into a numeric value. Note this function will receive until a timeout or a none numeric char is received, the none numeric char will be lost.' statediag='0' >
						<return name='Return' type='s32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Timeout' type='u8' description='Max time in ms to wait in between bytes' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='IgnoreData' type='b1' description='0=Dont ignore any data, 1=Ignore any initial none numeric data' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='first' type='b1' description='' isconst='0' isHidden='0' isinit='1' usrinit='1' setinit='1' />
						<local name='done' type='b1' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='char' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='bNeg' type='b1' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.done = 0' >
							<flowline >
								<command class_type='call' title='Component Macro' component='cal_uart' macro='Receive' >
									<return exp='.char' />
									<argument exp='.Timeout' />
								</command>
								<command class_type='decision' title='Decision' exp='.char &gt;= 255' swap='0' >
									<flowline >
										<command class_type='calculation' title='Timeout - Return' >
											<exp exp='.done = 1' />
										</command>
									</flowline>
									<flowline >
										<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashRx' />
										<command class_type='decision' title='Decision' exp='.first' swap='0' >
											<flowline >
												<command class_type='decision' title='Decision' exp='(.char &gt;= &apos;0&apos; &amp;&amp; .char &lt;= &apos;9&apos;) || .char = &apos;-&apos;' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='.first = 0' />
														</command>
														<command class_type='decision' title='Decision' exp='.char = &apos;-&apos;' swap='0' >
															<flowline >
																<command class_type='calculation' title='Calculation' >
																	<exp exp='.bNeg = 1' />
																</command>
															</flowline>
															<flowline >
																<command class_type='calculation' title='Calculation' >
																	<exp exp='.Return = .Return * 10' />
																	<exp exp='.Return = .Return + (.char - &apos;0&apos;)' />
																</command>
															</flowline>
														</command>
													</flowline>
													<flowline >
														<command class_type='decision' title='Decision' exp='.IgnoreData' swap='0' >
															<flowline />
															<flowline >
																<command class_type='calculation' title='Not a valid char - return' >
																	<exp exp='.done = 1' />
																</command>
															</flowline>
														</command>
													</flowline>
												</command>
											</flowline>
											<flowline >
												<command class_type='decision' title='Decision' exp='.char &gt;= &apos;0&apos; &amp;&amp; .char &lt;= &apos;9&apos;' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='.Return = .Return * 10' />
															<exp exp='.Return = .Return + (.char - &apos;0&apos;)' />
														</command>
													</flowline>
													<flowline >
														<command class_type='calculation' title='Not a valid char - return' >
															<exp exp='.done = 1' />
														</command>
													</flowline>
												</command>
											</flowline>
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' exp='.bNeg' swap='0' >
							<flowline >
								<command class_type='calculation' title='Number is negative' >
									<exp exp='.Return = 0 - .Return' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SendBinary16Bit' description='Sends out a 16-bit binary value split across two bytes.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
