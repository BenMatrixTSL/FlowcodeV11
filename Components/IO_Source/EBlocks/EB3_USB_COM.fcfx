				<macro >
					<flowline name='Ev_Property' description='Sent when a property has been changed by the User' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='temp_str' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<command class_type='sim' title='Built-in Function' macro='System.TimerStart' >
							<argument exp='0' />
							<argument exp='400' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReceiveBinary16Bit' description='Receives a binary 16-bit value split across two bytes.' statediag='0' >
						<return name='Return' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='MSBfirst' type='b1' description='0=Least significant byte first, 1=Most significant byte first' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Timeout' type='u8' description='Max amount of time in ms to wait between bytes' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='byte' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='decision' title='Decision' exp='.MSBfirst' swap='0' >
							<flowline >
								<command class_type='call' title='Component Macro' component='cal_uart' macro='Receive' >
									<return exp='.byte' />
									<argument exp='.Timeout' />
								</command>
								<command class_type='decision' title='Decision' exp='.byte &gt; 255' swap='0' >
									<flowline >
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' />
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversionsFree1' macro='SetByte' >
									<argument exp='1' />
									<argument exp='.byte' />
								</command>
								<command class_type='call' title='Component Macro' component='cal_uart' macro='Receive' >
									<return exp='.byte' />
									<argument exp='.Timeout' />
								</command>
								<command class_type='decision' title='Decision' exp='.byte &gt; 255' swap='0' >
									<flowline >
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' />
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversionsFree1' macro='SetByte' >
									<argument exp='0' />
									<argument exp='.byte' />
								</command>
							</flowline>
							<flowline >
								<command class_type='call' title='Component Macro' component='cal_uart' macro='Receive' >
									<return exp='.byte' />
									<argument exp='.Timeout' />
								</command>
								<command class_type='decision' title='Decision' exp='.byte &gt; 255' swap='0' >
									<flowline >
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' />
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversionsFree1' macro='SetByte' >
									<argument exp='0' />
									<argument exp='.byte' />
								</command>
								<command class_type='call' title='Component Macro' component='cal_uart' macro='Receive' >
									<return exp='.byte' />
									<argument exp='.Timeout' />
								</command>
								<command class_type='decision' title='Decision' exp='.byte &gt; 255' swap='0' >
									<flowline >
										<command class_type='goto' title='Goto Connection Point' labelid='0' labelname='' />
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Component Macro' component='TypeConversionsFree1' macro='SetByte' >
									<argument exp='1' />
									<argument exp='.byte' />
								</command>
							</flowline>
						</command>
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashRx' />
						<command class_type='call' title='Component Macro' component='TypeConversionsFree1' macro='GetInt' >
							<return exp='.Return' />
							<argument exp='0' />
						</command>
						<command class_type='label' title='Declare Connection Point' labelid='0' labelname='A' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Renamed' description='' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Name' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<command class_type='sim' title='' macro='Tree.GetName' >
							<return exp='.Name' />
							<argument exp='this' />
						</command>
						<command class_type='sim' title='' macro='Component.Property.SetValue' >
							<argument exp='LibraryComponent1' />
							<argument exp='&quot;Name&quot;' />
							<argument exp='.Name' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ChangeHWBaud' description='Changes the hardware UART baud rate allowing for dynamic speed changes. ' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='NewBaud' type='u8' description='0=1200, 1=2400, 2=4800, 3=9600, 4=19200, 5=38400, 6=57600, 7=115200, 8=250000' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Call Component Macro' component='cal_uart' macro='UpdateBaud' >
							<argument exp='.NewBaud' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReceiveFloat' description='Attempts to receive a floating point number as ASCII characters and convert back into a numeric value. Note this function will receive until a timeout or a none numeric char is received, the none numeric char will be lost.' statediag='0' >
						<return name='Return' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<param name='Timeout' type='u8' description='Max time in ms to wait in between bytes' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='IgnoreData' type='b1' description='0=Dont ignore any data, 1=Ignore any initial none numeric data' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='idx' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='done' type='b1' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='char' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='dpRx' type='b1' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='str' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<command class_type='loop' title='Loop' type='0' exp='.done = 0' >
							<flowline >
								<command class_type='call' title='Component Macro' component='cal_uart' macro='Receive' >
									<return exp='.char' />
									<argument exp='.Timeout' />
								</command>
								<command class_type='decision' title='Decision' exp='.char &gt;= 255' swap='0' >
									<flowline >
										<command class_type='calculation' title='Timeout - Return' >
											<exp exp='.done = 1' />
										</command>
									</flowline>
									<flowline >
										<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashRx' />
										<command class_type='decision' title='Decision' exp='.idx = 0' swap='0' >
											<flowline >
												<command class_type='decision' title='Decision' exp='(.char &gt;= &apos;0&apos; &amp;&amp; .char &lt;= &apos;9&apos;) || (.char = &apos;-&apos;)' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='.str[.idx] = .char' />
														</command>
														<command class_type='calculation' title='Calculation' >
															<exp exp='.idx = .idx + 1' />
														</command>
													</flowline>
													<flowline >
														<command class_type='decision' title='Decision' exp='.IgnoreData' swap='0' >
															<flowline />
															<flowline >
																<command class_type='calculation' title='Not a valid char - return' >
																	<exp exp='.done = 1' />
																</command>
															</flowline>
														</command>
													</flowline>
												</command>
											</flowline>
											<flowline >
												<command class_type='decision' title='Decision' exp='(.char &gt;= &apos;0&apos; &amp;&amp; .char &lt;= &apos;9&apos;) || (.char = &apos;.&apos; &amp;&amp; .dpRx = 0)' swap='0' >
													<flowline >
														<command class_type='decision' title='Decision' exp='.char = &apos;.&apos;' swap='0' >
															<flowline >
																<command class_type='calculation' title='Flag we have received decimal point' >
																	<exp exp='.dpRx = 1' />
																</command>
															</flowline>
															<flowline />
														</command>
														<command class_type='calculation' title='Calculation' >
															<exp exp='.str[.idx] = .char' />
														</command>
														<command class_type='calculation' title='Calculation' >
															<exp exp='.idx = .idx + 1' />
														</command>
													</flowline>
													<flowline >
														<command class_type='calculation' title='Not a valid char - return' >
															<exp exp='.done = 1' />
														</command>
													</flowline>
												</command>
											</flowline>
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' exp='.idx' swap='0' >
							<flowline >
								<command class_type='calculation' title='Terminate String' >
									<exp exp='.str[.idx] = 0' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = StringToFloat$ (.str)' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0.0' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SendFloat' description='Sends out a floating point number as an ASCII String from the UART interface.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Number' type='f32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0.0' setinit='' />
						<local name='numStr' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.numStr = FloatToString$ (.Number)' />
						</command>
						<command class_type='call' title='Component Macro' component='cal_uart' macro='SendString' >
							<argument exp='.numStr' />
						</command>
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashTx' />
					</flowline>
				</macro>
				<macro >
					<flowline name='SendHexNumber' description='Sends out a number as an ASCII hexadecimal String from the UART interface.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Number' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='NumChars' type='u8' description='Number of characters in the string data, 0 for auto, 2 for 0x00, 4 for 0x0000' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Prefix' type='b1' description='Generate hexadecimal prefix 0x e.g. 1= 0xFF, 0= FF' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='idx' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='chars' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='8' />
						</local>
						<command class_type='decision' title='Decision' exp='.Prefix' swap='0' >
							<flowline >
								<command class_type='call' title='Component Macro' component='cal_uart' macro='Send' >
									<argument exp='&apos;0&apos;' />
								</command>
								<command class_type='call' title='Component Macro' component='cal_uart' macro='Send' >
									<argument exp='&apos;x&apos;' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='.NumChars = 0' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='.Number &lt; 256' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.NumChars = 2' />
										</command>
									</flowline>
									<flowline >
										<command class_type='decision' title='Decision' exp='.Number &lt; 65536' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.NumChars = 4' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.NumChars = 8' />
												</command>
											</flowline>
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='.NumChars &gt; 8' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.NumChars = 8' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='loop' title='Build list of characters to send' type='0' exp='.idx &lt; .NumChars' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.chars[.idx] = .Number % 16' />
									<exp exp='.Number = .Number &gt;&gt; 4' />
								</command>
								<command class_type='decision' title='Decision' exp='.chars[.idx] &gt;= 10' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.chars[.idx] = .chars[.idx] + &apos;A&apos; - 10' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.chars[.idx] = .chars[.idx] + &apos;0&apos;' />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.idx = .idx + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='loop' title='Send characters starting with most significant' type='0' exp='.idx &gt; 0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.idx = .idx - 1' />
								</command>
								<command class_type='call' title='Component Macro' textarea='63,-5,63,-5' component='cal_uart' macro='Send' >
									<argument exp='.chars[.idx]' />
								</command>
								<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashTx' />
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ReceiveHexNumber' description='Attempts to receive a hex number as ASCII characters and convert back into a numeric value. Note this function will receive until a timeout or a none hexadecimal char is received, the none numeric char will be lost.' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Timeout' type='u8' description='Max time in ms to wait in between bytes' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='IgnoreData' type='b1' description='0=Dont ignore any data, 1=Ignore any initial none numeric data' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Prefix' type='b1' description='Look for prefix before receiving, 1=0xFF, 0=FF' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='state' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='done' type='b1' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='char' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='decision' title='Decision' exp='.Prefix = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.state = 2' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.done = 0' >
							<flowline >
								<command class_type='call' title='Component Macro' component='cal_uart' macro='Receive' >
									<return exp='.char' />
									<argument exp='.Timeout' />
								</command>
								<command class_type='decision' title='Decision' exp='.char &gt;= 255' swap='0' >
									<flowline >
										<command class_type='calculation' title='Timeout - Return' >
											<exp exp='.done = 1' />
										</command>
									</flowline>
									<flowline >
										<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashRx' />
										<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='.state' >
											<case >
												<flowline >
													<command class_type='decision' title='Decision' exp='.char = &apos;0&apos;' swap='0' >
														<flowline >
															<command class_type='calculation' title='Calculation' >
																<exp exp='.state = .state + 1' />
															</command>
														</flowline>
														<flowline >
															<command class_type='decision' title='Decision' exp='.IgnoreData' swap='0' >
																<flowline />
																<flowline >
																	<command class_type='calculation' title='Not a valid char - return' >
																		<exp exp='.done = 1' />
																	</command>
																</flowline>
															</command>
														</flowline>
													</command>
												</flowline>
											</case>
											<case exp='1' >
												<flowline >
													<command class_type='decision' title='Decision' exp='.char = &apos;x&apos;' swap='0' >
														<flowline >
															<command class_type='calculation' title='Calculation' >
																<exp exp='.state = .state + 1' />
															</command>
														</flowline>
														<flowline >
															<command class_type='decision' title='Decision' exp='.char = &apos;0&apos;' swap='0' >
																<flowline />
																<flowline >
																	<command class_type='decision' title='Decision' exp='.IgnoreData' swap='0' >
																		<flowline >
																			<command class_type='calculation' title='Calculation' >
																				<exp exp='.state = .state + 1' />
																			</command>
																		</flowline>
																		<flowline >
																			<command class_type='calculation' title='Not a valid char - return' >
																				<exp exp='.done = 1' />
																			</command>
																		</flowline>
																	</command>
																</flowline>
															</command>
														</flowline>
													</command>
												</flowline>
											</case>
											<case exp='2' >
												<flowline >
													<command class_type='decision' title='Decision' exp='(.char &gt;= &apos;0&apos; &amp;&amp; .char &lt;= &apos;9&apos;) || (.char &gt;= &apos;A&apos; &amp;&amp; .char &lt;= &apos;F&apos;)' swap='0' >
														<flowline >
															<command class_type='decision' title='Decision' exp='.char &gt;= &apos;A&apos; &amp;&amp; .char &lt;= &apos;F&apos;' swap='0' >
																<flowline >
																	<command class_type='calculation' title='Calculation' >
																		<exp exp='.Return = .Return * 16' />
																		<exp exp='.Return = .Return + (.char - &apos;A&apos;) + 10' />
																	</command>
																</flowline>
																<flowline >
																	<command class_type='calculation' title='Calculation' >
																		<exp exp='.Return = .Return * 16' />
																		<exp exp='.Return = .Return + (.char - &apos;0&apos;)' />
																	</command>
																</flowline>
															</command>
														</flowline>
														<flowline >
															<command class_type='decision' title='Decision' exp='(.Prefix = 0) &amp;&amp; (.IgnoreData = 1)' swap='0' >
																<flowline />
																<flowline >
																	<command class_type='calculation' title='Not a valid char - return' >
																		<exp exp='.done = 1' />
																	</command>
																</flowline>
															</command>
														</flowline>
													</command>
												</flowline>
											</case>
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SendBinary32Bit' description='Sends out a 32-bit binary value split across four bytes.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
