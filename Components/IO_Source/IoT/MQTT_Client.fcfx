			<macros >
				<macro >
					<flowline name='GetTopic' description='Get the Topic of the last received (Read) packet.
Returns the number of bytes for the Topic' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Topic' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='Size' type='u8' description='Byte count the Topic buffer' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='x' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Len' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Len = RxTopicSize' />
						</command>
						<command class_type='decision' title='The return value is a byte, so cap it' exp='.Len &gt; 255' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Len = 255' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = .Len' />
							<exp exp='.x = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='(.x &lt; .Size) &amp;&amp; (.x &lt; .Return)' for1='' for3='' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Topic[.x] = Packet[RxHeaderSize + 2 + .x]' />
									<exp exp='.x = .x + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' exp='.x &lt; .Size' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Topic[.x] = 0' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ErrorAsString' description='' statediag='0' >
						<return name='Return' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='2000' />
						</return>
						<param name='Error' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = &quot;&quot;' />
						</command>
						<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='.Error' >
							<case >
								<flowline />
							</case>
							<case exp='ERROR_COULD_NOT_CONNECT_TO_HOST' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.Return = &quot;Could not connect to Host&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='ERROR_COULD_NOT_OPEN_SOCKET' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.Return = &quot;Could not open socket&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='ERROR_COULD_NOT_SEND_DATA' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.Return = &quot;Could not send data&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='ERROR_MQTT_CONNECT_FAILED' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.Return = &quot;MQTT connect failed&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='ERROR_NO_REPLY_DATA' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.Return = &quot;No reply data&quot;' />
									</command>
								</flowline>
							</case>
						</command>
						<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='.Error' >
							<case >
								<flowline />
							</case>
							<case exp='ERROR_MQTT_CLIENT_ID_NOT_ALLOWED' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.Return = &quot;MQTT Client identifier rejected&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='ERROR_MQTT_DATA_MALFORMED' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.Return = &quot;MQTT Bad user name or password&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='ERROR_MQTT_NOT_AUTHORIZED' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.Return = &quot;MQTT Client not authorized&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='ERROR_MQTT_SERVICE_UNAVAILABLE' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.Return = &quot;MQTT Server unavailable&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='ERROR_MQTT_WRONG_PROTOCOL' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.Return = &quot;MQTT unacceptable protocol version&quot;' />
									</command>
								</flowline>
							</case>
						</command>
						<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='.Error' >
							<case >
								<flowline />
							</case>
							<case exp='ERROR_NOT_CONNECTED' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.Return = &quot;Not connected&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='ERROR_MQTT_SUBSCRIBE_FAILED' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.Return = &quot;MQTT Subscribe Failed&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='ERROR_TOPIC_TOO_LARGE' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.Return = &quot;Topic String Too Long&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='ERROR_MQTT_ACK_TIMEOUT' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.Return = &quot;MQTT no acknowledgement from broker&quot;' />
									</command>
								</flowline>
							</case>
							<case exp='ERROR_PACKET_TOO_LARGE' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.Return = &quot;Packet larger than Max Packet Size&quot;' />
									</command>
								</flowline>
							</case>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='PublishByteArray' description='Publish a byte array payload to the server (broker)
Returns non-zero if successful.
At QoS 1 and QoS 2 this call also waits for the broker to acknowledge the message.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Topic' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='Payload' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='PayloadSize' type='u16' description='Number of bytes in the payload array' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='TopicSize' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='x' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='RemLen' type='u32' description='Remaining Length field of the PUBLISH packet' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Overhead' type='u16' description='Everything in the Remaining Length except the payload' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='MsgId' type='u16' description='Packet Identifier, only used at QoS 1 and QoS 2' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Hdr' type='u8' description='Fixed header size in bytes' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Pos' type='u16' description='Write position within Packet' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='SendSize' type='u16' description='Bytes actually handed to the network component' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
							<exp exp='.MsgId = 0' />
						</command>
						<command class_type='decision' title='Decision' exp='Connected' swap='0' >
							<flowline >
								<command class_type='comment' title='' comment='Send MQTT PUBLISH' textarea='12,0,12,0' />
								<command class_type='calculation' title='Calculation' >
									<exp exp='.TopicSize = Length$ (.Topic)' />
									<exp exp='.Overhead = 2 + .TopicSize // Topic length field plus the Topic itself' />
								</command>
								<command class_type='decision' title='QoS 1 and QoS 2 carry a Packet Identifier' exp='QoS &gt; 0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Overhead = .Overhead + 2' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.RemLen = .Overhead + .PayloadSize' />
								</command>
								<command class_type='call' title='How many bytes will the Remaining Length field need?' macro='Prv_VbiSize' >
									<return exp='.Hdr' />
									<argument exp='.RemLen' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Hdr = .Hdr + 1' />
								</command>
								<command class_type='decision' title='Does the whole packet fit in the buffer?' exp='(.Hdr + .RemLen) &gt; MaxPacketSize' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' exp='(.Hdr + .Overhead) &gt; MaxPacketSize' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Return = 0' />
													<exp exp='LastError = ERROR_TOPIC_TOO_LARGE' />
												</command>
												<command class_type='goto' title='Topic too large - all bets are off' labelid='0' labelname='' labeltype='0' />
											</flowline>
											<flowline >
												<command class_type='calculation' title='Truncate the payload to fit' >
													<exp exp='.PayloadSize = MaxPacketSize - .Hdr - .Overhead' />
													<exp exp='.RemLen = .Overhead + .PayloadSize' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Fixed header' >
									<exp exp='Packet[0] = 0x30 | (QoS &lt;&lt; 1) | RetainFlag // PUBLISH type packet' />
								</command>
								<command class_type='call' title='Encode the Remaining Length' macro='Prv_EncodeRemainingLength' >
									<return exp='.Hdr' />
									<argument exp='.RemLen' />
								</command>
								<command class_type='calculation' title='Variable header - Topic' >
									<exp exp='Packet[.Hdr] = .TopicSize &gt;&gt; 8 // Topic length MSB' />
									<exp exp='Packet[.Hdr + 1] = .TopicSize // Topic length LSB' />
									<exp exp='.Pos = .Hdr + 2' />
									<exp exp='.x = 0' />
								</command>
								<command class_type='loop' title='Copy the Topic to the Packet' type='0' exp='.x &lt; .TopicSize' for1='' for3='' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='Packet[.Pos] = .Topic[.x]' />
											<exp exp='.Pos = .Pos + 1' />
											<exp exp='.x = .x + 1' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Insert the Packet Identifier for QoS 1 and QoS 2' exp='QoS &gt; 0' swap='0' >
									<flowline >
										<command class_type='call' title='Call Macro' macro='Prv_NextPacketId' >
											<return exp='.MsgId' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='Packet[.Pos] = .MsgId &gt;&gt; 8 // Packet Identifier MSB' />
											<exp exp='Packet[.Pos + 1] = .MsgId // Packet Identifier LSB' />
											<exp exp='.Pos = .Pos + 2' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.x = 0' />
								</command>
								<command class_type='loop' title='Copy the Payload to the Packet' type='0' exp='.x &lt; .PayloadSize' for1='' for3='' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='Packet[.Pos] = .Payload[.x]' />
											<exp exp='.Pos = .Pos + 1' />
											<exp exp='.x = .x + 1' />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='PacketSize = .Pos' />
								</command>
								<command class_type='call' title='Call Macro' macro='PacketTransfer' >
									<return exp='.SendSize' />
									<argument exp='0' />
								</command>
								<command class_type='decision' title='Did the packet go out?' exp='.SendSize &gt; 0' swap='0' >
									<flowline >
										<command class_type='decision' title='QoS 1 and QoS 2 must be acknowledged before we call it a success' exp='QoS &gt; 0' swap='0' >
											<flowline >
												<command class_type='call' title='Call Macro' macro='Prv_CompletePublish' >
													<return exp='.Return' />
													<argument exp='.MsgId' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Return = 1' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
								</command>
								<command class_type='label' title='Declare Connection Point' labelid='0' labelname='A' labeltype='4' />
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
									<exp exp='LastError = ERROR_NOT_CONNECTED' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Prv_WaitForAck' description='Waits for an acknowledgement of the given type carrying the given Packet Identifier.
Unrelated packets arriving while we wait are discarded.
Returns non-zero if the acknowledgement was seen.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='AckType' type='u8' description='Expected packet type in the high nibble, e.g. 0x40 for PUBACK' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Id' type='u16' description='Packet Identifier being waited for' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Attempts' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='MaxAttempts' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Size' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='RxId' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
							<exp exp='.Attempts = 0' />
							<exp exp='.MaxAttempts = ACK_RETRIES' />
						</command>
						<command class_type='decision' title='A retry count below one would never read anything' exp='.MaxAttempts &lt; 1' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.MaxAttempts = 1' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='loop' title='Read packets until the acknowledgement turns up or we give up' type='0' exp='(.Attempts &lt; .MaxAttempts) &amp;&amp; (.Return = 0)' for1='' for3='' >
							<flowline >
								<command class_type='call' title='Call Component Macro' component='NetworkCommsDummy' macro='Receive' >
									<return exp='.Size' />
									<argument exp='Packet' />
									<argument exp='MaxPacketSize' />
									<argument exp='ACK_TIMEOUT' />
								</command>
								<command class_type='decision' title='Decision' exp='.Size &gt;= 4' swap='0' >
									<flowline >
										<command class_type='sim' title='Call Component Macro' component='LibraryComponent1' macro='FlashRx' />
										<command class_type='decision' title='Right packet type?' exp='(Packet[0] &amp; 0xF0) = (.AckType &amp; 0xF0)' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.RxId = (Packet[2] &lt;&lt; 8) | Packet[3]' />
												</command>
												<command class_type='decision' title='Right Packet Identifier?' exp='.RxId = .Id' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='.Return = 1' />
														</command>
													</flowline>
													<flowline />
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Attempts = .Attempts + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' exp='.Return = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='LastError = ERROR_MQTT_ACK_TIMEOUT' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Prv_CompletePublish' description='Runs the outbound acknowledgement handshake for a PUBLISH that has just been sent.
QoS 1 waits for PUBACK. QoS 2 waits for PUBREC, sends PUBREL and waits for PUBCOMP.
Returns non-zero if the message was fully acknowledged.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='MsgId' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Dummy' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='decision' title='QoS 1?' exp='QoS = 1' swap='0' >
							<flowline >
								<command class_type='call' title='Wait for PUBACK' macro='Prv_WaitForAck' >
									<return exp='.Return' />
									<argument exp='0x40' />
									<argument exp='.MsgId' />
								</command>
							</flowline>
							<flowline >
								<command class_type='call' title='Wait for PUBREC' macro='Prv_WaitForAck' >
									<return exp='.Return' />
									<argument exp='0x50' />
									<argument exp='.MsgId' />
								</command>
								<command class_type='decision' title='Decision' exp='.Return' swap='0' >
									<flowline >
										<command class_type='call' title='Send PUBREL' macro='Prv_SendAck' >
											<return exp='.Dummy' />
											<argument exp='0x62' />
											<argument exp='.MsgId' />
										</command>
										<command class_type='call' title='Wait for PUBCOMP' macro='Prv_WaitForAck' >
											<return exp='.Return' />
											<argument exp='0x70' />
											<argument exp='.MsgId' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='GetDup' description='Returns non-zero if the last received (Read) packet was flagged by the broker as a
redelivery of a message it has already sent. Useful for spotting duplicates at QoS 2.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = RxDup' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Connect' description='Connect to the MQTT Server using the Host, Port and Client identifier properties.
Returns the connected state.
0 if not connected, 1 if successful connection, or already connected.
' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='ClientID' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='32' />
						</local>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.ClientID = CLIENT' />
						</command>
						<command class_type='call' title='Call Macro' macro='Prv_DoConnect' >
							<return exp='.Return' />
							<argument exp='HOST' />
							<argument exp='PORT' />
							<argument exp='.ClientID' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Initialise' description='Initialisation routine for the component once the component is linked to its parent' statediag='0' >
						<return name='Return' type='u32' description='Non-zero to prevent initialisation' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='TempStr' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<command class_type='sim' title='Simulation' macro='File.AbsPath' >
							<return exp='.TempStr' />
							<argument exp='&quot;this:IoT.png&quot;' />
							<argument exp='this' />
						</command>
						<command class_type='call' title='Call Macro' macro='Ev_Property' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='Connected = 0' />
							<exp exp='LastError = 0' />
							<exp exp='PacketSize = 0' />
							<exp exp='PacketId = 0' />
							<exp exp='RxHeaderSize = 2' />
							<exp exp='RxRemainingLength = 0' />
							<exp exp='RxQoS = 0' />
							<exp exp='RxMessageId = 0' />
							<exp exp='RxTopicSize = 0' />
							<exp exp='RxPayloadOffset = 0' />
							<exp exp='RxPayloadSize = 0' />
							<exp exp='RetainFlag = RETAIN' />
							<exp exp='RxRetain = 0' />
							<exp exp='RxDup = 0' />
							<exp exp='SubGrantedQoS = 0' />
							<exp exp='SessionPresent = 0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Publish' description='Publish a string payload to the server (broker)
Returns non-zero if successful.
At QoS 1 and QoS 2 this call also waits for the broker to acknowledge the message.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Topic' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='Payload' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<local name='PayloadSize' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='TopicSize' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='x' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='RemLen' type='u32' description='Remaining Length field of the PUBLISH packet' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Overhead' type='u16' description='Everything in the Remaining Length except the payload' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='MsgId' type='u16' description='Packet Identifier, only used at QoS 1 and QoS 2' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Hdr' type='u8' description='Fixed header size in bytes' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Pos' type='u16' description='Write position within Packet' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='SendSize' type='u16' description='Bytes actually handed to the network component' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
							<exp exp='.MsgId = 0' />
						</command>
						<command class_type='decision' title='Decision' exp='Connected' swap='0' >
							<flowline >
								<command class_type='comment' title='' comment='Send MQTT PUBLISH' textarea='12,0,12,0' />
								<command class_type='calculation' title='Calculation' >
									<exp exp='.TopicSize = Length$ (.Topic)' />
									<exp exp='.PayloadSize = Length$ (.Payload)' />
									<exp exp='.Overhead = 2 + .TopicSize // Topic length field plus the Topic itself' />
								</command>
								<command class_type='decision' title='QoS 1 and QoS 2 carry a Packet Identifier' exp='QoS &gt; 0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Overhead = .Overhead + 2' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.RemLen = .Overhead + .PayloadSize' />
								</command>
								<command class_type='call' title='How many bytes will the Remaining Length field need?' macro='Prv_VbiSize' >
									<return exp='.Hdr' />
									<argument exp='.RemLen' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Hdr = .Hdr + 1' />
								</command>
								<command class_type='decision' title='Does the whole packet fit in the buffer?' exp='(.Hdr + .RemLen) &gt; MaxPacketSize' swap='0' >
									<flowline >
										<command class_type='decision' title='Decision' exp='(.Hdr + .Overhead) &gt; MaxPacketSize' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Return = 0' />
													<exp exp='LastError = ERROR_TOPIC_TOO_LARGE' />
												</command>
												<command class_type='goto' title='Topic too large - all bets are off' labelid='0' labelname='' labeltype='0' />
											</flowline>
											<flowline >
												<command class_type='calculation' title='Truncate the payload to fit' >
													<exp exp='.PayloadSize = MaxPacketSize - .Hdr - .Overhead' />
													<exp exp='.RemLen = .Overhead + .PayloadSize' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Fixed header' >
									<exp exp='Packet[0] = 0x30 | (QoS &lt;&lt; 1) | RetainFlag // PUBLISH type packet' />
								</command>
								<command class_type='call' title='Encode the Remaining Length' macro='Prv_EncodeRemainingLength' >
									<return exp='.Hdr' />
									<argument exp='.RemLen' />
								</command>
								<command class_type='calculation' title='Variable header - Topic' >
									<exp exp='Packet[.Hdr] = .TopicSize &gt;&gt; 8 // Topic length MSB' />
									<exp exp='Packet[.Hdr + 1] = .TopicSize // Topic length LSB' />
									<exp exp='.Pos = .Hdr + 2' />
									<exp exp='.x = 0' />
								</command>
								<command class_type='loop' title='Copy the Topic to the Packet' type='0' exp='.x &lt; .TopicSize' for1='' for3='' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='Packet[.Pos] = .Topic[.x]' />
											<exp exp='.Pos = .Pos + 1' />
											<exp exp='.x = .x + 1' />
										</command>
									</flowline>
								</command>
								<command class_type='decision' title='Insert the Packet Identifier for QoS 1 and QoS 2' exp='QoS &gt; 0' swap='0' >
									<flowline >
										<command class_type='call' title='Call Macro' macro='Prv_NextPacketId' >
											<return exp='.MsgId' />
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='Packet[.Pos] = .MsgId &gt;&gt; 8 // Packet Identifier MSB' />
											<exp exp='Packet[.Pos + 1] = .MsgId // Packet Identifier LSB' />
											<exp exp='.Pos = .Pos + 2' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.x = 0' />
								</command>
								<command class_type='loop' title='Copy the Payload to the Packet' type='0' exp='.x &lt; .PayloadSize' for1='' for3='' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='Packet[.Pos] = .Payload[.x]' />
											<exp exp='.Pos = .Pos + 1' />
											<exp exp='.x = .x + 1' />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='PacketSize = .Pos' />
								</command>
								<command class_type='call' title='Call Macro' macro='PacketTransfer' >
									<return exp='.SendSize' />
									<argument exp='0' />
								</command>
								<command class_type='decision' title='Did the packet go out?' exp='.SendSize &gt; 0' swap='0' >
									<flowline >
										<command class_type='decision' title='QoS 1 and QoS 2 must be acknowledged before we call it a success' exp='QoS &gt; 0' swap='0' >
											<flowline >
												<command class_type='call' title='Call Macro' macro='Prv_CompletePublish' >
													<return exp='.Return' />
													<argument exp='.MsgId' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Return = 1' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return = 0' />
										</command>
									</flowline>
								</command>
								<command class_type='label' title='Declare Connection Point' labelid='0' labelname='A' labeltype='4' />
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 0' />
									<exp exp='LastError = ERROR_NOT_CONNECTED' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='PublishRetain' description='As Publish, but the Retain flag is given per message instead of
coming from the Retain property.

A retained message is kept by the broker and handed to any client that subscribes to the
Topic later. Publishing an empty retained payload clears a previously retained message.
Returns non-zero if successful.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Topic' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='Payload' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='Retain' type='u8' description='Non-zero to ask the broker to retain this message' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='SaveRetain' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Remember the instance default' >
							<exp exp='.SaveRetain = RetainFlag' />
						</command>
						<command class_type='decision' title='Normalise the flag to 0 or 1' exp='.Retain' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='RetainFlag = 1' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='RetainFlag = 0' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Call Macro' macro='Publish' >
							<return exp='.Return' />
							<argument exp='.Topic' />
							<argument exp='.Payload' />
						</command>
						<command class_type='calculation' title='Put the instance default back' >
							<exp exp='RetainFlag = .SaveRetain' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='LastError' description='Returns the last error' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = LastError' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Read' description='Read incoming data.
Returns non-zero if a PUBLISH packet was received.
Use GetTopic and GetPayload to read the contents.

Incoming QoS 1 messages are acknowledged with a PUBACK automatically.
Incoming QoS 2 messages are acknowledged with a PUBREC, and the matching PUBREL is
answered with a PUBCOMP on a later call to Read. The message itself is handed to the
caller as soon as it arrives, so a redelivered message may be seen twice.' statediag='0' >
						<return name='Return' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Size' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Type' type='u8' description='Packet type held in the high nibble of the first header byte' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Pos' type='u16' description='Read position within Packet' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='RxLen' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='RxId' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Dummy' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='call' title='Call Component Macro' component='NetworkCommsDummy' macro='Receive' >
							<return exp='.Size' />
							<argument exp='Packet' />
							<argument exp='MaxPacketSize' />
							<argument exp='ReadTimeout' />
						</command>
						<command class_type='decision' title='Decision' exp='.Size &gt; 1' swap='0' >
							<flowline >
								<command class_type='sim' title='Call Component Macro' component='LibraryComponent1' macro='FlashRx' />
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Type = Packet[0] &amp; 0xF0 // Mask off the DUP, QoS and RETAIN flags' />
								</command>
								<command class_type='call' title='Decode the Remaining Length' macro='Prv_DecodeRemainingLength' >
									<return exp='.RxLen' />
								</command>
								<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='.Type' >
									<case >
										<flowline >
											<command class_type='comment' title='' comment='Not a packet this macro reports to the caller' textarea='12,0,12,0' />
										</flowline>
									</case>
									<case exp='48' >
										<flowline >
											<command class_type='comment' title='' comment='PUBLISH (0x30)' textarea='12,0,12,0' />
											<command class_type='calculation' title='Calculation' >
												<exp exp='RxQoS = (Packet[0] &gt;&gt; 1) &amp; 0x03' />
												<exp exp='RxRetain = Packet[0] &amp; 0x01' />
												<exp exp='RxDup = (Packet[0] &gt;&gt; 3) &amp; 0x01' />
												<exp exp='RxTopicSize = (Packet[RxHeaderSize] &lt;&lt; 8) | Packet[RxHeaderSize + 1]' />
												<exp exp='RxMessageId = 0' />
												<exp exp='.Pos = RxHeaderSize + 2 + RxTopicSize' />
											</command>
											<command class_type='decision' title='QoS 1 and QoS 2 carry a Packet Identifier' exp='RxQoS &gt; 0' swap='0' >
												<flowline >
													<command class_type='calculation' title='Calculation' >
														<exp exp='RxMessageId = (Packet[.Pos] &lt;&lt; 8) | Packet[.Pos + 1]' />
														<exp exp='.Pos = .Pos + 2' />
													</command>
												</flowline>
												<flowline />
											</command>
											<command class_type='calculation' title='Calculation' >
												<exp exp='RxPayloadOffset = .Pos' />
												<exp exp='RxPayloadSize = RxRemainingLength - (.Pos - RxHeaderSize)' />
												<exp exp='.Return = .Size' />
											</command>
											<command class_type='decision' title='Clamp the payload to what actually arrived' exp='(RxPayloadOffset + RxPayloadSize) &gt; .Size' swap='0' >
												<flowline >
													<command class_type='decision' title='Decision' exp='.Size &gt; RxPayloadOffset' swap='0' >
														<flowline >
															<command class_type='calculation' title='Calculation' >
																<exp exp='RxPayloadSize = .Size - RxPayloadOffset' />
															</command>
														</flowline>
														<flowline >
															<command class_type='calculation' title='Calculation' >
																<exp exp='RxPayloadSize = 0' />
															</command>
														</flowline>
													</command>
												</flowline>
												<flowline />
											</command>
											<command class_type='decision' title='Acknowledge a QoS 1 message' exp='RxQoS = 1' swap='0' >
												<flowline >
													<command class_type='call' title='Send PUBACK' macro='Prv_SendAck' >
														<return exp='.Dummy' />
														<argument exp='0x40' />
														<argument exp='RxMessageId' />
													</command>
												</flowline>
												<flowline />
											</command>
											<command class_type='decision' title='Acknowledge a QoS 2 message' exp='RxQoS = 2' swap='0' >
												<flowline >
													<command class_type='call' title='Send PUBREC' macro='Prv_SendAck' >
														<return exp='.Dummy' />
														<argument exp='0x50' />
														<argument exp='RxMessageId' />
													</command>
												</flowline>
												<flowline />
											</command>
										</flowline>
									</case>
									<case exp='96' >
										<flowline >
											<command class_type='comment' title='' comment='PUBREL (0x60) - the broker is finishing an inbound QoS 2 exchange' textarea='12,0,12,0' />
											<command class_type='calculation' title='Calculation' >
												<exp exp='.RxId = (Packet[RxHeaderSize] &lt;&lt; 8) | Packet[RxHeaderSize + 1]' />
											</command>
											<command class_type='call' title='Send PUBCOMP' macro='Prv_SendAck' >
												<return exp='.Dummy' />
												<argument exp='0x70' />
												<argument exp='.RxId' />
											</command>
										</flowline>
									</case>
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='GetRetain' description='Returns non-zero if the last received (Read) packet was a retained message
replayed by the broker, rather than a live publication.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = RxRetain' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Disconnect' description='Disconnects from the MQTT server and the network' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='SendSize' type='u16' description='Bytes actually handed to the network component' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='decision' title='Decision' exp='Connected' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='Packet[0] = 0xE0 // DISCONNECT type packet' />
									<exp exp='Packet[1] = 0 // Remaining Length' />
									<exp exp='PacketSize = 2' />
								</command>
								<command class_type='call' title='Call Macro' macro='PacketTransfer' >
									<return exp='.SendSize' />
									<argument exp='0' />
								</command>
								<command class_type='decision' title='Decision' exp='.SendSize &gt; 0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Packet sent OK' >
											<exp exp='.Return = 1' />
										</command>
									</flowline>
									<flowline />
								</command>
								<command class_type='call' title='Call Component Macro' component='NetworkCommsDummy' macro='SocketClose' />
								<command class_type='calculation' title='' >
									<exp exp='Connected = 0' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Prv_VbiSize' description='Returns the number of bytes needed to hold Length as an MQTT Variable Byte Integer (1 to 4)' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Length' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 1' />
						</command>
						<command class_type='decision' title='Decision' exp='.Length &gt; 127' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 2' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='.Length &gt; 16383' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 3' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='.Length &gt; 2097151' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Return = 4' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Prv_NextPacketId' description='Returns the next outgoing Packet Identifier.
Wraps from 65535 back to 1 - zero is not a legal Packet Identifier.' statediag='0' >
						<return name='Return' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='PacketId = PacketId + 1' />
						</command>
						<command class_type='decision' title='Skip the reserved value zero' exp='PacketId = 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='PacketId = 1' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = PacketId' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='PublishByteArrayRetain' description='As PublishByteArray, but the Retain flag is given per message instead of
coming from the Retain property.

A retained message is kept by the broker and handed to any client that subscribes to the
Topic later. Publishing an empty retained payload clears a previously retained message.
Returns non-zero if successful.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Topic' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='Payload' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='PayloadSize' type='u16' description='Number of bytes in the payload array' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Retain' type='u8' description='Non-zero to ask the broker to retain this message' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='SaveRetain' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Remember the instance default' >
							<exp exp='.SaveRetain = RetainFlag' />
						</command>
						<command class_type='decision' title='Normalise the flag to 0 or 1' exp='.Retain' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='RetainFlag = 1' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='RetainFlag = 0' />
								</command>
							</flowline>
						</command>
						<command class_type='call' title='Call Macro' macro='PublishByteArray' >
							<return exp='.Return' />
							<argument exp='.Topic' />
							<argument exp='.Payload' />
							<argument exp='.PayloadSize' />
						</command>
						<command class_type='calculation' title='Put the instance default back' >
							<exp exp='RetainFlag = .SaveRetain' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Prv_DoConnect' description='Shared implementation behind Connect and ConnectTo.
Opens the socket, builds and sends a MQTT CONNECT packet and interprets the CONNACK.
Returns the connected state.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Host' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='Port' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ClientID' type='T8*' description='Client identifier name - must be unique on server' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<local name='ClientLength' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='x' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='ReplySize' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='AuthName' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='32' />
						</local>
						<local name='AuthNameLength' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='AuthPassword' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='32' />
						</local>
						<local name='AuthPasswordLength' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='WillTopic' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='32' />
						</local>
						<local name='WillTopicLength' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='WillMessage' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='64' />
						</local>
						<local name='WillMessageLength' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='RemLen' type='u32' description='Remaining Length field of the CONNECT packet' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Flags' type='u8' description='CONNECT flags byte' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Hdr' type='u8' description='Fixed header size in bytes' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='Decision' exp='Connected' swap='0' >
							<flowline />
							<flowline >
								<command class_type='call' title='Call Component Macro' component='NetworkCommsDummy' macro='SocketOpen' >
									<return exp='.Return' />
								</command>
								<command class_type='decision' title='Decision' exp='.Return' swap='0' >
									<flowline >
										<command class_type='call' title='Call Component Macro' component='NetworkCommsDummy' macro='Connect' >
											<return exp='.Return' />
											<argument exp='.Host' />
											<argument exp='.Port' />
										</command>
										<command class_type='decision' title='Decision' exp='.Return' swap='0' >
											<flowline >
												<command class_type='comment' title='' comment='Send MQTT CONNECT' textarea='12,0,12,0' />
												<command class_type='calculation' title='Work out the payload lengths before building anything' >
													<exp exp='.ClientLength = Length$ (.ClientID)' />
													<exp exp='.AuthNameLength = 0' />
													<exp exp='.AuthPasswordLength = 0' />
													<exp exp='.WillTopicLength = 0' />
													<exp exp='.WillMessageLength = 0' />
													<exp exp='.Flags = 0 // Connect Flags, built up from the settings below' />
													<exp exp='SessionPresent = 0' />
													<exp exp='.RemLen = 10 + 2 + .ClientLength // Variable header plus the Client Identifier' />
												</command>
												<command class_type='decision' title='A zero length Client identifier cannot resume a session, so force a clean one' exp='(CLEAN_START) || (.ClientLength = 0)' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='.Flags = .Flags | 0x02 // Connect Flags: Clean Session / Clean Start' />
														</command>
													</flowline>
													<flowline />
												</command>
												<command class_type='decision' title='' exp='WILL_ENABLE' swap='1' >
													<flowline />
													<flowline >
														<command class_type='calculation' title='Measure the Will fields and set the Will flags' >
															<exp exp='.WillTopic = WILL_TOPIC' />
															<exp exp='.WillTopicLength = Length$ (.WillTopic)' />
															<exp exp='.WillMessage = WILL_MESSAGE' />
															<exp exp='.WillMessageLength = Length$ (.WillMessage)' />
															<exp exp='.Flags = .Flags | 0x04 | (WILL_QOS &lt;&lt; 3) // Connect Flags: Will Flag and Will QoS' />
															<exp exp='.RemLen = .RemLen + 4 + .WillTopicLength + .WillMessageLength' />
														</command>
														<command class_type='decision' title='' exp='WILL_RETAIN' swap='1' >
															<flowline />
															<flowline >
																<command class_type='calculation' title='Calculation' >
																	<exp exp='.Flags = .Flags | 0x20 // Connect Flags: Will Retain' />
																</command>
															</flowline>
														</command>
													</flowline>
												</command>
												<command class_type='decision' title='' exp='AUTHENTICATION' swap='1' >
													<flowline />
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='.AuthName = NAME' />
															<exp exp='.AuthNameLength = Length$ (.AuthName)' />
															<exp exp='.AuthPassword = PASSWORD' />
															<exp exp='.AuthPasswordLength = Length$ (.AuthPassword)' />
															<exp exp='.Flags = .Flags | 0xC0 // Connect Flags: add User Name and Password' />
															<exp exp='.RemLen = .RemLen + 4 + .AuthNameLength + .AuthPasswordLength' />
														</command>
													</flowline>
												</command>
												<command class_type='call' title='How many bytes will the Remaining Length field need?' macro='Prv_VbiSize' >
													<return exp='.Hdr' />
													<argument exp='.RemLen' />
												</command>
												<command class_type='calculation' title='Calculation' >
													<exp exp='.Hdr = .Hdr + 1' />
												</command>
												<command class_type='decision' title='Will the CONNECT packet fit in the buffer?' exp='(.Hdr + .RemLen) &gt; MaxPacketSize' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='LastError = ERROR_PACKET_TOO_LARGE' />
														</command>
														<command class_type='call' title='Call Component Macro' component='NetworkCommsDummy' macro='SocketClose' />
													</flowline>
													<flowline >
														<command class_type='calculation' title='Fixed header' >
															<exp exp='Packet[0] = 0x10 // CONNECT type packet' />
														</command>
														<command class_type='call' title='Encode the Remaining Length' macro='Prv_EncodeRemainingLength' >
															<return exp='.Hdr' />
															<argument exp='.RemLen' />
														</command>
														<command class_type='calculation' title='Variable header' >
															<exp exp='PacketSize = .Hdr' />
															<exp exp='Packet[PacketSize] = 0 // Protocol Name length MSB' />
															<exp exp='Packet[PacketSize + 1] = 4 // Protocol Name length LSB' />
															<exp exp='Packet[PacketSize + 2] = &apos;M&apos;' />
															<exp exp='Packet[PacketSize + 3] = &apos;Q&apos;' />
															<exp exp='Packet[PacketSize + 4] = &apos;T&apos;' />
															<exp exp='Packet[PacketSize + 5] = &apos;T&apos;' />
															<exp exp='Packet[PacketSize + 6] = 4 // Protocol level 4 = MQTT 3.1.1' />
															<exp exp='Packet[PacketSize + 7] = .Flags' />
															<exp exp='Packet[PacketSize + 8] = KEEP_ALIVE &gt;&gt; 8 // Keep Alive time MSB' />
															<exp exp='Packet[PacketSize + 9] = KEEP_ALIVE // Keep Alive time LSB' />
															<exp exp='PacketSize = PacketSize + 10' />
														</command>
														<command class_type='comment' title='' comment='Get the payload fields' textarea='12,0,12,0' />
														<command class_type='comment' title='' comment='Insert the Client ID' textarea='12,0,12,0' />
														<command class_type='calculation' title='Calculation' >
															<exp exp='Packet[PacketSize] = .ClientLength &gt;&gt; 8 // item length MSB' />
															<exp exp='PacketSize = PacketSize + 1' />
															<exp exp='Packet[PacketSize] = .ClientLength // item length LSB' />
															<exp exp='PacketSize = PacketSize + 1' />
															<exp exp='.x = 0' />
														</command>
														<command class_type='loop' title='Copy the Client Identifier to the payload' type='0' exp='.x &lt; .ClientLength' for1='' for3='' >
															<flowline >
																<command class_type='calculation' title='Calculation' >
																	<exp exp='Packet[PacketSize] = .ClientID[.x]' />
																	<exp exp='PacketSize = PacketSize + 1' />
																	<exp exp='.x = .x + 1' />
																</command>
															</flowline>
														</command>
														<command class_type='comment' title='' comment='The Will Topic and Will Message go after the Client Identifier and before the credentials' textarea='12,0,12,0' />
														<command class_type='decision' title='' exp='WILL_ENABLE' swap='1' >
															<flowline />
															<flowline >
																<command class_type='calculation' title='Insert the Will Topic' >
																	<exp exp='Packet[PacketSize] = .WillTopicLength &gt;&gt; 8 // item length MSB' />
																	<exp exp='PacketSize = PacketSize + 1' />
																	<exp exp='Packet[PacketSize] = .WillTopicLength // item length LSB' />
																	<exp exp='PacketSize = PacketSize + 1' />
																	<exp exp='.x = 0' />
																</command>
																<command class_type='loop' title='' type='0' exp='.x &lt; .WillTopicLength' for1='' for3='' >
																	<flowline >
																		<command class_type='calculation' title='Calculation' >
																			<exp exp='Packet[PacketSize] = .WillTopic[.x]' />
																			<exp exp='PacketSize = PacketSize + 1' />
																			<exp exp='.x = .x + 1' />
																		</command>
																	</flowline>
																</command>
																<command class_type='calculation' title='Insert the Will Message' >
																	<exp exp='Packet[PacketSize] = .WillMessageLength &gt;&gt; 8 // item length MSB' />
																	<exp exp='PacketSize = PacketSize + 1' />
																	<exp exp='Packet[PacketSize] = .WillMessageLength // item length LSB' />
																	<exp exp='PacketSize = PacketSize + 1' />
																	<exp exp='.x = 0' />
																</command>
																<command class_type='loop' title='' type='0' exp='.x &lt; .WillMessageLength' for1='' for3='' >
																	<flowline >
																		<command class_type='calculation' title='Calculation' >
																			<exp exp='Packet[PacketSize] = .WillMessage[.x]' />
																			<exp exp='PacketSize = PacketSize + 1' />
																			<exp exp='.x = .x + 1' />
																		</command>
																	</flowline>
																</command>
															</flowline>
														</command>
														<command class_type='decision' title='' exp='AUTHENTICATION' swap='1' >
															<flowline />
															<flowline >
																<command class_type='comment' title='' comment='Insert the Authorisation Name' textarea='12,0,12,0' />
																<command class_type='calculation' title='Calculation' >
																	<exp exp='Packet[PacketSize] = .AuthNameLength &gt;&gt; 8 // item length MSB' />
																	<exp exp='PacketSize = PacketSize + 1' />
																	<exp exp='Packet[PacketSize] = .AuthNameLength // item length LSB' />
																	<exp exp='PacketSize = PacketSize + 1' />
																	<exp exp='.x = 0' />
																</command>
																<command class_type='loop' title='' type='0' exp='.x &lt; .AuthNameLength' for1='' for3='' >
																	<flowline >
																		<command class_type='calculation' title='Calculation' >
																			<exp exp='Packet[PacketSize] = .AuthName[.x]' />
																			<exp exp='PacketSize = PacketSize + 1' />
																			<exp exp='.x = .x + 1' />
																		</command>
																	</flowline>
																</command>
																<command class_type='comment' title='' comment='Insert the Authorisation Password' textarea='12,0,12,0' />
																<command class_type='calculation' title='Calculation' >
																	<exp exp='Packet[PacketSize] = .AuthPasswordLength &gt;&gt; 8 // item length MSB' />
																	<exp exp='PacketSize = PacketSize + 1' />
																	<exp exp='Packet[PacketSize] = .AuthPasswordLength // item length LSB' />
																	<exp exp='PacketSize = PacketSize + 1' />
																	<exp exp='.x = 0' />
																</command>
																<command class_type='loop' title='' type='0' exp='.x &lt; .AuthPasswordLength' for1='' for3='' >
																	<flowline >
																		<command class_type='calculation' title='Calculation' >
																			<exp exp='Packet[PacketSize] = .AuthPassword[.x]' />
																			<exp exp='PacketSize = PacketSize + 1' />
																			<exp exp='.x = .x + 1' />
																		</command>
																	</flowline>
																</command>
															</flowline>
														</command>
														<command class_type='call' title='Call Macro' macro='PacketTransfer' >
															<return exp='.ReplySize' />
															<argument exp='1' />
														</command>
														<command class_type='decision' title='Decision' exp='.ReplySize &gt; 0' swap='0' >
															<flowline >
																<command class_type='comment' title='' comment='Check the response' textarea='12,0,12,0' />
																<command class_type='decision' title='Decision' exp='Packet[0] = 0x20' swap='0' >
																	<flowline >
																		<command class_type='comment' title='' comment='Got CONNACK Packet' textarea='12,0,12,0' />
																		<command class_type='switch' title='Switch' textarea='36,25,36,25' exp='Packet[3]' >
																			<case >
																				<flowline >
																					<command class_type='calculation' title='Unknown return code' >
																						<exp exp='LastError = ERROR_MQTT_CONNECT_FAILED' />
																					</command>
																				</flowline>
																			</case>
																			<case exp='0' >
																				<flowline >
																					<command class_type='calculation' title='Connection Accepted' >
																						<exp exp='Connected = 1' />
																						<exp exp='SessionPresent = Packet[2] &amp; 0x01 // Connect Acknowledge Flags: did the broker resume our session?' />
																					</command>
																					<command class_type='decision' title='Only restart the Packet Identifier sequence for a brand new session' exp='SessionPresent' swap='0' >
																						<flowline />
																						<flowline >
																							<command class_type='calculation' title='Calculation' >
																								<exp exp='PacketId = 0' />
																							</command>
																						</flowline>
																					</command>
																				</flowline>
																			</case>
																			<case exp='1' >
																				<flowline >
																					<command class_type='calculation' title='MQTT protocol not supported' >
																						<exp exp='LastError = ERROR_MQTT_WRONG_PROTOCOL' />
																					</command>
																				</flowline>
																			</case>
																			<case exp='2' >
																				<flowline >
																					<command class_type='calculation' title='The Client identifier is not allowed' >
																						<exp exp='LastError = ERROR_MQTT_CLIENT_ID_NOT_ALLOWED' />
																					</command>
																				</flowline>
																			</case>
																			<case exp='3' >
																				<flowline >
																					<command class_type='calculation' title='MQTT service is unavailable' >
																						<exp exp='LastError = ERROR_MQTT_SERVICE_UNAVAILABLE' />
																					</command>
																				</flowline>
																			</case>
																			<case exp='4' >
																				<flowline >
																					<command class_type='calculation' title='The data in the user name or password is malformed' >
																						<exp exp='LastError = ERROR_MQTT_DATA_MALFORMED' />
																					</command>
																				</flowline>
																			</case>
																			<case exp='5' >
																				<flowline >
																					<command class_type='calculation' title='The Client is not authorized to connect' >
																						<exp exp='LastError = ERROR_MQTT_NOT_AUTHORIZED' />
																					</command>
																				</flowline>
																			</case>
																		</command>
																	</flowline>
																	<flowline >
																		<command class_type='calculation' title='Calculation' >
																			<exp exp='LastError = ERROR_MQTT_CONNECT_FAILED' />
																		</command>
																	</flowline>
																</command>
															</flowline>
															<flowline >
																<command class_type='calculation' title='JUST FOR TEST' disable='1' >
																	<exp exp='Connected = 1' />
																</command>
															</flowline>
														</command>
													</flowline>
												</command>
											</flowline>
											<flowline >
												<command class_type='call' title='Call Component Macro' component='NetworkCommsDummy' macro='SocketClose' />
												<command class_type='calculation' title='Calculation' >
													<exp exp='LastError = ERROR_COULD_NOT_CONNECT_TO_HOST' />
												</command>
											</flowline>
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='LastError = ERROR_COULD_NOT_OPEN_SOCKET' />
										</command>
									</flowline>
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = Connected' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Property' description='Sent when a property has been changed by the User' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Handle' type='h32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='GetLinkHandle' >
							<return exp='.Handle' />
							<argument exp='1' />
						</command>
						<command class_type='decision' title='Decision' exp='.Handle' swap='0' >
							<flowline >
								<command class_type='sim' title='Simulation' macro='System.RedirectMacros' >
									<argument exp='NetworkCommsDummy' />
									<argument exp='.Handle' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='AUTHENTICATION' swap='0' >
							<flowline >
								<command class_type='sim' title='Simulation' macro='Component.Property.SetVisible' >
									<argument exp='this' />
									<argument exp='&quot;NAME&quot;' />
									<argument exp='1' />
								</command>
								<command class_type='sim' title='Simulation' macro='Component.Property.SetVisible' >
									<argument exp='this' />
									<argument exp='&quot;PASSWORD&quot;' />
									<argument exp='1' />
								</command>
							</flowline>
							<flowline >
								<command class_type='sim' title='Simulation' macro='Component.Property.SetVisible' >
									<argument exp='this' />
									<argument exp='&quot;NAME&quot;' />
									<argument exp='0' />
								</command>
								<command class_type='sim' title='Simulation' macro='Component.Property.SetVisible' >
									<argument exp='this' />
									<argument exp='&quot;PASSWORD&quot;' />
									<argument exp='0' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Show the Will fields only when the Will is enabled' exp='WILL_ENABLE' swap='0' >
							<flowline >
								<command class_type='sim' title='Simulation' macro='Component.Property.SetVisible' >
									<argument exp='this' />
									<argument exp='&quot;WILL_TOPIC&quot;' />
									<argument exp='1' />
								</command>
								<command class_type='sim' title='Simulation' macro='Component.Property.SetVisible' >
									<argument exp='this' />
									<argument exp='&quot;WILL_MESSAGE&quot;' />
									<argument exp='1' />
								</command>
								<command class_type='sim' title='Simulation' macro='Component.Property.SetVisible' >
									<argument exp='this' />
									<argument exp='&quot;WILL_QOS&quot;' />
									<argument exp='1' />
								</command>
								<command class_type='sim' title='Simulation' macro='Component.Property.SetVisible' >
									<argument exp='this' />
									<argument exp='&quot;WILL_RETAIN&quot;' />
									<argument exp='1' />
								</command>
							</flowline>
							<flowline >
								<command class_type='sim' title='Simulation' macro='Component.Property.SetVisible' >
									<argument exp='this' />
									<argument exp='&quot;WILL_TOPIC&quot;' />
									<argument exp='0' />
								</command>
								<command class_type='sim' title='Simulation' macro='Component.Property.SetVisible' >
									<argument exp='this' />
									<argument exp='&quot;WILL_MESSAGE&quot;' />
									<argument exp='0' />
								</command>
								<command class_type='sim' title='Simulation' macro='Component.Property.SetVisible' >
									<argument exp='this' />
									<argument exp='&quot;WILL_QOS&quot;' />
									<argument exp='0' />
								</command>
								<command class_type='sim' title='Simulation' macro='Component.Property.SetVisible' >
									<argument exp='this' />
									<argument exp='&quot;WILL_RETAIN&quot;' />
									<argument exp='0' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='The acknowledgement settings only apply above QoS 0' exp='QoS' swap='0' >
							<flowline >
								<command class_type='sim' title='Simulation' macro='Component.Property.SetVisible' >
									<argument exp='this' />
									<argument exp='&quot;ACK_TIMEOUT&quot;' />
									<argument exp='1' />
								</command>
								<command class_type='sim' title='Simulation' macro='Component.Property.SetVisible' >
									<argument exp='this' />
									<argument exp='&quot;ACK_RETRIES&quot;' />
									<argument exp='1' />
								</command>
							</flowline>
							<flowline >
								<command class_type='sim' title='Simulation' macro='Component.Property.SetVisible' >
									<argument exp='this' />
									<argument exp='&quot;ACK_TIMEOUT&quot;' />
									<argument exp='0' />
								</command>
								<command class_type='sim' title='Simulation' macro='Component.Property.SetVisible' >
									<argument exp='this' />
									<argument exp='&quot;ACK_RETRIES&quot;' />
									<argument exp='0' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_LoadComplete' description='Broadcast after a project has finished loading' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='decision' title='Decision' exp='NETWORK_COMPONENT' swap='0' >
							<flowline >
								<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='SetLinkHandle' >
									<argument exp='1' />
									<argument exp='NETWORK_COMPONENT' />
								</command>
								<command class_type='sim' title='Built-in Function' macro='Component.Property.SetValue' >
									<argument exp='this' />
									<argument exp='&quot;NETWORK_COMPONENT&quot;' />
									<argument exp='0' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ConnectTo' description='Connect to a variable MQTT Server, overriding the Host, Port and Client identifier properties.

Returns the connected state.
0 if not connected, 1 if successful connection, or already connected.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Host' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='Port' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ClientID' type='T8*' description='Client identifier name - must be unique on server' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<command class_type='call' title='Call Macro' macro='Prv_DoConnect' >
							<return exp='.Return' />
							<argument exp='.Host' />
							<argument exp='.Port' />
							<argument exp='.ClientID' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ping' description='Ping packet is sent to the Server and checks for a reply.
Returns non-zero value if successful
' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='ReplySize' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='comment' title='' comment='Send MQTT PINGREQ' textarea='12,0,12,0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='Packet[0] = 0xC0 // PINGREQ type packet' />
							<exp exp='Packet[1] = 0 // Remaining Length' />
							<exp exp='PacketSize = 2' />
							<exp exp='' />
						</command>
						<command class_type='call' title='Call Macro' macro='PacketTransfer' >
							<return exp='.ReplySize' />
							<argument exp='1' />
						</command>
						<command class_type='decision' title='Decision' exp='.ReplySize = 2' swap='0' >
							<flowline >
								<command class_type='comment' title='' comment='Check the response' textarea='12,0,12,0' />
								<command class_type='decision' title='Check for PINGRESP packet' exp='(Packet[0] = 0xD0) &amp;&amp; (Packet[1] = 0)' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Return = 1' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='IsConnected' description='Returns non-zero while the client holds an open MQTT session with the broker.

Cleared by Disconnect, and also if a send fails, so it is worth checking before Publish.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = Connected' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Renamed' description='' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Name' type='T8' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</local>
						<command class_type='sim' title='' macro='Tree.GetName' >
							<return exp='.Name' />
							<argument exp='this' />
						</command>
						<command class_type='sim' title='' macro='Component.Property.SetValue' >
							<argument exp='LibraryComponent1' />
							<argument exp='&quot;Name&quot;' />
							<argument exp='.Name' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='GetPayload' description='Get the Payload of the last received (Read) packet.
Returns the number of bytes for the Payload' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Payload' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='Size' type='u8' description='Byte count the Payload buffer' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='x' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Len' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Len = RxPayloadSize' />
						</command>
						<command class_type='decision' title='The return value is a byte, so cap it' exp='.Len &gt; 255' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Len = 255' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = .Len' />
							<exp exp='.x = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='(.x &lt; .Size) &amp;&amp; (.x &lt; .Return)' for1='' for3='' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Payload[.x] = Packet[RxPayloadOffset + .x]' />
									<exp exp='.x = .x + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='decision' title='Decision' exp='.x &lt; .Size' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Payload[.x] = 0' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_GetVarSize' description='Sent to a component to amend the size of the expected array' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='VarName' type='T8' description='The original Flowcode variable' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<param name='Elements' type='u32*' description='The number of elements in the array' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 1' />
						</command>
						<command class_type='decision' title='Decision' exp='Compare$(.VarName,&quot;Packet&quot;,0) == 0' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Elements = MaxPacketSize' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Prv_SendAck' description='Sends a four byte acknowledgement packet (PUBACK, PUBREC, PUBREL or PUBCOMP).
Uses its own buffer so that a received message held in Packet is not destroyed.
Returns the number of bytes sent.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='AckType' type='u8' description='Complete first header byte, e.g. 0x40 for PUBACK or 0x62 for PUBREL' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Id' type='u16' description='Packet Identifier being acknowledged' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='AckPacket[0] = .AckType' />
							<exp exp='AckPacket[1] = 2 // Remaining Length' />
							<exp exp='AckPacket[2] = .Id &gt;&gt; 8 // Packet Identifier MSB' />
							<exp exp='AckPacket[3] = .Id // Packet Identifier LSB' />
						</command>
						<command class_type='call' title='Call Component Macro' component='NetworkCommsDummy' macro='Send' >
							<return exp='.Return' />
							<argument exp='AckPacket' />
							<argument exp='4' />
						</command>
						<command class_type='sim' title='Call Component Macro' component='LibraryComponent1' macro='FlashTx' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Subscribe' description='Subscribe to a Topic.
Must be Connected first.
The Quality of Service property is sent as the requested maximum QoS for the subscription.
Returns non-zero if successful
' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Topic' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<local name='TopicLength' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='x' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='ReplySize' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='RemLen' type='u32' description='Remaining Length field of the SUBSCRIBE packet' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Hdr' type='u8' description='Fixed header size in bytes' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Pos' type='u16' description='Write position within Packet' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='MsgId' type='u16' description='Packet Identifier of this SUBSCRIBE' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='RxId' type='u16' description='Packet Identifier echoed back in the SUBACK' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='RxLen' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='decision' title='Decision' exp='Connected' swap='0' >
							<flowline >
								<command class_type='comment' title='' comment='Send MQTT SUBSCRIBE' textarea='12,0,12,0' />
								<command class_type='calculation' title='Calculation' >
									<exp exp='.TopicLength = Length$ (.Topic)' />
									<exp exp='.RemLen = 5 + .TopicLength // Packet Identifier, Topic length field, Topic, requested QoS' />
								</command>
								<command class_type='call' title='How many bytes will the Remaining Length field need?' macro='Prv_VbiSize' >
									<return exp='.Hdr' />
									<argument exp='.RemLen' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Hdr = .Hdr + 1' />
								</command>
								<command class_type='decision' title='Does the whole packet fit in the buffer?' exp='(.Hdr + .RemLen) &gt; MaxPacketSize' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='LastError = ERROR_TOPIC_TOO_LARGE' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='Call Macro' macro='Prv_NextPacketId' >
											<return exp='.MsgId' />
										</command>
										<command class_type='calculation' title='Fixed header' >
											<exp exp='Packet[0] = 0x82 // SUBSCRIBE type packet, reserved flags must be 0010' />
										</command>
										<command class_type='call' title='Encode the Remaining Length' macro='Prv_EncodeRemainingLength' >
											<return exp='.Hdr' />
											<argument exp='.RemLen' />
										</command>
										<command class_type='calculation' title='Variable header' >
											<exp exp='Packet[.Hdr] = .MsgId &gt;&gt; 8 // Packet Identifier MSB' />
											<exp exp='Packet[.Hdr + 1] = .MsgId // Packet Identifier LSB' />
											<exp exp='Packet[.Hdr + 2] = .TopicLength &gt;&gt; 8 // Topic length MSB' />
											<exp exp='Packet[.Hdr + 3] = .TopicLength // Topic length LSB' />
											<exp exp='.Pos = .Hdr + 4' />
											<exp exp='.x = 0' />
										</command>
										<command class_type='loop' title='Copy the Topic to the payload' type='0' exp='.x &lt; .TopicLength' for1='' for3='' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='Packet[.Pos] = .Topic[.x]' />
													<exp exp='.Pos = .Pos + 1' />
													<exp exp='.x = .x + 1' />
												</command>
											</flowline>
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='Packet[.Pos] = QoS // Requested maximum QoS for this subscription' />
											<exp exp='.Pos = .Pos + 1' />
											<exp exp='PacketSize = .Pos' />
										</command>
										<command class_type='call' title='Call Macro' macro='PacketTransfer' >
											<return exp='.ReplySize' />
											<argument exp='1' />
										</command>
										<command class_type='decision' title='Decision' exp='.ReplySize &gt; 0' swap='0' >
											<flowline >
												<command class_type='comment' title='' comment='Check the response' textarea='12,0,12,0' />
												<command class_type='call' title='Call Macro' macro='Prv_DecodeRemainingLength' >
													<return exp='.RxLen' />
												</command>
												<command class_type='calculation' title='Calculation' >
													<exp exp='.RxId = (Packet[RxHeaderSize] &lt;&lt; 8) | Packet[RxHeaderSize + 1]' />
												</command>
												<command class_type='decision' title='Check for SUBACK packet with a granted QoS' exp='(Packet[0] = 0x90) &amp;&amp; (.RxId = .MsgId) &amp;&amp; (Packet[RxHeaderSize + 2] != 0x80)' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='.Return = 1' />
															<exp exp='SubGrantedQoS = Packet[RxHeaderSize + 2] // The broker may grant a lower QoS than we asked for' />
														</command>
													</flowline>
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='LastError = ERROR_MQTT_SUBSCRIBE_FAILED' />
															<exp exp='SubGrantedQoS = 0x80 // Subscription refused by the broker' />
														</command>
													</flowline>
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='LastError = ERROR_NOT_CONNECTED' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Prv_EncodeRemainingLength' description='Writes Length into Packet[1..] as an MQTT Variable Byte Integer.
Returns the total fixed header size, i.e. 1 + the number of length bytes written.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Length' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Idx' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Value' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Byte' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='More' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Idx = 1' />
							<exp exp='.Value = .Length' />
							<exp exp='.More = 1' />
						</command>
						<command class_type='loop' title='Emit one continuation byte at a time' type='0' exp='.More' for1='' for3='' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Byte = .Value &amp; 0x7F' />
									<exp exp='.Value = .Value &gt;&gt; 7' />
								</command>
								<command class_type='decision' title='More bytes to follow?' exp='.Value &gt; 0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.Byte = .Byte | 0x80' />
										</command>
									</flowline>
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.More = 0' />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='Packet[.Idx] = .Byte' />
									<exp exp='.Idx = .Idx + 1' />
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = .Idx' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Prv_DecodeRemainingLength' description='Decodes the MQTT Variable Byte Integer Remaining Length field of the packet held in Packet.
Sets RxHeaderSize and RxRemainingLength, and returns the Remaining Length.' statediag='0' >
						<return name='Return' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Idx' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Mult' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Byte' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='More' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Idx = 1' />
							<exp exp='.Mult = 1' />
							<exp exp='.More = 1' />
							<exp exp='.Return = 0' />
						</command>
						<command class_type='loop' title='Consume up to four length bytes' type='0' exp='(.More) &amp;&amp; (.Idx &lt; 5)' for1='' for3='' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Byte = Packet[.Idx]' />
									<exp exp='.Return = .Return + ((.Byte &amp; 0x7F) * .Mult)' />
									<exp exp='.Mult = .Mult * 128' />
									<exp exp='.Idx = .Idx + 1' />
								</command>
								<command class_type='decision' title='Continuation bit clear?' exp='(.Byte &amp; 0x80) = 0' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='.More = 0' />
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='RxHeaderSize = .Idx' />
							<exp exp='RxRemainingLength = .Return' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Unsubscribe' description='Unsubscribe from a Topic.
Must be Connected first
Returns non-zero if successful
' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Topic' type='T8*' description='' isconst='0' isHidden='0' isinit='0' usrinit='&quot;&quot;' setinit='' >
							<array size='20' />
						</param>
						<local name='TopicLength' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='x' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='ReplySize' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='RemLen' type='u32' description='Remaining Length field of the UNSUBSCRIBE packet' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Hdr' type='u8' description='Fixed header size in bytes' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Pos' type='u16' description='Write position within Packet' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='MsgId' type='u16' description='Packet Identifier of this UNSUBSCRIBE' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='RxId' type='u16' description='Packet Identifier echoed back in the UNSUBACK' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='RxLen' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = 0' />
						</command>
						<command class_type='decision' title='Decision' exp='Connected' swap='0' >
							<flowline >
								<command class_type='comment' title='' comment='Send MQTT UNSUBSCRIBE' textarea='12,0,12,0' />
								<command class_type='calculation' title='Calculation' >
									<exp exp='.TopicLength = Length$ (.Topic)' />
									<exp exp='.RemLen = 4 + .TopicLength // Packet Identifier, Topic length field, Topic. No QoS byte on UNSUBSCRIBE' />
								</command>
								<command class_type='call' title='How many bytes will the Remaining Length field need?' macro='Prv_VbiSize' >
									<return exp='.Hdr' />
									<argument exp='.RemLen' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Hdr = .Hdr + 1' />
								</command>
								<command class_type='decision' title='Does the whole packet fit in the buffer?' exp='(.Hdr + .RemLen) &gt; MaxPacketSize' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='LastError = ERROR_TOPIC_TOO_LARGE' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='Call Macro' macro='Prv_NextPacketId' >
											<return exp='.MsgId' />
										</command>
										<command class_type='calculation' title='Fixed header' >
											<exp exp='Packet[0] = 0xA2 // UNSUBSCRIBE type packet, reserved flags must be 0010' />
										</command>
										<command class_type='call' title='Encode the Remaining Length' macro='Prv_EncodeRemainingLength' >
											<return exp='.Hdr' />
											<argument exp='.RemLen' />
										</command>
										<command class_type='calculation' title='Variable header' >
											<exp exp='Packet[.Hdr] = .MsgId &gt;&gt; 8 // Packet Identifier MSB' />
											<exp exp='Packet[.Hdr + 1] = .MsgId // Packet Identifier LSB' />
											<exp exp='Packet[.Hdr + 2] = .TopicLength &gt;&gt; 8 // Topic length MSB' />
											<exp exp='Packet[.Hdr + 3] = .TopicLength // Topic length LSB' />
											<exp exp='.Pos = .Hdr + 4' />
											<exp exp='.x = 0' />
										</command>
										<command class_type='loop' title='Copy the Topic to the payload' type='0' exp='.x &lt; .TopicLength' for1='' for3='' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='Packet[.Pos] = .Topic[.x]' />
													<exp exp='.Pos = .Pos + 1' />
													<exp exp='.x = .x + 1' />
												</command>
											</flowline>
										</command>
										<command class_type='calculation' title='Calculation' >
											<exp exp='PacketSize = .Pos' />
										</command>
										<command class_type='call' title='Call Macro' macro='PacketTransfer' >
											<return exp='.ReplySize' />
											<argument exp='1' />
										</command>
										<command class_type='decision' title='Decision' exp='.ReplySize &gt; 0' swap='0' >
											<flowline >
												<command class_type='comment' title='' comment='Check the response' textarea='12,0,12,0' />
												<command class_type='call' title='Call Macro' macro='Prv_DecodeRemainingLength' >
													<return exp='.RxLen' />
												</command>
												<command class_type='calculation' title='Calculation' >
													<exp exp='.RxId = (Packet[RxHeaderSize] &lt;&lt; 8) | Packet[RxHeaderSize + 1]' />
												</command>
												<command class_type='decision' title='Check for UNSUBACK packet' exp='(Packet[0] = 0xB0) &amp;&amp; (.RxId = .MsgId)' swap='0' >
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='.Return = 1' />
														</command>
													</flowline>
													<flowline >
														<command class_type='calculation' title='Calculation' >
															<exp exp='LastError = ERROR_MQTT_SUBSCRIBE_FAILED' />
														</command>
													</flowline>
												</command>
											</flowline>
											<flowline />
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='LastError = ERROR_NOT_CONNECTED' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='GetGrantedQoS' description='Returns the QoS the broker actually granted for the last Subscribe.

A broker may grant a lower QoS than requested, so this can be less than the Quality of
Service property. Returns 0x80 if the last Subscribe was refused.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = SubGrantedQoS' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='comment' title='' comment='Component Version Information;
7, 1.1, 23-07-24, BR, Added Max Packet Size property to allow the size of a single packet to be altered by the user;
8, 1.1, 30-07-24, BR, Resolved ESP compile error due to missing return and added TopicTooLong error;
9, 1.2, 11-08-26, Remaining Length is now encoded and decoded as a proper Variable Byte Integer, so packets are no longer limited to 127 bytes;
10, 1.2, 11-08-26, Connect and ConnectTo now share a single Prv_DoConnect implementation;
11, 1.2, 11-08-26, PacketTransfer reply buffer was hardcoded to 64 bytes, now uses Max Packet Size;
12, 1.2, 11-08-26, UNSUBSCRIBE no longer sends a spurious QoS byte and its Remaining Length is correct;
13, 1.2, 11-08-26, Read masks the packet type nibble, so PUBLISH packets with DUP, QoS or RETAIN flags set are no longer discarded;
14, 1.2, 11-08-26, Full QoS 1 and QoS 2 support with Packet Identifiers and acknowledgement handshakes, Quality of Service property unhidden;
15, 1.3, 11-08-26, Added Retain support - Retain property, PublishRetain and PublishByteArrayRetain, plus GetRetain and GetDup for incoming messages;
16, 1.3, 11-08-26, Added Last Will and Testament - Will Topic, Message, QoS and Retain properties sent in the CONNECT packet;
17, 1.4, 11-08-26, ErrorAsString return buffer reduced from 2000 to 48 bytes;
18, 1.4, 11-08-26, PacketTransfer returned u16 packet sizes through a u8, so sends of 256 bytes or more reported failure. Widened to u16;
19, 1.4, 11-08-26, Publish and PublishByteArray now return 1 or 0 consistently at every QoS level;
20, 1.4, 11-08-26, Added IsConnected and GetGrantedQoS;
21, 1.4, 11-08-26, Acknowledge Timeout and Acknowledge Retries properties replace the fixed four attempts at the network timeout;
22, 1.4, 11-08-26, Corrected the CONNACK code 4 error string and the Max Packet Size and Client identifier help text;
23, 1.5, 11-08-26, Added Clean Start - the Clean Session flag was previously hardwired on. Session Present is read from the CONNACK and exposed by GetSessionPresent;
24, 1.5, 11-08-26, The Packet Identifier sequence is no longer reset when the broker resumes an existing session;' textarea='12,0,12,0' />
					</flowline>
				</macro>
				<macro >
					<flowline name='PacketTransfer' description='Send Packet and receive reply Packet if ExpectReply is not 0
Returns reply packet size, 0 if not received 
or send size if ExpectReply is 0' statediag='0' >
						<return name='Return' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='ExpectReply' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<local name='Timer' type='u16' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='call' title='Call Component Macro' component='NetworkCommsDummy' macro='Send' >
							<return exp='PacketSize' />
							<argument exp='Packet' />
							<argument exp='PacketSize' />
						</command>
						<command class_type='decision' title='Decision' exp='PacketSize &gt; 0' swap='0' >
							<flowline >
								<command class_type='sim' title='Call Component Macro' component='LibraryComponent1' macro='FlashTx' />
								<command class_type='decision' title='Decision' exp='.ExpectReply' swap='0' >
									<flowline >
										<command class_type='call' title='Call Component Macro' component='NetworkCommsDummy' macro='Receive' >
											<return exp='PacketSize' />
											<argument exp='Packet' />
											<argument exp='MaxPacketSize' />
											<argument exp='TIMEOUT' />
										</command>
										<command class_type='decision' title='Decision' exp='PacketSize = 0' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='LastError = ERROR_NO_REPLY_DATA' />
												</command>
											</flowline>
											<flowline >
												<command class_type='sim' title='Call Component Macro' component='LibraryComponent1' macro='FlashRx' />
											</flowline>
										</command>
									</flowline>
									<flowline />
								</command>
							</flowline>
							<flowline >
								<command class_type='comment' title='' comment='Failed send' textarea='12,0,12,0' />
								<command class_type='call' title='Call Component Macro' component='NetworkCommsDummy' macro='SocketClose' />
								<command class_type='calculation' title='Calculation' >
									<exp exp='Connected = 0' />
									<exp exp='LastError = ERROR_COULD_NOT_SEND_DATA' />
								</command>
							</flowline>
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = PacketSize' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Initialise' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='Connected = 0' />
							<exp exp='PacketId = 0' />
							<exp exp='RxHeaderSize = 2' />
							<exp exp='RxRemainingLength = 0' />
							<exp exp='RxQoS = 0' />
							<exp exp='RxMessageId = 0' />
							<exp exp='RxTopicSize = 0' />
							<exp exp='RxPayloadOffset = 0' />
							<exp exp='RxPayloadSize = 0' />
							<exp exp='RetainFlag = RETAIN' />
							<exp exp='RxRetain = 0' />
							<exp exp='RxDup = 0' />
							<exp exp='SubGrantedQoS = 0' />
							<exp exp='SessionPresent = 0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='GetSessionPresent' description='Returns non-zero if the broker resumed a previous session on the last successful connect.

Only meaningful when Clean Start is cleared. If this returns 0 the broker did not have a
session for this Client identifier, so your subscriptions were lost and you need to
Subscribe again.' statediag='0' >
						<return name='Return' type='u8' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = SessionPresent' />
						</command>
					</flowline>
				</macro>
			</macros>
			<component class_type='ref' guid='58be670e-18fb-477e-ab09-61fde14b23ec' vmin='0' vmaj='1' codename='LibraryComponent1' panelId='-1' x='0' y='0' z='0' xsz='100' ysz='100' zsz='100' xang='0' yang='0' zang='0' xquat='0' yquat='0' zquat='0' wquat='1' visible='1' scadavisible='1' interactive='1' solid='1' layer='1' poslock='1' ancTop='0' ancBottom='0' ancLeft='0' ancRight='0' ancMinX='0' ancMinY='0' comp2dType='0' >
