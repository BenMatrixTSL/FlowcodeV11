							</flowline>
						</command>
						<command class_type='call' title='Component Macro' component='PWM1' macro='SetDutyCycle' >
							<argument exp='IdleDuty' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='RepeatFlag = 0' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='RxState = 0' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='EdgeTimeoutTicks = 0' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='TickCount = 0' />
						</command>
						<command class_type='calculation' title='Calculation' >
