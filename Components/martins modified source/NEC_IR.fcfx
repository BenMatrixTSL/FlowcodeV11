			<macros >
				<macro >
					<flowline name='DelayUs' description='Internal: busy-wait for the given number of microseconds using TickCount (no Timer1 involved).' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='TargetUs' type='u32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='ElapsedUs' type='u32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='TickCount = 0' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.ElapsedUs = 0' />
						</command>
						<command class_type='loop' title='Loop' type='0' exp='.ElapsedUs &lt; .TargetUs' for1='' for3='' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='.ElapsedUs = TickCount * EstBestPeriod' />
								</command>
							</flowline>
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='TransmitNEC' description='Sends one standard NEC frame: 8-bit address, 8-bit inverted address, 8-bit command, 8-bit inverted command.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='TxAddress' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<param name='TxCommand' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='InvAddress' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='InvCommand' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.InvAddress = 255 - .TxAddress' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.InvCommand = 255 - .TxCommand' />
						</command>
						<command class_type='call' title='Call Macro' macro='SendMark' >
							<argument exp='9000' />
						</command>
						<command class_type='call' title='Call Macro' macro='SendSpace' >
							<argument exp='4500' />
						</command>
						<command class_type='call' title='Call Macro' macro='SendByte' >
							<argument exp='.TxAddress' />
						</command>
						<command class_type='call' title='Call Macro' macro='SendByte' >
							<argument exp='.InvAddress' />
						</command>
						<command class_type='call' title='Call Macro' macro='SendByte' >
							<argument exp='.TxCommand' />
						</command>
						<command class_type='call' title='Call Macro' macro='SendByte' >
							<argument exp='.InvCommand' />
						</command>
						<command class_type='call' title='Call Macro' macro='SendMark' >
							<argument exp='562' />
						</command>
						<command class_type='call' title='Component Macro' component='PWM1' macro='SetDutyCycle' >
							<argument exp='IdleDuty' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SendMark' description='Internal: carrier ON (IR LED burst at 38kHz) for the given duration.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='DurationUs' type='u32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='call' title='Component Macro' component='PWM1' macro='SetDutyCycle' >
							<argument exp='MarkDuty' />
						</command>
						<command class_type='call' title='Call Macro' macro='DelayUs' >
							<argument exp='.DurationUs' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='SendByte' description='Internal: sends one byte, LSB first, as NEC-encoded mark/space pairs.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='Value' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Mask' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='BitIdx' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Mask = 1' />
						</command>
						<command class_type='loop' title='Loop' type='2' forvar='.BitIdx' exp='8' for1='' for3='' >
							<flowline >
								<command class_type='call' title='Call Macro' macro='SendMark' >
									<argument exp='562' />
								</command>
								<command class_type='decision' title='Decision' exp='(.Value AND .Mask) != 0' swap='0' >
									<flowline >
										<command class_type='call' title='Call Macro' macro='SendSpace' >
											<argument exp='1687' />
										</command>
									</flowline>
									<flowline >
										<command class_type='call' title='Call Macro' macro='SendSpace' >
											<argument exp='562' />
										</command>
									</flowline>
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='.Mask = .Mask * 2' />
								</command>
							</flowline>
						</command>
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashTx' />
					</flowline>
				</macro>
				<macro >
					<flowline name='IsHeld' description='On-demand: is the last decoded button still considered held?' statediag='0' >
						<return name='Return' type='b1' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = RepeatFlag' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='IsDataDetected' description='On-demand: has a new frame or repeat been decoded since the last ClearDataDetected() call?' statediag='0' >
						<return name='Return' type='b1' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = DataDetected' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Ev_Properties' description='Auto-syncs Tick Period (us) to match RX Timer settings whenever a property changes.' statediag='0' >
						<return name='Return' type='u32' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='sim' title='Built-in Function' macro='Component.Property.CopyValue' >
							<argument exp='TimedInterval1' />
							<argument exp='This' />
							<argument exp='&quot;EstBestPeriod&quot;' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='PeriodicHeldCheck' description='Timer callback: increments TickCount and ages out held/repeat state.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='TickCount = TickCount + 1' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='HeldCheckCounter = HeldCheckCounter + 1' />
						</command>
						<command class_type='decision' title='Decision' exp='HeldCheckCounter &gt;= 471' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='HeldCheckCounter = 0' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='EdgeTimeoutTicks = EdgeTimeoutTicks + 1' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='(RxState == 0) &amp;&amp; (RepeatFlag == 1) &amp;&amp; ((SIGNED EdgeTimeoutTicks * 50) &gt; HeldThresholdMs)' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='RepeatFlag = 0' />
								</command>
							</flowline>
							<flowline />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='ProcessEdge' description='Call on every RxPin edge (both edges). Returns the last decoded value per Mode: 1=Address, 2=Command, 3=both.' statediag='0' >
						<return name='Return' type='u32' description='The most recently decoded value(s) selected by Mode. 4294967295 only before any frame has ever been received.' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<param name='Mode' type='u8' description='Which decoded value(s) to return: 1=Address only, 2=Command only, 3=both packed as (Address*256)+Command.' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Elapsed' type='u32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='ByteIndex' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Bit' type='u8' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='NewData' type='b1' description='Set true only when this edge completed a validated full frame or repeat code.' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Address' type='u8' description='Scratch: validated address for this call only, immediately folded into LastReceived - never needs to survive to a later call, so this is local, not a component variable.' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<local name='Command' type='u8' description='Scratch: validated command for this call only, immediately folded into LastReceived - never needs to survive to a later call, so this is local, not a component variable.' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.NewData = 0' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='LastRxState = RxState' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Elapsed = TickCount * EstBestPeriod' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='LastElapsedUs = .Elapsed' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='TickCount = 0' />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='EdgeTimeoutTicks = 0' />
						</command>
						<command class_type='switch' title='Switch' exp='RxState' >
							<case >
								<flowline />
							</case>
							<case exp='0' >
								<flowline >
									<command class_type='decision' title='Decision' exp='RxPin == 0' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='RxState = 1' />
											</command>
										</flowline>
										<flowline />
									</command>
								</flowline>
							</case>
							<case exp='1' >
								<flowline >
									<command class_type='decision' title='Decision' exp='(.Elapsed &gt;= 8000) &amp;&amp; (.Elapsed &lt;= 10000)' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='RxState = 2' />
											</command>
										</flowline>
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='RxState = 0' />
											</command>
										</flowline>
									</command>
								</flowline>
							</case>
							<case exp='2' >
								<flowline >
									<command class_type='decision' title='Decision' exp='(.Elapsed &gt;= 4000) &amp;&amp; (.Elapsed &lt;= 5000)' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='BitIndex = 0' />
											</command>
											<command class_type='calculation' title='Calculation' >
												<exp exp='Mask = 1' />
											</command>
											<command class_type='calculation' title='Calculation' >
												<exp exp='WorkingAddress = 0' />
											</command>
											<command class_type='calculation' title='Calculation' >
												<exp exp='WorkingInvAddress = 0' />
											</command>
											<command class_type='calculation' title='Calculation' >
												<exp exp='WorkingCommand = 0' />
											</command>
											<command class_type='calculation' title='Calculation' >
												<exp exp='WorkingInvCommand = 0' />
											</command>
											<command class_type='calculation' title='Calculation' >
												<exp exp='RxState = 3' />
											</command>
										</flowline>
										<flowline >
											<command class_type='decision' title='Decision' exp='(.Elapsed &gt;= 2000) &amp;&amp; (.Elapsed &lt;= 2500)' swap='0' >
												<flowline >
													<command class_type='calculation' title='Calculation' >
														<exp exp='RxState = 6' />
													</command>
												</flowline>
												<flowline >
													<command class_type='calculation' title='Calculation' >
														<exp exp='RxState = 0' />
													</command>
												</flowline>
											</command>
										</flowline>
									</command>
								</flowline>
							</case>
							<case exp='3' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='RxState = 4' />
									</command>
								</flowline>
							</case>
							<case exp='4' >
								<flowline >
									<command class_type='decision' title='Decision' exp='.Elapsed &gt; 2000' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='RxState = 0' />
											</command>
										</flowline>
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Bit = 0' />
											</command>
											<command class_type='decision' title='Decision' exp='.Elapsed &gt; 1125' swap='0' >
												<flowline >
													<command class_type='calculation' title='Calculation' >
														<exp exp='.Bit = 1' />
													</command>
												</flowline>
												<flowline />
											</command>
											<command class_type='calculation' title='Calculation' >
												<exp exp='.ByteIndex = BitIndex / 8' />
											</command>
											<command class_type='decision' title='Decision' exp='.Bit == 1' swap='0' >
												<flowline >
													<command class_type='decision' title='Decision' exp='.ByteIndex == 0' swap='0' >
														<flowline >
															<command class_type='calculation' title='Calculation' >
																<exp exp='WorkingAddress = WorkingAddress + Mask' />
															</command>
														</flowline>
														<flowline />
													</command>
													<command class_type='decision' title='Decision' exp='.ByteIndex == 1' swap='0' >
														<flowline >
															<command class_type='calculation' title='Calculation' >
																<exp exp='WorkingInvAddress = WorkingInvAddress + Mask' />
															</command>
														</flowline>
														<flowline />
													</command>
													<command class_type='decision' title='Decision' exp='.ByteIndex == 2' swap='0' >
														<flowline >
															<command class_type='calculation' title='Calculation' >
																<exp exp='WorkingCommand = WorkingCommand + Mask' />
															</command>
														</flowline>
														<flowline />
													</command>
													<command class_type='decision' title='Decision' exp='.ByteIndex == 3' swap='0' >
														<flowline >
															<command class_type='calculation' title='Calculation' >
																<exp exp='WorkingInvCommand = WorkingInvCommand + Mask' />
															</command>
														</flowline>
														<flowline />
													</command>
												</flowline>
												<flowline />
											</command>
											<command class_type='calculation' title='Calculation' >
												<exp exp='Mask = Mask * 2' />
											</command>
											<command class_type='decision' title='Decision' exp='Mask == 0' swap='0' >
												<flowline >
													<command class_type='calculation' title='Calculation' >
														<exp exp='Mask = 1' />
													</command>
												</flowline>
												<flowline />
											</command>
											<command class_type='calculation' title='Calculation' >
												<exp exp='BitIndex = BitIndex + 1' />
											</command>
											<command class_type='decision' title='Decision' exp='BitIndex == 32' swap='0' >
												<flowline >
													<command class_type='calculation' title='Calculation' >
														<exp exp='RxState = 5' />
													</command>
												</flowline>
												<flowline >
													<command class_type='calculation' title='Calculation' >
														<exp exp='RxState = 3' />
													</command>
												</flowline>
											</command>
										</flowline>
									</command>
								</flowline>
							</case>
							<case exp='5' >
								<flowline >
									<command class_type='decision' title='Decision' exp='(WorkingAddress == 255 - WorkingInvAddress) &amp;&amp; (WorkingCommand == 255 - WorkingInvCommand)' swap='0' >
										<flowline >
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Address = WorkingAddress' />
											</command>
											<command class_type='calculation' title='Calculation' >
												<exp exp='.Command = WorkingCommand' />
											</command>
											<command class_type='calculation' title='Calculation' >
												<exp exp='.NewData = 1' />
											</command>
											<command class_type='calculation' title='Calculation' >
												<exp exp='RepeatFlag = 0' />
											</command>
										</flowline>
										<flowline />
									</command>
									<command class_type='calculation' title='Calculation' >
										<exp exp='RxState = 0' />
									</command>
								</flowline>
							</case>
							<case exp='6' >
								<flowline >
									<command class_type='calculation' title='Calculation' >
										<exp exp='.NewData = 1' />
									</command>
									<command class_type='calculation' title='Calculation' >
										<exp exp='RepeatFlag = 1' />
									</command>
									<command class_type='calculation' title='Calculation' >
										<exp exp='RxState = 0' />
									</command>
								</flowline>
							</case>
						</command>
						<command class_type='decision' title='Decision' exp='.NewData == 1' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='DataDetected = 1' />
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='decision' title='Decision' exp='(.NewData == 1) &amp;&amp; (RepeatFlag == 0)' swap='0' >
							<flowline >
								<command class_type='decision' title='Decision' exp='.Mode == 1' swap='0' >
									<flowline >
										<command class_type='calculation' title='Calculation' >
											<exp exp='LastReceived = .Address' />
										</command>
									</flowline>
									<flowline >
										<command class_type='decision' title='Decision' exp='.Mode == 2' swap='0' >
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='LastReceived = .Command' />
												</command>
											</flowline>
											<flowline >
												<command class_type='calculation' title='Calculation' >
													<exp exp='LastReceived = (.Address * 256) + .Command' />
												</command>
											</flowline>
										</command>
									</flowline>
								</command>
							</flowline>
							<flowline />
						</command>
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = LastReceived' />
						</command>
						<command class_type='sim' title='Component Macro' component='LibraryComponent1' macro='FlashRx' />
					</flowline>
				</macro>
				<macro >
					<flowline name='SendSpace' description='Internal: carrier OFF for the given duration.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<param name='DurationUs' type='u32' description='' isconst='0' isHidden='0' isinit='1' usrinit='0' setinit='0' />
						<command class_type='call' title='Component Macro' component='PWM1' macro='SetDutyCycle' >
							<argument exp='IdleDuty' />
