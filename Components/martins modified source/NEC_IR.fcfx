						<command class_type='calculation' title='Calculation' >
							<exp exp='DataDetected = 0' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='IsRepeat' description='On-demand: was the last decoded frame a repeat code rather than a fresh frame?' statediag='0' >
						<return name='Return' type='b1' description='' isconst='0' isHidden='0' isinit='0' usrinit='0' setinit='' />
						<command class_type='calculation' title='Calculation' >
							<exp exp='.Return = RepeatFlag' />
						</command>
					</flowline>
				</macro>
				<macro >
					<flowline name='Main' description='' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
					</flowline>
				</macro>
				<macro >
					<flowline name='Initialise' description='Sets up PWM, RX pin and held-detection timer. Call once at startup.' statediag='0' >
						<return name='Return' type='v0' description='' isconst='0' isHidden='0' isinit='0' usrinit='' setinit='' />
						<command class_type='call' title='Component Macro' component='PWM1' macro='Enable' />
						<command class_type='call' title='Component Macro' component='PWM1' macro='ChangePeriod' >
							<argument exp='209' />
							<argument exp='1' />
						</command>
						<command class_type='decision' title='Decision' exp='InvertOutput == 1' swap='0' >
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='IdleDuty = 255' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='MarkDuty = 127' />
								</command>
							</flowline>
							<flowline >
								<command class_type='calculation' title='Calculation' >
									<exp exp='IdleDuty = 0' />
								</command>
								<command class_type='calculation' title='Calculation' >
									<exp exp='MarkDuty = 128' />
